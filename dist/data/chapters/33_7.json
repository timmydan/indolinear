[{"book": 33, "chapter": 7, "verse": 1, "ayat_id": 22666, "title": "Kemerosotan Moral Israel", "ayt_text": "“Celakalah aku! Sebab, keadaanku seperti saat mereka mengumpulkan buah-buahan musim kemarau, seperti pada waktu pemetikan susulan buah anggur. Tidak ada buah anggur untuk dimakan, tidak ada buah ara yang kusukai.”", "words": [{"pos": 1, "word_orig": "אַ֣לְלַי", "strong": "H480", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Celakalah"}, {"pos": 2, "word_orig": "לִ֗/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 4, "word_orig": "הָיִ֨יתִי֙", "strong": "H1961", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "keadaanku"}, {"pos": 5, "word_orig": "כְּ/אָסְפֵּי", "strong": "H625", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "mengumpulkan"}, {"pos": 6, "word_orig": "קַ֔יִץ", "strong": "H7019", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "buah-buahan"}, {"pos": 7, "word_orig": "כְּ/עֹלְלֹ֖ת", "strong": "H5955", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "pemetikan"}, {"pos": 8, "word_orig": "בָּצִ֑יר", "strong": "H1210", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 9, "word_orig": "אֵין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "ada"}, {"pos": 10, "word_orig": "אֶשְׁכּ֣וֹל", "strong": "H811", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 11, "word_orig": "לֶ/אֱכ֔וֹל", "strong": "H398", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "dimakan"}, {"pos": 12, "word_orig