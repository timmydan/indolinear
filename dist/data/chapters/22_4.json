[{"book": 22, "chapter": 4, "verse": 1, "ayat_id": 17584, "title": "Pengantin Laki-laki Memuji Pengantin Perempuan", "ayt_text": "Lihat, cantiknya engkau, kekasihku! Lihat, cantiknya engkau! Matamu bagaikan merpati di balik cadarmu. Rambutmu bagaikan kawanan kambing yang menuruni Gunung Gilead.", "words": [{"pos": 1, "word_orig": "הִנָּ֨/ךְ", "strong": "H2005", "morph": "HTm/Sp2fs", "morph_id": "Tm + Sp2fs", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "יָפָ֤ה", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantiknya"}, {"pos": 3, "word_orig": "רַעְיָתִ/י֙", "strong": "H7474", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "הִנָּ֣/ךְ", "strong": "H2005", "morph": "HTm/Sp2fs", "morph_id": "Tm + Sp2fs", "ayt_word": "Lihat"}, {"pos": 5, "word_orig": "יָפָ֔ה", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantiknya"}, {"pos": 6, "word_orig": "עֵינַ֣יִ/ךְ", "strong": "H5869", "morph": "HNcbdc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2fs", "ayt_word": "Matamu"}, {"pos": 7, "word_orig": "יוֹנִ֔ים", "strong": "H3123", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "merpati"}, {"pos": 8, "word_orig": "מִ/בַּ֖עַד", "strong": "H1157", "morph": "HR/R", "morph_id": "Preposisi + Preposisi", "ayt_word": "balik"}, {"pos": 9, "word_orig": "לְ/צַמָּתֵ֑/ךְ", "strong": "H6777", "morph": "HR/Ncfsc/Sp2fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "cadarmu"}, {"pos": 10, "word_orig": "שַׂעְרֵ/ךְ֙", "strong": "H8181", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "Rambutmu"}, {"pos": 11, "word_orig": "כְּ/עֵ֣דֶר", "strong": "H5739", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kawanan"}, {"pos": 12, "word_orig": "הָֽ/עִזִּ֔ים", "strong": "H5795", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kambing"}, {"pos": 13, "word_orig": "שֶׁ/גָּלְשׁ֖וּ", "strong": "H1570", "morph": "HTr/Vqp3cp", "morph_id": "Tr + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menuruni"}, {"pos": 14, "word_orig": "מֵ/הַ֥ר", "strong": "H2022", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Gunung"}, {"pos": 15, "word_orig": "גִּלְעָֽד", "strong": "H1568", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Gilead"}]}, {"book": 22, "chapter": 4, "verse": 2, "ayat_id": 17585, "title": "", "ayt_text": "Gigimu bagaikan kawanan domba yang baru digunting, yang keluar dari pencuciannya. Semuanya itu beranak kembar, dan tidak satu pun dari mereka kehilangan anaknya.", "words": [{"pos": 1, "word_orig": "שִׁנַּ֨יִ/ךְ֙", "strong": "H8127", "morph": "HNcbdc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2fs", "ayt_word": "Gigimu"}, {"pos": 2, "word_orig": "כְּ/עֵ֣דֶר", "strong": "H5739", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kawanan"}, {"pos": 3, "word_orig": "הַ/קְּצוּב֔וֹת", "strong": "H7094", "morph": "HTd/Vqsfpa", "morph_id": "Artikel Definit (הַ) + Verba Qal Partisip Pasif", "ayt_word": "digunting"}, {"pos": 4, "word_orig": "שֶׁ/עָל֖וּ", "strong": "H5927", "morph": "HTr/Vqp3cp", "morph_id": "Tr + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "keluar"}, {"pos": 5, "word_orig": "מִן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dari"}, {"pos": 6, "word_orig": "הָ/רַחְצָ֑ה", "strong": "H7367", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempua