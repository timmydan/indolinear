_orig": "צְבִיָּ֑ה", "strong": "H6646", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kijang"}, {"pos": 7, "word_orig": "הָ/רוֹעִ֖ים", "strong": "H7462", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "merumput"}, {"pos": 8, "word_orig": "בַּ/שּׁוֹשַׁנִּֽים", "strong": "H7799", "morph": "HRd/Ncbpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "bakung"}]}, {"book": 22, "chapter": 4, "verse": 6, "ayat_id": 17589, "title": "", "ayt_text": "Sampai siang hari berembus, dan bayang-bayang menghilang, aku akan pergi ke gunung mur, dan ke bukit kemenyan.", "words": [{"pos": 1, "word_orig": "עַ֤ד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Sampai"}, {"pos": 2, "word_orig": "שֶׁ/יָּפ֨וּחַ֙", "strong": "H6315", "morph": "HTr/Vqi3ms", "morph_id": "Tr + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berembus"}, {"pos": 3, "word_orig": "הַ/יּ֔וֹם", "strong": "H3117", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 4, "word_orig": "וְ/נָ֖סוּ", "strong": "H5127", "morph": "HC/Vqq3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Jamak", "ayt_word": "menghilang"}, {"pos": 5, "word_orig": "הַ/צְּלָלִ֑ים", "strong": "H6752", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bayang-bayang"}, {"pos": 6, "word_orig": "אֵ֤לֶךְ", "strong": "H3212", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "pergi"}, {"pos": 7, "word_orig": "לִ/י֙", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 8, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 9, "word_orig": "הַ֣ר", "strong": "H2022", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "gunung"}, {"pos": 10, "word_orig": "הַ/מּ֔וֹר", "strong": "H4753", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mur"}, {"pos": 11, "word_orig": "וְ/אֶל", "strong": "H413", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "ke"}, {"pos": 12, "word_orig": "גִּבְעַ֖ת", "strong": "H1389", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "bukit"}, {"pos": 13, "word_orig": "הַ/לְּבוֹנָֽה", "strong": "H3828", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemenyan"}]}, {"book": 22, "chapter": 4, "verse": 7, "ayat_id": 17590, "title": "", "ayt_text": "Engkau cantik seutuhnya, kekasihku. Tidak ada cacat padamu.", "words": [{"pos": 1, "word_orig": "כֻּלָּ֤/ךְ", "strong": "H3605", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "seutuhnya"}, {"pos": 2, "word_orig": "יָפָה֙", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantik"}, {"pos": 3, "word_orig": "רַעְיָתִ֔/י", "strong": "H7474", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "וּ/מ֖וּם", "strong": "H3971", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "cacat"}, {"pos": 5, "word_orig": "אֵ֥ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "ada"}, {"pos": 6, "word_orig": "בָּֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 22, "chapter": 4, "verse": 8, "ayat_id": 17591, "title": "", "ayt_text": "Datanglah bersamaku dari Lebanon, pengantin perempuanku, bersamaku da