[{"book": 23, "chapter": 6, "verse": 1, "ayat_id": 17771, "title": "Allah Memanggil Yesaya", "ayt_text": "Pada tahun kematian Raja Uzia, aku melihat Tuhan duduk di atas takhta yang tinggi dan menjulang; ujung jubah-Nya turun memenuhi Bait Suci.", "words": [{"pos": 1, "word_orig": "בִּ/שְׁנַת", "strong": "H8141", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "tahun"}, {"pos": 2, "word_orig": "מוֹת֙", "strong": "H4194", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kematian"}, {"pos": 3, "word_orig": "הַ/מֶּ֣לֶךְ", "strong": "H4428", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Raja"}, {"pos": 4, "word_orig": "עֻזִּיָּ֔הוּ", "strong": "H5818", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Uzia"}, {"pos": 5, "word_orig": "וָ/אֶרְאֶ֧ה", "strong": "H7200", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "melihat"}, {"pos": 6, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "אֲדֹנָ֛/י", "strong": "H136", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Tuhan"}, {"pos": 8, "word_orig": "יֹשֵׁ֥ב", "strong": "H3427", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "duduk"}, {"pos": 9, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 10, "word_orig": "כִּסֵּ֖א", "strong": "H3678", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "takhta"}, {"pos": 11, "word_orig": "רָ֣ם", "strong": "H7311", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "tinggi"}, {"pos": 12, "word_orig": "וְ/נִשָּׂ֑א", "strong": "H5375"