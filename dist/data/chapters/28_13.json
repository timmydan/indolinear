[{"book": 28, "chapter": 13, "verse": 1, "ayat_id": 22268, "title": "Murka TUHAN terhadap Efraim", "ayt_text": "“Ketika Efraim berbicara, ada kegentaran, ia ditinggikan di Israel, tetapi ia bersalah karena Baal, sehingga ia mati.", "words": [{"pos": 1, "word_orig": "כְּ/דַבֵּ֤ר", "strong": "H1696", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "berbicara"}, {"pos": 2, "word_orig": "אֶפְרַ֨יִם֙", "strong": "H669", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Efraim"}, {"pos": 3, "word_orig": "רְתֵ֔ת", "strong": "H7578", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kegentaran"}, {"pos": 4, "word_orig": "נָשָׂ֥א", "strong": "H5375", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ditinggikan"}, {"pos": 5, "word_orig": "ה֖וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": ""}, {"pos": 6, "word_orig": "בְּ/יִשְׂרָאֵ֑ל", "strong": "H3478", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Israel"}, {"pos": 7, "word_orig": "וַ/יֶּאְשַׁ֥ם", "strong": "H816", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersalah"}, {"pos": 8, "word_orig": "בַּ/בַּ֖עַל", "strong": "H1168", "morph": "HRd/Np", "morph_id": "Rd + Nomina Jamak", "ayt_word": "Baal"}, {"pos": 9, "word_orig": "וַ/יָּמֹֽת", "strong": "H4191", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mati"}]}, {"book": 28, "chapter": 13, "verse": 2, "ayat_id": 22269, "title": "", "ayt_text": "Sekarang, mereka berdosa lebih banyak dan lebih banyak lagi, dan membuat bagi mereka patung-patung tuangan besi, dan berhala-berhala dibuat dengan terampil dari perak mereka, semua itu buatan para pengrajin. Dikatakan tentang mereka, “Biarlah mereka yang mempersembahkan kurban manusia men