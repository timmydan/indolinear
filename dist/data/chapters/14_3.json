[{"book": 14, "chapter": 3, "verse": 1, "ayat_id": 11231, "title": "Salomo Membangun Bait TUHAN", "ayt_text": "Salomo mulai membangun bait TUHAN di Yerusalem, di Gunung Moria, tempat TUHAN memperlihatkan diri-Nya kepada Daud, ayahnya. Tempat itu adalah tempat yang sudah disiapkan oleh Daud, yaitu di tempat pengirikan Ornan, orang Yebus itu.", "words": [{"pos": 1, "word_orig": "וַ/יָּ֣חֶל", "strong": "H2490", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mulai"}, {"pos": 2, "word_orig": "שְׁלֹמֹ֗ה", "strong": "H8010", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Salomo"}, {"pos": 3, "word_orig": "לִ/בְנ֤וֹת", "strong": "H1129", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "membangun"}, {"pos": 4, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 5, "word_orig": "בֵּית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bait"}, {"pos": 6, "word_orig": "יְהוָה֙", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "בִּ/יר֣וּשָׁלִַ֔ם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}, {"pos": 8, "word_orig": "בְּ/הַר֙", "strong": "H2022", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Gunung"}, {"pos": 9, "word_orig": "הַ/מּ֣וֹרִיָּ֔ה", "strong": "H4179", "morph": "HTd/Np", "morph_id": "Artikel Definit (הַ) + Nomina Jamak", "ayt_word": "Moria"}, {"pos": 10, "word_orig": "אֲשֶׁ֥ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "tempat"}, {"pos": 11, "word_orig": "נִרְאָ֖ה", "strong": "H7200", "morph": "HVNp3ms", "morph_id": "Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memperlihatkan"}