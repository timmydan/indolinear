[{"book": 20, "chapter": 2, "verse": 1, "ayat_id": 16435, "title": "Mencari Hikmat", "ayt_text": "Anakku, jika kamu menerima kata-kataku, dan menyimpan perintah-perintahku dalam dirimu,", "words": [{"pos": 1, "word_orig": "בְּ֭נִ/י", "strong": "H1121", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Anakku"}, {"pos": 2, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 3, "word_orig": "תִּקַּ֣ח", "strong": "H3947", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menerima"}, {"pos": 4, "word_orig": "אֲמָרָ֑/י", "strong": "H561", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "kata-kataku"}, {"pos": 5, "word_orig": "וּ֝/מִצְוֺתַ֗/י", "strong": "H4687", "morph": "HC/Ncfpc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "perintah-perintahku"}, {"pos": 6, "word_orig": "תִּצְפֹּ֥ן", "strong": "H6845", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menyimpan"}, {"pos": 7, "word_orig": "אִתָּֽ/ךְ", "strong": "H854", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "dalam"}]}, {"book": 20, "chapter": 2, "verse": 2, "ayat_id": 16436, "title": "", "ayt_text": "buatlah telingamu memperhatikan hikmat, dan condongkanlah hatimu kepada pengertian.", "words": [{"pos": 1, "word_orig": "לְ/הַקְשִׁ֣יב", "strong": "H7181", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "memperhatikan"}, {"pos": 2, "word_orig": "לַֽ/חָכְמָ֣ה", "strong": "H2451", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 3, "word_orig": "אָזְנֶ֑/ךָ", "strong": "H241", "morph": "HNcfsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "telingamu"}, {"pos": 4, "word_orig": "תַּטֶּ֥ה", "strong": "H5186", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "condongkanlah"}, {"pos": 5, "word_orig": "לִ֝בְּ/ךָ֗", "strong": "H3820", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "hatimu"}, {"pos": 6, "word_orig": "לַ/תְּבוּנָֽה", "strong": "H8394", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}]}, {"book": 20, "chapter": 2, "verse": 3, "ayat_id": 16437, "title": "", "ayt_text": "Ya, jika kamu berseru-seru demi pengetahuan, dan mengangkat suaramu demi pengertian,", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "אִ֣ם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 3, "word_orig": "לַ/בִּינָ֣ה", "strong": "H998", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 4, "word_orig": "תִקְרָ֑א", "strong": "H7121", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "berseru-seru"}, {"pos": 5, "word_orig": "לַ֝/תְּבוּנָ֗ה", "strong": "H8394", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 6, "word_orig": "תִּתֵּ֥ן", "strong": "H5414", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengangkat"}, {"pos": 7, "word_orig": "קוֹלֶֽ/ךָ", "strong": "H6963", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "suaramu"}]}, {"book": 20, "chapter": 2, "verse": 4, "ayat_id": 16438, "title": "", "ayt_text": "jika kamu mencarinya seperti perak, dan menyelidikinya seperti harta yang tersembunyi,", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 2, "word_orig": "תְּבַקְשֶׁ֥/נָּה", "strong": "H1245", "morph": "HVpi2ms/Sp3fs", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Tunggal + Sp3fs", "ayt_word": "mencarinya"}, {"pos": 3, "word_orig": "כַ/כָּ֑סֶף", "strong": "H3701", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 4, "word_orig": "וְֽ/כַ/מַּטְמוֹנִ֥ים", "strong": "H4301", "morph": "HC/Rd/Ncmpa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "harta"}, {"pos": 5, "word_orig": "תַּחְפְּשֶֽׂ/נָּה", "strong": "H2664", "morph": "HVqi2ms/Sp3fs", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal + Sp3fs", "ayt_word": "menyelidikinya"}]}, {"book": 20, "chapter": 2, "verse": 5, "ayat_id": 16439, "title": "", "ayt_text": "pada waktu itulah kamu akan mengerti tentang takut akan TUHAN, dan menemukan pengetahuan akan Allah.", "words": [{"pos": 1, "word_orig": "אָ֗ז", "strong": "H227", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "waktu"}, {"pos": 2, "word_orig": "תָּ֭בִין", "strong": "H995", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengerti"}, {"pos": 3, "word_orig": "יִרְאַ֣ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "takut"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וְ/דַ֖עַת", "strong": "H1847", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "אֱלֹהִ֣ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 7, "word_orig": "תִּמְצָֽא", "strong": "H4672", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menemukan"}]}, {"book": 20, "chapter": 2, "verse": 6, "ayat_id": 16440, "title": "", "ayt_text": "Sebab, TUHAN mengaruniakan hikmat; pengetahuan dan pengertian datang dari mulut-Nya.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "יִתֵּ֣ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengaruniakan"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 5, "word_orig": "מִ֝/פִּ֗י/ו", "strong": "H6310", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulut-Nya"}, {"pos": 6, "word_orig": "דַּ֣עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 7, "word_orig": "וּ/תְבוּנָֽה", "strong": "H8394", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}]}, {"book": 20, "chapter": 2, "verse": 7, "ayat_id": 16441, "title": "", "ayt_text": "Dia menyimpan hikmat yang benar bagi orang-orang yang tulus. Dia adalah perisai bagi mereka yang berjalan dalam kejujuran,", "words": [{"pos": 1, "word_orig": "ו/צפן", "strong": "H6845", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyimpan"}, {"pos": 2, "word_ori