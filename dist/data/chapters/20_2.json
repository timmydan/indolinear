": "H4616", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "karena"}, {"pos": 2, "word_orig": "תֵּ֭לֵךְ", "strong": "H3212", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "berjalan"}, {"pos": 3, "word_orig": "בְּ/דֶ֣רֶךְ", "strong": "H1870", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 4, "word_orig": "טוֹבִ֑ים", "strong": "H2896", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "וְ/אָרְח֖וֹת", "strong": "H734", "morph": "HC/Ncbpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan-jalan"}, {"pos": 6, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 7, "word_orig": "תִּשְׁמֹֽר", "strong": "H8104", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "memelihara"}]}, {"book": 20, "chapter": 2, "verse": 21, "ayat_id": 16455, "title": "", "ayt_text": "Sebab, orang jujur akan diam di negeri, dan orang yang tidak bercela akan tinggal di dalamnya,", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "יְשָׁרִ֥ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "יִשְׁכְּנוּ", "strong": "H7931", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "diam"}, {"pos": 4, "word_orig": "אָ֑רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}, {"pos": 5, "word_orig": "וּ֝/תְמִימִ֗ים", "strong": "H8549", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יִוָּ֥תְרוּ", "strong": "H3498", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "tinggal"}, {"pos": 7, "word_orig": "בָֽ/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": "dalamnya"}]}, {"book": 20, "chapter": 2, "verse": 22, "ayat_id": 16456, "title": "", "ayt_text": "tetapi orang fasik akan dipangkas dari negeri, dan para pelanggar akan dicabut darinya.", "words": [{"pos": 1, "word_orig": "וּ֭/רְשָׁעִים", "strong": "H7563", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "fasik"}, {"pos": 2, "word_orig": "מֵ/אֶ֣רֶץ", "strong": "H776", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}, {"pos": 3, "word_orig": "יִכָּרֵ֑תוּ", "strong": "H3772", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "dipangkas"}, {"pos": 4, "word_orig": "וּ֝/בוֹגְדִ֗ים", "strong": "H898", "morph": "HC/Vqrmpa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "pelanggar"}, {"pos": 5, "word_orig": "יִסְּח֥וּ", "strong": "H5255", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "dicabut"}, {"pos": 6, "word_orig": "מִמֶּֽ/נָּה", "strong": "H4480", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": "darinya"}]}]