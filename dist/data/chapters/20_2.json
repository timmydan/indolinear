 Orang ke-3 Perempuan Tunggal + Sp2ms", "ayt_word": "menjagamu"}]}, {"book": 20, "chapter": 2, "verse": 12, "ayat_id": 16446, "title": "", "ayt_text": "untuk melepaskanmu dari jalan kejahatan, dari orang-orang yang mengatakan kesesatan,", "words": [{"pos": 1, "word_orig": "לְ֭/הַצִּ֣ילְ/ךָ", "strong": "H5337", "morph": "HR/Vhc/Sp2ms", "morph_id": "Preposisi + Verba Hifil Imperatif + Sp2ms", "ayt_word": "melepaskanmu"}, {"pos": 2, "word_orig": "מִ/דֶּ֣רֶךְ", "strong": "H1870", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 3, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatan"}, {"pos": 4, "word_orig": "מֵ֝/אִ֗ישׁ", "strong": "H376", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "מְדַבֵּ֥ר", "strong": "H1696", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "mengatakan"}, {"pos": 6, "word_orig": "תַּהְפֻּכֽוֹת", "strong": "H8419", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kesesatan"}]}, {"book": 20, "chapter": 2, "verse": 13, "ayat_id": 16447, "title": "", "ayt_text": "yang meninggalkan jalan-jalan kejujuran, dan melangkah di jalan-jalan kegelapan,", "words": [{"pos": 1, "word_orig": "הַ֭/עֹ֣זְבִים", "strong": "H5800", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "meninggalkan"}, {"pos": 2, "word_orig": "אָרְח֣וֹת", "strong": "H734", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan-jalan"}, {"pos": 3, "word_orig": "יֹ֑שֶׁר", "strong": "H3476", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kejujuran"}, {"pos": 4, "word_orig": "לָ֝/לֶ֗כֶת", "strong": "H3212", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melangkah"}, {"pos": 5, "word_orig": "בְּ/דַרְכֵי", "strong": "H1870", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan-jalan"}, {"pos": 6, "word_orig": "חֹֽשֶׁךְ", "strong": "H2822", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}]}, {"book": 20, "chapter": 2, "verse": 14, "ayat_id": 16448, "title": "", "ayt_text": "yang bersukacita dengan melakukan kejahatan, dan senang dengan kesesatan yang jahat,", "words": [{"pos": 1, "word_orig": "הַ֭/שְּׂמֵחִים", "strong": "H8056", "morph": "HTd/Aampa", "morph_id": "Artikel Definit (הַ) + Aampa", "ayt_word": "bersukacita"}, {"pos": 2, "word_orig": "לַ/עֲשׂ֥וֹת", "strong": "H6213", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melakukan"}, {"pos": 3, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatan"}, {"pos": 4, "word_orig": "יָ֝גִ֗ילוּ", "strong": "H1523", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "senang"}, {"pos": 5, "word_orig": "בְּֽ/תַהְפֻּכ֥וֹת", "strong": "H8419", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "kesesatan"}, {"pos": 6, "word_orig": "רָֽע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}]}, {"book": 20, "chapter": 2, "verse": 15, "ayat_id": 16449, "title": "", "ayt_text": "yang langkah-langkahnya bengkok, dan yang jalan-jalannya sesat.", "words": [{"pos": 1, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 2, "word_orig": "אָרְחֹתֵי/הֶ֣ם", "strong": "H734", "morph": "HNcbpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "langkah-langkahnya"}, {"pos": 3, "word_orig": "עִקְּשִׁ֑ים", "strong": "H6141", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bengkok"}, {"pos": 4, "word_orig": "וּ֝/נְלוֹזִ֗ים", "strong": "H3868", "morph": "HC/VNrmpa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "sesat"}, {"pos": 5, "word_orig": "בְּ/מַעְגְּלוֹתָֽ/ם", "strong": "H4570", "morph": "HR/Ncmpc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "jalan-jalannya"}]}, {"book": 20, "chapter": 2, "verse": 16, "ayat_id": 16450, "title": "", "ayt_text": "Kamu akan diselamatkan dari perempuan liar, dari perempuan asing dengan kata-kata rayuannya,", "words": [{"pos": 1, "word_orig": "לְ֭/הַצִּ֣ילְ/ךָ", "strong": "H5337", "morph": "HR/Vhc/Sp2ms", "morph_id": "Preposisi + Verba Hifil Imperatif + Sp2ms", "ayt_word": "diselamatkan"}, {"pos": 2, "word_orig": "מֵ/אִשָּׁ֣ה", "strong": "H802", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perempuan"}, {"pos": 3, "word_orig": "זָרָ֑ה", "strong": "H2114", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "liar"}, {"pos": 4, "word_orig": "מִ֝/נָּכְרִיָּ֗ה", "strong": "H5237", "morph": "HR/Aafsa", "morph_id": "Preposisi + Aafsa", "ayt_word": "asing"}, {"pos": 5, "word_orig": "אֲמָרֶ֥י/הָ", "strong": "H561", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "kata-kata"}, {"pos": 6, "word_orig": "הֶחֱלִֽיקָה", "strong": "H2505", "morph": "HVhp3fs", "morph_id": "Verba Hifil Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "rayuannya"}]}, {"book": 20, "chapter": 2, "verse": 17, "ayat_id": 16451, "title": "", "ayt_text": "yang meninggalkan teman masa mudanya, dan melupakan perjanjian dengan Allahnya.", "words": [{"pos": 1, "word_orig": "הַ֭/עֹזֶבֶת", "strong": "H5800", "morph": "HTd/Vqrfsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "meninggalkan"}, {"pos": 2, "word_orig": "אַלּ֣וּף", "strong": "H441", "m