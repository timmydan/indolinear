onstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekejaman"}, {"pos": 4, "word_orig": "שֹׁתֶ֑ה", "strong": "H8354", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "meminum"}, {"pos": 5, "word_orig": "שֹׁלֵ֖חַ", "strong": "H7971", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengirim"}, {"pos": 6, "word_orig": "דְּבָרִ֣ים", "strong": "H1697", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pesan"}, {"pos": 7, "word_orig": "בְּ/יַד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 8, "word_orig": "כְּסִֽיל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}]}, {"book": 20, "chapter": 26, "verse": 7, "ayat_id": 17149, "title": "", "ayt_text": "Bagaikan kaki yang terkulai pada orang yang lumpuh, seperti itulah amsal pada mulut orang-orang bodoh.", "words": [{"pos": 1, "word_orig": "דַּלְי֣וּ", "strong": "H1809", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "terkulai"}, {"pos": 2, "word_orig": "שֹׁ֭קַיִם", "strong": "H7785", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "kaki"}, {"pos": 3, "word_orig": "מִ/פִּסֵּ֑חַ", "strong": "H6455", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "yang"}, {"pos": 4, "word_orig": "וּ֝/מָשָׁ֗ל", "strong": "H4912", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "amsal"}, {"pos": 5, "word_orig": "בְּ/פִ֣י", "strong": "H6310", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 6, "word_orig": "כְסִילִֽים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bodoh"}]}, {"book": 20, "chapter": 26, "verse": 8, "ayat_id": 17150, "title": "", "ayt_text": "Bagaikan orang mengikat batu pada umban, seperti itulah orang yang memberi hormat kepada orang bodoh.", "words": [{"pos": 1, "word_orig": "כִּ/צְר֣וֹר", "strong": "H6887", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mengikat"}, {"pos": 2, "word_orig": "אֶ֭בֶן", "strong": "H68", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "batu"}, {"pos": 3, "word_orig": "בְּ/מַרְגֵּמָ֑ה", "strong": "H4773", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "umban"}, {"pos": 4, "word_orig": "כֵּן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "itulah"}, {"pos": 5, "word_orig": "נוֹתֵ֖ן", "strong": "H5414", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memberi"}, {"pos": 6, "word_orig": "לִ/כְסִ֣יל", "strong": "H3684", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "כָּבֽוֹד", "strong": "H3519", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "hormat"}]}, {"book": 20, "chapter": 26, "verse": 9, "ayat_id": 17151, "title": "", "ayt_text": "Bagaikan duri yang menusuk tangan pemabuk, seperti itulah amsal pada mulut orang-orang bodoh.", "words": [{"pos": 1, "word_orig": "ח֭וֹחַ", "strong": "H2336", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "duri"}, {"pos": 2, "word_orig": "עָלָ֣ה", "strong": "H5927", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menusuk"}, {"pos": 3, "word_orig": "בְ/יַד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 4, "word_orig": "שִׁכּ֑וֹר", "strong": "H7910", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pemabuk"}, {"pos": 5, "word_orig": "וּ֝/מָשָׁ֗ל", "strong": "H4912", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "amsal"}, {"pos": 6, "word_orig": "בְּ/פִ֣י", "strong": "H6310", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 7, "word_orig": "כְסִילִֽים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}]}, {"book": 20, "chapter": 26, "verse": 10, "ayat_id": 17152, "title": "", "ayt_text": "Bagaikan pemanah yang melukai setiap orang, seperti itulah orang yang mempekerjakan orang bodoh atau yang mempekerjakan orang yang lewat.", "words": [{"pos": 1, "word_orig": "רַ֥ב", "strong": "H7227", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pemanah"}, {"pos": 2, "word_orig": "מְחֽוֹלֵֽל", "strong": "H2342", "morph": "HVmrmsa", "morph_id": "Verba", "ayt_word": "melukai"}, {"pos": 3, "word_orig": "כֹּ֑ל", "strong": "H3605", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "setiap"}, {"pos": 4, "word_orig": "וְ/שֹׂכֵ֥ר", "strong": "H7936", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mempekerjakan"}, {"pos": 5, "word_orig": "כְּ֝סִ֗יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "וְ/שֹׂכֵ֥ר", "strong": "H7936", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mempekerjakan"}, {"pos": 7, "word_orig": "עֹבְרִֽים", "strong": "H5674", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "lewat"}]}, {"book": 20, "chapter": 26, "verse": 11, "ayat_id": 17153, "title": "", "ayt_text": "Bagaikan anjing yang kembali ke muntahannya, seperti itulah orang bodoh yang mengulangi kebodohannya.", "words": [{"pos": 1, "word_orig": "כְּ֭/כֶלֶב", "strong": "H3611", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal A