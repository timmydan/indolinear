/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pujian"}, {"pos": 5, "word_orig": "נָרִ֥יעַֽ", "strong": "H7321", "morph": "HVhh1cp", "morph_id": "Verba Hifil Orang ke-1 Jamak", "ayt_word": "berseru"}, {"pos": 6, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 19, "chapter": 95, "verse": 3, "ayat_id": 15458, "title": "", "ayt_text": "Sebab, TUHAN adalah Allah yang besar, dan Raja yang besar di atas segala ilah.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "אֵ֣ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "גָּד֣וֹל", "strong": "H1419", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "besar"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וּ/מֶ֥לֶךְ", "strong": "H4428", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Raja"}, {"pos": 6, "word_orig": "גָּ֝ד֗וֹל", "strong": "H1419", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "besar"}, {"pos": 7, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 8, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 9, "word_orig": "אֱלֹהִֽים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "ilah"}]}, {"book": 19, "chapter": 95, "verse": 4, "ayat_id": 15459, "title": "", "ayt_text": "Kedalaman bumi ada di dalam tangan-Nya; puncak-puncak gunung adalah milik-Nya juga.", "words": [{"pos": 1, "w