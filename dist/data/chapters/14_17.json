, {"pos": 12, "word_orig": "דָרַ֖שׁ", "strong": "H1875", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 13, "word_orig": "לַ/בְּעָלִֽים", "strong": "H1168", "morph": "HRd/Np", "morph_id": "Rd + Nomina Jamak", "ayt_word": "baal-baal"}]}, {"book": 14, "chapter": 17, "verse": 4, "ayat_id": 11528, "title": "", "ayt_text": "tetapi mencari Allah ayahnya. Dia hidup menurut perintah-perintah-Nya dan tidak bertindak seperti orang Israel.", "words": [{"pos": 1, "word_orig": "כִּ֠י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "tetapi"}, {"pos": 2, "word_orig": "לֵֽ/אלֹהֵ֤י", "strong": "H430", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "אָבִי/ו֙", "strong": "H1", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ayahnya"}, {"pos": 4, "word_orig": "דָּרָ֔שׁ", "strong": "H1875", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 5, "word_orig": "וּ/בְ/מִצְוֺתָ֖י/ו", "strong": "H4687", "morph": "HC/R/Ncfpc/Sp3ms", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "perintah-perintah-Nya"}, {"pos": 6, "word_orig": "הָלָ֑ךְ", "strong": "H1980", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "hidup"}, {"pos": 7, "word_orig": "וְ/לֹ֖א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "כְּ/מַעֲשֵׂ֥ה", "strong": "H4639", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bertindak"}, {"pos": 9, "word_orig": "יִשְׂרָאֵֽל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt