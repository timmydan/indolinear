[{"book": 23, "chapter": 47, "verse": 1, "ayat_id": 18601, "title": "Nubuat tentang Babel", "ayt_text": "Turunlah dan duduklah di dalam debu, hai anak dara, putri Babel. Duduklah di atas tanah tanpa takhta, hai putri orang-orang Kasdim. Sebab, kamu tidak akan lagi disebut lembut dan halus.", "words": [{"pos": 1, "word_orig": "רְדִ֣י", "strong": "H3381", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Turunlah"}, {"pos": 2, "word_orig": "וּ/שְׁבִ֣י", "strong": "H3427", "morph": "HC/Vqv2fs", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "duduklah"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 4, "word_orig": "עָפָ֗ר", "strong": "H6083", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "debu"}, {"pos": 5, "word_orig": "בְּתוּלַת֙", "strong": "H1330", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "anak"}, {"pos": 6, "word_orig": "בַּת", "strong": "H1323", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "putri"}, {"pos": 7, "word_orig": "בָּבֶ֔ל", "strong": "H894", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Babel"}, {"pos": 8, "word_orig": "שְׁבִי", "strong": "H3427", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Duduklah"}, {"pos": 9, "word_orig": "לָ/אָ֥רֶץ", "strong": "H776", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "tanah"}, {"pos": 10, "word_orig": "אֵין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tanpa"}, {"pos": 11, "word_orig": "כִּסֵּ֖א", "strong": "H3678", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ta