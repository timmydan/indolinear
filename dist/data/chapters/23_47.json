lah"}, {"pos": 4, "word_orig": "קָ֑מַח", "strong": "H7058", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tepung"}, {"pos": 5, "word_orig": "גַּלִּ֨י", "strong": "H1540", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Bukalah"}, {"pos": 6, "word_orig": "צַמָּתֵ֧/ךְ", "strong": "H6777", "morph": "HNcfsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "kerudungmu"}, {"pos": 7, "word_orig": "חֶשְׂפִּי", "strong": "H2834", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "angkatlah"}, {"pos": 8, "word_orig": "שֹׁ֛בֶל", "strong": "H7640", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rokmu"}, {"pos": 9, "word_orig": "גַּלִּי", "strong": "H1540", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Telanjangilah"}, {"pos": 10, "word_orig": "שׁ֖וֹק", "strong": "H7785", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kakimu"}, {"pos": 11, "word_orig": "עִבְרִ֥י", "strong": "H5674", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "seberangilah"}, {"pos": 12, "word_orig": "נְהָרֽוֹת", "strong": "H5104", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sungai-sungai"}]}, {"book": 23, "chapter": 47, "verse": 3, "ayat_id": 18603, "title": "", "ayt_text": "Ketelanjanganmu akan terbuka dan rasa malumu akan terlihat. Aku akan mengadakan pembalasan, dan Aku tidak akan menyayangkan seorang pun.", "words": [{"pos": 1, "word_orig": "תִּגָּל֙", "strong": "H1540", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "terbuka"}, {"pos": 2, "word_orig": "עֶרְוָתֵ֔/ךְ", "strong": "H6172", "morph": "HNcfsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "Ketelanjanganmu"}, {"pos": 3, "word_orig": "גַּ֥ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "dan"}, {"pos": 4, "word_orig": "תֵּרָאֶ֖ה", "strong": "H7200", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "terlihat"}, {"pos": 5, "word_orig": "חֶרְפָּתֵ֑/ךְ", "strong": "H2781", "morph": "HNcfsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "malumu"}, {"pos": 6, "word_orig": "נָקָ֣ם", "strong": "H5359", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pembalasan"}, {"pos": 7, "word_orig": "אֶקָּ֔ח", "strong": "H3947", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mengadakan"}, {"pos": 8, "word_orig": "וְ/לֹ֥א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "אֶפְגַּ֖ע", "strong": "H6293", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menyayangkan"}, {"pos": 10, "word_orig": "אָדָֽם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seorang"}]}, {"book": 23, "chapter": 47, "verse": 4, "ayat_id": 18604, "title": "", "ayt_text": "Penebus kami, TUHAN semesta alam adalah nama-Nya, Yang Kudus dari Israel.", "words": [{"pos": 1, "word_orig": "גֹּאֲלֵ֕/נוּ", "strong": "H1350", "morph": "HVqrmsc/Sp1cp", "morph_id": "Verba Qal + Sp1cp", "ayt_word": "Penebus"}, {"pos": 2, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "צְבָא֖וֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "semesta"}, {"pos": 4, "wo