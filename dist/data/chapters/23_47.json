mu dari hal-hal yang akan datang ke atasmu itu.", "words": [{"pos": 1, "word_orig": "נִלְאֵ֖ית", "strong": "H3811", "morph": "HVNp2fs", "morph_id": "Verba Nifal Perfek Orang ke-2 Perempuan Tunggal", "ayt_word": "dilelahkan"}, {"pos": 2, "word_orig": "בְּ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "banyaknya"}, {"pos": 3, "word_orig": "עֲצָתָ֑יִ/ךְ", "strong": "H6098", "morph": "HNcfpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "nasihat"}, {"pos": 4, "word_orig": "יַעַמְדוּ", "strong": "H5975", "morph": "HVqj3mp", "morph_id": "Verba Qal Orang ke-3 Laki-laki Jamak", "ayt_word": "tampil"}, {"pos": 5, "word_orig": "נָ֨א", "strong": "H4994", "morph": "HTe", "morph_id": "Te", "ayt_word": "Sekarang"}, {"pos": 6, "word_orig": "וְ/יוֹשִׁיעֻ֜/ךְ", "strong": "H3467", "morph": "HC/Vhj3mp/Sp2fs", "morph_id": "Konjungsi (וְ) + Verba Hifil Orang ke-3 Laki-laki Jamak + Sp2fs", "ayt_word": "menyelamatkanmu"}, {"pos": 7, "word_orig": "הברו", "strong": "H1895", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "ahli"}, {"pos": 8, "word_orig": "הֹבְרֵ֣י", "strong": "H1895", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "ahli"}, {"pos": 9, "word_orig": "שָׁמַ֗יִם", "strong": "H8064", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pelihat"}, {"pos": 10, "word_orig": "הַֽ/חֹזִים֙", "strong": "H2374", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "bintang"}, {"pos": 11, "word_orig": "בַּ/כּ֣וֹכָבִ֔ים", "strong": "H3556", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "peramal"}, {"pos": 12, "word_orig": "מֽוֹדִיעִם֙", "strong": "H3045", "morph": "HVhrmpa", "morph_id": "Verba Hifil", "ayt_word": "baru"}, {"pos": 13, "word_orig": "לֶ/חֳדָשִׁ֔י