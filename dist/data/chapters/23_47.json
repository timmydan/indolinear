pos": 10, "word_orig": "יִקְרְאוּ", "strong": "H7121", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "disebut"}, {"pos": 11, "word_orig": "לָ֔/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}, {"pos": 12, "word_orig": "גְּבֶ֖רֶת", "strong": "H1404", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "ratu"}, {"pos": 13, "word_orig": "מַמְלָכֽוֹת", "strong": "H4467", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kerajaan-kerajaan"}]}, {"book": 23, "chapter": 47, "verse": 6, "ayat_id": 18606, "title": "", "ayt_text": "Aku murka terhadap umat-Ku. Aku menajiskan milik pusaka-Ku dan menyerahkan mereka ke dalam tanganmu. Kamu tidak menunjukkan belas kasihan kepada mereka, Bahkan, kamu meletakkan kuk yang sangat berat ke atas mereka yang tua.", "words": [{"pos": 1, "word_orig": "קָצַ֣פְתִּי", "strong": "H7107", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "murka"}, {"pos": 2, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "terhadap"}, {"pos": 3, "word_orig": "עַמִּ֗/י", "strong": "H5971", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "umat-Ku"}, {"pos": 4, "word_orig": "חִלַּ֨לְתִּי֙", "strong": "H2490", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "menajiskan"}, {"pos": 5, "word_orig": "נַחֲלָתִ֔/י", "strong": "H5159", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "milik"}, {"pos": 6, "word_orig": "וָ/אֶתְּנֵ֖/ם", "strong": "H5414", "morph": "HC/Vqw1cs/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menyerahkan"}, {"pos": 7, "word_orig": "בְּ/יָ