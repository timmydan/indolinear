[{"book": 20, "chapter": 16, "verse": 1, "ayat_id": 16842, "title": "", "ayt_text": "Manusia berencana dalam hati, tetapi jawaban lidah berasal dari TUHAN.", "words": [{"pos": 1, "word_orig": "לְ/אָדָ֥ם", "strong": "H120", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Manusia"}, {"pos": 2, "word_orig": "מַֽעַרְכֵי", "strong": "H4633", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "berencana"}, {"pos": 3, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 4, "word_orig": "וּ֝/מֵ/יְהוָ֗ה", "strong": "H3068", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "מַעֲנֵ֥ה", "strong": "H4617", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "jawaban"}, {"pos": 6, "word_orig": "לָשֽׁוֹן", "strong": "H3956", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "lidah"}]}, {"book": 20, "chapter": 16, "verse": 2, "ayat_id": 16843, "title": "", "ayt_text": "Segala jalan seseorang itu bersih dalam pandangannya sendiri, tetapi TUHAN menimbang roh.", "words": [{"pos": 1, "word_orig": "כָּֽל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Segala"}, {"pos": 2, "word_orig": "דַּרְכֵי", "strong": "H1870", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 3, "word_orig": "אִ֭ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 4, "word_orig": "זַ֣ךְ", "strong": "H2134", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bersih"}, {"p