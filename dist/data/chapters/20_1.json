ph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "bersalah"}, {"pos": 9, "word_orig": "חִנָּֽם", "strong": "H2600", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "alasan"}]}, {"book": 20, "chapter": 1, "verse": 12, "ayat_id": 16413, "title": "", "ayt_text": "Mari kita menelan mereka hidup-hidup seperti dunia orang mati, dan dengan seutuhnya, seperti mereka yang turun ke liang kubur.", "words": [{"pos": 1, "word_orig": "נִ֭בְלָעֵ/ם", "strong": "H1104", "morph": "HVqh1cp/Sp3mp", "morph_id": "Verba Qal Orang ke-1 Jamak + Sp3mp", "ayt_word": "menelan"}, {"pos": 2, "word_orig": "כִּ/שְׁא֣וֹל", "strong": "H7585", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "mati"}, {"pos": 3, "word_orig": "חַיִּ֑ים", "strong": "H2416", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "hidup-hidup"}, {"pos": 4, "word_orig": "וּ֝/תְמִימִ֗ים", "strong": "H8549", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "seutuhnya"}, {"pos": 5, "word_orig": "כְּ/י֣וֹרְדֵי", "strong": "H3381", "morph": "HR/Vqrmpc", "morph_id": "Preposisi + Verba Qal", "ayt_word": "turun"}, {"pos": 6, "word_orig": "בֽוֹר", "strong": "H953", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "liang"}]}, {"book": 20, "chapter": 1, "verse": 13, "ayat_id": 16414, "title": "", "ayt_text": "Kita akan mendapatkan segala harta benda berharga; kita akan memenuhi rumah kita dengan barang-barang rampasan.", "words": [{"pos": 1, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 2, "word_orig": "ה֣וֹן", "strong": "H1952", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "harta"}, {"pos": 3, "word_orig": "יָקָ֣ר", "strong": "H3368", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berharga"}, {"pos": 4, "word_orig": "נִמְצָ֑א", "strong": "H4672", "morp