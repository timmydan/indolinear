d": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "memilih"}]}, {"book": 20, "chapter": 1, "verse": 30, "ayat_id": 16431, "title": "", "ayt_text": "tidak menginginkan nasihatku, dan menghina semua teguranku.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "אָב֥וּ", "strong": "H14", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menginginkan"}, {"pos": 3, "word_orig": "לַ/עֲצָתִ֑/י", "strong": "H6098", "morph": "HR/Ncfsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "nasihatku"}, {"pos": 4, "word_orig": "נָ֝אֲצ֗וּ", "strong": "H5006", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menghina"}, {"pos": 5, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "תּוֹכַחְתִּֽ/י", "strong": "H8433", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "teguranku"}]}, {"book": 20, "chapter": 1, "verse": 31, "ayat_id": 16432, "title": "", "ayt_text": "Oleh sebab itu, mereka akan memakan buah dari jalan mereka, dan dikenyangkan oleh rencana-rencana mereka sendiri.", "words": [{"pos": 1, "word_orig": "וְֽ֭/יֹאכְלוּ", "strong": "H398", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memakan"}, {"pos": 2, "word_orig": "מִ/פְּרִ֣י", "strong": "H6529", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "buah"}, {"pos": 3, "word_orig": "דַרְכָּ֑/ם", "strong": "H1870", "morph": "HNcbsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "jalan"}, {"pos": 4, "word_orig": "וּֽ/מִ/מֹּעֲצֹ֖תֵי/הֶ֣ם", "strong": "H4156", "morph": "HC/R/Ncfpc/Sp3mp", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "rencana-rencana"}, {"pos": 5, "word_orig": "יִשְׂבָּֽעוּ", "strong": "H7646", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "dikenyangkan"}]}, {"book": 20, "chapter": 1, "verse": 32, "ayat_id": 16433, "title": "", "ayt_text": "Sebab, orang-orang naif dibunuh oleh kesesatan mereka, dan kemakmuran orang-orang bodoh akan membinasakan mereka.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "מְשׁוּבַ֣ת", "strong": "H4878", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kesesatan"}, {"pos": 3, "word_orig": "פְּתָיִ֣ם", "strong": "H6612", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "naif"}, {"pos": 4, "word_orig": "תַּֽהַרְגֵ֑/ם", "strong": "H2026", "morph": "HVqi3fs/Sp3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "dibunuh"}, {"pos": 5, "word_orig": "וְ/שַׁלְוַ֖ת", "strong": "H7962", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kemakmuran"}, {"pos": 6, "word_orig": "כְּסִילִ֣ים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "תְּאַבְּדֵֽ/ם", "strong": "H6", "morph": "HVpi3fs/Sp3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "membinasakan"}]}, {"book": 20, "chapter": 1, "verse": 33, "ayat_id": 16434, "title": "", "ayt_text": "Akan tetapi, mereka yang mendengarkan aku akan diam dengan aman dan tenteram tanpa takut terhadap malapetaka.”", "words": [{"pos": 1, "word_orig": "וְ/שֹׁמֵ֣עַֽ", "strong": "H8085", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mendengarkan"}, {"pos": 2, "word_orig": "לִ֭/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "יִשְׁכָּן", "strong": "H7931", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diam"}, {"pos": 4, "word_orig": "בֶּ֑טַח", "strong": "H983", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "aman"}, {"pos": 5, "word_orig": "וְ֝/שַׁאֲנַ֗ן", "strong": "H7599", "morph": "HC/Vkq3ms", "morph_id": "Konjungsi (וְ) + Verba Orang ke-3 Laki-laki Tunggal", "ayt_word": "tenteram"}, {"pos": 6, "word_orig": "מִ/פַּ֥חַד", "strong": "H6343", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "takut"}, {"pos": 7, "word_orig": "רָעָֽה", "strong": "H7451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "malapetaka"}]}]