orph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kepandaian"}, {"pos": 4, "word_orig": "לְ֝/נַ֗עַר", "strong": "H5288", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "muda"}, {"pos": 5, "word_orig": "דַּ֣עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "וּ/מְזִמָּֽה", "strong": "H4209", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "petunjuk"}]}, {"book": 20, "chapter": 1, "verse": 5, "ayat_id": 16406, "title": "", "ayt_text": "Biarlah yang berhikmat mendengar dan menambah pengajaran, dan yang berpengertian memperoleh bimbingan,", "words": [{"pos": 1, "word_orig": "יִשְׁמַ֣ע", "strong": "H8085", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendengar"}, {"pos": 2, "word_orig": "חָ֭כָם", "strong": "H2450", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berhikmat"}, {"pos": 3, "word_orig": "וְ/י֣וֹסֶף", "strong": "H3254", "morph": "HC/Vhi3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menambah"}, {"pos": 4, "word_orig": "לֶ֑קַח", "strong": "H3948", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengajaran"}, {"pos": 5, "word_orig": "וְ֝/נָב֗וֹן", "strong": "H995", "morph": "HC/VNrmsa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "berpengertian"}, {"pos": 6, "word_orig": "תַּחְבֻּל֥וֹת", "strong": "H8458", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "bimbingan"}, {"pos": 7, "word_orig": "יִקְנֶֽה", "strong": "H7069", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memperoleh"}]}, {"book": 20, "chapter": 1, "verse": 6, "ayat_id": 16407, "title": "", "ayt_text": "untuk memahami amsal dan perumpamaan, kata-kata orang berhikmat dan teka-teki mereka.", "words": [{"pos": 1, "word_orig": "לְ/הָבִ֣ין", "strong": "H995", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "memahami"}, {"pos": 2, "word_orig": "מָ֭שָׁל", "strong": "H4912", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "amsal"}, {"pos": 3, "word_orig": "וּ/מְלִיצָ֑ה", "strong": "H4426", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perumpamaan"}, {"pos": 4, "word_orig": "דִּבְרֵ֥י", "strong": "H1697", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "kata-kata"}, {"pos": 5, "word_orig": "חֲ֝כָמִ֗ים", "strong": "H2450", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "וְ/חִידֹתָֽ/ם", "strong": "H2420", "morph": "HC/Ncfpc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "teka-teki"}]}, {"book": 20, "chapter": 1, "verse": 7, "ayat_id": 16408, "title": "", "ayt_text": "Takut akan TUHAN adalah permulaan pengetahuan; orang-orang bodoh menghina hikmat dan didikan.", "words": [{"pos": 1, "word_orig": "יִרְאַ֣ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "רֵאשִׁ֣ית", "strong": "H7225", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "permulaan"}, {"pos": 4, "word_orig": "דָּ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tu