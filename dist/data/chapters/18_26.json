": 26, "verse": 14, "ayat_id": 13482, "title": "", "ayt_text": "Lihatlah, semua itu hanyalah tepi-tepi jalan-Nya. Betapa lirihnya bisikan yang kita dengar dari-Nya! Akan tetapi, siapa yang dapat mengerti gemuruh kuasa-Nya?”", "words": [{"pos": 1, "word_orig": "הֶן", "strong": "H2005", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "אֵ֤לֶּה", "strong": "H428", "morph": "HPdxcp", "morph_id": "Pdxcp", "ayt_word": "itu"}, {"pos": 3, "word_orig": "קְצ֬וֹת", "strong": "H7098", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "tepi-tepi"}, {"pos": 4, "word_orig": "דרכ/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalan-Nya"}, {"pos": 5, "word_orig": "דְּרָכָ֗י/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "Betapa"}, {"pos": 6, "word_orig": "וּ/מַה", "strong": "H4100", "morph": "HC/Ti", "morph_id": "Konjungsi (וְ) + Ti", "ayt_word": "lirihnya"}, {"pos": 7, "word_orig": "שֵּׁ֣מֶץ", "strong": "H8102", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bisikan"}, {"pos": 8, "word_orig": "דָּ֭בָר", "strong": "H1697", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dengar"}, {"pos": 9, "word_orig": "נִשְׁמַע", "strong": "H8085", "morph": "HVqi1cp", "morph_id": "Verba Qal Imperfek Orang ke-1 Jamak", "ayt_word": ""}, {"pos": 10, "word_orig": "בּ֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "gemuruh"}, {"pos": 11, "word_orig": "וְ/רַ֥עַם", "strong": "H7482", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kuasa-Nya"}, {"pos": 12, "word_orig": "גבורת/ו", "strong":