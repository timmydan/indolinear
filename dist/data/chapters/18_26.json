": 2, "word_orig": "שְׁא֣וֹל", "strong": "H7585", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Dunia"}, {"pos": 3, "word_orig": "נֶגְדּ֑/וֹ", "strong": "H5048", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "hadapan"}, {"pos": 4, "word_orig": "וְ/אֵ֥ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "כְּ֝ס֗וּת", "strong": "H3682", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "memiliki"}, {"pos": 6, "word_orig": "לָֽ/אֲבַדּֽוֹן", "strong": "H11", "morph": "HRd/Np", "morph_id": "Rd + Nomina Jamak", "ayt_word": "tempat"}]}, {"book": 18, "chapter": 26, "verse": 7, "ayat_id": 13475, "title": "", "ayt_text": "Dia membentangkan utara di atas kekosongan; Dia menggantungkan bumi pada kehampaan.", "words": [{"pos": 1, "word_orig": "נֹטֶ֣ה", "strong": "H5186", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membentangkan"}, {"pos": 2, "word_orig": "צָפ֣וֹן", "strong": "H6828", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "utara"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 4, "word_orig": "תֹּ֑הוּ", "strong": "H8414", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekosongan"}, {"pos": 5, "word_orig": "תֹּ֥לֶה", "strong": "H8518", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menggantungkan"}, {"pos": 6, "word_orig": "אֶ֝֗רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 7, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "pada"}, {"pos": 8, "word_orig": "בְּלִי", "strong": "H1099", "morph": "HTn", "morph_id": "Tn", "ayt_word": "kehampaan"}, {"pos": 9, "word_orig": "מָֽה", "strong": "H1099", "m