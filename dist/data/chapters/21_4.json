: "melahap"}, {"pos": 6, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "בְּשָׂרֽ/וֹ", "strong": "H1320", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "dagingnya"}]}, {"book": 21, "chapter": 4, "verse": 6, "ayat_id": 17388, "title": "", "ayt_text": "Segenggam penuh ketenangan lebih baik daripada dua genggam penuh kerja keras dan usaha mengejar angin.", "words": [{"pos": 1, "word_orig": "ט֕וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 2, "word_orig": "מְלֹ֥א", "strong": "H4393", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "penuh"}, {"pos": 3, "word_orig": "כַ֖ף", "strong": "H3709", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Segenggam"}, {"pos": 4, "word_orig": "נָ֑חַת", "strong": "H5183", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "ketenangan"}, {"pos": 5, "word_orig": "מִ/מְּלֹ֥א", "strong": "H4393", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "penuh"}, {"pos": 6, "word_orig": "חָפְנַ֛יִם", "strong": "H2651", "morph": "HNcmda", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Absolut", "ayt_word": "dua"}, {"pos": 7, "word_orig": "עָמָ֖ל", "strong": "H5999", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kerja"}, {"pos": 8, "word_orig": "וּ/רְע֥וּת", "strong": "H7469", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "mengejar"}, {"pos": 9, "word_orig": "רֽוּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal A