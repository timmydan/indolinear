[{"book": 21, "chapter": 4, "verse": 1, "ayat_id": 17383, "title": "Apakah Lebih Baik Mati?", "ayt_text": "Aku kembali melihat semua penindasan yang dilakukan di bawah matahari. Lihatlah, air mata orang-orang tertindas, dan tidak ada yang menghibur mereka. Ada kekuasaan pada pihak para penindas mereka, tetapi tidak ada yang menghibur mereka.", "words": [{"pos": 1, "word_orig": "וְ/שַׁ֣בְתִּֽי", "strong": "H7725", "morph": "HC/Vqp1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "kembali"}, {"pos": 2, "word_orig": "אֲנִ֗י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 3, "word_orig": "וָ/אֶרְאֶה֙", "strong": "H7200", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "melihat"}, {"pos": 4, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 5, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "הָ֣/עֲשֻׁקִ֔ים", "strong": "H6217", "morph": "HTd/Vqsmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal Partisip Pasif", "ayt_word": "penindasan"}, {"pos": 7, "word_orig": "אֲשֶׁ֥ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 8, "word_orig": "נַעֲשִׂ֖ים", "strong": "H6213", "morph": "HVNsmpa", "morph_id": "Verba Nifal Partisip Pasif", "ayt_word": "dilakukan"}, {"pos": 9, "word_orig": "תַּ֣חַת", "strong": "H8478", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "bawah"}, {"pos": 10, "word_orig": "הַ/שָּׁ֑מֶשׁ", "strong": "H8121", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "matahari"}, {"pos": 11, "word_orig": "וְ/הִנֵּ֣ה", "strong": "H2009", "morph": "HC/Tm", "morph_id": "Konjungsi (וְ) + Tm", "ayt_word": "Lihatlah"}, {"pos