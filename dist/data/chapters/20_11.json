[{"book": 20, "chapter": 11, "verse": 1, "ayat_id": 16690, "title": "", "ayt_text": "Timbangan yang menipu adalah kekejian bagi TUHAN, tetapi batu timbangan yang tepat adalah kesukaan-Nya.", "words": [{"pos": 1, "word_orig": "מֹאזְנֵ֣י", "strong": "H3976", "morph": "HNcmdc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Timbangan"}, {"pos": 2, "word_orig": "מִ֭רְמָה", "strong": "H4820", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "menipu"}, {"pos": 3, "word_orig": "תּוֹעֲבַ֣ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וְ/אֶ֖בֶן", "strong": "H68", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "batu"}, {"pos": 6, "word_orig": "שְׁלֵמָ֣ה", "strong": "H8003", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "tepat"}, {"pos": 7, "word_orig": "רְצוֹנֽ/וֹ", "strong": "H7522", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kesukaan-Nya"}]}, {"book": 20, "chapter": 11, "verse": 2, "ayat_id": 16691, "title": "", "ayt_text": "Ketika keangkuhan datang, datanglah aib, tetapi hikmat ada pada orang yang rendah hati.", "words": [{"pos": 1, "word_orig": "בָּֽא", "strong": "H935", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "datang"}, {"pos": 2, "word_orig": "זָ֭דוֹן", "strong": "H2087", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keangkuhan"}, {"pos": 3, "word_orig": "וַ/יָּבֹ֣א", "strong": "H935", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "datanglah"}, {"pos": 4, "word_orig": "קָל֑וֹן", "strong": "H7036", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "aib"}, {"pos": 5, "word_orig": "וְֽ/אֶת", "strong": "H854", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "ada"}, {"pos": 6, "word_orig": "צְנוּעִ֥ים", "strong": "H6800", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "rendah"}, {"pos": 7, "word_orig": "חָכְמָֽה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}]}, {"book": 20, "chapter": 11, "verse": 3, "ayat_id": 16692, "title": "", "ayt_text": "Kejujuran orang benar akan menuntun mereka, tetapi kecurangan pengkhianat menghancurkan mereka.", "words": [{"pos": 1, "word_orig": "תֻּמַּ֣ת", "strong": "H8538", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Kejujuran"}, {"pos": 2, "word_orig": "יְשָׁרִ֣ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "תַּנְחֵ֑/ם", "strong": "H5148", "morph": "HVhi3fs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "menuntun"}, {"pos": 4, "word_orig": "וְ/סֶ֖לֶף", "strong": "H5558", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kecurangan"}, {"pos": 5, "word_orig": "בּוֹגְדִ֣ים", "strong": "H898", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "pengkhianat"}, {"pos": 6, "word_orig": "ו/שד/ם", "strong": "H7703", "morph": "HC/Ncmsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "menghancurkan"}, {"pos": 7, "word_orig": "יְשָׁדֵּֽ/ם", "strong": "H7703", "morph": "HVqi3ms/Sp3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": ""}]}, {"book": 20, "chapter": 11, "verse": 4, "ayat_id": 16693, "title": "", "ayt_text": "Harta tidak menguntungkan pada hari kemurkaan, tetapi kebenaran melepaskan dari maut.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יוֹעִ֣יל", "strong": "H3276", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menguntungkan"}, {"pos": 3, "word_orig": "ה֭וֹן", "strong": "H1952", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Harta"}, {"pos": 4, "word_orig": "בְּ/י֣וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hari"}, {"pos": 5, "word_orig": "עֶבְרָ֑ה", "strong": "H5678", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemurkaan"}, {"pos": 6, "word_orig": "וּ֝/צְדָקָ֗ה", "strong": "H6666", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 7, "word_orig": "תַּצִּ֥יל", "strong": "H5337", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "melepaskan"}, {"pos": 8, "word_orig": "מִ/מָּֽוֶת", "strong": "H4194", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}]}, {"book": 20, "chapter": 11, "verse": 5, "ayat_id": 16694, "title": "", "ayt_text": "Kebenaran orang yang tidak bercela menjaga jalannya tetap lurus, tetapi orang fasik jatuh oleh karena kefasikannya.", "words": [{"pos": 1, "word_orig": "צִדְקַ֣ת", "strong": "H6666", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Kebenaran"}, {"pos": 2, "word_orig": "תָּ֭מִים", "strong": "H8549", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bercela"}, {"pos": 3, "word_orig": "תְּיַשֵּׁ֣ר", "strong": "H3474", "morph": "HVpi3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "tetap"}, {"pos": 4, "word_orig": "דַּרְכּ֑/וֹ", "strong": "H1870", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "jalannya"}, {"pos": 5, "word_orig": "וּ֝/בְ/רִשְׁעָת֗/וֹ", "strong": "H7564", "morph": "HC/R/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "יִפֹּ֥ל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}, {"pos": 7, "word_orig": "רָשָֽׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kefasikannya"}]}, {"book": 20, "chapter": 11, "verse": 6, "ayat_id": 16695, "title": "", "ayt_text": "Kebenaran orang yang lurus hati menyelamatkan mereka, tetapi para pengkhianat ditawan oleh hawa nafsunya.", "words": [{"pos": 1, "word_orig": "צִדְקַ֣ת", "strong": "H6666", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Kebenaran"}, {"pos": 2, "word_orig": "יְ֭שָׁרִים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "yang"}, {"pos": 3, "word_orig": "תַּצִּילֵ֑/ם", "strong": "H5337", "morph": "HVhi3fs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "menyelamatkan"}, {"pos": 4, "word_orig": "וּ֝/בְ/הַוַּ֗ת", "strong": "H1942", "morph": "HC/R/Ncfsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "nafsunya"}, {"pos": 5, "word_orig": "בֹּגְדִ֥ים", "strong": "H898", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "pengkhianat"}, {"pos": 6, "word_orig": "יִלָּכֵֽדוּ", "strong": "H3920", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "ditawan"}]}, {"book": 20, "chapter": 11, "verse": 7, "ayat_id": 16696, "title": "", "ayt_text": "Ketika orang fasik mati, pengharapannya akan lenyap, dan harapan orang jahat akan lenyap.", "words": [{"pos": 1, "word_orig": "בְּ/מ֤וֹת", "strong": "H4194", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mati"}, {"pos": 2, "word_orig": "אָדָ֣ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 3, "word_orig": "רָ֭שָׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "fasik"}, {"pos": 4, "word_orig": "תֹּאבַ֣ד", "strong": "H6", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "lenyap"}, {"pos": 5, "word_orig": "תִּקְוָ֑ה", "strong": "H8615", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengharapannya"}, {"pos": 6, "word_orig": "וְ/תוֹחֶ֖לֶת", "strong": "H8431", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "harapan"}, {"pos": 7, "word_orig": "אוֹנִ֣ים", "strong": "H205", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "jahat"}, {"pos": 8, "word_orig": "אָבָֽדָה", "strong": "H6", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "lenyap"}]}, {"book": 20, "chapter": 11, "verse": 8, "ayat_id": 16697, "title": "", "ayt_text": "Orang benar diselamatkan dari kesusahan, tetapi orang fasik masuk ke dalamnya sebagai gantinya.", "words": [{"pos": 1, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 2, "word_orig": "מִ/צָּרָ֣ה", "strong": "H6869", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesusahan"}, {"pos": 3, "word_orig": "נֶחֱלָ֑ץ", "strong": "H2502", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "diselamatkan"}, {"pos": 4, "word_orig": "וַ/יָּבֹ֖א", "strong": "H935", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "masuk"}, {"pos": 5, "word_orig": "רָשָׁ֣ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "תַּחְתָּֽי/ו", "strong": "H8478", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "sebagai"}]}, {"book": 20, "chapter": 11, "verse": 9, "ayat_id": 16698, "title": "", "ayt_text": "Dengan mulut mereka, orang-orang munafik menghancurkan sesamanya, tetapi oleh pengetahuan, orang benar diselamatkan.", "words": [{"pos": 1, "word_orig": "בְּ/פֶ֗ה", "strong": "H6310", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mulut"}, {"pos": 2, "word_orig": "חָ֭נֵף", "strong": "H2611", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang-orang"}, {"pos": 3, "word_orig": "יַשְׁחִ֣ת", "strong": "H7843", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghancurkan"}, {"pos": 4, "word_orig": "רֵעֵ֑/הוּ", "strong": "H7453", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}, {"pos": 5, "word_orig": "וּ֝/בְ/דַ֗עַת", "strong": "H1847", "morph": "HC/R/Ncfsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "צַדִּיקִ֥ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 7, "word_orig": "יֵחָלֵֽצוּ", "strong": "H2502", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "diselamatkan"}]}, {"book": 20, "chapter": 11, "verse": 10, "ayat_id": 16699, "title": "", "ayt_text": "Ketika kemujuran ada bersama orang benar, kota bersukaria, dan ketika orang fasik binasa, ada sorak-sorai.", "words": [{"pos": 1, "word_orig": "בְּ/ט֣וּב", "strong": "H2898", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kemujuran"}, {"pos": 2, "word_orig": "צַ֭דִּיקִים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "תַּעֲלֹ֣ץ", "strong": "H5970", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "bersukaria"}, {"pos": 4, "word_orig": "קִרְיָ֑ה", "strong": "H7151", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}, {"pos": 5, "word_orig": "וּ/בַ/אֲבֹ֖ד", "strong": "H6", "morph": "HC/R/Vqc", "morph_id": "Konjungsi (וְ) + Preposisi + Verba Qal Imperatif", "ayt_word": "binasa"}, {"pos": 6, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "רִנָּֽה", "strong": "H7440", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sorak-sorai"}]}, {"book": 20, "chapter": 11, "verse": 11, "ayat_id": 16700, "title": "", "ayt_text": "Oleh berkat orang jujur, kota ditinggikan, tetapi mulut orang fasik meruntuhkannya.", "words": [{"pos": 1, "word_orig": "בְּ/בִרְכַּ֣ת", "strong": "H1293", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "berkat"}, {"pos": 2, "word_orig": "יְ֭שָׁרִים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "תָּר֣וּם", "strong": "H7311", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "ditinggikan"}, {"pos": 4, "word_orig": "קָ֑רֶת", "strong": "H7176", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}, {"pos": 5, "word_orig": "וּ/בְ/פִ֥י", "strong": "H6310", "morph": "HC/R/Ncmsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 6, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "תֵּהָרֵֽס", "strong": "H2040", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "meruntuhkannya"}]}, {"book": 20, "chapter": 11, "verse": 12, "ayat_id": 16701, "title": "", "ayt_text": "Dia yang menghina sesamanya kekurangan akal budi, tetapi orang berpengertian tetap diam.", "words": [{"pos": 1, "word_orig": "בָּז", "strong": "H936", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghina"}, {"pos": 2, "word_orig": "לְ/רֵעֵ֥/הוּ", "strong": "H7453", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}, {"pos": 3, "word_orig": "חֲסַר", "strong": "H2638", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "kekurangan"}, {"pos": 4, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "budi"}, {"pos": 5, "word_orig": "וְ/אִ֖ישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 6, "word_orig": "תְּבוּנ֣וֹת", "strong": "H8394", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "berpengertian"}, {"pos": 7, "word_orig": "יַחֲרִֽישׁ", "strong": "H2790", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diam"}]}, {"book": 20, "chapter": 11, "verse": 13, "ayat_id": 16702, "title": "", "ayt_text": "Orang yang menyebar fitnah membuka rahasia, tetapi orang yang setia hatinya menutupi perkara.", "words": [{"pos": 1, "word_orig": "הוֹלֵ֣ךְ", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyebar"}, {"pos": 2, "word_orig": "רָ֭כִיל", "strong": "H7400", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "fitnah"}, {"pos": 3, "word_orig": "מְגַלֶּה", "strong": "H1540", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "membuka"}, {"pos": 4, "word_orig": "סּ֑וֹד", "strong": "H5475", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rahasia"}, {"pos": 5, "word_orig": "וְ/נֶאֱמַן", "strong": "H539", "morph": "HC/VNrmsc", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "setia"}, {"pos": 6, "word_orig": "ר֝֗וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "hatinya"}, {"pos": 7, "word_orig": "מְכַסֶּ֥ה", "strong": "H3680", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menutupi"}, {"pos": 8, "word_orig": "דָבָֽר", "strong": "H1697", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkara"}]}, {"book": 20, "chapter": 11, "verse": 14, "ayat_id": 16703, "title": "", "ayt_text": "Jika tidak ada pimpinan, sebuah bangsa jatuh, tetapi jika ada banyak penasihat, keselamatan ada di sana.", "words": [{"pos": 1, "word_orig": "בְּ/אֵ֣ין", "strong": "H369", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "תַּ֭חְבֻּלוֹת", "strong": "H8458", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "pimpinan"}, {"pos": 3, "word_orig": "יִפָּל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}, {"pos": 4, "word_orig": "עָ֑ם", "strong": "H5971", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bangsa"}, {"pos": 5, "word_orig": "וּ֝/תְשׁוּעָ֗ה", "strong": "H8668", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatan"}, {"pos": 6, "word_orig": "בְּ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "banyak"}, {"pos": 7, "word_orig": "יוֹעֵֽץ", "strong": "H3289", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "penasihat"}]}, {"book": 20, "chapter": 11, "verse": 15, "ayat_id": 16704, "title": "", "ayt_text": "Dia yang menjadi penjamin bagi orang asing benar-benar malang, tetapi dia yang membenci penjaminan akan aman.", "words": [{"pos": 1, "word_orig": "רַע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar-benar"}, {"pos": 2, "word_orig": "יֵ֭רוֹעַ", "strong": "H7489", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "malang"}, {"pos": 3, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 4, "word_orig": "עָ֣רַב", "strong": "H6148", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "penjamin"}, {"pos": 5, "word_orig": "זָ֑ר", "strong": "H2114", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "וְ/שֹׂנֵ֖א", "strong": "H8130", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "membenci"}, {"pos": 7, "word_orig": "תֹקְעִ֣ים", "strong": "H8628", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "penjaminan"}, {"pos": 8, "word_orig": "בּוֹטֵֽחַ", "strong": "H982", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "aman"}]}, {"book": 20, "chapter": 11, "verse": 16, "ayat_id": 16705, "title": "", "ayt_text": "Perempuan yang murah hati menerima hormat, dan orang kejam hanya mendapatkan kekayaan.", "words": [{"pos": 1, "word_orig": "אֵֽשֶׁת", "strong": "H802", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Perempuan"}, {"pos": 2, "word_orig": "חֵ֭ן", "strong": "H2580", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "murah"}, {"pos": 3, "word_orig": "תִּתְמֹ֣ךְ", "strong": "H8551", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menerima"}, {"pos": 4, "word_orig": "כָּב֑וֹד", "strong": "H3519", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "hormat"}, {"pos": 5, "word_orig": "וְ֝/עָרִיצִ֗ים", "strong": "H6184", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "kejam"}, {"pos": 6, "word_orig": "יִתְמְכוּ", "strong": "H8551", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mendapatkan"}, {"pos": 7, "word_orig": "עֹֽשֶׁר", "strong": "H6239", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekayaan"}]}, {"book": 20, "chapter": 11, "verse": 17, "ayat_id": 16706, "title": "", "ayt_text": "Orang baik menguntungkan dirinya sendiri, tetapi orang kejam mencelakakan tubuhnya sendiri.", "words": [{"pos": 1, "word_orig": "גֹּמֵ֣ל", "strong": "H1580", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menguntungkan"}, {"pos": 2, "word_orig": "נַ֭פְשׁ/וֹ", "strong": "H5315", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sendiri"}, {"pos": 3, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 4, "word_orig": "חָ֑סֶד", "strong": "H2617", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "baik"}, {"pos": 5, "word_orig": "וְ/עֹכֵ֥ר", "strong": "H5916", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mencelakakan"}, {"pos": 6, "word_orig": "שְׁ֝אֵר֗/וֹ", "strong": "H7607", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tubuhnya"}, {"pos": 7, "word_orig": "אַכְזָרִֽי", "strong": "H394", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejam"}]}, {"book": 20, "chapter": 11, "verse": 18, "ayat_id": 16707, "title": "", "ayt_text": "Orang fasik memperoleh upah yang menipu, tetapi mereka yang menabur kebenaran memperoleh upah tetap.", "words": [{"pos": 1, "word_orig": "רָשָׁ֗ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "fasik"}, {"pos": 2, "word_orig": "עֹשֶׂ֥ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memperoleh"}, {"pos": 3, "word_orig": "פְעֻלַּת", "strong": "H6468", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "upah"}, {"pos": 4, "word_orig": "שָׁ֑קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "menipu"}, {"pos": 5, "word_orig": "וְ/זֹרֵ֥עַ", "strong": "H2232", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menabur"}, {"pos": 6, "word_orig": "צְ֝דָקָ֗ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 7, "word_orig": "שֶׂ֣כֶר", "strong": "H7938", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "upah"}, {"pos": 8, "word_orig": "אֱמֶֽת", "strong": "H571", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tetap"}]}, {"book": 20, "chapter": 11, "verse": 19, "ayat_id": 16708, "title": "", "ayt_text": "Siapa berpegang pada kebenaran akan hidup, tetapi dia yang mengejar kejahatan akan mati.", "words": [{"pos": 1, "word_orig": "כֵּן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": ""}, {"pos": 2, "word_orig": "צְדָקָ֥ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "לְ/חַיִּ֑ים", "strong": "H2416", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "hidup"}, {"pos": 4, "word_orig": "וּ/מְרַדֵּ֖ף", "strong": "H7291", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "mengejar"}, {"pos": 5, "word_orig": "רָעָ֣ה", "strong": "H7451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kejahatan"}, {"pos": 6, "word_orig": "לְ/מוֹתֽ/וֹ", "strong": "H4194", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mati"}]}, {"book": 20, "chapter": 11, "verse": 20, "ayat_id": 16709, "title": "", "ayt_text": "Orang yang bengkok hatinya adalah kekejian bagi TUHAN, tetapi Dia berkenan kepada orang yang jalannya tidak bercela.", "words": [{"pos": 1, "word_orig": "תּוֹעֲבַ֣ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "עִקְּשֵׁי", "strong": "H6141", "morph": "HAampc", "morph_id": "Aampc", "ayt_word": "bengkok"}, {"pos": 4, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatinya"}, {"pos": 5, "word_orig": "וּ֝/רְצוֹנ֗/וֹ", "strong": "H7522", "morph": "HC/Ncmsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "berkenan"}, {"pos": 6, "word_orig": "תְּמִ֣ימֵי", "strong": "H8549", "morph": "HAampc", "morph_id": "Aampc", "ayt_word": "bercela"}, {"pos": 7, "word_orig": "דָֽרֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalannya"}]}, {"book": 20, "chapter": 11, "verse": 21, "ayat_id": 16710, "title": "", "ayt_text": "Yakinlah, orang fasik tidak akan terlepas dari hukuman, tetapi keturunan orang benar akan diselamatkan.", "words": [{"pos": 1, "word_orig": "יָ֣ד", "strong": "H3027", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Yakinlah"}, {"pos": 2, "word_orig": "לְ֭/יָד", "strong": "H3027", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Yakinlah"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יִנָּ֣קֶה", "strong": "H5352", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terlepas"}, {"pos": 5, "word_orig": "רָּ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "וְ/זֶ֖רַע", "strong": "H2233", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keturunan"}, {"pos": 7, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 8, "word_orig": "נִמְלָֽט", "strong": "H4422", "morph": "HVNp3ms", "morph_id": "Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diselamatkan"}]}, {"book": 20, "chapter": 11, "verse": 22, "ayat_id": 16711, "title": "", "ayt_text": "Bagaikan cincin emas pada moncong babi, seperti itulah perempuan cantik tanpa akal budi.", "words": [{"pos": 1, "word_orig": "נֶ֣זֶם", "strong": "H5141", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "cincin"}, {"pos": 2, "word_orig": "זָ֭הָב", "strong": "H2091", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 3, "word_orig": "בְּ/אַ֣ף", "strong": "H639", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "moncong"}, {"pos": 4, "word_orig": "חֲזִ֑יר", "strong": "H2386", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "babi"}, {"pos": 5, "word_orig": "אִשָּׁ֥ה", "strong": "H802", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perempuan"}, {"pos": 6, "word_orig": "יָ֝פָ֗ה", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantik"}, {"pos": 7, "word_orig": "וְ/סָ֣רַת", "strong": "H5493", "morph": "HC/Vqrfsc", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "tanpa"}, {"pos": 8, "word_orig": "טָֽעַם", "strong": "H2940", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "budi"}]}, {"book": 20, "chapter": 11, "verse": 23, "ayat_id": 16712, "title": "", "ayt_text": "Keinginan orang benar hanya berujung kebaikan, tetapi harapan orang fasik ada dalam kemurkaan.", "words": [{"pos": 1, "word_orig": "תַּאֲוַ֣ת", "strong": "H8378", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Keinginan"}, {"pos": 2, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "אַךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "hanya"}, {"pos": 4, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}, {"pos": 5, "word_orig": "תִּקְוַ֖ת", "strong": "H8615", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "harapan"}, {"pos": 6, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "עֶבְרָֽה", "strong": "H5678", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemurkaan"}]}, {"book": 20, "chapter": 11, "verse": 24, "ayat_id": 16713, "title": "", "ayt_text": "Seseorang menyebar harta, tetapi bertambah kaya, yang lain menahan melebihi seharusnya, tetapi menjadi kekurangan.", "words": [{"pos": 1, "word_orig": "יֵ֣שׁ", "strong": "H3426", "morph": "HTm", "morph_id": "Tm", "ayt_word": ""}, {"pos": 2, "word_orig": "מְ֭פַזֵּר", "strong": "H6340", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menyebar"}, {"pos": 3, "word_orig": "וְ/נוֹסָ֥ף", "strong": "H3254", "morph": "HC/VNrmsa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "bertambah"}, {"pos": 4, "word_orig": "ע֑וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lain"}, {"pos": 5, "word_orig": "וְ/חוֹשֵׂ֥ךְ", "strong": "H2820", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menahan"}, {"pos": 6, "word_orig": "מִ֝/יֹּ֗שֶׁר", "strong": "H3476", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seharusnya"}, {"pos": 7, "word_orig": "אַךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "tetapi"}, {"pos": 8, "word_orig": "לְ/מַחְסֽוֹר", "strong": "H4270", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekurangan"}]}, {"book": 20, "chapter": 11, "verse": 25, "ayat_id": 16714, "title": "", "ayt_text": "Orang yang memberi berkat akan menjadi makmur, dan orang yang memberi minum, dia juga akan diberi minum.", "words": [{"pos": 1, "word_orig": "נֶֽפֶשׁ", "strong": "H5315", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "בְּרָכָ֥ה", "strong": "H1293", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "memberi"}, {"pos": 3, "word_orig": "תְדֻשָּׁ֑ן", "strong": "H1878", "morph": "HVPi3fs", "morph_id": "Verba Pual Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "makmur"}, {"pos": 4, "word_orig": "וּ֝/מַרְוֶ֗ה", "strong": "H7301", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "minum"}, {"pos": 5, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "juga"}, {"pos": 6, "word_orig": "ה֥וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "dia"}, {"pos": 7, "word_orig": "יוֹרֶֽא", "strong": "H3384", "morph": "HVHi3ms", "morph_id": "Verba", "ayt_word": "minum"}]}, {"book": 20, "chapter": 11, "verse": 26, "ayat_id": 16715, "title": "", "ayt_text": "Orang akan mengutuki dia yang menahan gandum, tetapi berkat ada di atas kepala mereka yang menjualnya.", "words": [{"pos": 1, "word_orig": "מֹ֣נֵֽעַ", "strong": "H4513", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menahan"}, {"pos": 2, "word_orig": "בָּ֭ר", "strong": "H1250", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "gandum"}, {"pos": 3, "word_orig": "יִקְּבֻ֣/הוּ", "strong": "H5344", "morph": "HVqi3mp/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp3ms", "ayt_word": "mengutuki"}, {"pos": 4, "word_orig": "לְא֑וֹם", "strong": "H3816", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 5, "word_orig": "וּ֝/בְרָכָ֗ה", "strong": "H1293", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berkat"}, {"pos": 6, "word_orig": "לְ/רֹ֣אשׁ", "strong": "H7218", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kepala"}, {"pos": 7, "word_orig": "מַשְׁבִּֽיר", "strong": "H7666", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menjualnya"}]}, {"book": 20, "chapter": 11, "verse": 27, "ayat_id": 16716, "title": "", "ayt_text": "Orang yang bertekun mencari kebaikan mencari perkenanan, tetapi kejahatan menghampiri mereka yang mencari kejahatan.", "words": [{"pos": 1, "word_orig": "שֹׁ֣חֵֽר", "strong": "H7836", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "bertekun"}, {"pos": 2, "word_orig": "ט֭וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}, {"pos": 3, "word_orig": "יְבַקֵּ֣שׁ", "strong": "H1245", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 4, "word_orig": "רָצ֑וֹן", "strong": "H7522", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkenanan"}, {"pos": 5, "word_orig": "וְ/דֹרֵ֖שׁ", "strong": "H1875", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mencari"}, {"pos": 6, "word_orig": "רָעָ֣ה", "strong": "H7451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kejahatan"}, {"pos": 7, "word_orig": "תְבוֹאֶֽ/נּוּ", "strong": "H935", "morph": "HVqi3fs/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "menghampiri"}]}, {"book": 20, "chapter": 11, "verse": 28, "ayat_id": 16717, "title": "", "ayt_text": "Siapa memercayakan diri kepada kekayaannya, dia akan jatuh, tetapi orang benar akan bertunas seperti daun muda.", "words": [{"pos": 1, "word_orig": "בּוֹטֵ֣חַ", "strong": "H982", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memercayak