": "budak"}, {"pos": 6, "word_orig": "אֱ֝וִ֗יל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "לַ/חֲכַם", "strong": "H2450", "morph": "HR/Aamsc", "morph_id": "Preposisi + Aamsc", "ayt_word": "berhikmat"}, {"pos": 8, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berhikmat"}]}, {"book": 20, "chapter": 11, "verse": 30, "ayat_id": 16719, "title": "", "ayt_text": "Buah orang benar adalah pohon kehidupan, dan dia yang berhikmat meraih hati orang.", "words": [{"pos": 1, "word_orig": "פְּֽרִי", "strong": "H6529", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Buah"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "עֵ֣ץ", "strong": "H6086", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pohon"}, {"pos": 4, "word_orig": "חַיִּ֑ים", "strong": "H2416", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 5, "word_orig": "וְ/לֹקֵ֖חַ", "strong": "H3947", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "meraih"}, {"pos": 6, "word_orig": "נְפָשׂ֣וֹת", "strong": "H5315", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": ""}, {"pos": 7, "word_orig": "חָכָֽם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}]}, {"book": 20, "chapter": 11, "verse": 31, "ayat_id": 16720, "title": "", "ayt_text": "Jika orang benar menerima balasan di bumi, betapa lebih lagi orang fasik dan para pendosa.", "words": [{"pos": 1, "word_orig": "הֵ֣ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H