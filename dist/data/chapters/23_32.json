orph_id": "Aafsa", "ayt_word": "tandus"}]}, {"book": 23, "chapter": 32, "verse": 3, "ayat_id": 18263, "title": "", "ayt_text": "Mata orang-orang yang melihat tidak akan dibutakan, dan telinga mereka yang mendengar akan memperhatikan.", "words": [{"pos": 1, "word_orig": "וְ/לֹ֥א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "תִשְׁעֶ֖ינָה", "strong": "H8159", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "dibutakan"}, {"pos": 3, "word_orig": "עֵינֵ֣י", "strong": "H5869", "morph": "HNcbdc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Mata"}, {"pos": 4, "word_orig": "רֹאִ֑ים", "strong": "H7200", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "melihat"}, {"pos": 5, "word_orig": "וְ/אָזְנֵ֥י", "strong": "H241", "morph": "HC/Ncfdc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "telinga"}, {"pos": 6, "word_orig": "שֹׁמְעִ֖ים", "strong": "H8085", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "mendengar"}, {"pos": 7, "word_orig": "תִּקְשַֽׁבְנָה", "strong": "H7181", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "memperhatikan"}]}, {"book": 23, "chapter": 32, "verse": 4, "ayat_id": 18264, "title": "", "ayt_text": "Pikiran mereka yang terburu-buru akan memahami pengetahuan, lidah orang-orang gagap akan segera berbicara dengan jelas.", "words": [{"pos": 1, "word_orig": "וּ/לְבַ֥ב", "strong": "H3824", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Pikiran"}, {"pos": 2, "word_orig": "נִמְהָרִ֖ים", "strong": "H4116", "morph": "HVNrmpa", "morph_id": "Verba Nifal", "ayt_word": "terburu-buru"}, {"pos": 3, "word_orig": "יָבִ֣ין", "strong": "H995", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memahami"}, {"pos": 4, "word_orig": "לָ/דָ֑עַת", "strong": "H3045", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "pengetahuan"}, {"pos": 5, "word_orig": "וּ/לְשׁ֣וֹן", "strong": "H3956", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "lidah"}, {"pos": 6, "word_orig": "עִלְּגִ֔ים", "strong": "H5926", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "gagap"}, {"pos": 7, "word_orig": "תְּמַהֵ֖ר", "strong": "H4116", "morph": "HVpi3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "segera"}, {"pos": 8, "word_orig": "לְ/דַבֵּ֥ר", "strong": "H1696", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "berbicara"}, {"pos": 9, "word_orig": "צָחֽוֹת", "strong": "H6703", "morph": "HAafpa", "morph_id": "Aafpa", "ayt_word": "jelas"}]}, {"book": 23, "chapter": 32, "verse": 5, "ayat_id": 18265, "title": "", "ayt_text": "Orang bodoh tidak akan lagi disebut mulia, ataupun orang berengsek disebut dermawan.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יִקָּרֵ֥א", "strong": "H7121", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "disebut"}, {"pos": 3, "word_orig": "ע֛וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lagi"}, {"pos": 4, "word_orig": "לְ/נָבָ֖ל", "strong": "H5036", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "Orang"}, {"pos": 5, "word_orig": "נָדִ֑יב", "strong": "H5081", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "mulia"}, {"pos": 6, "word_orig": "וּ/לְ/כִילַ֕י", "strong": "H3596", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 7, "word_orig": "לֹ֥א", "s