[{"book": 23, "chapter": 32, "verse": 1, "ayat_id": 18261, "title": "Raja yang Adil", "ayt_text": "Sesungguhnya, seorang raja akan memerintah dalam kebenaran, dan pembesar-pembesar akan memerintah dengan adil.", "words": [{"pos": 1, "word_orig": "הֵ֥ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Sesungguhnya"}, {"pos": 2, "word_orig": "לְ/צֶ֖דֶק", "strong": "H6664", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "יִמְלָךְ", "strong": "H4427", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memerintah"}, {"pos": 4, "word_orig": "מֶ֑לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raja"}, {"pos": 5, "word_orig": "וּ/לְ/שָׂרִ֖ים", "strong": "H8269", "morph": "HC/R/Ncmpa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pembesar-pembesar"}, {"pos": 6, "word_orig": "לְ/מִשְׁפָּ֥ט", "strong": "H4941", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "adil"}, {"pos": 7, "word_orig": "יָשֹֽׂרוּ", "strong": "H8323", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memerintah"}]}, {"book": 23, "chapter": 32, "verse": 2, "ayat_id": 18262, "title": "", "ayt_text": "Masing-masing orang akan menjadi seperti tempat berlindung dari angin, tempat berteduh dari badai; seperti aliran air di tanah yang kering, seperti bayangan bukit batu besar di tanah yang tandus.", "words": [{"pos": 1, "word_orig": "וְ/הָיָה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "אִ֥ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "a