[{"book": 19, "chapter": 125, "verse": 1, "ayat_id": 16112, "title": "Pelindung Israel", "ayt_text": "Nyanyian Ziarah. Orang-orang yang percaya kepada TUHAN adalah seperti Gunung Sion, yang tidak dapat goyah dan tetap untuk selama-lamanya.", "words": [{"pos": 1, "word_orig": "שִׁ֗יר", "strong": "H7892", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Nyanyian"}, {"pos": 2, "word_orig": "הַֽ/מַּ֫עֲל֥וֹת", "strong": "H4609", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Ziarah"}, {"pos": 3, "word_orig": "הַ/בֹּטְחִ֥ים", "strong": "H982", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "percaya"}, {"pos": 4, "word_orig": "בַּ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "כְּֽ/הַר", "strong": "H2022", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Gunung"}, {"pos": 6, "word_orig": "צִיּ֥וֹן", "strong": "H6726", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sion"}, {"pos": 7, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "dapat"}, {"pos": 8, "word_orig": "יִ֝מּ֗וֹט", "strong": "H4131", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "goyah"}, {"pos": 9, "word_orig": "לְ/עוֹלָ֥ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 10, "word_orig": "יֵשֵֽׁב", "strong": "H3427", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "tetap"}]}, {"book": 19, "chapter": 125, "verse": 2, "ayat_id": 16113, "title": "", "ayt_text": "Seperti gunung-gunung yang mengelilingi Yerusalem, begitu pun TUHAN meng