nari"}]}, {"book": 21, "chapter": 3, "verse": 5, "ayat_id": 17365, "title": "", "ayt_text": "Ada waktu untuk membuang batu, dan ada waktu untuk mengumpulkan batu. Ada waktu untuk memeluk, dan ada waktu untuk menahan diri dari memeluk.", "words": [{"pos": 1, "word_orig": "עֵ֚ת", "strong": "H6256", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 2, "word_orig": "לְ/הַשְׁלִ֣יךְ", "strong": "H7993", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "membuang"}, {"pos": 3, "word_orig": "אֲבָנִ֔ים", "strong": "H68", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "batu"}, {"pos": 4, "word_orig": "וְ/עֵ֖ת", "strong": "H6256", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "waktu"}, {"pos": 5, "word_orig": "כְּנ֣וֹס", "strong": "H3664", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "mengumpulkan"}, {"pos": 6, "word_orig": "אֲבָנִ֑ים", "strong": "H68", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "batu"}, {"pos": 7, "word_orig": "עֵ֣ת", "strong": "H6256", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 8, "word_orig": "לַ/חֲב֔וֹק", "strong": "H2263", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "memeluk"}, {"pos": 9, "word_orig": "וְ/עֵ֖ת", "strong": "H6256", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 10, "word_orig": "לִ/רְחֹ֥ק", "strong": "H7368", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "menahan"}, {"pos": 11, "word_orig": "מֵ/חַבֵּֽק", "strong": "H2263", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "memeluk"}]}, {