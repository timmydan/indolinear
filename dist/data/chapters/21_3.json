[{"book": 21, "chapter": 3, "verse": 1, "ayat_id": 17361, "title": "Segala Sesuatu Ada Waktunya", "ayt_text": "Ada masa tertentu untuk segala sesuatu, dan ada waktu yang tepat untuk segala sesuatu di bawah langit.", "words": [{"pos": 1, "word_orig": "לַ/כֹּ֖ל", "strong": "H3605", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "segala"}, {"pos": 2, "word_orig": "זְמָ֑ן", "strong": "H2165", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tertentu"}, {"pos": 3, "word_orig": "וְ/עֵ֥ת", "strong": "H6256", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 4, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 5, "word_orig": "חֵ֖פֶץ", "strong": "H2656", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tepat"}, {"pos": 6, "word_orig": "תַּ֥חַת", "strong": "H8478", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "bawah"}, {"pos": 7, "word_orig": "הַ/שָּׁמָֽיִם", "strong": "H8064", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}]}, {"book": 21, "chapter": 3, "verse": 2, "ayat_id": 17362, "title": "", "ayt_text": "Ada waktu untuk lahir, dan ada waktu untuk mati. Ada waktu untuk menanam, dan ada waktu untuk mencabut yang ditanam.", "words": [{"pos": 1, "word_orig": "עֵ֥ת", "strong": "H6256", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 2, "word_orig": "לָ/לֶ֖דֶת", "strong": "H3205", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "lahir"}, {"pos": 3, "word_orig": "וְ/עֵ֣ת", "strong": "H6256", "morph": "HC/Ncbsa", "mor