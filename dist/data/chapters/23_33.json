[{"book": 23, "chapter": 33, "verse": 1, "ayat_id": 18281, "title": "TUHAN Akan Membawa Keselamatan", "ayt_text": "Celakalah kamu, hai perusak, yang kamu sendiri belum pernah dirusak, hai pengkhianat, yang belum pernah dikhianati! Ketika kamu berhenti menghancurkan, kamu akan dihancurkan, dan ketika kamu sudah tidak lagi mengkhianati, mereka akan mengkhianatimu.", "words": [{"pos": 1, "word_orig": "ה֣וֹי", "strong": "H1945", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Celakalah"}, {"pos": 2, "word_orig": "שׁוֹדֵ֗ד", "strong": "H7703", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "perusak"}, {"pos": 3, "word_orig": "וְ/אַתָּה֙", "strong": "H859", "morph": "HC/Pp2ms", "morph_id": "Konjungsi (וְ) + Pp2ms", "ayt_word": "kamu"}, {"pos": 4, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "belum"}, {"pos": 5, "word_orig": "שָׁד֔וּד", "strong": "H7703", "morph": "HVqsmsa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "dirusak"}, {"pos": 6, "word_orig": "וּ/בוֹגֵ֖ד", "strong": "H898", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "pengkhianat"}, {"pos": 7, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "belum"}, {"pos": 8, "word_orig": "בָ֣גְדוּ", "strong": "H898", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "dikhianati"}, {"pos": 9, "word_orig": "ב֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 10, "word_orig": "כַּ/הֲתִֽמְ/ךָ֤", "strong": "H8552", "morph": "HR/Vhc/Sp2ms", "morph_id": "Preposisi + Verba Hifil Imperatif + Sp2ms", "ayt_word": "berhenti"}, {"pos": 11, "word_orig": "שׁוֹדֵד֙", "strong": "H7703", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghancurkan"}, {"pos": 12, "word_orig": "תּוּשַּׁ֔ד", "strong": "H7703", "morph": "HVQi2ms", "morph_id": "Verba Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "dihancurkan"}, {"pos": 13, "word_orig": "כַּ/נְּלֹתְ/ךָ֥", "strong": "H5239", "morph": "HR/Vhc/Sp2ms", "morph_id": "Preposisi + Verba Hifil Imperatif + Sp2ms", "ayt_word": "lagi"}, {"pos": 14, "word_orig": "לִ/בְגֹּ֖ד", "strong": "H898", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mengkhianati"}, {"pos": 15, "word_orig": "יִבְגְּדוּ", "strong": "H898", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mengkhianatimu"}, {"pos": 16, "word_orig": "בָֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 23, "chapter": 33, "verse": 2, "ayat_id": 18282, "title": "", "ayt_text": "“TUHAN, kasihanilah kami. Kami telah menanti-nantikan Engkau. Jadilah kekuatan kami setiap pagi, keselamatan kami pada masa kesesakan.", "words": [{"pos": 1, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "חָנֵּ֖/נוּ", "strong": "H2603", "morph": "HVqv2ms/Sp1cp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp1cp", "ayt_word": "kasihanilah"}, {"pos": 3, "word_orig": "לְ/ךָ֣", "strong": "", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": "kami"}, {"pos": 4, "word_orig": "קִוִּ֑ינוּ", "strong": "H6960", "morph": "HVpp1cp", "morph_id": "Verba Piel Perfek Orang ke-1 Jamak", "ayt_word": "menanti-nantikan"}, {"pos": 5, "word_orig": "הֱיֵ֤ה", "strong": "H1961", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Jadilah"}, {"pos": 6, "word_orig": "זְרֹעָ/ם֙", "strong": "H2220", "morph": "HNcbsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kekuatan"}, {"pos": 7, "word_orig": "לַ/בְּקָרִ֔ים", "strong": "H1242", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pagi"}, {"pos": 8, "word_orig": "אַף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 9, "word_orig": "יְשׁוּעָתֵ֖/נוּ", "strong": "H3444", "morph": "HNcfsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "keselamatan"}, {"pos": 10, "word_orig": "בְּ/עֵ֥ת", "strong": "H6256", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "masa"}, {"pos": 11, "word_orig": "צָרָֽה", "strong": "H6869", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesesakan"}]}, {"book": 23, "chapter": 33, "verse": 3, "ayat_id": 18283, "title": "", "ayt_text": "Karena bunyi keributan, bangsa-bangsa melarikan diri. Karena Engkau meninggikan diri-Mu, bangsa-bangsa tercerai-berai.”", "words": [{"pos": 1, "word_orig": "מִ/קּ֣וֹל", "strong": "H6963", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bunyi"}, {"pos": 2, "word_orig": "הָמ֔וֹן", "strong": "H1995", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keributan"}, {"pos": 3, "word_orig": "נָדְד֖וּ", "strong": "H5074", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "melarikan"}, {"pos": 4, "word_orig": "עַמִּ֑ים", "strong": "H5971", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 5, "word_orig": "מֵ/ר֣וֹמְמֻתֶ֔/ךָ", "strong": "H7427", "morph": "HR/Ncfsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "meninggikan"}, {"pos": 6, "word_orig": "נָפְצ֖וּ", "strong": "H5310", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "tercerai-berai"}, {"pos": 7, "word_orig": "גּוֹיִֽם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}]}, {"book": 23, "chapter": 33, "verse": 4, "ayat_id": 18284, "title": "", "ayt_text": "Jarahanmu akan dikumpulkan seperti mengumpulkan ulat. Seperti belalang datang menyerbu, demikianlah mereka datang menyerbunya.", "words": [{"pos": 1, "word_orig": "וְ/אֻסַּ֣ף", "strong": "H622", "morph": "HC/VPq3ms", "morph_id": "Konjungsi (וְ) + Verba Pual Orang ke-3 Laki-laki Tunggal", "ayt_word": "dikumpulkan"}, {"pos": 2, "word_orig": "שְׁלַלְ/כֶ֔ם", "strong": "H7998", "morph": "HNcmsc/Sp2mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2mp", "ayt_word": "Jarahanmu"}, {"pos": 3, "word_orig": "אֹ֖סֶף", "strong": "H625", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mengumpulkan"}, {"pos": 4, "word_orig": "הֶֽ/חָסִ֑יל", "strong": "H2625", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ulat"}, {"pos": 5, "word_orig": "כְּ/מַשַּׁ֥ק", "strong": "H4944", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "menyerbu"}, {"pos": 6, "word_orig": "גֵּבִ֖ים", "strong": "H1357", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "belalang"}, {"pos": 7, "word_orig": "שׁוֹקֵ֥ק", "strong": "H8264", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyerbunya"}, {"pos": 8, "word_orig": "בּֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 23, "chapter": 33, "verse": 5, "ayat_id": 18285, "title": "", "ayt_text": "TUHAN ditinggikan karena Dia bersemayam di tempat yang tinggi. Dia memenuhi Sion dengan keadilan dan kebenaran.", "words": [{"pos": 1, "word_orig": "נִשְׂגָּ֣ב", "strong": "H7682", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "ditinggikan"}, {"pos": 2, "word_orig": "יְהוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 4, "word_orig": "שֹׁכֵ֖ן", "strong": "H7931", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "bersemayam"}, {"pos": 5, "word_orig": "מָר֑וֹם", "strong": "H4791", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 6, "word_orig": "מִלֵּ֣א", "strong": "H4390", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memenuhi"}, {"pos": 7, "word_orig": "צִיּ֔וֹן", "strong": "H6726", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sion"}, {"pos": 8, "word_orig": "מִשְׁפָּ֖ט", "strong": "H4941", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 9, "word_orig": "וּ/צְדָקָֽה", "strong": "H6666", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}]}, {"book": 23, "chapter": 33, "verse": 6, "ayat_id": 18286, "title": "", "ayt_text": "Pada zamanmu akan ada keamanan, kelimpahan, keselamatan, kebijaksanaan, dan pengetahuan, takut akan TUHAN adalah kekayaan Sion.", "words": [{"pos": 1, "word_orig": "וְ/הָיָה֙", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "אֱמוּנַ֣ת", "strong": "H530", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "keamanan"}, {"pos": 3, "word_orig": "עִתֶּ֔י/ךָ", "strong": "H6256", "morph": "HNcbpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "zamanmu"}, {"pos": 4, "word_orig": "חֹ֥סֶן", "strong": "H2633", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kelimpahan"}, {"pos": 5, "word_orig": "יְשׁוּעֹ֖ת", "strong": "H3444", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "keselamatan"}, {"pos": 6, "word_orig": "חָכְמַ֣ת", "strong": "H2451", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kebijaksanaan"}, {"pos": 7, "word_orig": "וָ/דָ֑עַת", "strong": "H1847", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 8, "word_orig": "יִרְאַ֥ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "takut"}, {"pos": 9, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 10, "word_orig": "הִ֥יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "adalah"}, {"pos": 11, "word_orig": "אוֹצָרֽ/וֹ", "strong": "H214", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kekayaan"}]}, {"book": 23, "chapter": 33, "verse": 7, "ayat_id": 18287, "title": "", "ayt_text": "Lihatlah, orang-orang mereka yang gagah perkasa menangis di jalan-jalan. Para utusan perdamaian menangis dalam kepedihan.", "words": [{"pos": 1, "word_orig": "הֵ֚ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "אֶרְאֶלָּ֔ם", "strong": "H691", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkasa"}, {"pos": 3, "word_orig": "צָעֲק֖וּ", "strong": "H6817", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menangis"}, {"pos": 4, "word_orig": "חֻ֑צָ/ה", "strong": "H2351", "morph": "HNcmsa/Sd", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tungga