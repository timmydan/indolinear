[{"book": 19, "chapter": 23, "verse": 1, "ayat_id": 14237, "title": "TUHAN adalah Gembalaku", "ayt_text": "Nyanyian Daud. TUHAN adalah gembalaku. Aku tidak kekurangan apa pun.", "words": [{"pos": 1, "word_orig": "מִזְמ֥וֹר", "strong": "H4210", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Nyanyian"}, {"pos": 2, "word_orig": "לְ/דָוִ֑ד", "strong": "H1732", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Daud"}, {"pos": 3, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "רֹ֝עִ֗/י", "strong": "H7462", "morph": "HVqrmsc/Sp1cs", "morph_id": "Verba Qal + Sp1cs", "ayt_word": "gembalaku"}, {"pos": 5, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "pun"}, {"pos": 6, "word_orig": "אֶחְסָֽר", "strong": "H2637", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "kekurangan"}]}, {"book": 19, "chapter": 23, "verse": 2, "ayat_id": 14238, "title": "", "ayt_text": "Dia membaringkanku di padang rumput hijau. Dia menuntunku, ke tepi air yang tenang.", "words": [{"pos": 1, "word_orig": "בִּ/נְא֣וֹת", "strong": "H4999", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "padang"}, {"pos": 2, "word_orig": "דֶּ֭שֶׁא", "strong": "H1877", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rumput"}, {"pos": 3, "word_orig": "יַרְבִּיצֵ֑/נִי", "strong": "H7257", "morph": "HVhi3ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "membaringkanku"}, {"pos": 4, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "tepi"}, {"pos": 5, "word_orig": "מֵ֖י", "strong": "H4325", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "air"}, {"pos": 6, "word_orig": "מְנֻח֣וֹת", "strong": "H4496", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "tenang"}, {"pos": 7, "word_orig": "יְנַהֲלֵֽ/נִי", "strong": "H5095", "morph": "HVpi3ms/Sp1cs", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menuntunku"}]}, {"book": 19, "chapter": 23, "verse": 3, "ayat_id": 14239, "title": "", "ayt_text": "Dia memulihkan jiwaku. Dia menuntun aku di jalan-jalan kebenaran oleh karena nama-Nya.", "words": [{"pos": 1, "word_orig": "נַפְשִׁ֥/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 2, "word_orig": "יְשׁוֹבֵ֑ב", "strong": "H7725", "morph": "HVoi3ms", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memulihkan"}, {"pos": 3, "word_orig": "יַֽנְחֵ֥/נִי", "strong": "H5148", "morph": "HVhi3ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menuntun"}, {"pos": 4, "word_orig": "בְ/מַעְגְּלֵי", "strong": "H4570", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "jalan-jalan"}, {"pos": 5, "word_orig": "צֶ֝֗דֶק", "strong": "H6664", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 6, "word_orig": "לְמַ֣עַן", "strong": "H4616", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "karena"}, {"pos": 7, "word_orig": "שְׁמֽ/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "nama-Nya"}]}, {"book": 19, "chapter": 23, "verse": 4, "ayat_id": 14240, "title": "", "ayt_text": "Walaupun aku berjalan melewati lembah bayang-bayang kematian, aku takkan takut bahaya, karena Engkau bersamaku; gada-Mu dan tongkat-Mu, itu yang menghiburku.", "words": [{"pos": 1, "word_orig": "גַּ֤ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Walaupun"}, {"pos": 2, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Walaupun"}, {"pos": 3, "word_orig": "אֵלֵ֨ךְ", "strong": "H3212", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "berjalan"}, {"pos": 4, "word_orig": "בְּ/גֵ֪יא", "strong": "H1516", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "lembah"}, {"pos": 5, "word_orig": "צַלְמָ֡וֶת", "strong": "H6757", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bayang-bayang"}, {"pos": 6, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 7, "word_orig": "אִ֘ירָ֤א", "strong": "H3372", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "takut"}, {"pos": 8, "word_orig": "רָ֗ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bahaya"}, {"pos": 9, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 10, "word_orig": "אַתָּ֥ה", "strong": "H859", "morph": "HPp2ms", "morph_id": "Pp2ms", "ayt_word": "Engkau"}, {"pos": 11, "word_orig": "עִמָּדִ֑/י", "strong": "H5978", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "bersamaku"}, {"pos": 12, "word_orig": "שִׁבְטְ/ךָ֥", "strong": "H7626", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "tongkat-Mu"}, {"pos": 13, "word_orig": "וּ֝/מִשְׁעַנְתֶּ֗/ךָ", "strong": "H4938", "morph": "HC/Ncfsc/Sp2ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "gada-Mu"}, {"pos": 14, "word_orig": "הֵ֣מָּה", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": "itu"}, {"pos": 15, "word_orig": "יְנַֽחֲמֻֽ/נִי", "strong": "H5162", "morph": "HVpi3mp/Sp1cs", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak + Sp1cs", "ayt_word": "menghiburku"}]}, {"book": 19, "chapter": 23, "verse": 5, "ayat_id": 14241, "title": "", "ayt_text": "Engkau mengatur meja di hadapanku, di depan musuh-musuhku. Engkau mengurapi kepalaku dengan minyak; pialaku berlimpah-limpah.", "words": [{"pos": 1, "word_orig": "תַּעֲרֹ֬ךְ", "strong": "H6186", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengatur"}, {"pos": 2, "word_orig": "לְ/פָנַ֨/י", "strong": "H6440", "morph": "HR/Ncbpc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "hadapanku"}, {"pos": 3, "word_orig": "שֻׁלְחָ֗ן", "strong": "H7979", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "meja"}, {"pos": 4, "word_orig": "נֶ֥גֶד", "strong": "H5048", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "depan"}, {"pos": 5, "word_orig": "צֹרְרָ֑/י", "strong": "H6887", "morph": "HVqrmpc/Sp1cs", "morph_id": "Verba Qal + Sp1cs", "ayt_word": "musuh-musuhku"}, {"pos": 6, "word_orig": "דִּשַּׁ֖נְתָּ", "strong": "H1878", "morph": "HVpp2ms", "morph_id": "Verba Piel Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengurapi"}, {"pos": 7, "word_orig": "בַ/שֶּׁ֥מֶן", "strong": "H8081", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "minyak"}, {"pos": 8, "word_orig": "רֹ֝אשִׁ֗/י", "strong": "H7218", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kepalaku"}, {"pos": 9, "word_orig": "כּוֹסִ֥/י", "strong": "H3563", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "pialaku"}, {"pos": 10, "word_ori