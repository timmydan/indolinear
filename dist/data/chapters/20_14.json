[{"book": 20, "chapter": 14, "verse": 1, "ayat_id": 16774, "title": "", "ayt_text": "Perempuan yang berhikmat membangun rumahnya, tetapi yang bodoh meruntuhkannya dengan tangannya sendiri.", "words": [{"pos": 1, "word_orig": "חַכְמ֣וֹת", "strong": "H2454", "morph": "HAafpc", "morph_id": "Aafpc", "ayt_word": "berhikmat"}, {"pos": 2, "word_orig": "נָ֭שִׁים", "strong": "H802", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Perempuan"}, {"pos": 3, "word_orig": "בָּנְתָ֣ה", "strong": "H1129", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "membangun"}, {"pos": 4, "word_orig": "בֵיתָ֑/הּ", "strong": "H1004", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "rumahnya"}, {"pos": 5, "word_orig": "וְ֝/אִוֶּ֗לֶת", "strong": "H200", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "בְּ/יָדֶ֥י/הָ", "strong": "H3027", "morph": "HR/Ncbdc/Sp3fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3fs", "ayt_word": "tangannya"}, {"pos": 7, "word_orig": "תֶהֶרְסֶֽ/נּוּ", "strong": "H2040", "morph": "HVqi3fs/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "meruntuhkannya"}]}, {"book": 20, "chapter": 14, "verse": 2, "ayat_id": 16775, "title": "", "ayt_text": "Siapa berjalan dalam kejujuran itu takut akan TUHAN, tetapi dia yang jalannya sesat menghina-Nya.", "words": [{"pos": 1, "word_orig": "הוֹלֵ֣ךְ", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berjalan"}, {"pos": 2, "word_orig": "בְּ֭/יָשְׁר/וֹ", "strong": "H3476", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kejujuran"}, {"pos": 3, "word_orig": "יְרֵ֣א", "strong": "H3373", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "takut"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וּ/נְל֖וֹז", "strong": "H3868", "morph": "HC/VNrmsc", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "sesat"}, {"pos": 6, "word_orig": "דְּרָכָ֣י/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalannya"}, {"pos": 7, "word_orig": "בּוֹזֵֽ/הוּ", "strong": "H959", "morph": "HVqrmsc/Sp3ms", "morph_id": "Verba Qal + Sp3ms", "ayt_word": "menghina-Nya"}]}, {"book": 20, "chapter": 14, "verse": 3, "ayat_id": 16776, "title": "", "ayt_text": "Dalam mulut orang bodoh terdapat rotan kesombongan, tetapi orang berhikmat dilindungi oleh bibirnya.", "words": [{"pos": 1, "word_orig": "בְּֽ/פִי", "strong": "H6310", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 2, "word_orig": "אֱ֭וִיל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "חֹ֣טֶר", "strong": "H2415", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "rotan"}, {"pos": 4, "word_orig": "גַּאֲוָ֑ה", "strong": "H1346", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesombongan"}, {"pos": 5, "word_orig": "וְ/שִׂפְתֵ֥י", "strong": "H8193", "morph": "HC/Ncfdc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "bibirnya"}, {"pos": 6, "word_orig": "חֲ֝כָמִ֗ים", "strong": "H2450", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "berhikmat"}, {"pos": 7, "word_orig": "תִּשְׁמוּרֵֽ/ם", "strong": "H8104", "morph": "HVqi3fs/Sp3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "dilindungi"}]}, {"book": 20, "chapter": 14, "verse": 4, "ayat_id": 16777, "title": "", "ayt_text": "Jika tidak ada sapi, palungan menjadi bersih, tetapi panen yang melimpah didapat melalui kekuatan sapi.", "words": [{"pos": 1, "word_orig": "בְּ/אֵ֣ין", "strong": "H369", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "אֲ֭לָפִים", "strong": "H504", "morph": "HAcbpa", "morph_id": "Acbpa", "ayt_word": "sapi"}, {"pos": 3, "word_orig": "אֵב֣וּס", "strong": "H18", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "palungan"}, {"pos": 4, "word_orig": "בָּ֑ר", "strong": "H1249", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bersih"}, {"pos": 5, "word_orig": "וְ/רָב", "strong": "H7230", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "melimpah"}, {"pos": 6, "word_orig": "תְּ֝בוּא֗וֹת", "strong": "H8393", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "panen"}, {"pos": 7, "word_orig": "בְּ/כֹ֣חַ", "strong": "H3581", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kekuatan"}, {"pos": 8, "word_orig": "שֽׁוֹר", "strong": "H7794", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sapi"}]}, {"book": 20, "chapter": 14, "verse": 5, "ayat_id": 16778, "title": "", "ayt_text": "Saksi yang setia tidak berdusta, tetapi saksi yang palsu mengembuskan kebohongan.", "words": [{"pos": 1, "word_orig": "עֵ֣ד", "strong": "H5707", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Saksi"}, {"pos": 2, "word_orig": "אֱ֭מוּנִים", "strong": "H529", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "setia"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יְכַזֵּ֑ב", "strong": "H3576", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdusta"}, {"pos": 5, "word_orig": "וְ/יָפִ֥יחַ", "strong": "H6315", "morph": "HC/Vhi3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengembuskan"}, {"pos": 6, "word_orig": "כְּ֝זָבִ֗ים", "strong": "H3577", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "palsu"}, {"pos": 7, "word_orig": "עֵ֣ד", "strong": "H5707", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "saksi"}, {"pos": 8, "word_orig": "שָֽׁקֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebohongan"}]}, {"book": 20, "chapter": 14, "verse": 6, "ayat_id": 16779, "title": "", "ayt_text": "Pencemooh mencari hikmat dalam kesia-siaan, tetapi pengetahuan mudah diperoleh bagi orang yang berpengertian.", "words": [{"pos": 1, "word_orig": "בִּקֶּשׁ", "strong": "H1245", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 2, "word_orig": "לֵ֣ץ", "strong": "H3887", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Pencemooh"}, {"pos": 3, "word_orig": "חָכְמָ֣ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 4, "word_orig": "וָ/אָ֑יִן", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "kesia-siaan"}, {"pos": 5, "word_orig": "וְ/דַ֖עַת", "strong": "H1847", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "לְ/נָב֣וֹן", "strong": "H995", "morph": "HR/VNrmsa", "morph_id": "Preposisi + Verba Nifal", "ayt_word": "berpengertian"}, {"pos": 7, "word_orig": "נָקָֽל", "strong": "H7043", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "mudah"}]}, {"book": 20, "chapter": 14, "verse": 7, "ayat_id": 16780, "title": "", "ayt_text": "Menjauhlah dari hadapan orang bodoh karena kamu tidak akan menemukan pengetahuan dari bibirnya.", "words": [{"pos": 1, "word_orig": "לֵ֣ךְ", "strong": "H3212", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Menjauhlah"}, {"pos": 2, "word_orig": "מִ֭/נֶּגֶד", "strong": "H5048", "morph": "HR/R", "morph_id": "Preposisi + Preposisi", "ayt_word": "dari"}, {"pos": 3, "word_orig": "לְ/אִ֣ישׁ", "strong": "H376", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "כְּסִ֑יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 5, "word_orig": "וּ/בַל", "strong": "H1077", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יָ֝דַ֗עְתָּ", "strong": "H3045", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menemukan"}, {"pos": 7, "word_orig": "שִׂפְתֵי", "strong": "H8193", "morph": "HNcfdc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "bibirnya"}, {"pos": 8, "word_orig": "דָֽעַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 20, "chapter": 14, "verse": 8, "ayat_id": 16781, "title": "", "ayt_text": "Hikmat orang cerdik adalah mengerti jalannya, tetapi kebodohan orang bodoh adalah tipu daya.", "words": [{"pos": 1, "word_orig": "חָכְמַ֣ת", "strong": "H2451", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Hikmat"}, {"pos": 2, "word_orig": "עָ֭רוּם", "strong": "H6175", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "הָבִ֣ין", "strong": "H995", "morph": "HVhc", "morph_id": "Verba Hifil Imperatif", "ayt_word": "mengerti"}, {"pos": 4, "word_orig": "דַּרְכּ֑/וֹ", "strong": "H1870", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "jalannya"}, {"pos": 5, "word_orig": "וְ/אִוֶּ֖לֶת", "strong": "H200", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kebodohan"}, {"pos": 6, "word_orig": "כְּסִילִ֣ים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "מִרְמָֽה", "strong": "H4820", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tipu"}]}, {"book": 20, "chapter": 14, "verse": 9, "ayat_id": 16782, "title": "", "ayt_text": "Orang bodoh mencemooh kurban penghapus dosa, tetapi di antara orang jujur terdapat perkenanan.", "words": [{"pos": 1, "word_orig": "אֱ֭וִלִים", "strong": "H191", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bodoh"}, {"pos": 2, "word_orig": "יָלִ֣יץ", "strong": "H3887", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencemooh"}, {"pos": 3, "word_orig": "אָשָׁ֑ם", "strong": "H817", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penghapus"}, {"pos": 4, "word_orig": "וּ/בֵ֖ין", "strong": "H996", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "antara"}, {"pos": 5, "word_orig": "יְשָׁרִ֣ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "jujur"}, {"pos": 6, "word_orig": "רָצֽוֹן", "strong": "H7522", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkenanan"}]}, {"book": 20, "chapter": 14, "verse": 10, "ayat_id": 16783, "title": "", "ayt_text": "Hati mengenal kepahitannya sendiri, dan tidak ada orang lain yang turut merasakan sukacitanya.", "words": [{"pos": 1, "word_orig": "לֵ֗ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Hati"}, {"pos": 2, "word_orig": "י֭וֹדֵעַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengenal"}, {"pos": 3, "word_orig": "מָרַּ֣ת", "strong": "H4787", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kepahitannya"}, {"pos": 4, "word_orig": "נַפְשׁ֑/וֹ", "strong": "H5315", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sendiri"}, {"pos": 5, "word_orig": "וּ֝/בְ/שִׂמְחָת֗/וֹ", "strong": "H8057", "morph": "HC/R/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sukacitanya"}, {"pos": 6, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יִתְעָ֥רַב", "strong": "H6148", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "turut"}, {"pos": 8, "word_orig": "זָֽר", "strong": "H2114", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 20, "chapter": 14, "verse": 11, "ayat_id": 16784, "title": "", "ayt_text": "Rumah orang fasik akan dimusnahkan, tetapi kemah orang jujur akan berkembang.", "words": [{"pos": 1, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Rumah"}, {"pos": 2, "word_orig": "רְ֭שָׁעִים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "יִשָּׁמֵ֑ד", "strong": "H8045", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dimusnahkan"}, {"pos": 4, "word_orig": "וְ/אֹ֖הֶל", "strong": "H168", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kemah"}, {"pos": 5, "word_orig": "יְשָׁרִ֣ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "יַפְרִֽיחַ", "strong": "H6524", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berkembang"}]}, {"book": 20, "chapter": 14, "verse": 12, "ayat_id": 16785, "title": "", "ayt_text": "Ada jalan yang disangka benar oleh seseorang, tetapi ujungnya adalah jalan menuju maut.", "words": [{"pos": 1, "word_orig": "יֵ֤שׁ", "strong": "H3426", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Ada"}, {"pos": 2, "word_orig": "דֶּ֣רֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 3, "word_orig": "יָ֭שָׁר", "strong": "H3477", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "לִ/פְנֵי", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "oleh"}, {"pos": 5, "word_orig": "אִ֑ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 6, "word_orig": "וְ֝/אַחֲרִיתָ֗/הּ", "strong": "H319", "morph": "HC/Ncfsc/Sp3fs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "ujungnya"}, {"pos": 7, "word_orig": "דַּרְכֵי", "strong": "H1870", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 8, "word_orig": "מָֽוֶת", "strong": "H4194", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}]}, {"book": 20, "chapter": 14, "verse": 13, "ayat_id": 16786, "title": "", "ayt_text": "Dalam tawa pun hati dapat merana, dan sukacita dapat berakhir dengan dukacita.", "words": [{"pos": 1, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "pun"}, {"pos": 2, "word_orig": "בִּ/שְׂח֥וֹק", "strong": "H7814", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tawa"}, {"pos": 3, "word_orig": "יִכְאַב", "strong": "H3510", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merana"}, {"pos": 4, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 5, "word_orig": "וְ/אַחֲרִיתָ֖/הּ", "strong": "H319", "morph": "HC/Ncfsc/Sp3fs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "berakhir"}, {"pos": 6, "word_orig": "שִׂמְחָ֣ה", "strong": "H8057", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sukacita"}, {"pos": 7, "word_orig": "תוּגָֽה", "strong": "H8424", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "dukacita"}]}, {"book": 20, "chapter": 14, "verse": 14, "ayat_id": 16787, "title": "", "ayt_text": "Orang yang ingkar hatinya akan dikenyangkan dengan jalannya, tetapi orang baik dengan apa yang ada padanya.", "words": [{"pos": 1, "word_orig": "מִ/דְּרָכָ֣י/ו", "strong": "H1870", "morph": "HR/Ncbpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalannya"}, {"pos": 2, "word_orig": "יִ֭שְׂבַּע", "strong": "H7646", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dikenyangkan"}, {"pos": 3, "word_orig": "ס֣וּג", "strong": "H5472", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "yang"}, {"pos": 4, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatinya"}, {"pos": 5, "word_orig": "וּ֝/מֵ/עָלָ֗י/ו", "strong": "H5921", "morph": "HC/R/R/Sp3ms", "morph_id": "Konjungsi (וְ) + Preposisi + Preposisi + Sp3ms", "ayt_word": "padanya"}, {"pos": 6, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 7, "word_orig": "טֽוֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}]}, {"book": 20, "chapter": 14, "verse": 15, "ayat_id": 16788, "title": "", "ayt_text": "Orang naif memercayai segala perkataan, tetapi orang bijak mempertimbangkan langkah-langkahnya.", "words": [{"pos": 1, "word_orig": "פֶּ֭תִי", "strong": "H6612", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "יַאֲמִ֣ין", "strong": "H539", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memercayai"}, {"pos": 3, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 4, "word_orig": "דָּבָ֑ר", "strong": "H1697", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkataan"}, {"pos": 5, "word_orig": "וְ֝/עָר֗וּם", "strong": "H6175", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "יָבִ֥ין", "strong": "H995", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mempertimbangkan"}, {"pos": 7, "word_orig": "לַ/אֲשֻׁרֽ/וֹ", "strong": "H838", "morph": "HR/Ncfsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "langkah-langkahnya"}]}, {"book": 20, "chapter": 14, "verse": 16, "ayat_id": 16789, "title": "", "ayt_text": "Orang berhikmat berhati-hati dan menjauhi kejahatan, tetapi orang bodoh melintasinya dan merasa yakin.", "words": [{"pos": 1, "word_orig": "חָכָ֣ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 2, "word_orig": "יָ֭רֵא", "strong": "H3373", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berhati-hati"}, {"pos": 3, "word_orig": "וְ/סָ֣ר", "strong": "H5493", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menjauhi"}, {"pos": 4, "word_orig": "מֵ/רָ֑ע", "strong": "H7451", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "kejahatan"}, {"pos": 5, "word_orig": "וּ֝/כְסִ֗יל", "strong": "H3684", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "מִתְעַבֵּ֥ר", "strong": "H5674", "morph": "HVtrmsa", "morph_id": "Verba Hitpael", "ayt_word": "melintasinya"}, {"pos": 7, "word_orig": "וּ/בוֹטֵֽחַ", "strong": "H982", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "yakin"}]}, {"book": 20, "chapter": 14, "verse": 17, "ayat_id": 16790, "title": "", "ayt_text": "Seseorang yang cepat marah bertindak bodoh, dan seseorang yang merencanakan kejahatan dibenci.", "words": [{"pos": 1, "word_orig": "קְֽצַר", "strong": "H7116", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "cepat"}, {"pos": 2, "word_orig": "אַ֭פַּיִם", "strong": "H639", "morph": "HNcmda", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Absolut", "ayt_word": "marah"}, {"pos": 3, "word_orig": "יַעֲשֶׂ֣ה", "strong": "H6213", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertindak"}, {"pos": 4, "word_orig": "אִוֶּ֑לֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bodoh"}, {"pos": 5, "word_orig": "וְ/אִ֥ישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "seseorang"}, {"pos": 6, "word_orig": "מְ֝זִמּ֗וֹת", "strong": "H4209", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "seseorang"}, {"pos": 7, "word_orig": "יִשָּׂנֵֽא", "strong": "H8130", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dibenci"}]}, {"book": 20, "chapter": 14, "verse": 18, "ayat_id": 16791, "title": "", "ayt_text": "Orang naif mewarisi kebodohan, tetapi orang bijak bermahkotakan pengetahuan.", "words": [{"pos": 1, "word_orig": "נָחֲל֣וּ", "strong": "H5157", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "mewarisi"}, {"pos": 2, "word_orig": "פְתָאיִ֣ם", "strong": "H6612", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Orang"}, {"pos": 3, "word_orig": "אִוֶּ֑לֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebodohan"}, {"pos": 4, "word_orig": "וַֽ֝/עֲרוּמִ֗ים", "strong": "H6175", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "יַכְתִּ֥רוּ", "strong": "H3803", "morph": "HVhi3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bermahkotakan"}, {"pos": 6, "word_orig": "דָֽעַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 20, "chapter": 14, "verse": 19, "ayat_id": 16792, "title": "", "ayt_text": "Orang jahat tunduk di hadapan orang baik, tetapi orang fasik di depan pintu gerbang orang benar.", "words": [{"pos": 1, "word_orig": "שַׁח֣וּ", "strong": "H7817", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "tunduk"}, {"pos": 2, "word_orig": "רָ֭עִים", "strong": "H7451", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "jahat"}, {"pos": 3, "word_orig": "לִ/פְנֵ֣י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "di"}, {"pos": 4, "word_orig": "טוֹבִ֑ים", "strong": "H2896", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "וּ֝/רְשָׁעִ֗ים", "strong": "H7563", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "עַֽל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 7, "word_orig": "שַׁעֲרֵ֥י", "strong": "H8179", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "pintu"}, {"pos": 8, "word_orig": "צַדִּֽיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}]}, {"book": 20, "chapter": 14, "verse": 20, "ayat_id": 16793, "title": "", "ayt_text": "Orang miskin tidak disukai, bahkan oleh sesamanya, tetapi orang kaya mempunyai banyak sahabat.", "words": [{"pos": 1, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "bahkan"}, {"pos": 2, "word_orig": "לְ֭/רֵעֵ/הוּ", "strong": "H7453", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}, {"pos": 3, "word_orig": "יִשָּׂ֣נֵא", "strong": "H8130", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "disukai"}, {"pos": 4, "word_orig": "רָ֑שׁ", "strong": "H7326", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "miskin"}, {"pos": 5, "word_orig": "וְ/אֹהֲבֵ֖י", "strong": "H157", "morph": "HC/Vqrmpc", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "sahabat"}, {"pos": 6, "word_orig": "עָשִׁ֣יר", "strong": "H6223", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "רַבִּֽים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "banyak"}]}, {"book": 20, "chapter": 14, "verse": 21, "ayat_id": 16794, "title": "", "ayt_text": "Mereka yang menghina sesamanya berbuat dosa, tetapi berbahagialah mereka yang berbelaskasihan kepada orang miskin.", "words": [{"pos": 1, "word_orig": "בָּז", "strong": "H936", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghina"}, {"pos": 2, "word_orig": "לְ/רֵעֵ֥/הוּ", "strong": "H7453", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}, {"pos": 3, "word_orig": "חוֹטֵ֑א", "strong": "H2398", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "dosa"}, {"pos": 4, "word_orig": "וּ/מְחוֹנֵ֖ן", "strong": "H2603", "morph": "HC/Vmrmsa", "morph_id": "Konjungsi (וְ) + Verba", "ayt_word": "berbelaskasihan"}, {"pos": 5, "word_orig": "עניים", "strong": "H6041", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "עֲנָוִ֣ים", "strong": "H6035", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "berbahagialah"}, {"pos": 7, "word_orig": "אַשְׁרָֽי/ו", "strong": "H835", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 14, "verse": 22, "ayat_id": 16795, "title": "", "ayt_text": "Tidakkah mereka yang merencanakan kejahatan itu sesat? Namun, mereka yang merencanakan kebaikan menemukan kasih dan kesetiaan.", "words": [{"pos": 1, "word_orig": "הֲֽ/לוֹא", "strong": "H3808", "morph": "HTi/Tn", "morph_id": "Ti + Tn", "ayt_word": "Tidakkah"}, {"pos": 2, "word_orig": "יִ֭תְעוּ", "strong": "H8582", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "sesat"}, {"pos": 3, "