g": "H7116", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "cepat"}, {"pos": 6, "word_orig": "ר֝֗וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "marah"}, {"pos": 7, "word_orig": "מֵרִ֥ים", "strong": "H7311", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "meninggikan"}, {"pos": 8, "word_orig": "אִוֶּֽלֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebodohan"}]}, {"book": 20, "chapter": 14, "verse": 30, "ayat_id": 16803, "title": "", "ayt_text": "Jiwa yang sehat memberi kehidupan bagi tubuh, tetapi iri hati membuat tulang membusuk.", "words": [{"pos": 1, "word_orig": "חַיֵּ֣י", "strong": "H2416", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "kehidupan"}, {"pos": 2, "word_orig": "בְ֭שָׂרִים", "strong": "H1320", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "tubuh"}, {"pos": 3, "word_orig": "לֵ֣ב", "strong": "H3820", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Jiwa"}, {"pos": 4, "word_orig": "מַרְפֵּ֑א", "strong": "H4832", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sehat"}, {"pos": 5, "word_orig": "וּ/רְקַ֖ב", "strong": "H7538", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "membusuk"}, {"pos": 6, "word_orig": "עֲצָמ֣וֹת", "strong": "H6106", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "tulang"}, {"pos": 7, "word_orig": "קִנְאָֽה", "strong": "H7068", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "iri"}]}, {"book": 20, "chapter": 14, "verse": 31, "ayat_id": 16804, "title": "", "ayt_text": "Dia yang menindas orang miskin menghina Penciptanya, tetapi dia yang berbelaskasihan kepada orang melarat memuliakan Dia.", "words": [{"pos": 1, "word_orig": "עֹ֣שֵֽׁק", "strong": "H6231", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menindas"}, {"pos": 2, "word_orig": "דָּ֭ל", "strong": "H1800", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "חֵרֵ֣ף", "strong": "H2778", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghina"}, {"pos": 4, "word_orig": "עֹשֵׂ֑/הוּ", "strong": "H6213", "morph": "HVqrmsc/Sp3ms", "morph_id": "Verba Qal + Sp3ms", "ayt_word": "Penciptanya"}, {"pos": 5, "word_orig": "וּ֝/מְכַבְּד֗/וֹ", "strong": "H3513", "morph": "HC/Vprmsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Piel + Sp3ms", "ayt_word": "memuliakan"}, {"pos": 6, "word_orig": "חֹנֵ֥ן", "strong": "H2603", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berbelaskasihan"}, {"pos": 7, "word_orig": "אֶבְיֽוֹן", "strong": "H34", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 20, "chapter": 14, "verse": 32, "ayat_id": 16805, "title": "", "ayt_text": "Orang fasik dihempaskan oleh kejahatannya, tetapi orang benar mendapat perlindungan pada saat kematiannya.", "words": [{"pos": 1, "word_orig": "בְּֽ֭/רָעָת/וֹ", "strong": "H7451", "morph": "HR/Ncfsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "יִדָּחֶ֣ה", "strong": "H1760", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dihempaskan"}, {"pos": 3, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatannya"}, {"pos": 4, "word_orig": "וְ/חֹסֶ֖ה", "strong": "H2620", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mendapat"}, {"pos": 5, "word_orig": "בְ/מוֹת֣/וֹ", "strong": "H4194", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kematiannya"}, {"pos": 6, "word_orig": "צַדִּֽיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}]}, {"book": 20, "chapter": 14, "verse": 33, "ayat_id": 16806, "title": "", "ayt_text": "Hikmat tinggal dalam hati orang yang berpengertian, tetapi ia tidak dikenal dalam hati orang bodoh.", "words": [{"pos": 1, "word_orig": "בְּ/לֵ֣ב", "strong": "H3820", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 2, "word_orig": "נָ֭בוֹן", "strong": "H995", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "berpengertian"}, {"pos": 3, "word_orig": "תָּנ֣וּחַ", "strong": "H5117", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "tinggal"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Hikmat"}, {"pos": 5, "word_orig": "וּ/בְ/קֶ֥רֶב", "strong": "H7130", "morph": "HC/R/Ncmsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "dalam"}, {"pos": 6, "word_orig": "כְּ֝סִילִ֗ים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "תִּוָּדֵֽעַ", "strong": "H3045", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "dikenal"}]}, {"book": 20, "chapter": 14, "verse": 34, "ayat_id": 16807, "title": "", "ayt_text": "Kebenaran meninggikan suatu bangsa, tetapi dosa adalah noda bagi bangsa mana pun.", "words": [{"pos": 1, "word_orig": "צְדָקָ֥ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kebenaran"}, {"pos": 2, "word_orig": "תְרֽוֹ