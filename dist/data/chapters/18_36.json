: "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "hidup"}, {"pos": 5, "word_orig": "בַּ/קְּדֵשִֽׁים", "strong": "H6945", "morph": "HRd/Aampa", "morph_id": "Rd + Aampa", "ayt_word": "pelacur"}]}, {"book": 18, "chapter": 36, "verse": 15, "ayat_id": 13752, "title": "", "ayt_text": "Dia menyelamatkan yang menderita dengan penderitaan mereka, dan membuka telinga mereka dengan penindasan.", "words": [{"pos": 1, "word_orig": "יְחַלֵּ֣ץ", "strong": "H2502", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyelamatkan"}, {"pos": 2, "word_orig": "עָנִ֣י", "strong": "H6041", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "menderita"}, {"pos": 3, "word_orig": "בְ/עָנְי֑/וֹ", "strong": "H6040", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "penderitaan"}, {"pos": 4, "word_orig": "וְ/יִ֖גֶל", "strong": "H1540", "morph": "HC/Vqi3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuka"}, {"pos": 5, "word_orig": "בַּ/לַּ֣חַץ", "strong": "H3906", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penindasan"}, {"pos": 6, "word_orig": "אָזְנָֽ/ם", "strong": "H241", "morph": "HNcfsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "telinga"}]}, {"book": 18, "chapter": 36, "verse": 16, "ayat_id": 13753, "title": "", "ayt_text": "Pasti, Dia akan membujukmu keluar dari kesesakan, menuju tempat yang luas, tanpa kekangan, dan apa yang disiapkan di atas mejamu penuh dengan lemak.", "words": [{"pos": 1, "word_orig": "וְ/אַ֤ף", "strong": "H637", "morph": "HC/D", "morph_id": "Konjungsi (וְ) + Adverbia", "ayt_word": "Pasti"}, {"pos": 2, "word_orig": "הֲסִיתְ/ךָ֨", "strong": "H5496", "morph": "HVhp3ms/Sp2ms", "morph_id": "Verba Hifil Perf