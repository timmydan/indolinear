Aamsa", "ayt_word": "kemakmuran"}, {"pos": 7, "word_orig": "וּ֝/שְׁנֵי/הֶ֗ם", "strong": "H8141", "morph": "HC/Acmdc/Sp3mp", "morph_id": "Konjungsi (וְ) + Acmdc + Sp3mp", "ayt_word": "tahun-tahun"}, {"pos": 8, "word_orig": "בַּ/נְּעִימִֽים", "strong": "H5273", "morph": "HRd/Aampa", "morph_id": "Rd + Aampa", "ayt_word": "kesenangan"}]}, {"book": 18, "chapter": 36, "verse": 12, "ayat_id": 13749, "title": "", "ayt_text": "Akan tetapi, jika mereka tidak mendengarkan, mereka akan mati oleh pedang, dan binasa tanpa pengetahuan.", "words": [{"pos": 1, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 2, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "יִ֭שְׁמְעוּ", "strong": "H8085", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mendengarkan"}, {"pos": 4, "word_orig": "בְּ/שֶׁ֣לַח", "strong": "H7973", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 5, "word_orig": "יַעֲבֹ֑רוּ", "strong": "H5674", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mati"}, {"pos": 6, "word_orig": "וְ֝/יִגְוְע֗וּ", "strong": "H1478", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "binasa"}, {"pos": 7, "word_orig": "כִּ/בְלִי", "strong": "H1097", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "tanpa"}, {"pos": 8, "word_orig": "דָֽעַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 18, "chapter": 36, "verse": 13, "ayat_id": 13750, "title": "", "ayt_text": "Orang yang hatinya fasik menyimpan kemarahan di dalam hati; mereka tidak berseru minta tolong ketika Dia membelenggu mereka.", "words": [{"pos": 