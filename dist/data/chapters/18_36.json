[{"book": 18, "chapter": 36, "verse": 1, "ayat_id": 13738, "title": "", "ayt_text": "Lalu, Elihu kembali berkata,", "words": [{"pos": 1, "word_orig": "וַ/יֹּ֥סֶף", "strong": "H3254", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kembali"}, {"pos": 2, "word_orig": "אֱלִיה֗וּא", "strong": "H453", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Elihu"}, {"pos": 3, "word_orig": "וַ/יֹּאמַֽר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berkata"}]}, {"book": 18, "chapter": 36, "verse": 2, "ayat_id": 13739, "title": "", "ayt_text": "“Bersabarlah denganku sebentar, dan aku akan menunjukkan kepadamu, karena masih ada lagi yang harus kukatakan atas nama Allah.", "words": [{"pos": 1, "word_orig": "כַּתַּר", "strong": "H3803", "morph": "HVpv2ms", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Bersabarlah"}, {"pos": 2, "word_orig": "לִ֣/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "זְ֭עֵיר", "strong": "H2191", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sebentar"}, {"pos": 4, "word_orig": "וַ/אֲחַוֶּ֑/ךָּ", "strong": "H2331", "morph": "HC/Vpi1cs/Sp2ms", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-1 Tunggal + Sp2ms", "ayt_word": "menunjukkan"}, {"pos": 5, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "ע֖וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lagi"}, {"pos": 7, "word_orig": "לֶ/אֱל֣וֹהַּ", "strong": "H433", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 8, "word_orig": "מִלִּֽים", "strong": "H4405", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kukatakan"}]}, {"book": 18, "chapter": 36, "verse": 3, "ayat_id": 13740, "title": "", "ayt_text": "Aku akan memperoleh pengetahuanku dari jauh, dan membenarkan Penciptaku.", "words": [{"pos": 1, "word_orig": "אֶשָּׂ֣א", "strong": "H5375", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "memperoleh"}, {"pos": 2, "word_orig": "דֵ֭עִ/י", "strong": "H1843", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "pengetahuanku"}, {"pos": 3, "word_orig": "לְ/מֵ/רָח֑וֹק", "strong": "H7350", "morph": "HR/R/Aamsa", "morph_id": "Preposisi + Preposisi + Aamsa", "ayt_word": "jauh"}, {"pos": 4, "word_orig": "וּ֝/לְ/פֹעֲלִ֗/י", "strong": "H6466", "morph": "HC/R/Vqrmsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Preposisi + Verba Qal + Sp1cs", "ayt_word": "Penciptaku"}, {"pos": 5, "word_orig": "אֶֽתֵּֽן", "strong": "H5414", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "membenarkan"}, {"pos": 6, "word_orig": "צֶֽדֶק", "strong": "H6664", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "membenarkan"}]}, {"book": 18, "chapter": 36, "verse": 4, "ayat_id": 13741, "title": "", "ayt_text": "Sebab, sebenarnya, perkataanku tidak salah; seorang yang sempurna pengetahuannya ada bersamamu.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "אָ֭מְנָם", "strong": "H551", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "sebenarnya"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "שֶׁ֣קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "salah"}, {"pos": 5, "word_orig": "מִלָּ֑/י", "strong": "H4405", "morph": "HNcfpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "perkataanku"}, {"pos": 6, "word_orig": "תְּמִ֖ים", "strong": "H8549", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "sempurna"}, {"pos": 7, "word_orig": "דֵּע֣וֹת", "strong": "H1844", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "pengetahuannya"}, {"pos": 8, "word_orig": "עִמָּֽ/ךְ", "strong": "H5973", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "bersamamu"}]}, {"book": 18, "chapter": 36, "verse": 5, "ayat_id": 13742, "title": "", "ayt_text": "Lihat, Allah itu perkasa, dan Dia tidak merendahkan siapa pun. Dia perkasa dalam kekuatan akal budi-Nya.", "words": [{"pos": 1, "word_orig": "הֶן", "strong": "H2005", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "אֵ֣ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "כַּ֭בִּיר", "strong": "H3524", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "perkasa"}, {"pos": 4, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "יִמְאָ֑ס", "strong": "H3988", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merendahkan"}, {"pos": 6, "word_orig": "כַּ֝בִּ֗יר", "strong": "H3524", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "perkasa"}, {"pos": 7, "word_orig": "כֹּ֣חַֽ", "strong": "H3581", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kekuatan"}, {"pos": 8, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "budi-Nya"}]}, {"book": 18, "chapter": 36, "verse": 6, "ayat_id": 13743, "title": "", "ayt_text": "Dia tidak akan membiarkan orang fasik hidup, tetapi memberikan keadilan kepada orang yang tertindas.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יְחַיֶּ֥ה", "strong": "H2421", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "hidup"}, {"pos": 3, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 4, "word_orig": "וּ/מִשְׁפַּ֖ט", "strong": "H4941", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keadilan"}, {"pos": 5, "word_orig": "עֲנִיִּ֣ים", "strong": "H6041", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "yang"}, {"pos": 6, "word_orig": "יִתֵּֽן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberikan"}]}, {"book": 18, "chapter": 36, "verse": 7, "ayat_id": 13744, "title": "", "ayt_text": "Dia tidak menarik pandangan-Nya dari orang benar, tetapi bersama para raja di atas takhta, Dia mendudukkan mereka selamanya, dan mereka ditinggikan.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יִגְרַ֥ע", "strong": "H1639", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menarik"}, {"pos": 3, "word_orig": "מִ/צַּדִּ֗יק", "strong": "H6662", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "עֵ֫ינָ֥י/ו", "strong": "H5869", "morph": "HNcbdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "pandangan-Nya"}, {"pos": 5, "word_orig": "וְ/אֶת", "strong": "H854", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "bersama"}, {"pos": 6, "word_orig": "מְלָכִ֥ים", "strong": "H4428", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja"}, {"pos": 7, "word_orig": "לַ/כִּסֵּ֑א", "strong": "H3678", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "takhta"}, {"pos": 8, "word_orig": "וַ/יֹּשִׁיבֵ֥/ם", "strong": "H3427", "morph": "HC/Vhw3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "mendudukkan"}, {"pos": 9, "word_orig": "לָ֝/נֶ֗צַח", "strong": "H5331", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}, {"pos": 10, "word_orig": "וַ/יִּגְבָּֽהוּ", "strong": "H1361", "morph": "HC/Vqw3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "ditinggikan"}]}, {"book": 18, "chapter": 36, "verse": 8, "ayat_id": 13745, "title": "", "ayt_text": "Akan tetapi, jika mereka dibelenggu dengan rantai, dan ditangkap dengan tali-tali penderitaan,", "words": [{"pos": 1, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 2, "word_orig": "אֲסוּרִ֥ים", "strong": "H631", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "dibelenggu"}, {"pos": 3, "word_orig": "בַּ/זִּקִּ֑ים", "strong": "H2131", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "rantai"}, {"pos": 4, "word_orig": "יִ֝לָּכְד֗וּ/ן", "strong": "H3920", "morph": "HVNi3mp/Sn", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak + Sn", "ayt_word": "ditangkap"}, {"pos": 5, "word_orig": "בְּ/חַבְלֵי", "strong": "H2256", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "tali-tali"}, {"pos": 6, "word_orig": "עֹֽנִי", "strong": "H6040", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penderitaan"}]}, {"book": 18, "chapter": 36, "verse": 9, "ayat_id": 13746, "title": "", "ayt_text": "Dia memberi tahu mereka tentang perbuatan mereka dan pelanggaran-pelanggaran mereka, bahwa mereka telah berlaku sombong.", "words": [{"pos": 1, "word_orig": "וַ/יַּגֵּ֣ד", "strong": "H5046", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "tahu"}, {"pos": 2, "word_orig": "לָ/הֶ֣ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": "mereka"}, {"pos": 3, "word_orig": "פָּעֳלָ֑/ם", "strong": "H6467", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "perbuatan"}, {"pos": 4, "word_orig": "וּ֝/פִשְׁעֵי/הֶ֗ם", "strong": "H6588", "morph": "HC/Ncmpc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "pelanggaran-pelanggaran"}, {"pos": 5, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "bahwa"}, {"pos": 6, "word_orig": "יִתְגַּבָּֽרוּ", "strong": "H1396", "morph": "HVti3mp", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "sombong"}]}, {"book": 18, "chapter": 36, "verse": 10, "ayat_id": 13747, "title": "", "ayt_text": "Dia membuka telinga mereka bagi teguran, dan memerintahkan agar mereka berbalik dari kejahatan.", "words": [{"pos": 1, "word_orig": "וַ/יִּ֣גֶל", "strong": "H1540", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuka"}, {"pos": 2, "word_orig": "אָ֭זְנָ/ם", "strong": "H241", "morph": "HNcfsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "telinga"}, {"pos": 3, "word_orig": "לַ/מּו