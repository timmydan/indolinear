": "kata-kata"}, {"pos": 4, "word_orig": "הֱ֝צִיקַ֗תְ/נִי", "strong": "H6693", "morph": "HVhp3fs/Sp1cs", "morph_id": "Verba Hifil Perfek Orang ke-3 Perempuan Tunggal + Sp1cs", "ayt_word": "mendesakku"}, {"pos": 5, "word_orig": "ר֣וּחַ", "strong": "H7307", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "semangat"}, {"pos": 6, "word_orig": "בִּטְנִֽ/י", "strong": "H990", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "di"}]}, {"book": 18, "chapter": 32, "verse": 19, "ayat_id": 13648, "title": "", "ayt_text": "Lihat, perutku seperti anggur yang belum dibuka, seperti kirbat anggur baru yang siap pecah.", "words": [{"pos": 1, "word_orig": "הִנֵּֽה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "בִטְנִ֗/י", "strong": "H990", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "perutku"}, {"pos": 3, "word_orig": "כְּ/יַ֥יִן", "strong": "H3196", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 4, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "belum"}, {"pos": 5, "word_orig": "יִפָּתֵ֑חַ", "strong": "H6605", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dibuka"}, {"pos": 6, "word_orig": "כְּ/אֹב֥וֹת", "strong": "H178", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kirbat"}, {"pos": 7, "word_orig": "חֲ֝דָשִׁ֗ים", "strong": "H2319", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "baru"}, {"pos": 8, "word_orig": "יִבָּקֵֽעַ", "strong": "H1234", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "pecah"}]}, {"book": 18, "chapter": 32, 