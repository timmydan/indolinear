": 1, "verse": 8, "ayat_id": 22849, "title": "", "ayt_text": "Naiklah ke gunung, bawalah kayu, dan bangunlah Bait itu, maka Aku akan berkenan atasnya dan Aku akan dimuliakan,’ firman Tuhan.", "words": [{"pos": 1, "word_orig": "עֲל֥וּ", "strong": "H5927", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Naiklah"}, {"pos": 2, "word_orig": "הָ/הָ֛ר", "strong": "H2022", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "gunung"}, {"pos": 3, "word_orig": "וַ/הֲבֵאתֶ֥ם", "strong": "H935", "morph": "HC/Vhq2mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Orang ke-2 Laki-laki Jamak", "ayt_word": "bawalah"}, {"pos": 4, "word_orig": "עֵ֖ץ", "strong": "H6086", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kayu"}, {"pos": 5, "word_orig": "וּ/בְנ֣וּ", "strong": "H1129", "morph": "HC/Vqv2mp", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "bangunlah"}, {"pos": 6, "word_orig": "הַ/בָּ֑יִת", "strong": "H1004", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Bait"}, {"pos": 7, "word_orig": "וְ/אֶרְצֶה", "strong": "H7521", "morph": "HC/Vqi1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "berkenan"}, {"pos": 8, "word_orig": "בּ֥/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "Aku"}, {"pos": 9, "word_orig": "ו/אכבד", "strong": "H3513", "morph": "HC/VNi1cs", "morph_id": "Konjungsi (וְ) + Verba Nifal Imperfek Orang ke-1 Tunggal", "ayt_word": "dimuliakan"}, {"pos": 10, "word_orig": "וְ/אֶכָּבְדָ֖ה", "strong": "H3513", "morph": "HC/VNh1cs", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-1 Tunggal", "ayt_word": "firman"}, {"pos": 11, "word_orig": "אָמַ֥ר", "strong": "H559", "morph": "HVqp3ms", "morph_id": "Verba Qa