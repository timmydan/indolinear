[{"book": 2, "chapter": 24, "verse": 1, "ayat_id": 2179, "title": "Perjanjian TUHAN dengan Bangsa Israel", "ayt_text": "Kemudian, Dia berfirman kepada Musa, “Naiklah ke hadapan TUHAN, kamu, Harun, Nadab, Abihu, dan tujuh puluh tua-tua Israel, dan bersujudlah dari kejauhan.", "words": [{"pos": 1, "word_orig": "וְ/אֶל", "strong": "H413", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "kepada"}, {"pos": 2, "word_orig": "מֹשֶׁ֨ה", "strong": "H4872", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Musa"}, {"pos": 3, "word_orig": "אָמַ֜ר", "strong": "H559", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berfirman"}, {"pos": 4, "word_orig": "עֲלֵ֣ה", "strong": "H5927", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Naiklah"}, {"pos": 5, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 6, "word_orig": "יְהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "אַתָּה֙", "strong": "H859", "morph": "HPp2ms", "morph_id": "Pp2ms", "ayt_word": "kamu"}, {"pos": 8, "word_orig": "וְ/אַהֲרֹן֙", "strong": "H175", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Harun"}, {"pos": 9, "word_orig": "נָדָ֣ב", "strong": "H5070", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Nadab"}, {"pos": 10, "word_orig": "וַ/אֲבִיה֔וּא", "strong": "H30", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Abihu"}, {"pos": 11, "word_orig": "וְ/שִׁבְעִ֖ים", "strong": "H7657", "morph": "HC/Acbpa", "morph_id": "Konjungsi (וְ) + Acbpa", "ayt_word": "tujuh"}, {"pos": 12, "word_orig": "מִ/זִּקְנֵ֣י", "strong": "H2205", "morph": "HR/Aampc", "morph_id": "Preposisi + Aampc", "ayt_word": "tua-tua"}, {"pos": 13, "word_orig": "יִשְׂרָאֵ֑ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_w