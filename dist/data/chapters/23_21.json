[{"book": 23, "chapter": 21, "verse": 1, "ayat_id": 18037, "title": "Nubuat tentang Babel", "ayt_text": "Inilah pesan ilahi tentang “padang belantara di tepi laut”: Seperti angin puting beliung melintasi tanah Negeb, demikianlah datangnya dari padang belantara, dari negeri yang mengerikan.", "words": [{"pos": 1, "word_orig": "מַשָּׂ֖א", "strong": "H4853", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "ilahi"}, {"pos": 2, "word_orig": "מִדְבַּר", "strong": "H4057", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "belantara"}, {"pos": 3, "word_orig": "יָ֑ם", "strong": "H3220", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laut"}, {"pos": 4, "word_orig": "כְּ/סוּפ֤וֹת", "strong": "H5492", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "angin"}, {"pos": 5, "word_orig": "בַּ/נֶּ֨גֶב֙", "strong": "H5045", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tanah"}, {"pos": 6, "word_orig": "לַֽ/חֲלֹ֔ף", "strong": "H2498", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melintasi"}, {"pos": 7, "word_orig": "מִ/מִּדְבָּ֣ר", "strong": "H4057", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "padang"}, {"pos": 8, "word_orig": "בָּ֔א", "strong": "H935", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "datangnya"}, {"pos": 9, "word_orig": "מֵ/אֶ֖רֶץ", "strong": "H776", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}, {"pos": 10, "word_orig": "נוֹרָאָֽה", "strong": "H3372", "morph": "HVNrfsa", "morph_id": "Verba Nifal", "ayt_word": "mengerikan"}]}, {"book": 23, "chapter": 21, "verse": 2, "ayat_id": 18038, "title": "", "ayt_text": "Suatu penglihatan yang sukar telah ditunjukkan kepadaku: Orang yang berkhianat akan melakukan pengkhianatan. Para perampok akan merampok. Majulah, hai Elam! Kepunglah, hai Madai! Aku akan menghentikan segala keluh kesah yang ditimbulkannya.", "words": [{"pos": 1, "word_orig": "חָז֥וּת", "strong": "H2380", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "penglihatan"}, {"pos": 2, "word_orig": "קָשָׁ֖ה", "strong": "H7186", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "sukar"}, {"pos": 3, "word_orig": "הֻגַּד", "strong": "H5046", "morph": "HVHp3ms", "morph_id": "Verba Piel", "ayt_word": "ditunjukkan"}, {"pos": 4, "word_orig": "לִ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 5, "word_orig": "הַ/בּוֹגֵ֤ד", "strong": "H898", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "berkhianat"}, {"pos": 6, "word_orig": "בּוֹגֵד֙", "strong": "H898", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 7, "word_orig": "וְ/הַ/שּׁוֹדֵ֣ד", "strong": "H7703", "morph": "HC/Td/Vqrmsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Verba Qal", "ayt_word": "perampok"}, {"pos": 8, "word_orig": "שׁוֹדֵ֔ד", "strong": "H7703", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "merampok"}, {"pos": 9, "word_orig": "עֲלִ֤י", "strong": "H5927", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Majulah"}, {"pos": 10, "word_orig": "עֵילָם֙", "strong": "H5867", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Elam"}, {"pos": 11, "word_orig": "צוּרִ֣י", "strong": "H6696", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Kepunglah"}, {"pos": 12, "word_orig": "מָדַ֔י", "strong": "H4074", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Madai"}, {"pos"