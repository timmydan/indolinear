[{"book": 20, "chapter": 24, "verse": 1, "ayat_id": 17081, "title": "--19--", "ayt_text": "Jangan iri hati terhadap orang fasik; jangan berkeinginan untuk bergaul dengan mereka.", "words": [{"pos": 1, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Jangan"}, {"pos": 2, "word_orig": "תְּ֭קַנֵּא", "strong": "H7065", "morph": "HVpj2ms", "morph_id": "Verba Piel Orang ke-2 Laki-laki Tunggal", "ayt_word": "iri"}, {"pos": 3, "word_orig": "בְּ/אַנְשֵׁ֣י", "strong": "H376", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 4, "word_orig": "רָעָ֑ה", "strong": "H7451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "fasik"}, {"pos": 5, "word_orig": "וְ/אַל", "strong": "H408", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "jangan"}, {"pos": 6, "word_orig": "תתאו", "strong": "H183", "morph": "HVtj2ms", "morph_id": "Verba Hitpael Orang ke-2 Laki-laki Tunggal", "ayt_word": "berkeinginan"}, {"pos": 7, "word_orig": "תִּ֝תְאָ֗יו", "strong": "H183", "morph": "HVtj2ms", "morph_id": "Verba Hitpael Orang ke-2 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 8, "word_orig": "לִ/הְי֥וֹת", "strong": "H1961", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "dengan"}, {"pos": 9, "word_orig": "אִתָּֽ/ם", "strong": "H854", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 20, "chapter": 24, "verse": 2, "ayat_id": 17082, "title": "", "ayt_text": "Sebab, hati mereka memikirkan kekejaman, dan bibir mereka membicarakan keonaran.", "words": [{"pos": 1, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "שֹׁ֭ד", "strong": "H7701", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekejaman"}, {"pos": 3, "word_orig": "יֶהְגֶּ֣ה", "strong": "H1897", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memikirkan"}, {"pos": 4, "word_orig": "לִבָּ֑/ם", "strong": "H3820", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "hati"}, {"pos": 5, "word_orig": "וְ֝/עָמָ֗ל", "strong": "H5999", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "keonaran"}, {"pos": 6, "word_orig": "שִׂפְתֵי/הֶ֥ם", "strong": "H8193", "morph": "HNcfdc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3mp", "ayt_word": "bibir"}, {"pos": 7, "word_orig": "תְּדַבֵּֽרְנָה", "strong": "H1696", "morph": "HVpi3fp", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "membicarakan"}]}, {"book": 20, "chapter": 24, "verse": 3, "ayat_id": 17083, "title": "--20--", "ayt_text": "Dengan hikmat, rumah dibangun, dan dengan pengertian, ia ditegakkan;", "words": [{"pos": 1, "word_orig": "בְּ֭/חָכְמָה", "strong": "H2451", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 2, "word_orig": "יִבָּ֣נֶה", "strong": "H1129", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dibangun"}, {"pos": 3, "word_orig": "בָּ֑יִת", "strong": "H1004", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rumah"}, {"pos": 4, "word_orig": "וּ֝/בִ/תְבוּנָ֗ה", "strong": "H8394", "morph": "HC/R/Ncfsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 5, "word_orig": "יִתְכּוֹנָֽן", "strong": "H3559", "morph": "HVri3ms", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ditegakkan"}]}, {"book": 20, "chapter": 24, "verse": 4, "ayat_id": 17084, "title": "", "ayt_text": "dengan pengetahuan, kamar-kamar diisi dengan segala harta benda yang berharga dan indah.", "words": [{"pos": 1, "word_orig": "וּ֭/בְ/דַעַת", "strong": "H1847", "morph": "HC/R/Ncfsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 2, "word_orig": "חֲדָרִ֣ים", "strong": "H2315", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kamar-kamar"}, {"pos": 3, "word_orig": "יִמָּלְא֑וּ", "strong": "H4390", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "diisi"}, {"pos": 4, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 5, "word_orig": "ה֖וֹן", "strong": "H1952", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "benda"}, {"pos": 6, "word_orig": "יָקָ֣ר", "strong": "H3368", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berharga"}, {"pos": 7, "word_orig": "וְ/נָעִֽים", "strong": "H5273", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "indah"}]}, {"book": 20, "chapter": 24, "verse": 5, "ayat_id": 17085, "title": "--21--", "ayt_text": "Orang yang berhikmat memiliki kekuatan, dan orang yang berpengetahuan menambah kekuatannya.", "words": [{"pos": 1, "word_orig": "גֶּֽבֶר", "strong": "H1397", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "חָכָ֥ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 3, "word_orig": "בַּ/ע֑וֹז", "strong": "H5797", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatan"}, {"pos": 4, "word_orig": "וְ/אִֽישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 5, "word_orig": "דַּ֝֗עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berpengetahuan"}, {"pos": 6, "word_orig": "מְאַמֶּץ", "strong": "H553", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menambah"}, {"pos": 7, "word_orig": "כֹּֽחַ", "strong": "H3581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatannya"}]}, {"book": 20, "chapter": 24, "verse": 6, "ayat_id": 17086, "title": "", "ayt_text": "Sebab, dengan nasihat yang bijak, kamu dapat melakukan peperangan, dan dalam melimpahnya penasihat, ada kemenangan.", "words": [{"pos": 1, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "בְ֭/תַחְבֻּלוֹת", "strong": "H8458", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "bijak"}, {"pos": 3, "word_orig": "תַּעֲשֶׂה", "strong": "H6213", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "melakukan"}, {"pos": 4, "word_orig": "לְּ/ךָ֣", "strong": "", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": ""}, {"pos": 5, "word_orig": "מִלְחָמָ֑ה", "strong": "H4421", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "peperangan"}, {"pos": 6, "word_orig": "וּ֝/תְשׁוּעָ֗ה", "strong": "H8668", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemenangan"}, {"pos": 7, "word_orig": "בְּ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "melimpahnya"}, {"pos": 8, "word_orig": "יוֹעֵֽץ", "strong": "H3289", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "penasihat"}]}, {"book": 20, "chapter": 24, "verse": 7, "ayat_id": 17087, "title": "--22--", "ayt_text": "Kebijaksanaan itu terlalu tinggi bagi orang bodoh; di pintu gerbang, dia tidak membuka mulutnya.", "words": [{"pos": 1, "word_orig": "רָאמ֣וֹת", "strong": "H7311", "morph": "HVqrfpa", "morph_id": "Verba Qal", "ayt_word": "tinggi"}, {"pos": 2, "word_orig": "לֶֽ/אֱוִ֣יל", "strong": "H191", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "חָכְמ֑וֹת", "strong": "H2454", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Kebijaksanaan"}, {"pos": 4, "word_orig": "בַּ֝/שַּׁ֗עַר", "strong": "H8179", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pintu"}, {"pos": 5, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יִפְתַּח", "strong": "H6605", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuka"}, {"pos": 7, "word_orig": "פִּֽי/הוּ", "strong": "H6310", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulutnya"}]}, {"book": 20, "chapter": 24, "verse": 8, "ayat_id": 17088, "title": "--23--", "ayt_text": "Siapa merencanakan kejahatan akan disebut penipu.", "words": [{"pos": 1, "word_orig": "מְחַשֵּׁ֥ב", "strong": "H2803", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "merencanakan"}, {"pos": 2, "word_orig": "לְ/הָרֵ֑עַ", "strong": "H7489", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "kejahatan"}, {"pos": 3, "word_orig": "ל֝֗/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 4, "word_orig": "בַּֽעַל", "strong": "H1167", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "penipu"}, {"pos": 5, "word_orig": "מְזִמּ֥וֹת", "strong": "H4209", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "penipu"}, {"pos": 6, "word_orig": "יִקְרָֽאוּ", "strong": "H7121", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "disebut"}]}, {"book": 20, "chapter": 24, "verse": 9, "ayat_id": 17089, "title": "", "ayt_text": "Merancangkan kebodohan adalah dosa, dan pencemooh adalah suatu kekejian bagi manusia.", "words": [{"pos": 1, "word_orig": "זִמַּ֣ת", "strong": "H2154", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Merancangkan"}, {"pos": 2, "word_orig": "אִוֶּ֣לֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebodohan"}, {"pos": 3, "word_orig": "חַטָּ֑את", "strong": "H2403", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "dosa"}, {"pos": 4, "word_orig": "וְ/תוֹעֲבַ֖ת", "strong": "H8441", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 5, "word_orig": "לְ/אָדָ֣ם", "strong": "H120", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 6, "word_orig": "לֵֽץ", "strong": "H3887", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pencemooh"}]}, {"book": 20, "chapter": 24, "verse": 10, "ayat_id": 17090, "title": "--24--", "ayt_text": "Jika kamu lemah pada hari kesukaran, kecillah kekuatanmu.", "words": [{"pos": 1, "word_orig": "הִ֭תְרַפִּיתָ", "strong": "H7503", "morph": "HVtp2ms", "morph_id": "Verba Hitpael Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "lemah"}, {"pos": 2, "word_orig": "בְּ/י֥וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Lak