erse": 25, "ayat_id": 17105, "title": "", "ayt_text": "Akan tetapi, mereka yang menegur akan merasa senang, dan berkat kebaikan akan menghampiri mereka.", "words": [{"pos": 1, "word_orig": "וְ/לַ/מּוֹכִיחִ֥ים", "strong": "H3198", "morph": "HC/Rd/Vhrmpa", "morph_id": "Konjungsi (וְ) + Rd + Verba Hifil", "ayt_word": "menegur"}, {"pos": 2, "word_orig": "יִנְעָ֑ם", "strong": "H5276", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "senang"}, {"pos": 3, "word_orig": "וַֽ֝/עֲלֵי/הֶ֗ם", "strong": "H5921", "morph": "HC/R/Sp3mp", "morph_id": "Konjungsi (וְ) + Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 4, "word_orig": "תָּב֥וֹא", "strong": "H935", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menghampiri"}, {"pos": 5, "word_orig": "בִרְכַּת", "strong": "H1293", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "berkat"}, {"pos": 6, "word_orig": "טֽוֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}]}, {"book": 20, "chapter": 24, "verse": 26, "ayat_id": 17106, "title": "", "ayt_text": "Siapa memberi jawaban jujur mengecup bibir.", "words": [{"pos": 1, "word_orig": "שְׂפָתַ֥יִם", "strong": "H8193", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "bibir"}, {"pos": 2, "word_orig": "יִשָּׁ֑ק", "strong": "H5401", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengecup"}, {"pos": 3, "word_orig": "מֵ֝שִׁ֗יב", "strong": "H7725", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memberi"}, {"pos": 4, "word_orig": "דְּבָרִ֥ים", "strong": "H1697", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "jawaban"}, {"pos": 5, "word_orig": "נְכֹחִֽים", "strong": "H5228", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "jujur"}]}, {"book": 20, 