chapter": 31, "verse": 2, "ayat_id": 18253, "title": "", "ayt_text": "Akan tetapi, Dia bijaksana dan akan mendatangkan bencana. Dia tidak akan menarik kembali firman-Nya. Dia akan bangkit melawan keluarga penjahat dan melawan penolong para pelaku kejahatan.", "words": [{"pos": 1, "word_orig": "וְ/גַם", "strong": "H1571", "morph": "HC/Ta", "morph_id": "Konjungsi (וְ) + Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "ה֤וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "Dia"}, {"pos": 3, "word_orig": "חָכָם֙", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bijaksana"}, {"pos": 4, "word_orig": "וַ/יָּ֣בֵא", "strong": "H935", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendatangkan"}, {"pos": 5, "word_orig": "רָ֔ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bencana"}, {"pos": 6, "word_orig": "וְ/אֶת", "strong": "H853", "morph": "HC/To", "morph_id": "Konjungsi (וְ) + Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "דְּבָרָ֖י/ו", "strong": "H1697", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "firman-Nya"}, {"pos": 8, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "הֵסִ֑יר", "strong": "H5493", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menarik"}, {"pos": 10, "word_orig": "וְ/קָם֙", "strong": "H6965", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "bangkit"}, {"pos": 11, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "melawan"}, {"pos": 12, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keluarga"}, {"pos": 13, "word_orig": "מְרֵעִ֔ים", "strong": "H7489", "morph": "HVhrmpa", "morph_id": "Verba Hifil", "ayt_word": "penjahat"}, {"pos": 14, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "melawan"}, {"pos": 15, "word_orig": "עֶזְרַ֖ת", "strong": "H5833", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "penolong"}, {"pos": 16, "word_orig": "פֹּ֥עֲלֵי", "strong": "H6466", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "pelaku"}, {"pos": 17, "word_orig": "אָֽוֶן", "strong": "H205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kejahatan"}]}, {"book": 23, "chapter": 31, "verse": 3, "ayat_id": 18254, "title": "", "ayt_text": "Orang-orang Mesir hanyalah manusia, bukan Allah. Kuda-kuda mereka hanyalah daging, bukan roh. Jika TUHAN merentangkan tangan-Nya, penolong itu akan tersandung dan orang yang ditolong akan terjatuh. Mereka semua akan binasa bersama-sama.", "words": [{"pos": 1, "word_orig": "וּ/מִצְרַ֤יִם", "strong": "H4714", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Mesir"}, {"pos": 2, "word_orig": "אָדָם֙", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 3, "word_orig": "וְֽ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "bukan"}, {"pos": 4, "word_orig": "אֵ֔ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "וְ/סוּסֵי/הֶ֥ם", "strong": "H5483", "morph": "HC/Ncmpc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "Kuda-kuda"}, {"pos": 6, "word_orig": "בָּשָׂ֖ר", "strong": "H1320", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki