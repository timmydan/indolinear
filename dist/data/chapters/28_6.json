1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghilang"}]}, {"book": 28, "chapter": 6, "verse": 5, "ayat_id": 22173, "title": "", "ayt_text": "Oleh sebab itu, Aku telah memotong mereka melalui para nabi, Aku telah membunuh mereka dengan perkataan dari mulut-Ku, dan penghukuman-Ku menembus seperti cahaya.", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Oleh"}, {"pos": 2, "word_orig": "כֵּ֗ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "itu"}, {"pos": 3, "word_orig": "חָצַ֨בְתִּי֙", "strong": "H2672", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "memotong"}, {"pos": 4, "word_orig": "בַּ/נְּבִיאִ֔ים", "strong": "H5030", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "nabi"}, {"pos": 5, "word_orig": "הֲרַגְתִּ֖י/ם", "strong": "H2026", "morph": "HVqp1cs/Sp3mp", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "membunuh"}, {"pos": 6, "word_orig": "בְּ/אִמְרֵי", "strong": "H561", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "perkataan"}, {"pos": 7, "word_orig": "פִ֑/י", "strong": "H6310", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "mulut-Ku"}, {"pos": 8, "word_orig": "וּ/מִשְׁפָּטֶ֖י/ךָ", "strong": "H4941", "morph": "HC/Ncmpc/Sp2ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "penghukuman-Ku"}, {"pos": 9, "word_orig": "א֥וֹר", "strong": "H216", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "cahaya"}, {"pos": 10, "word_orig": "יֵצֵֽא", "strong": "H3318", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menembus"}]}, {"book": 28, "chapter": 6, "verse": 6, "ayat_id": 22174, "title": "", "ayt_text": "Sebab, Aku menginginkan kesetiaan, bukan kurban, dan pengenalan akan Allah, bukan kurban-kurban bakaran.", "words": [{"pos": 1, "word_orig": "כִּ֛י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "חֶ֥סֶד", "strong": "H2617", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesetiaan"}, {"pos": 3, "word_orig": "חָפַ֖צְתִּי", "strong": "H2654", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "menginginkan"}, {"pos": 4, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "bukan"}, {"pos": 5, "word_orig": "זָ֑בַח", "strong": "H2077", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kurban"}, {"pos": 6, "word_orig": "וְ/דַ֥עַת", "strong": "H1847", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "pengenalan"}, {"pos": 7, "word_orig": "אֱלֹהִ֖ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 8, "word_orig": "מֵ/עֹלֽוֹת", "strong": "H5930", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "bakaran"}]}, {"book": 28, "chapter": 6, "verse": 7, "ayat_id": 22175, "title": "Efraim Tidak Bertobat", "ayt_text": "Namun, seperti Adam, mereka melanggar perjanjian. Di sana, mereka berlaku dengan tidak setia terhadap Aku.", "words": [{"pos": 1, "word_orig": "וְ/הֵ֕מָּה", "strong": "H1992", "morph": "HC/Pp3mp", "morph_id": "Konjungsi (וְ) + Pp3mp", "ayt_word": "mereka"}, {"pos": 2, "word_orig": "כְּ/אָדָ֖ם", "strong": "H121", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Adam"}, {"pos": 3, "word_orig": "עָבְר֣וּ", "strong"