[{"book": 28, "chapter": 6, "verse": 1, "ayat_id": 22169, "title": "Upah Pertobatan", "ayt_text": "“Mari, kita berbalik kepada TUHAN, sebab Dia telah mencabik-cabik kita, biarlah Dia menyembuhkan kita; Dia telah menyerang kita, dan Dia akan membalut kita.", "words": [{"pos": 1, "word_orig": "לְכוּ֙", "strong": "H3212", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Mari"}, {"pos": 2, "word_orig": "וְ/נָשׁ֣וּבָה", "strong": "H7725", "morph": "HC/Vqh1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-1 Jamak", "ayt_word": "berbalik"}, {"pos": 3, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 4, "word_orig": "יְהוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "כִּ֛י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebab"}, {"pos": 6, "word_orig": "ה֥וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "Dia"}, {"pos": 7, "word_orig": "טָרָ֖ף", "strong": "H2963", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencabik-cabik"}, {"pos": 8, "word_orig": "וְ/יִרְפָּאֵ֑/נוּ", "strong": "H7495", "morph": "HC/Vqi3ms/Sp1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cp", "ayt_word": "menyembuhkan"}, {"pos": 9, "word_orig": "יַ֖ךְ", "strong": "H5221", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyerang"}, {"pos": 10, "word_orig": "וְ/יַחְבְּשֵֽׁ/נוּ", "strong": "H2280", "morph": "HC/Vqi3ms/Sp1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cp", "ayt_word": "membalut"}]}, {"book": 28, "chapter": 6, "verse": 2, "ayat_id": 22170, "title": "", "ayt_text": "Setelah dua hari, Dia akan menghidupkan kita. Pada hari yang ketiga, Dia akan membangkitkan kita supaya kita boleh hidup dalam hadirat-Nya.", "words": [{"pos": 1, "word_orig": "יְחַיֵּ֖/נוּ", "strong": "H2421", "morph": "HVpi3ms/Sp1cp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cp", "ayt_word": "menghidupkan"}, {"pos": 2, "word_orig": "מִ/יֹּמָ֑יִם", "strong": "H3117", "morph": "HR/Ncmda", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Absolut", "ayt_word": "hari"}, {"pos": 3, "word_orig": "בַּ/יּוֹם֙", "strong": "H3117", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 4, "word_orig": "הַ/שְּׁלִישִׁ֔י", "strong": "H7992", "morph": "HTd/Aomsa", "morph_id": "Artikel Definit (הַ) + Aomsa", "ayt_word": "ketiga"}, {"pos": 5, "word_orig": "יְקִמֵ֖/נוּ", "strong": "H6965", "morph": "HVhi3ms/Sp1cp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cp", "ayt_word": "membangkitkan"}, {"pos": 6, "word_orig": "וְ/נִחְיֶ֥ה", "strong": "H2421", "morph": "HC/Vqi1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Jamak", "ayt_word": "hidup"}, {"pos": 7, "word_orig": "לְ/פָנָֽי/ו", "strong": "H6440", "morph": "HR/Ncbpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "di"}]}, {"book": 28, "chapter": 6, "verse": 3, "ayat_id": 22171, "title": "", "ayt_text": "Marilah kita mengenal, marilah kita mengejar untuk mengenal TUHAN. Kemunculan-Nya sepasti terbitnya fajar, dan Dia akan datang kepada kita seperti hujan, seperti hujan pada akhir musim yang mengairi bumi.”", "words": [{"pos": 1, "word_orig": "וְ/נֵדְעָ֣ה", "strong": "H3045", "morph": "HC/Vqh1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-1 Jamak", "ayt_word": "mengenal"}, {"pos": 2, "word_orig": "נִרְדְּפָ֗ה", "strong": "H7291", "morph": "HVqi1cp", "morph_id": "Verba Qal Imperfek Orang ke-1 Jamak", "ayt_word": "mengejar"}, {"pos": 3, "word_orig": "לָ/דַ֨עַת֙", "strong": "H3045", "morph": "HR/Vqc", "morph_id":