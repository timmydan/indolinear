_id": 14377, "title": "", "ayt_text": "TUHAN menggagalkan maksud bangsa-bangsa; Dia menahan rancangan suku-suku bangsa.", "words": [{"pos": 1, "word_orig": "יְֽהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "הֵפִ֥יר", "strong": "H6331", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menggagalkan"}, {"pos": 3, "word_orig": "עֲצַת", "strong": "H6098", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "maksud"}, {"pos": 4, "word_orig": "גּוֹיִ֑ם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 5, "word_orig": "הֵ֝נִ֗יא", "strong": "H5106", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menahan"}, {"pos": 6, "word_orig": "מַחְשְׁב֥וֹת", "strong": "H4284", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "rancangan"}, {"pos": 7, "word_orig": "עַמִּֽים", "strong": "H5971", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa"}]}, {"book": 19, "chapter": 33, "verse": 11, "ayat_id": 14378, "title": "", "ayt_text": "Maksud TUHAN tetap selama-lamanya, rancangan hati-Nya dari generasi ke generasi.", "words": [{"pos": 1, "word_orig": "עֲצַ֣ת", "strong": "H6098", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Maksud"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "לְ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 4, "word_orig": "תַּעֲמֹ֑ד", "strong": "H5975", "morph": "HVqi3fs",