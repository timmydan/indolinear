{"pos": 10, "word_orig": "כֹּֽחַ", "strong": "H3581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatannya"}]}, {"book": 19, "chapter": 33, "verse": 17, "ayat_id": 14384, "title": "", "ayt_text": "Kuda adalah harapan palsu bagi kemenangan; walau dengan semua kekuatannya yang besar, ia tidak bisa menyelamatkan.", "words": [{"pos": 1, "word_orig": "שֶׁ֣קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "harapan"}, {"pos": 2, "word_orig": "הַ֭/סּוּס", "strong": "H5483", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Kuda"}, {"pos": 3, "word_orig": "לִ/תְשׁוּעָ֑ה", "strong": "H8668", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemenangan"}, {"pos": 4, "word_orig": "וּ/בְ/רֹ֥ב", "strong": "H7230", "morph": "HC/R/Ncbsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "besar"}, {"pos": 5, "word_orig": "חֵ֝יל֗/וֹ", "strong": "H2428", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kekuatannya"}, {"pos": 6, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יְמַלֵּֽט", "strong": "H4422", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyelamatkan"}]}, {"book": 19, "chapter": 33, "verse": 18, "ayat_id": 14385, "title": "", "ayt_text": "Lihat, mata TUHAN terarah kepada orang-orang yang takut akan Dia, kepada orang-orang yang berharap pada kasih setia-Nya,", "words": [{"pos": 1, "word_orig": "הִנֵּ֤ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "עֵ֣ין", "strong": "H5869", "morph": "HNc