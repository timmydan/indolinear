[{"book": 19, "chapter": 33, "verse": 1, "ayat_id": 14368, "title": "Pujian atas Kuasa dan Kehendak TUHAN", "ayt_text": "Bersoraklah dalam TUHAN, hai kamu orang saleh! Puji-pujian itu layak bagi orang benar.", "words": [{"pos": 1, "word_orig": "רַנְּנ֣וּ", "strong": "H7442", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Bersoraklah"}, {"pos": 2, "word_orig": "צַ֭דִּיקִים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "saleh"}, {"pos": 3, "word_orig": "בַּֽ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "לַ֝/יְשָׁרִ֗ים", "strong": "H3477", "morph": "HRd/Aampa", "morph_id": "Rd + Aampa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "נָאוָ֥ה", "strong": "H5000", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "layak"}, {"pos": 6, "word_orig": "תְהִלָּֽה", "strong": "H8416", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Puji-pujian"}]}, {"book": 19, "chapter": 33, "verse": 2, "ayat_id": 14369, "title": "", "ayt_text": "Bersyukurlah kepada TUHAN dengan kecapi; serukan kepada-Nya dengan gambus sepuluh tali.", "words": [{"pos": 1, "word_orig": "הוֹד֣וּ", "strong": "H3034", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Bersyukurlah"}, {"pos": 2, "word_orig": "לַ/יהוָ֣ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "בְּ/כִנּ֑וֹר", "strong": "H3658", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kecapi"}, {"pos": 4, "word_orig": "בְּ/נֵ֥בֶל", "strong": "H5035", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "gambus"}, {"pos": 5, "word_orig": "עָ֝שׂ֗וֹר", "strong": "H6218", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sepuluh"}, {"pos": 6, "word_orig": "זַמְּרוּ", "strong": "H2167", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "serukan"}, {"pos": 7, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 19, "chapter": 33, "verse": 3, "ayat_id": 14370, "title": "", "ayt_text": "Nyanyikan bagi-Nya sebuah nyanyian baru, mainkan baik-baik kecapi dalam sorak-sorai!", "words": [{"pos": 1, "word_orig": "שִֽׁירוּ", "strong": "H7891", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Nyanyikan"}, {"pos": 2, "word_orig": "ל֭/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 3, "word_orig": "שִׁ֣יר", "strong": "H7892", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "nyanyian"}, {"pos": 4, "word_orig": "חָדָ֑שׁ", "strong": "H2319", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baru"}, {"pos": 5, "word_orig": "הֵיטִ֥יבוּ", "strong": "H3190", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "baik-baik"}, {"pos": 6, "word_orig": "נַ֝גֵּ֗ן", "strong": "H5059", "morph": "HVpc", "morph_id": "Verba Piel Imperatif", "ayt_word": "mainkan"}, {"pos": 7, "word_orig": "בִּ/תְרוּעָֽה", "strong": "H8643", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sorak-sorai"}]}, {"book": 19, "chapter": 33, "verse": 4, "ayat_id": 14371, "title": "", "ayt_text": "Sebab, firman TUHAN itu benar, dan semua pekerjaan-Nya dilakukan dalam kesetiaan.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "יָשָׁ֥ר", "strong": "H3477", "morph": "HAamsa", "