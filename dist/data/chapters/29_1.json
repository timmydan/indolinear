3213", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "merataplah"}, {"pos": 4, "word_orig": "כֹּֽרְמִ֔ים", "strong": "H3755", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pekerja"}, {"pos": 5, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "karena"}, {"pos": 6, "word_orig": "חִטָּ֖ה", "strong": "H2406", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "gandum"}, {"pos": 7, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "karena"}, {"pos": 8, "word_orig": "שְׂעֹרָ֑ה", "strong": "H8184", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "jelai"}, {"pos": 9, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebab"}, {"pos": 10, "word_orig": "אָבַ֖ד", "strong": "H6", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "musnah"}, {"pos": 11, "word_orig": "קְצִ֥יר", "strong": "H7105", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "tuaian"}, {"pos": 12, "word_orig": "שָׂדֶֽה", "strong": "H7704", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ladang"}]}, {"book": 29, "chapter": 1, "verse": 12, "ayat_id": 22304, "title": "", "ayt_text": "Pohon anggur menjadi kering, dan pohon ara layu. Pohon delima, juga pohon kurma, dan pohon apel, semua pohon di ladang sudah mengering. Sungguh, kegirangan menjadi layu di antara anak-anak manusia.", "words": [{"pos": 1, "word_orig": "הַ/גֶּ֣פֶן", "strong": "H1612", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 2, "word_orig": "הוֹבִ֔ישָׁה", "strong": "H3001", "morph": "HVhp3fs", "morph_id": "Verba Hifil Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjadi"}, {"pos": 3, "word_orig": "וְ/הַ/תְּאֵנָ֖ה", "strong": "H8384", "morph": "HC/Td/Ncfsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pohon"}, {"pos": 4, "word_orig": "אֻמְלָ֑לָה", "strong": "H535", "morph": "HVKp3fs", "morph_id": "Verba Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "layu"}, {"pos": 5, "word_orig": "רִמּ֞וֹן", "strong": "H7416", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Pohon"}, {"pos": 6, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "juga"}, {"pos": 7, "word_orig": "תָּמָ֣ר", "strong": "H8558", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pohon"}, {"pos": 8, "word_orig": "וְ/תַפּ֗וּחַ", "strong": "H8598", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pohon"}, {"pos": 9, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 10, "word_orig": "עֲצֵ֤י", "strong": "H6086", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "pohon"}, {"pos": 11, "word_orig": "הַ/שָּׂדֶה֙", "strong": "H7704", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ladang"}, {"pos": 12, "word_orig": "יָבֵ֔שׁוּ", "strong": "H3001", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "mengering"}, {"pos": 13, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sungguh"}, {"pos": 14, "word_orig": "הֹבִ֥ישׁ", "strong": "H3001", "morph": "HVhp3ms