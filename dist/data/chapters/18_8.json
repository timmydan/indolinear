"ayt_word": "tunas-tunasnya"}, {"pos": 8, "word_orig": "תֵצֵֽא", "strong": "H3318", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjulur"}]}, {"book": 18, "chapter": 8, "verse": 17, "ayat_id": 13047, "title": "", "ayt_text": "Akar-akarnya membalut timbunan batu, dan mencari tempat di antara batu-batu.", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 2, "word_orig": "גַּ֭ל", "strong": "H1530", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "timbunan"}, {"pos": 3, "word_orig": "שָֽׁרָשָׁ֣י/ו", "strong": "H8328", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "Akar-akarnya"}, {"pos": 4, "word_orig": "יְסֻבָּ֑כוּ", "strong": "H5440", "morph": "HVPi3mp", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "membalut"}, {"pos": 5, "word_orig": "בֵּ֖ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "tempat"}, {"pos": 6, "word_orig": "אֲבָנִ֣ים", "strong": "H68", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "batu-batu"}, {"pos": 7, "word_orig": "יֶחֱזֶֽה", "strong": "H2372", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}]}, {"book": 18, "chapter": 8, "verse": 18, "ayat_id": 13048, "title": "", "ayt_text": "Jika ia dicabut dari tempatnya, tempat itu tidak akan mengakuinya, katanya, ‘Aku belum pernah melihatmu.’", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יְבַלְּעֶ֥/נּוּ", "strong": "H1104", "morph": "HVpi3ms/Sp3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "dicabut