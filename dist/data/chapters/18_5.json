 {"book": 18, "chapter": 5, "verse": 20, "ayat_id": 12972, "title": "", "ayt_text": "Pada masa kelaparan, Dia akan melepaskanmu dari kematian, dan pada masa peperangan dari kuasa pedang.", "words": [{"pos": 1, "word_orig": "בְּ֭/רָעָב", "strong": "H7458", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kelaparan"}, {"pos": 2, "word_orig": "פָּֽדְ/ךָ֣", "strong": "H6299", "morph": "HVqp3ms/Sp2ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "melepaskanmu"}, {"pos": 3, "word_orig": "מִ/מָּ֑וֶת", "strong": "H4194", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kematian"}, {"pos": 4, "word_orig": "וּ֝/בְ/מִלְחָמָ֗ה", "strong": "H4421", "morph": "HC/R/Ncfsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "peperangan"}, {"pos": 5, "word_orig": "מִ֣/ידֵי", "strong": "H3027", "morph": "HR/Ncbdc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "kuasa"}, {"pos": 6, "word_orig": "חָֽרֶב", "strong": "H2719", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}]}, {"book": 18, "chapter": 5, "verse": 21, "ayat_id": 12973, "title": "", "ayt_text": "Kamu akan dilindungi dari cambukan lidah, dan kamu tidak perlu takut akan kehancuran ketika hal itu datang.", "words": [{"pos": 1, "word_orig": "בְּ/שׁ֣וֹט", "strong": "H7752", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "cambukan"}, {"pos": 2, "word_orig": "לָ֭שׁוֹן", "strong": "H3956", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "lidah"}, {"pos": 3, "word_orig": "תֵּחָבֵ֑א", "strong": "H2244", "morph": "HVNi2ms", "morph_id": "Verba Nifal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "dilindungi"}, {"pos": 4, "word_orig": "וְֽ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "perlu"}, {"pos": 5, "word_orig": "תִירָ֥א", "strong": "H3372", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "takut"}, {"pos": 6, "word_orig": "מִ֝/שֹּׁ֗ד", "strong": "H7701", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kehancuran"}, {"pos": 7, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "ketika"}, {"pos": 8, "word_orig": "יָבֽוֹא", "strong": "H935", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "datang"}]}, {"book": 18, "chapter": 5, "verse": 22, "ayat_id": 12974, "title": "", "ayt_text": "Pada saat kehancuran dan kelaparan, kamu akan tertawa, dan kamu tidak akan takut pada binatang-binatang buas di bumi.", "words": [{"pos": 1, "word_orig": "לְ/שֹׁ֣ד", "strong": "H7701", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kehancuran"}, {"pos": 2, "word_orig": "וּ/לְ/כָפָ֣ן", "strong": "H3720", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kelaparan"}, {"pos": 3, "word_orig": "תִּשְׂחָ֑ק", "strong": "H7832", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "tertawa"}, {"pos": 4, "word_orig": "וּֽ/מֵ/חַיַּ֥ת", "strong": "H2416", "morph": "HC/R/Ncfsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "binatang-binatang"}, {"pos": 5, "word_orig": "הָ֝/אָ֗רֶץ", "strong": "H776", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 6, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "תִּירָֽא", "strong": "H3372", "morph": "HVqj2ms", "morph_id": "Verba Qal Orang ke-2 Laki-laki Tunggal", "ayt_word": "takut"}]}, {"book": 18, "chapter": 5, "verse": 23, "ayat_id": 12975, "title": "", "ayt_text": "Sebab, kamu akan mengadakan perjanjian dengan batu-batu di ladang, dan binatang-binatang buas di ladang akan berdamai denganmu.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dengan"}, {"pos": 3, "word_orig": "אַבְנֵ֣י", "strong": "H68", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "batu-batu"}, {"pos": 4, "word_orig": "הַ/שָּׂדֶ֣ה", "strong": "H7704", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ladang"}, {"pos": 5, "word_orig": "בְרִיתֶ֑/ךָ", "strong": "H1285", "morph": "HNcfsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "perjanjian"}, {"pos": 6, "word_orig": "וְ/חַיַּ֥ת", "strong": "H2416", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "binatang-binatang"}, {"pos": 7, "word_orig": "הַ֝/שָּׂדֶ֗ה", "strong": "H7704", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ladang"}, {"pos": 8, "word_orig": "הָשְׁלְמָה", "strong": "H7999", "morph": "HVHp3fs", "morph_id": "Verba Piel", "ayt_word": "berdamai"}, {"pos": 9, "word_orig": "לָֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 18, "chapter": 5, "verse": 24, "ayat_id": 12976, "title": "", "ayt_text": "Kamu akan ta