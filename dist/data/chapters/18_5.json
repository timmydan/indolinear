_id": "Preposisi", "ayt_word": "ke"}, {"pos": 9, "word_orig": "פְּנֵ֥י", "strong": "H6440", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": ""}, {"pos": 10, "word_orig": "חוּצֽוֹת", "strong": "H2351", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "ladang-ladang"}]}, {"book": 18, "chapter": 5, "verse": 11, "ayat_id": 12963, "title": "", "ayt_text": "Dia menempatkan orang yang rendah di tempat yang tinggi, dan mereka yang berdukacita diangkat ke tempat yang aman.", "words": [{"pos": 1, "word_orig": "לָ/שׂ֣וּם", "strong": "H7760", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "menempatkan"}, {"pos": 2, "word_orig": "שְׁפָלִ֣ים", "strong": "H8217", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "rendah"}, {"pos": 3, "word_orig": "לְ/מָר֑וֹם", "strong": "H4791", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 4, "word_orig": "וְ֝/קֹדְרִ֗ים", "strong": "H6937", "morph": "HC/Vqrmpa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "berdukacita"}, {"pos": 5, "word_orig": "שָׂ֣גְבוּ", "strong": "H7682", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "diangkat"}, {"pos": 6, "word_orig": "יֶֽשַׁע", "strong": "H3468", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "aman"}]}, {"book": 18, "chapter": 5, "verse": 12, "ayat_id": 12964, "title": "", "ayt_text": "Dia menggagalkan rencana orang licik sehingga tangan mereka tidak mencapai keberhasilan.", "words": [{"pos": 1, "word_orig": "מֵ֭פֵר", "strong": "H6565", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menggagalkan"}, {"pos": 2, "word_orig": "מַחְשְׁב֣וֹת", "strong": "H4284", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "rencana"}, {"pos": 3, "word_orig": "עֲרוּמִ֑ים", "strong": "H6175", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "licik"}, {"pos": 4, "word_orig": "וְֽ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "תַעֲשֶׂ֥ינָה", "strong": "H6213", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "mencapai"}, {"pos": 6, "word_orig": "יְ֝דֵי/הֶ֗ם", "strong": "H3027", "morph": "HNcbdc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3mp", "ayt_word": "tangan"}, {"pos": 7, "word_orig": "תּוּשִׁיָּֽה", "strong": "H8454", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keberhasilan"}]}, {"book": 18, "chapter": 5, "verse": 13, "ayat_id": 12965, "title": "", "ayt_text": "Dia menangkap orang berhikmat dalam kecerdikan mereka sendiri, dan nasihat orang licik segera ditiadakan.", "words": [{"pos": 1, "word_orig": "לֹכֵ֣ד", "strong": "H3920", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menangkap"}, {"pos": 2, "word_orig": "חֲכָמִ֣ים", "strong": "H2450", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "berhikmat"}, {"pos": 3, "word_orig": "בְּ/עָרְמָ֑/ם", "strong": "H6193", "morph": "HR/Vqc/Sp3mp", "morph_id": "Preposisi + Verba Qal Imperatif + Sp3mp", "ayt_word": "kecerdikan"}, {"pos": 4, "word_orig": "וַ/עֲצַ֖ת", "strong": "H6098", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "nasihat"}, {"pos": 5, "word_orig": "נִפְתָּלִ֣ים", "strong": "H6617", "morph": "HVNrmpa", "morph_id": "Verba Nifal", "ayt_word": "licik"}, {"pos": 6, "word_orig": "נִמְהָֽרָה", "strong": "H4116", "morph": "HVNp3fs", "morph_id": "Verba Nifal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "ditiadakan"}]}, {"book": 18, "chapter": 5, "verse": 14, "ayat_id": 12966, "title": "", "ayt_text": "Mereka bertemu dengan kegelapan pada siang hari, dan meraba-raba pada tengah hari seperti pada malam hari.", "words": [{"pos": 1, "word_orig": "יוֹמָ֥ם", "strong": "H3119", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "hari"}, {"pos": 2, "word_orig": "יְפַגְּשׁוּ", "strong": "H6298", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bertemu"}, {"pos": 3, "word_orig": "חֹ֑שֶׁךְ", "strong": "H2822", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}, {"pos": 4, "word_orig": "וְ֝/כַ/לַּ֗יְלָה", "strong": "H3915", "morph": "HC/Rd/Ncmsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 5, "word_orig": "יְֽמַשְׁשׁ֥וּ", "strong": "H4959", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "meraba-raba"}, {"pos": 6, "word_orig": "בַֽ/צָּהֳרָֽיִם", "strong": "H6672", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "hari"}]}, {"book": 18, "chapter": 5, "verse": 15, "ayat_id": 12967, "title": "", "ayt_text": "Akan tetapi, Allah menyelamatkan orang miskin dari pedang mulut mereka dan dari tangan orang kuat.", "words": [{"pos": 1, "word_orig": "וַ/יֹּ֣שַׁע", "strong": "H3467", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyelamatkan"}, {"pos": 2, "word_orig": "מֵ֭/חֶרֶב", "strong": "H2719", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 3, "word_orig": "מִ/פִּי/הֶ֑ם", "strong": "H6310", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mulut"}, {"pos": 4, "word_orig": "וּ/מִ/יַּ֖ד", "strong": "H3027", "morph": "HC/R/Ncbsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomin