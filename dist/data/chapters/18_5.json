ayt_word": "diberkatilah"}, {"pos": 3, "word_orig": "אֱ֭נוֹשׁ", "strong": "H582", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "יוֹכִחֶ֣/נּֽוּ", "strong": "H3198", "morph": "HVhi3ms/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "ditegur"}, {"pos": 5, "word_orig": "אֱל֑וֹהַּ", "strong": "H433", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 6, "word_orig": "וּ/מוּסַ֥ר", "strong": "H4148", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "didikan"}, {"pos": 7, "word_orig": "שַׁ֝דַּ֗י", "strong": "H7706", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Mahakuasa"}, {"pos": 8, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "jangan"}, {"pos": 9, "word_orig": "תִּמְאָֽס", "strong": "H3988", "morph": "HVqj2ms", "morph_id": "Verba Qal Orang ke-2 Laki-laki Tunggal", "ayt_word": "rendah"}]}, {"book": 18, "chapter": 5, "verse": 18, "ayat_id": 12970, "title": "", "ayt_text": "Sebab, Dia melukai, tetapi Dia juga membalut; Dia meremukkan, tetapi tangan-Nya menyembuhkan.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "Dia"}, {"pos": 3, "word_orig": "יַכְאִ֣יב", "strong": "H3510", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melukai"}, {"pos": 4, "word_orig": "וְ/יֶחְבָּ֑שׁ", "strong": "H2280", "morph": "HC/Vqi3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membalut"}, {"pos": 5, "word_orig": "יִ֝מְחַ֗ץ", "strong": "H4272", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfe