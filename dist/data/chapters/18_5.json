"H6256", "morph": "HR/Ncbsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "masanya"}]}, {"book": 18, "chapter": 5, "verse": 27, "ayat_id": 12979, "title": "", "ayt_text": "Lihatlah, kami sudah menyelidikinya, dan memang benar; dengarkanlah dan ketahuilah hal itu demi kebaikanmu.”", "words": [{"pos": 1, "word_orig": "הִנֵּה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "זֹ֭את", "strong": "H2063", "morph": "HPdxfs", "morph_id": "Pdxfs", "ayt_word": ""}, {"pos": 3, "word_orig": "חֲקַרְנ֥וּ/הָ", "strong": "H2713", "morph": "HVqp1cp/Sp3fs", "morph_id": "Verba Qal Perfek Orang ke-1 Jamak + Sp3fs", "ayt_word": "menyelidikinya"}, {"pos": 4, "word_orig": "כֶּֽן", "strong": "H3651", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "benar"}, {"pos": 5, "word_orig": "הִ֑יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": ""}, {"pos": 6, "word_orig": "שְׁ֝מָעֶ֗/נָּה", "strong": "H8085", "morph": "HVqv2ms/Sp3fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp3fs", "ayt_word": "dengarkanlah"}, {"pos": 7, "word_orig": "וְ/אַתָּ֥ה", "strong": "H859", "morph": "HC/Pp2ms", "morph_id": "Konjungsi (וְ) + Pp2ms", "ayt_word": ""}, {"pos": 8, "word_orig": "דַֽע", "strong": "H3045", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "ketahuilah"}, {"pos": 9, "word_orig": "לָֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}]