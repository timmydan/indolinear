a Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tanah"}, {"pos": 7, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "יִצְמַ֥ח", "strong": "H6779", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "tumbuh"}, {"pos": 9, "word_orig": "עָמָֽל", "strong": "H5999", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kesusahan"}]}, {"book": 18, "chapter": 5, "verse": 7, "ayat_id": 12959, "title": "", "ayt_text": "tetapi manusia dilahirkan untuk kesusahan, seperti percikan api yang terbang ke atas.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "tetapi"}, {"pos": 2, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 3, "word_orig": "לְ/עָמָ֣ל", "strong": "H5999", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kesusahan"}, {"pos": 4, "word_orig": "יוּלָּ֑ד", "strong": "H3205", "morph": "HVPp3ms", "morph_id": "Verba Pual Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dilahirkan"}, {"pos": 5, "word_orig": "וּ/בְנֵי", "strong": "H1121", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "api"}, {"pos": 6, "word_orig": "רֶ֝֗שֶׁף", "strong": "H7565", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "api"}, {"pos": 7, "word_orig": "יַגְבִּ֥יהוּ", "strong": "H1361", "morph": "HVhi3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "atas"}, {"pos": 8, "word_orig": "עֽוּף", "strong": "H5774", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "terbang"}]}, {"book": 18, "chapter": 5, "verse": 8, "ayat_id": 12960, "title": "", "ayt_text": "Kalau aku, aku akan mencari Allah, maka kepada Allah aku akan mengadukan persoalanku.", "words": [{"pos": 1, "word_orig": "אוּלָ֗ם", "strong": "H199", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Kalau"}, {"pos": 2, "word_orig": "אֲ֭נִי", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 3, "word_orig": "אֶדְרֹ֣שׁ", "strong": "H1875", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mencari"}, {"pos": 4, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 5, "word_orig": "אֵ֑ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 6, "word_orig": "וְ/אֶל", "strong": "H413", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "kepada"}, {"pos": 7, "word_orig": "אֱ֝לֹהִ֗ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 8, "word_orig": "אָשִׂ֥ים", "strong": "H7760", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mengadukan"}, {"pos": 9, "word_orig": "דִּבְרָתִֽ/י", "strong": "H1700", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "persoalanku"}]}, {"book": 18, "chapter": 5, "verse": 9, "ayat_id": 12961, "title": "", "ayt_text": "Dialah yang melakukan hal-hal yang besar dan yang tidak terselidiki, hal-hal ajaib yang tidak terbilang banyaknya.", "words": [{"pos": 1, "word_orig": "עֹשֶׂ֣ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 2, "word_orig": "גְ֭דֹלוֹת", "strong": "H1419", "morph": "HAafpa", "morph_id": "Aafpa", "ayt_word": "besar"}, {"pos": 3, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt