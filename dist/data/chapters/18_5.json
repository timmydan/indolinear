at) Laki-laki Tunggal Absolut", "ayt_word": "kemurkaan"}, {"pos": 5, "word_orig": "וּ֝/פֹתֶ֗ה", "strong": "H6601", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "yang"}, {"pos": 6, "word_orig": "תָּמִ֥ית", "strong": "H4191", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "membunuh"}, {"pos": 7, "word_orig": "קִנְאָֽה", "strong": "H7068", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kecemburuan"}]}, {"book": 18, "chapter": 5, "verse": 3, "ayat_id": 12955, "title": "", "ayt_text": "Aku telah melihat orang bodoh membuat akar, tetapi tiba-tiba aku mengutuki tempat tinggalnya.", "words": [{"pos": 1, "word_orig": "אֲֽנִי", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 2, "word_orig": "רָ֭אִיתִי", "strong": "H7200", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "melihat"}, {"pos": 3, "word_orig": "אֱוִ֣יל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 4, "word_orig": "מַשְׁרִ֑ישׁ", "strong": "H8327", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "membuat"}, {"pos": 5, "word_orig": "וָ/אֶקּ֖וֹב", "strong": "H6895", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "mengutuki"}, {"pos": 6, "word_orig": "נָוֵ֣/הוּ", "strong": "H5116", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tempat"}, {"pos": 7, "word_orig": "פִתְאֹֽם", "strong": "H6597", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "tiba-tiba"}]}, {"book": 18, "chapter": 5, "verse": 4, "ayat_id": 12956, "title": "", "ayt_text": "Anak-anaknya jauh dari keamanan; mereka diremukkan di pintu gerbang, dan tidak seorang pun menyelamatkan mereka.", "words": [{"pos": 1, "word_orig": "יִרְחֲק֣וּ", "strong": "H7368", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "jauh"}, {"pos": 2, "word_orig": "בָנָ֣י/ו", "strong": "H1121", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "Anak-anaknya"}, {"pos": 3, "word_orig": "מִ/יֶּ֑שַׁע", "strong": "H3468", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keamanan"}, {"pos": 4, "word_orig": "וְ/יִֽדַּכְּא֥וּ", "strong": "H1792", "morph": "HC/Vti3mp", "morph_id": "Konjungsi (וְ) + Verba Hitpael Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "diremukkan"}, {"pos": 5, "word_orig": "בַ֝/שַּׁ֗עַר", "strong": "H8179", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pintu"}, {"pos": 6, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "מַצִּֽיל", "strong": "H5337", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menyelamatkan"}]}, {"book": 18, "chapter": 5, "verse": 5, "ayat_id": 12957, "title": "", "ayt_text": "Orang yang kelaparan melahap hasil panennya, dan bahkan mengambil yang tumbuh di antara duri-duri, dan orang yang haus menginginkan kekayaannya.", "words": [{"pos": 1, "word_orig": "אֲשֶׁ֤ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 2, "word_orig": "קְצִיר֨/וֹ", "strong": "H7105", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "panennya"}, {"pos": 3, "word_orig": "רָ֘עֵ֤ב", "strong": "H7457", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kelaparan"}, {"pos": 4, "word_orig": "יֹאכֵ֗ל", "strong": "H398", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melahap"}, {"pos": 5, "word_orig": "וְ/אֶֽל", "strong": "H413", "morph": "HC/R