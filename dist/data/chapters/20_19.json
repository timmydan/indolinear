word_orig": "עֲבֹ֣ר", "strong": "H5674", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "menghiraukan"}, {"pos": 7, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 8, "word_orig": "פָּֽשַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelanggaran"}]}, {"book": 20, "chapter": 19, "verse": 12, "ayat_id": 16938, "title": "", "ayt_text": "Kemarahan raja bagaikan raungan singa, tetapi kebaikannya seperti embun di atas rumput.", "words": [{"pos": 1, "word_orig": "נַ֣הַם", "strong": "H5099", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raungan"}, {"pos": 2, "word_orig": "כַּ֭/כְּפִיר", "strong": "H3715", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "singa"}, {"pos": 3, "word_orig": "זַ֣עַף", "strong": "H2197", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Kemarahan"}, {"pos": 4, "word_orig": "מֶ֑לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raja"}, {"pos": 5, "word_orig": "וּ/כְ/טַ֖ל", "strong": "H2919", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "embun"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 7, "word_orig": "עֵ֣שֶׂב", "strong": "H6212", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rumput"}, {"pos": 8, "word_orig": "רְצוֹנֽ/וֹ", "strong": "H7522", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kebaikannya"}]}, {"book": 20, "chapter": 19, "verse": 13, "ayat_id": 16939, "title": "", 