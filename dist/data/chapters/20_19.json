g": "H5159", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "warisan"}, {"pos": 4, "word_orig": "אָב֑וֹת", "strong": "H1", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "nenek"}, {"pos": 5, "word_orig": "וּ֝/מֵ/יְהוָ֗ה", "strong": "H3068", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "אִשָּׁ֥ה", "strong": "H802", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "istri"}, {"pos": 7, "word_orig": "מַשְׂכָּֽלֶת", "strong": "H7919", "morph": "HVhrfsa", "morph_id": "Verba Hifil", "ayt_word": "bijaksana"}]}, {"book": 20, "chapter": 19, "verse": 15, "ayat_id": 16941, "title": "", "ayt_text": "Kemalasan mendatangkan tidur nyenyak, dan jiwa yang lamban akan menderita kelaparan.", "words": [{"pos": 1, "word_orig": "עַ֭צְלָה", "strong": "H6103", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kemalasan"}, {"pos": 2, "word_orig": "תַּפִּ֣יל", "strong": "H5307", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mendatangkan"}, {"pos": 3, "word_orig": "תַּרְדֵּמָ֑ה", "strong": "H8639", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tidur"}, {"pos": 4, "word_orig": "וְ/נֶ֖פֶשׁ", "strong": "H5315", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jiwa"}, {"pos": 5, "word_orig": "רְמִיָּ֣ה", "strong": "H7423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "lamban"}, {"pos": 6, "word_orig": "תִרְעָֽב", "strong": "H7456", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "kelaparan"}]}, {"book": 20, "chapter": 19, "verse": 16, "ayat_id": 16942, "title": "", "ayt_text": "Mereka yang memelihara perintah memelihara nyawanya, tetapi mereka yang menghina jalan-Nya akan mati.", "words": [{"pos": 1, "word_orig": "שֹׁמֵ֣ר", "strong": "H8104", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "memelihara"}, {"pos": 2, "word_orig": "מִ֭צְוָה", "strong": "H4687", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perintah"}, {"pos": 3, "word_orig": "שֹׁמֵ֣ר", "strong": "H8104", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "memelihara"}, {"pos": 4, "word_orig": "נַפְשׁ֑/וֹ", "strong": "H5315", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "nyawanya"}, {"pos": 5, "word_orig": "בּוֹזֵ֖ה", "strong": "H959", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "menghina"}, {"pos": 6, "word_orig": "דְרָכָ֣י/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalan-Nya"}, {"pos": 7, "word_orig": "יומת", "strong": "H4191", "morph": "HVHi3ms", "morph_id": "Verba", "ayt_word": "mati"}, {"pos": 8, "word_orig": "יָמֽוּת", "strong": "H4191", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}]}, {"book": 20, "chapter": 19, "verse": 17, "ayat_id": 16943, "title": "", "ayt_text": "Orang yang berbelaskasihan kepada orang miskin memberi pinjaman kepada TUHAN, dan Dia akan membalasnya atas perbuatannya itu.", "words": [{"pos": 1, "word_orig": "מַלְוֵ֣ה", "strong": "H3867", "morph": "HVhrmsc", "morph_id": "Verba Hifil", "ayt_word": "pinjaman"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "ח֣וֹנֵֽן", "strong": "H2603", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berbelaskasihan"}, {"pos": 4, "word_orig": "דָּ֑ל", "stron