rph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 5, "word_orig": "וַ/עֲצַ֥ת", "strong": "H6098", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "maksud"}, {"pos": 6, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "הִ֣יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "yang"}, {"pos": 8, "word_orig": "תָקֽוּם", "strong": "H6965", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "bertahan"}]}, {"book": 20, "chapter": 19, "verse": 22, "ayat_id": 16948, "title": "", "ayt_text": "Yang diinginkan oleh manusia adalah kasih setianya, dan lebih baik orang miskin daripada seorang pembohong.", "words": [{"pos": 1, "word_orig": "תַּאֲוַ֣ת", "strong": "H8378", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "diinginkan"}, {"pos": 2, "word_orig": "אָדָ֣ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 3, "word_orig": "חַסְדּ֑/וֹ", "strong": "H2617", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "setianya"}, {"pos": 4, "word_orig": "וְ/טֽוֹב", "strong": "H2896", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "רָ֝שׁ", "strong": "H7326", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "miskin"}, {"pos": 6, "word_orig": "מֵ/אִ֥ישׁ", "strong": "H376", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "seorang"}, {"pos": 7, "word_orig": "כָּזָֽב", "strong": "H3577", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pembohong"}]}, {"book": 20, "chapter": 19, "verse": 23, "ayat_id": 16949, "title": "", "ayt_text": "Takut akan TUHAN mendatangkan kehidupan; orang yang demikian akan beristirahat dengan puas, dan tidak akan ditimpa malapetaka.", "words": [{"pos": 1, "word_orig": "יִרְאַ֣ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 2, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "לְ/חַיִּ֑ים", "strong": "H2416", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 4, "word_orig": "וְ/שָׂבֵ֥עַ", "strong": "H7649", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "puas"}, {"pos": 5, "word_orig": "יָ֝לִ֗ין", "strong": "H3885", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "beristirahat"}, {"pos": 6, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יִפָּ֥קֶד", "strong": "H6485", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ditimpa"}, {"pos": 8, "word_orig": "רָֽע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "malapetaka"}]}, {"book": 20, "chapter": 19, "verse": 24, "ayat_id": 16950, "title": "", "ayt_text": "Si pemalas mencelupkan tangannya ke dalam pinggan, dan bahkan tidak akan mengembalikannya ke dalam mulutnya.", "words": [{"pos": 1, "word_orig": "טָ֘מַ֤ן", "strong": "H2934", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencelupkan"}, {"pos": 2, "word_orig": "עָצֵ֣ל", "strong": "H6102", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pemalas"}, {"pos": 3, "word_orig": "יָ֭ד/וֹ", "strong": "H3027", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tangannya"}, {"pos": 4, "word_orig": "בַּ/צַּלָּ֑חַת", "strong": "H6747", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pinggan"}, {"pos": 5, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "bahkan"}, {"pos": 6, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 7, "word_orig": "פִּ֝֗י/הוּ", "strong": "H6310", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulutnya"}, {"pos": 8, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "יְשִׁיבֶֽ/נָּה", "strong": "H7725", "morph": "HVhi3ms/Sp3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3fs", "ayt_word": "mengembalikannya"}]}, {"book": 20, "chapter": 19, "verse": 25, "ayat_id": 16951, "title": "", "ayt_text": "Pukullah pencemooh, maka orang naif akan menjadi bijak; tegurlah orang berpengertian, maka dia akan memahami pengetahuan.", "words": [{"pos": 1, "word_orig": "לֵ֣ץ", "strong": "H3887", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pencemooh"}, {"pos": 2, "word_orig": "תַּ֭כֶּה", "strong": "H5221", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "Pukullah"}, {"pos": 3, "word_orig": "וּ/פֶ֣תִי", "strong": "H6612", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "יַעְרִ֑ם", "strong": "H6191", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 5, "word_orig": "וְ/הוֹכִ֥יחַ", "strong": "H3198", "morph": "HC/Vhc", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperatif", "ayt_word": "tegurlah"}, {"pos": 6, "word_orig": "לְ֝/נָב֗וֹן", "strong": "H995", "morph": "HR/VNrmsa", "morph_id": "Preposisi + Verba Nifal", "ayt_word": "berpengertian"}, {"pos": 7, "word_orig": "יָבִ֥ין", "strong": "H995", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memahami"}, {"pos": 8, "word_orig": "דָּֽעַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 20, "chapter": 19, "verse": 26, "ayat_id": 16952, "title": "", "ayt_text": "Mereka yang menganiaya ayahnya dan mengusir ibunya adalah anak yang memalukan dan mendatangkan cela.", "words": [{"pos": 1, "word_orig": "מְֽשַׁדֶּד", "strong": "H7703", "morph": "HVprmsc", "morph_id": "Verba Piel", "ayt_word": "menganiaya"}, {"pos": 2, "word_orig": "אָ֭ב", "strong": "H1", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ayahnya"}, {"pos": 3, "word_orig": "יַבְרִ֣יחַ", "strong": "H1272", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengusir"}, {"pos": 4, "word_orig": "אֵ֑ם", "strong": "H517", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "ibunya"}, {"pos": 5, "word_orig": "בֵּ֝֗ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 6, "word_orig": "מֵבִ֥ישׁ", "strong": "H954", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memalukan"}, {"pos": 7, "word_orig": "וּ/מַחְפִּֽיר", "strong": "H2659", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "mendatangkan"}]}, {"book": 20, "chapter": 19, "verse": 27, "ayat_id": 16953, "title": "", "ayt_text": "Anakku, berhentilah mendengarkan didikan, maka kamu akan tersesat dari perkataan pengetahuan.", "words": [{"pos": 1, "word_orig": "חַֽדַל", "strong": "H2308", "morph": "HVqv2ms"