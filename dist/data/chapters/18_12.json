yt_word": "ada"}, {"pos": 9, "word_orig": "יִפָּתֵֽחַ", "strong": "H6605", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membebaskannya"}]}, {"book": 18, "chapter": 12, "verse": 15, "ayat_id": 13144, "title": "", "ayt_text": "Jika Dia menahan air, semuanya menjadi kering. Jika Dia melepaskannya, semuanya akan menenggelamkan tanah.", "words": [{"pos": 1, "word_orig": "הֵ֤ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יַעְצֹ֣ר", "strong": "H6113", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menahan"}, {"pos": 3, "word_orig": "בַּ/מַּ֣יִם", "strong": "H4325", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}, {"pos": 4, "word_orig": "וְ/יִבָ֑שׁוּ", "strong": "H3001", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menjadi"}, {"pos": 5, "word_orig": "וִֽ֝/ישַׁלְּחֵ֗/ם", "strong": "H7971", "morph": "HC/Vpi3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "melepaskannya"}, {"pos": 6, "word_orig": "וְ/יַ֖הַפְכוּ", "strong": "H2015", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menenggelamkan"}, {"pos": 7, "word_orig": "אָֽרֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "tanah"}]}, {"book": 18, "chapter": 12, "verse": 16, "ayat_id": 13145, "title": "", "ayt_text": "Pada-Nya ada kekuatan dan suara hikmat. Orang yang tertipu dan orang yang menipu, keduanya adalah milik-Nya.", "words": [{"pos": 1, "word_orig": "עִ֭מּ/וֹ", "strong": "H5973", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "Pada-Nya"}, {"pos": 2, "word_orig": "עֹ֣ז", "strong": "H5797", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatan"}, {"pos": 3, "word_orig": "וְ/תֽוּשִׁיָּ֑ה", "strong": "H8454", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "suara"}, {"pos": 4, "word_orig": "ל֝֗/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 5, "word_orig": "שֹׁגֵ֥ג", "strong": "H7683", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "tertipu"}, {"pos": 6, "word_orig": "וּ/מַשְׁגֶּֽה", "strong": "H7686", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "menipu"}]}, {"book": 18, "chapter": 12, "verse": 17, "ayat_id": 13146, "title": "", "ayt_text": "Dia menuntun para penasihat yang pergi dengan bertelanjang kaki, dan Dia membuat para hakim menjadi bodoh.", "words": [{"pos": 1, "word_orig": "מוֹלִ֣יךְ", "strong": "H3212", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "pergi"}, {"pos": 2, "word_orig": "יוֹעֲצִ֣ים", "strong": "H3289", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "penasihat"}, {"pos": 3, "word_orig": "שׁוֹלָ֑ל", "strong": "H7758", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bertelanjang"}, {"pos": 4, "word_orig": "וְֽ/שֹׁפְטִ֥ים", "strong": "H8199", "morph": "HC/Vqrmpa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "hakim"}, {"pos": 5, "word_orig": "יְהוֹלֵֽל", "strong": "H1984", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bodoh"}]}, {"book": 18, "chapter": 12, "verse": 18, "ayat_id": 13147, "title": "", "ayt_text": "Allah melepaskan ikatan raja-raja, dan mengikat pinggang mereka dengan ikat pinggang.", "words": [{"pos": 1, "word_orig": "מוּסַ֣ר", "strong": "H4148", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "ikatan"}, {"pos": 2, "word_orig": "מְלָכִ֣ים", "strong": "H4428", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja-raja"}, {"pos": 3, "word_orig": "פִּתֵּ֑חַ", "strong": "H6605", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melepaskan"}, {"pos": 4, "word_orig": "וַ/יֶּאְסֹ֥ר", "strong": "H631", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengikat"}, {"pos": 5, "word_orig": "אֵ֝ז֗וֹר", "strong": "H232", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pinggang"}, {"pos": 6, "word_orig": "בְּ/מָתְנֵי/הֶֽם", "strong": "H4975", "morph": "HR/Ncmdc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Konstruk (Terikat) + Sp3mp", "ayt_word": "pinggang"}]}, {"book": 18, "chapter": 12, "verse": 19, "ayat_id": 13148, "title": "", "ayt_text": "Dia menuntun para imam pergi dengan bertelanjang kaki, dan menggulingkan orang-orang yang berkuasa.", "words": [{"pos": 1, "word_orig": "מוֹלִ֣יךְ", "strong": "H3212", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "pergi"}, {"pos": 2, "word_orig": "כֹּהֲנִ֣ים", "strong": "H3548", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "imam"}, {"pos": 3, "word_orig": "שׁוֹלָ֑ל", "strong": "H7758", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kaki"}, {"pos": 4, "word_orig": "וְ/אֵֽתָנִ֣ים", "strong": "H386", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "yang"}, {"pos": 5, "word_orig": "יְסַלֵּֽף", "strong": "H5557", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menggulingkan"}]}, {"book": 18, "chapter": 12, "verse": 20, "ayat_id": 13149, "title": "", "ayt_text": "Allah membungkam pembicaraan orang-orang yang dipercaya, dan menyingkirkan kearifan para tua-tua.", "words": [{"pos": 1, "word_orig": "מֵסִ֣יר", "strong": "H5493", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "membungkam"}, {"pos": 2, "word_orig": "שָׂ֭פָה", "strong": "H8193", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pembicaraan"}, {"pos": 3, "word_orig": "לְ/נֶאֱמָנִ֑ים", "strong": "H539", "morph": "HR/VNrmpa", "morph_id": "Preposisi + Verba Nifal", "ayt_word": "dipercaya"}, {"pos": 4, "word_orig": "וְ/טַ֖עַם", "strong": "H2940", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kearifan"}, {"pos": 5, "word_orig": "זְקֵנִ֣ים", "strong": "H2205", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "para"}, {"pos": 6, "word_orig": "יִקָּֽח", "strong": "H3947", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyingkirkan"}]}, {"book": 18, "chapter": 12, "verse": 21, "ayat_id": 13150, "title": "", "ayt_text": "Dia menuangkan penghinaan ke atas para pangeran, dan melepaskan ikat pinggang orang-orang yang berkuasa.", "words": [{"pos": 1, "word_orig": "שׁוֹפֵ֣ךְ", "strong": "H8210", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menuangkan"}, {"pos": 2, "word_orig": "בּ֭וּז", "strong": "H937", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penghinaan"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 4, "word_orig": "נְדִיבִ֑ים", "strong": "H5081", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "pangeran"}, {"pos": 5, "word_orig": "וּ/מְזִ֖יחַ", "strong": "H4206", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "ikat"}, {"pos": 6, "word_orig": "אֲפִיקִ֣ים", "strong": "H650", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "berkuasa"}, {"pos": 7, "word_orig": "רִפָּֽה", "strong": "H7503", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melepaskan"}]}, {"book": 18, "chapter": 12, "verse": 22, "ayat_id": 13151, "title": "", "ayt_text": "Dia mengungkapkan kelamnya kegelapan, dan membawa bayang-bayang kelam menuju terang.", "words": [{"pos": 1, "word_orig": "מְגַלֶּ֣ה", "strong": "H1540", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "mengungkapkan"}, {"pos": 2, "word_orig": "עֲ֭מֻקוֹת", "strong": "H6013", "morph": "HAafpa", "morph_id": "Aafpa", "ayt_word": "kelamnya"}, {"pos": 3, "word_orig": "מִנִּי", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 4, "word_orig": "חֹ֑שֶׁךְ", "strong": "H2822", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}, {"pos": 5, "word_orig": "וַ/יֹּצֵ֖א", "strong": "H3318", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menuju"}, {"pos": 6, "word_orig": "לָ/א֣וֹר", "strong": "H216", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "terang"}, {"pos": 7, "word_orig": "צַלְמָֽוֶת", "strong": "H6757", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bayang-bayang"}]}, {"book": 18, "chapter": 12, "verse": 23, "ayat_id": 13152, "title": "", "ayt_text": "Dia membuat bangsa-bangsa menjadi besar, lalu menghancurkan mereka. Dia membesarkan bangsa-bangsa, lalu menuntun mereka pergi.", "words": [{"pos": 1, "word_orig": "מַשְׂגִּ֣יא", "strong": "H7679", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "besar"}, {"pos": 2, "word_orig": "לַ֭/גּוֹיִם", "strong": "H1471", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 3, "word_orig": "וַֽ/יְאַבְּדֵ֑/ם", "strong": "H6", "morph": "HC/Vpw3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "menghancurkan"}, {"pos": 4, "word_orig": "שֹׁטֵ֥חַ", "strong": "H7849", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membesarkan"}, {"pos": 5, "word_orig": "לַ֝/גּוֹיִ֗ם", "strong": "H1471", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 6, "word_orig": "וַ/יַּנְחֵֽ/ם", "strong": "H5148", "morph": "HC/Vhw3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "menuntun"}]}, {"book": 18, "chapter": 12, "verse": 24, "ayat_id": 13153, "title": "", "ayt_text": "Dia mencabut pengertian dari para pemimpin di bumi, membuat mereka mengembara di padang belantara yang tanpa jalan.", "words": [{"pos": 1, "word_orig": "מֵסִ֗יר", "strong": "H5493", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "mencabut"}, {"pos": 2, "word_orig": "לֵ֭ב", "strong": "H3820", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pengertian"}, {"pos": 3, "word_orig": "רָאשֵׁ֣י", "strong": "H7218", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "pemimpin"}, {"pos": 4, "word_orig": "עַם", "strong": "H5971", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": ""}, {"pos": 5, "word_orig": "הָ/אָ֑רֶץ", "strong": "H776", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 6, "word_orig": "וַ֝/יַּתְעֵ֗/ם", "strong": "H8582", "morph": "HC/Vhw3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "membuat"}, {"pos": 7, "word_orig": "בְּ/תֹ֣הוּ", "strong": "H8414", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "padang"}, {"pos": 8, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tanpa"}, {"pos": 9, "word_orig": "דָֽרֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}]}, {"book": 18, "chapter": 12, "verse": 25, "ayat_id": 13154, "title": "", "ayt_text": "Mereka meraba-raba dalam kegelapan tanpa cahaya, dan Dia membuat mereka sempoyongan seperti orang mabuk.”", "words": [{"pos": 1, "word_orig": "יְמַֽשְׁשׁוּ", "strong": "H4959", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "meraba-raba"}, {"pos": 2, "word_orig": "חֹ֥שֶׁךְ", "strong": "H2822", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}, {"pos": 3, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tanpa"}, {"pos": 4, "word_orig": "א֑וֹר", "strong": "H216", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "cahaya"}, {"pos": 5, "word_orig": "וַ֝/יַּתְעֵ֗/ם", "strong": "H8582", "morph": "HC/Vhw3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "membuat"}, {"pos": 6, "word_orig": "כַּ/שִּׁכּֽוֹר", "strong": "H7910", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "mabuk"}]}]