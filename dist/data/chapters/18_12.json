at) Laki-laki Tunggal Absolut", "ayt_word": "langit-langit"}, {"pos": 6, "word_orig": "אֹ֣כֶל", "strong": "H400", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "makanan"}, {"pos": 7, "word_orig": "יִטְעַם", "strong": "H2938", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencicip"}, {"pos": 8, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 18, "chapter": 12, "verse": 12, "ayat_id": 13141, "title": "", "ayt_text": "Hikmat ada bersama orang-orang yang berumur, dan pengertian ada pada panjangnya umur.", "words": [{"pos": 1, "word_orig": "בִּֽ/ישִׁישִׁ֥ים", "strong": "H3453", "morph": "HR/Aampa", "morph_id": "Preposisi + Aampa", "ayt_word": "berumur"}, {"pos": 2, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Hikmat"}, {"pos": 3, "word_orig": "וְ/אֹ֖רֶךְ", "strong": "H753", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "panjangnya"}, {"pos": 4, "word_orig": "יָמִ֣ים", "strong": "H3117", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": ""}, {"pos": 5, "word_orig": "תְּבוּנָֽה", "strong": "H8394", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}]}, {"book": 18, "chapter": 12, "verse": 13, "ayat_id": 13142, "title": "", "ayt_text": "Pada Allah ada hikmat dan kekuasaan; Nasihat dan pengertian adalah milik-Nya.", "words": [{"pos": 1, "word_orig": "עִ֭מּ/וֹ", "strong": "H5973", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "Pada"}, {"pos": 2, "word_orig": "חָכְמָ֣ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 3, 