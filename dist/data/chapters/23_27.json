tu"}, {"pos": 3, "word_orig": "כֶּ֥רֶם", "strong": "H3754", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "kebun"}, {"pos": 4, "word_orig": "חֶ֖מֶד", "strong": "H2531", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "indah"}, {"pos": 5, "word_orig": "עַנּוּ", "strong": "H6030", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "bernyanyilah"}, {"pos": 6, "word_orig": "לָֽ/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}]}, {"book": 23, "chapter": 27, "verse": 3, "ayat_id": 18155, "title": "", "ayt_text": "“Akulah, TUHAN, yang menjaganya. Aku menyiramnya setiap waktu. Jangan ada seorang pun yang mengganggunya, Aku akan menjaganya siang dan malam.", "words": [{"pos": 1, "word_orig": "אֲנִ֤י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Akulah"}, {"pos": 2, "word_orig": "יְהוָה֙", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "נֹֽצְרָ֔/הּ", "strong": "H5341", "morph": "HVqrmsc/Sp3fs", "morph_id": "Verba Qal + Sp3fs", "ayt_word": "menjaganya"}, {"pos": 4, "word_orig": "לִ/רְגָעִ֖ים", "strong": "H7281", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "waktu"}, {"pos": 5, "word_orig": "אַשְׁקֶ֑/נָּה", "strong": "H8248", "morph": "HVhi1cs/Sp3fs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3fs", "ayt_word": "menyiramnya"}, {"pos": 6, "word_orig": "פֶּ֚ן", "strong": "H6435", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jangan"}, {"pos": 7, "word_orig": "יִפְקֹ֣ד", "strong": "H6485", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengganggunya"}, {"pos": 8, "word_orig": "עָלֶ֔י/הָ", "strong": "H5921", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}, {"pos": 9, "word_orig": "לַ֥יְלָה", "strong": "H3915", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 10, "word_orig": "וָ/י֖וֹם", "strong": "H3117", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "siang"}, {"pos": 11, "word_orig": "אֶצֳּרֶֽ/נָּה", "strong": "H5341", "morph": "HVqi1cs/Sp3fs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal + Sp3fs", "ayt_word": "menjaganya"}]}, {"book": 23, "chapter": 27, "verse": 4, "ayat_id": 18156, "title": "", "ayt_text": "Tidak ada murka pada-Ku. Jika ada duri dan onak, aku akan maju membasminya, dan aku akan membakarnya sekaligus.", "words": [{"pos": 1, "word_orig": "חֵמָ֖ה", "strong": "H2534", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "murka"}, {"pos": 2, "word_orig": "אֵ֣ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Tidak"}, {"pos": 3, "word_orig": "לִ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 4, "word_orig": "מִֽי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Jika"}, {"pos": 5, "word_orig": "יִתְּנֵ֜/נִי", "strong": "H5414", "morph": "HVqi3ms/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "שָׁמִ֥יר", "strong": "H8068", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "onak"}, {"pos": 7, "word_orig": "שַׁ֨יִת֙", "strong": "H7898", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "duri"}, {"pos": 8, "word_orig": "בַּ/מִּלְחָמָ֔ה", "strong": "H4421", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "membasminya"}, {"pos": 9, "word_orig": "אֶפְשְׂעָ֥ה", "strong": "H6585", "morph": "HVqh1cs", "morph_id": "Verba Qal Orang ke-1 Tunggal", "ayt_word": "maju"}, {"pos": 10, "word_orig": "בָ֖/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}, {"pos": 11, "word_orig": "אֲצִיתֶ֥/נָּה", "strong": "H6702", "morph": "HVhi1cs/Sp3fs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3fs", "ayt_word": "membakarnya"}, {"pos": 12, "word_orig": "יָּֽחַד", "strong": "H3162", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "sekaligus"}]}, {"book": 23, "chapter": 27, "verse": 5, "ayat_id": 18157, "title": "", "ayt_text": "Jika tidak mau seperti itu, biarlah mereka bersandar pada perlindungan-Ku, biarlah mereka berdamai dengan-Ku, ya, biarlah mereka berdamai dengan-Ku.", "words": [{"pos": 1, "word_orig": "א֚וֹ", "strong": "H176", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "יַחֲזֵ֣ק", "strong": "H2388", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersandar"}, {"pos": 3, "word_orig": "בְּ/מָעוּזִּ֔/י", "strong": "H4581", "morph": "HR/Ncmsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "perlindungan-Ku"}, {"pos": 4, "word_orig": "יַעֲשֶׂ֥ה", "strong": "H6213", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdamai"}, {"pos": 5, "word_orig": "שָׁל֖וֹם", "strong": "H7965", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berdamai"}, {"pos": 6, "word_orig": "לִ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 7, "word_orig": "שָׁל֖וֹם", "strong": "H7965", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berdamai"}, {"pos": 8, "word_orig": "יַֽעֲשֶׂה", "strong": "H6213", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdamai"}, {"pos": 9, "word_orig": "לִּֽ/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}]}, {"book": 23, "chapter": 27, "verse": 6, "ayat_id": 18158, "title": "", "ayt_text": "Pada masa yang akan datang, Yakub akan berakar, Israel akan bertunas dan berbunga serta memenuhi permukaan bumi dengan buahnya.”", "words": [{"pos": 1, "word_orig": "הַ/בָּאִים֙", "strong": "H935", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "datang"}, {"pos": 2, "word_orig": "יַשְׁרֵ֣שׁ", "strong": "H8327", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berakar"}, {"pos": 3, "word_orig": "יַֽעֲקֹ֔ב", "strong": "H3290", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yakub"}, {"pos": 4, "word_orig": "יָצִ֥יץ", "strong": "H6692", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertunas"}, {"pos": 5, "word_orig": "וּ/פָרַ֖ח", "strong": "H6524", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "berbunga"}, {"pos": 6, "word_orig": "יִשְׂרָאֵ֑ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 7, "word_orig": "וּ/מָלְא֥וּ", "strong": "H4390", "morph": "HC/Vqq3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Jamak", "ayt_word": "memenuhi"}, {"pos": 8, "word_orig": "פְנֵי", "strong": "H6440", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "permukaan"}, {"pos": 9, "word_orig": "תֵבֵ֖ל", "strong": "H8398", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 10, "word_orig": "תְּנוּבָֽה", "strong": "H8570", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "buahnya"}]}, {"book": 23, "chapter": 27, "verse": 7, "ayat_id": 18159, "title": "", "ayt_text": "Apakah Dia memukul umat-Nya seperti Dia memukul mereka yang memukul umat-Nya? Atau, apakah Dia akan membunuh umat-Nya seperti Dia membunuh mereka yang membunuh umat-Nya?", "words": [{"pos": 1, "word_orig": "הַ/כְּ/מַכַּ֥ת", "strong": "H4347", "morph": "HTi/R/Ncfsc", "morph_id": "Ti + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "memukul"}, {"pos": 2, "word_orig": "מַכֵּ֖/הוּ", "strong": "H5221", "morph": "HVhrmsc/Sp3ms", "morph_id": "Verba Hifil + Sp3ms", "ayt_word": "memukul"}, {"pos": 3, "word_orig": "הִכָּ֑/הוּ", "strong": "H5221", "morph": "HVhp3ms/Sp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "memukul"}, {"pos": 4, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Atau"}, {"pos": 5, "word_orig": "כְּ/הֶ֥רֶג", "strong": "H2027", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "membunuh"}, {"pos": 6, "word_orig": "הֲרֻגָ֖י/ו", "strong": "H2026", "morph": "HVqsmpc/Sp3ms", "morph_id": "Verba Qal Partisip Pasif + Sp3ms", "ayt_word": "membunuh"}, {"pos": 7, "word_orig": "הֹרָֽג", "strong": "H2026", "morph": "HVPp3ms", "morph_id": "Verba Pual Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membunuh"}]}, {"book": 23, "chapter": 27, "verse": 8, "ayat_id": 18160, "title": "", "ayt_text": "Dengan menghalau dan mengusir mereka, Engkau melawan mereka. Dia membuang mereka dengan napas-Nya yang dahsyat pada waktu angin timur.", "words": [{"pos": 1, "word_orig": "בְּ/סַּאסְּאָ֖ה", "strong": "H5432", "morph": "HR/Vlc", "morph_id": "Preposisi + Verba Imperatif", "ayt_word": "menghalau"}, {"pos": 2, "word_orig": "בְּ/שַׁלְחָ֣/הּ", "strong": "H7971", "morph": "HR/Vpc/Sp3fs", "morph_id": "Preposisi + Verba Piel Imperatif + Sp3fs", "ayt_word": "mengusir"}, {"pos": 3, "word_orig": "תְּרִיבֶ֑/נָּה", "strong": "H7378", "morph": "HVqi2ms/Sp3fs", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal + Sp3fs", "ayt_word": "melawan"}, {"pos": 4, "word_orig": "הָגָ֛ה", "strong": "H1898", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuang"}, {"pos": 5, "word_orig": "בְּ/רוּח֥/וֹ", "strong": "H7307", "morph": "HR/Ncbsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "napas-Nya"}, {"pos": 6, "word_orig": "הַ/קָּשָׁ֖ה", "strong": "H7186", "morph": "HTd/Aafsa", "morph_id": "Artikel Definit (הַ) + Aafsa", "ayt_word": "dahsyat"}, {"pos": 7, "word_orig": "בְּ/י֥וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "waktu"}, {"pos": 8, "word_orig": "קָדִֽים", "strong": "H6921", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "timur"}]}, {"book": 23, "chapter": 27, "verse": 9, "ayat_id": 18161, "title": "", "ayt_text": "Karena itu, dengan cara itulah kesalahan Yakub dihapuskan; itulah buah dari penyingkiran dosanya ketika dia menyusun semua batu mazbah seperti batu-batu kapur yang dipecah-pecahkan, Asyera dan mazbah-mazbah pedupaan tidak akan ada lagi.", "words": [{"pos": 1, "word_orig": "לָ/כֵ֗ן", "strong": "H3651", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "cara"}, {"pos": 2, "word_orig": "בְּ/זֹאת֙", "strong": "H2063", "morph": "HR/Pdxfs", "morph_id": "Preposisi + Pdxfs", "ayt_word": "itulah"}, {"pos": 3, "word_orig": "יְכֻפַּ֣ר", "strong": "H3722", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dihapuskan"}, {"pos": 4, "word_orig": "עֲוֺֽן", "strong": "H5771", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "kesalahan"}, {"pos": 5, "word_orig": "יַעֲקֹ֔ב", "strong": "H3290", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yaku