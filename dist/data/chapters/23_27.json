[{"book": 23, "chapter": 27, "verse": 1, "ayat_id": 18153, "title": "Israel Diselamatkan", "ayt_text": "Pada waktu itu, TUHAN akan menghukum Lewiatan, si ular yang melarikan diri itu, dengan pedang-Nya yang besar, kuat, dan keras; Lewiatan, si ular yang meliuk-liuk itu, dan membunuh naga yang tinggal di laut itu.", "words": [{"pos": 1, "word_orig": "בַּ/יּ֣וֹם", "strong": "H3117", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 2, "word_orig": "הַ/ה֡וּא", "strong": "H1931", "morph": "HTd/Pp3ms", "morph_id": "Artikel Definit (הַ) + Pp3ms", "ayt_word": "itu"}, {"pos": 3, "word_orig": "יִפְקֹ֣ד", "strong": "H6485", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghukum"}, {"pos": 4, "word_orig": "יְהוָה֩", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "בְּ/חַרְב֨/וֹ", "strong": "H2719", "morph": "HR/Ncfsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "pedang-Nya"}, {"pos": 6, "word_orig": "הַ/קָּשָׁ֜ה", "strong": "H7186", "morph": "HTd/Aafsa", "morph_id": "Artikel Definit (הַ) + Aafsa", "ayt_word": "keras"}, {"pos": 7, "word_orig": "וְ/הַ/גְּדוֹלָ֣ה", "strong": "H1419", "morph": "HC/Td/Aafsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Aafsa", "ayt_word": "besar"}, {"pos": 8, "word_orig": "וְ/הַֽ/חֲזָקָ֗ה", "strong": "H2389", "morph": "HC/Td/Aafsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Aafsa", "ayt_word": "kuat"}, {"pos": 9, "word_orig": "עַ֤ל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 10, "word_orig": "לִוְיָתָן֙", "strong": "H3882", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Lewiatan"}, {"pos": 11, "word_orig": "נָחָ֣שׁ", "strong": "H5175", "morph": "HNcmsa", "morph_id": "Nomina Konstruk