struk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "raunganku"}, {"pos": 6, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "sepanjang"}, {"pos": 7, "word_orig": "הַ/יּֽוֹם", "strong": "H3117", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}]}, {"book": 19, "chapter": 32, "verse": 4, "ayat_id": 14360, "title": "", "ayt_text": "Sebab, siang dan malam, tangan-Mu membebani aku, kekuatanku berubah menjadi musim kemarau yang kering. (Sela)", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "יוֹמָ֣ם", "strong": "H3119", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "siang"}, {"pos": 3, "word_orig": "וָ/לַיְלָה֮", "strong": "H3915", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 4, "word_orig": "תִּכְבַּ֥ד", "strong": "H3513", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "membebani"}, {"pos": 5, "word_orig": "עָלַ֗/י", "strong": "H5921", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "יָ֫דֶ֥/ךָ", "strong": "H3027", "morph": "HNcbsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "tangan-Mu"}, {"pos": 7, "word_orig": "נֶהְפַּ֥ךְ", "strong": "H2015", "morph": "HVNp3ms", "morph_id": "Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berubah"}, {"pos": 8, "word_orig": "לְשַׁדִּ֑/י", "strong": "H3955", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekuatanku"}, {"pos": 9, "word_orig": "בְּ/חַרְבֹ֖נֵי", "strong": "H2725", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "kering"}, {"pos": 10, "word_orig": "קַ֣יִץ", "strong": "H7019", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kemarau"}, {"pos": 11, "word_orig": "סֶֽלָה", "strong": "H5542", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Sela"}]}, {"book": 19, "chapter": 32, "verse": 5, "ayat_id": 14361, "title": "", "ayt_text": "Aku mengakui dosaku, dan aku tidak menyembunyikan kesalahanku. Aku berkata, “Aku akan mengakui pelanggaran-pelanggaranku kepada TUHAN.” Dan, Engkau mengampuni kesalahan dosa-dosaku. (Sela)", "words": [{"pos": 1, "word_orig": "חַטָּאתִ֨/י", "strong": "H2403", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "dosaku"}, {"pos": 2, "word_orig": "אוֹדִ֪יעֲ/ךָ֡", "strong": "H3045", "morph": "HVhi1cs/Sp2ms", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp2ms", "ayt_word": "mengakui"}, {"pos": 3, "word_orig": "וַ/עֲוֺ֘נִ֤/י", "strong": "H5771", "morph": "HC/Ncbsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kesalahanku"}, {"pos": 4, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "כִסִּ֗יתִי", "strong": "H3680", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "menyembunyikan"}, {"pos": 6, "word_orig": "אָמַ֗רְתִּי", "strong": "H559", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berkata"}, {"pos": 7, "word_orig": "אוֹדֶ֤ה", "strong": "H3034", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "mengakui"}, {"pos": 8, "word_orig": "עֲלֵ֣י", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 9, "word_orig": "פְ֭שָׁעַ/י", "strong": "H658