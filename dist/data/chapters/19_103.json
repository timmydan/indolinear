 [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "ketika"}, {"pos": 2, "word_orig": "ר֣וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "angin"}, {"pos": 3, "word_orig": "עָֽבְרָה", "strong": "H5674", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menerpanya"}, {"pos": 4, "word_orig": "בּ֣/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 5, "word_orig": "וְ/אֵינֶ֑/נּוּ", "strong": "H369", "morph": "HC/Tn/Sp3ms", "morph_id": "Konjungsi (וְ) + Tn + Sp3ms", "ayt_word": "lenyap"}, {"pos": 6, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יַכִּירֶ֖/נּוּ", "strong": "H5234", "morph": "HVhi3ms/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "mengenalnya"}, {"pos": 8, "word_orig": "ע֣וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lagi"}, {"pos": 9, "word_orig": "מְקוֹמֽ/וֹ", "strong": "H4725", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tempatnya"}]}, {"book": 19, "chapter": 103, "verse": 17, "ayat_id": 15567, "title": "", "ayt_text": "Namun, kasih setia TUHAN dari selamanya sampai selamanya terhadap orang-orang yang takut akan Dia, dan keadilan-Nya bagi anak cucu mereka;", "words": [{"pos": 1, "word_orig": "וְ/חֶ֤סֶד", "strong": "H2617", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kasih"}, {"pos": 2, "word_orig": "יְהוָ֨ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "מֵ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomin