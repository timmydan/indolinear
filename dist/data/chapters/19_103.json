[{"book": 19, "chapter": 103, "verse": 1, "ayat_id": 15551, "title": "Pujilah TUHAN, Hai Jiwaku!", "ayt_text": "Mazmur Daud. Pujilah TUHAN, hai jiwaku! Segenap batinku, pujilah nama-Nya yang kudus!", "words": [{"pos": 1, "word_orig": "לְ/דָוִ֨ד", "strong": "H1732", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Daud"}, {"pos": 2, "word_orig": "בָּרֲכִ֣י", "strong": "H1288", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Pujilah"}, {"pos": 3, "word_orig": "נַ֭פְשִׁ/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 4, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 5, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "וְ/כָל", "strong": "H3605", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Segenap"}, {"pos": 7, "word_orig": "קְ֝רָבַ֗/י", "strong": "H7130", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "batinku"}, {"pos": 8, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 9, "word_orig": "שֵׁ֥ם", "strong": "H8034", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama-Nya"}, {"pos": 10, "word_orig": "קָדְשֽׁ/וֹ", "strong": "H6944", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kudus"}]}, {"book": 19, "chapter": 103, "verse": 2, "ayat_id": 15552, "title": "", "ayt_text": "Pujilah TUHAN, hai jiwaku, dan jangan melupakan semua kebaikan-Nya;", "words": [{"pos": 1, "word_orig": "בָּרֲכִ֣י", "strong": "H1288", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Pujilah"}, {"pos": 2, "word_orig": "נַ֭פְשִׁ/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 3, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וְ/אַל", "strong": "H408", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "jangan"}, {"pos": 6, "word_orig": "תִּ֝שְׁכְּחִ֗י", "strong": "H7911", "morph": "HVqj2fs", "morph_id": "Verba Qal Orang ke-2 Perempuan Tunggal", "ayt_word": "melupakan"}, {"pos": 7, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 8, "word_orig": "גְּמוּלָֽי/ו", "strong": "H1576", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "kebaikan-Nya"}]}, {"book": 19, "chapter": 103, "verse": 3, "ayat_id": 15553, "title": "", "ayt_text": "yang mengampuni semua kesalahanmu, yang menyembuhkan semua penyakitmu,", "words": [{"pos": 1, "word_orig": "הַ/סֹּלֵ֥חַ", "strong": "H5545", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "mengampuni"}, {"pos": 2, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 3, "word_orig": "עֲוֺנֵ֑/כִי", "strong": "H5771", "morph": "HNcbsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "kesalahanmu"}, {"pos": 4, "word_orig": "הָ֝/רֹפֵ֗א", "strong": "H7495", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menyembuhkan"}, {"pos": 5, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "תַּחֲלֻאָֽיְ/כִי", "strong": "H8463", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "penyakitmu"}]}, {"book": 19, "chapter": 103, "verse": 4, "ayat_id": 15554, "title": "", "ayt_text": "yang menebus hidupmu dari liang kubur, yang memahkotaimu dengan kasih setia dan belas kasih,", "words": [{"pos": 1, "word_orig": "הַ/גּוֹאֵ֣ל", "strong": "H1350", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menebus"}, {"pos": 2, "word_orig": "מִ/שַּׁ֣חַת", "strong": "H7845", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kubur"}, {"pos": 3, "word_orig": "חַיָּ֑יְ/כִי", "strong": "H2416", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "hidupmu"}, {"pos": 4, "word_orig": "הַֽ֝/מְעַטְּרֵ֗/כִי", "strong": "H5849", "morph": "HTd/Vprmsc/Sp2fs", "morph_id": "Artikel Definit (הַ) + Verba Piel + Sp2fs", "ayt_word": "memahkotaimu"}, {"pos": 5, "word_orig": "חֶ֣סֶד", "strong": "H2617", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kasih"}, {"pos": 6, "word_orig": "וְ/רַחֲמִֽים", "strong": "H7356", "morph": "HC/Ncmpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kasih"}]}, {"book": 19, "chapter": 103, "verse": 5, "ayat_id": 15555, "title": "", "ayt_text": "yang memuaskanmu dengan hiasan-hiasan kebaikan, sehingga masa mudamu diperbarui bagai burung rajawali.", "words": [{"pos": 1, "word_orig": "הַ/מַּשְׂבִּ֣יַע", "strong": "H7646", "morph": "HTd/Vhrmsa", "morph_id": "Artikel Definit (הַ) + Verba Hifil", "ayt_word": "memuaskanmu"}, {"pos": 2, "word_orig": "בַּ/טּ֣וֹב", "strong": "H2896", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "kebaikan"}, {"pos": 3, "word_orig": "עֶדְיֵ֑/ךְ", "strong": "H5716", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "hiasan-hiasan"}, {"pos": 4, "word_orig": "תִּתְחַדֵּ֖שׁ", "strong": "H2318", "morph": "HVti3fs", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "diperbarui"}, {"pos": 5, "word_orig": "כַּ/נֶּ֣שֶׁר", "strong": "H5404", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "burung"}, {"pos": 6, "word_orig": "נְעוּרָֽיְ/כִי", "strong": "H5271", "morph": "HNcbpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "masa"}]}, {"book": 19, "chapter": 103, "verse": 6, "ayat_id": 15556, "title": "", "ayt_text": "TUHAN melakukan kebenaran dan keadilan bagi semua orang yang tertindas.", "words": [{"pos": 1, "word_orig": "עֹשֵׂ֣ה", "strong": "H6213", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 2, "word_orig": "צְדָק֣וֹת", "strong": "H6666", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "וּ֝/מִשְׁפָּטִ֗ים", "strong": "H4941", "morph": "HC/Ncmpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "keadilan"}, {"pos": 5, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "עֲשׁוּקִֽים", "strong": "H6231", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "tertindas"}]}, {"book": 19, "chapter": 103, "verse": 7, "ayat_id": 15557, "title": "", "ayt_text": "Dia memberitahukan jalan-jalan-Nya kepada Musa, dan perbuatan-perbuatannya kepada orang-orang Israel.", "words": [{"pos": 1, "word_orig": "יוֹדִ֣יעַ", "strong": "H3045", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberitahukan"}, {"pos": 2, "word_orig": "דְּרָכָ֣י/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalan-jalan-Nya"}, {"pos": 3, "word_orig": "לְ/מֹשֶׁ֑ה", "strong": "H4872", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Musa"}, {"pos": 4, "word_orig": "לִ/בְנֵ֥י", "strong": "H1121", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "יִ֝שְׂרָאֵ֗ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 6, "word_orig": "עֲלִילֽוֹתָי/ו", "strong": "H5949", "morph": "HNcfpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "perbuatan-perbuatannya"}]}, {"book": 19, "chapter": 103, "verse": 8, "ayat_id": 15558, "title": "", "ayt_text": "TUHAN itu berbelas kasih dan murah hati, lambat untuk marah, dan berlimpah kasih setia.", "words": [{"pos": 1, "word_orig": "רַח֣וּם", "strong": "H7349", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kasih"}, {"pos": 2, "word_orig": "וְ/חַנּ֣וּן", "strong": "H2587", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "murah"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "אֶ֖רֶךְ", "strong": "H750", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "lambat"}, {"pos": 5, "word_orig": "אַפַּ֣יִם", "strong": "H639", "morph": "HNcmda", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Absolut", "ayt_word": "marah"}, {"pos": 6, "word_orig": "וְ/רַב", "strong": "H7227", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "berlimpah"}, {"pos": 7, "word_orig": "חָֽסֶד", "strong": "H2617", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "setia"}]}, {"book": 19, "chapter": 103, "verse": 9, "ayat_id": 15559, "title": "", "ayt_text": "Dia tidak senantiasa menuntut, atau menyimpan amarah selamanya.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "לָ/נֶ֥צַח", "strong": "H5331", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "senantiasa"}, {"pos": 3, "word_orig": "יָרִ֑יב", "strong": "H7378", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menuntut"}, {"pos": 4, "word_orig": "וְ/לֹ֖א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "atau"}, {"pos": 5, "word_orig": "לְ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}, {"pos": 6, "word_orig": "יִטּֽוֹר", "strong": "H5201", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "amarah"}]}, {"book": 19, "chapter": 103, "verse": 10, "ayat_id": 15560, "title": "", "ayt_text": "Dia tidak memperlakukan kita berdasarkan dosa-dosa kita, atau membalas kita berdasarkan kesalahan-kesalahan kita.", "words": [{"pos": 1, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "כַ֭/חֲטָאֵי/נוּ", "strong": "H2399", "morph": "HR/Ncmpc/Sp1cp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-