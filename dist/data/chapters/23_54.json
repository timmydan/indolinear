ng ke-3 Laki-laki Tunggal", "ayt_word": "menyerangmu"}, {"pos": 4, "word_orig": "אֶ֖פֶס", "strong": "H657", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bukan"}, {"pos": 5, "word_orig": "מֵֽ/אוֹתִ֑/י", "strong": "H853", "morph": "HR/To/Sp1cs", "morph_id": "Preposisi + Tanda Objek (אֵת) + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "מִי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapa"}, {"pos": 7, "word_orig": "גָ֥ר", "strong": "H1481", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melawanmu"}, {"pos": 8, "word_orig": "אִתָּ֖/ךְ", "strong": "H854", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "melawanmu"}, {"pos": 9, "word_orig": "עָלַ֥יִ/ךְ", "strong": "H5921", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}, {"pos": 10, "word_orig": "יִפּֽוֹל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}]}, {"book": 23, "chapter": 54, "verse": 16, "ayat_id": 18740, "title": "", "ayt_text": "Sesungguhnya, Akulah yang telah menciptakan tukang besi, yang meniup bara api, dan menghasilkan senjata sesuai kegunaannya. Dan, Akulah yang menciptakan pemusnah untuk menghancurkan.", "words": [{"pos": 1, "word_orig": "הן", "strong": "H2005", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Sesungguhnya"}, {"pos": 2, "word_orig": "הִנֵּ֤ה", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Akulah"}, {"pos": 3, "word_orig": "אָֽנֹכִי֙", "strong": "H595", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "menciptakan"}, {"pos": 4, "word_orig": "בָּרָ֣אתִי", "strong": "H1254", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "tukang"}, {"pos": 5, "word_orig": "חָרָ֔שׁ", "strong": "H2796", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "meniup"}, {"pos": 6, "word_orig": "נֹפֵ֨חַ֙", "s