h_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 23, "chapter": 54, "verse": 11, "ayat_id": 18735, "title": "", "ayt_text": "“Hai kamu yang tertindas, yang diterjang badai, dan yang tidak dihiburkan! Lihatlah, Aku akan meletakkan alasmu dari batu hitam dan fondasimu dari batu safir.", "words": [{"pos": 1, "word_orig": "עֲנִיָּ֥ה", "strong": "H6041", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "tertindas"}, {"pos": 2, "word_orig": "סֹעֲרָ֖ה", "strong": "H5590", "morph": "HVPp3fs", "morph_id": "Verba Pual Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "diterjang"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "נֻחָ֑מָה", "strong": "H5162", "morph": "HVPp3fs", "morph_id": "Verba Pual Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "dihiburkan"}, {"pos": 5, "word_orig": "הִנֵּ֨ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 6, "word_orig": "אָנֹכִ֜י", "strong": "H595", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 7, "word_orig": "מַרְבִּ֤יץ", "strong": "H7257", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "meletakkan"}, {"pos": 8, "word_orig": "בַּ/פּוּךְ֙", "strong": "H6320", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hitam"}, {"pos": 9, "word_orig": "אֲבָנַ֔יִ/ךְ", "strong": "H68", "morph": "HNcfpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "alasmu"}, {"pos": 10, "word_orig": "וִ/יסַדְתִּ֖י/ךְ", "strong": "H3245", "morph": "HC/Vqq1cs/Sp2fs", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-1 Tunggal + Sp2fs", "ayt_word": "fondasimu"}, {"pos": 11, "word_orig": "בַּ/סַּפִּירִֽים", "strong": "H5601", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "safir"}]}, {"book": 23, "chapter": 54, "verse": 12, "ayat_id": 1