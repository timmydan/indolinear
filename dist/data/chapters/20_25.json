ayt_word": "mempermalukanmu"}, {"pos": 10, "word_orig": "אֹתְ/ךָ֣", "strong": "H853", "morph": "HTo/Sp2ms", "morph_id": "Tanda Objek (אֵת) + Sp2ms", "ayt_word": ""}, {"pos": 11, "word_orig": "רֵעֶֽ/ךָ", "strong": "H7453", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "sesamamu"}]}, {"book": 20, "chapter": 25, "verse": 9, "ayat_id": 17123, "title": "", "ayt_text": "Belalah perkaramu dengan sesamamu, dan jangan menyingkapkan rahasia orang lain,", "words": [{"pos": 1, "word_orig": "רִֽ֭יבְ/ךָ", "strong": "H7379", "morph": "HNcbsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "Belalah"}, {"pos": 2, "word_orig": "רִ֣יב", "strong": "H7378", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "perkaramu"}, {"pos": 3, "word_orig": "אֶת", "strong": "H854", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dengan"}, {"pos": 4, "word_orig": "רֵעֶ֑/ךָ", "strong": "H7453", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "sesamamu"}, {"pos": 5, "word_orig": "וְ/ס֖וֹד", "strong": "H5475", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rahasia"}, {"pos": 6, "word_orig": "אַחֵ֣ר", "strong": "H312", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "lain"}, {"pos": 7, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "jangan"}, {"pos": 8, "word_orig": "תְּגָֽל", "strong": "H1540", "morph": "HVpj2ms", "morph_id": "Verba Piel Orang ke-2 Laki-laki Tunggal", "ayt_word": "menyingkapkan"}]}, {"book": 20, "chapter": 25, "verse": 10, "ayat_id": 17124, "title": "", "ayt_text": "supaya jangan sampai orang yang mendengarnya mencemoohmu, lalu pergunjingan tentangmu tidak akan hilang.", "words": [{"pos": 1, "word_orig": "פֶּֽן", "strong": "H6435", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jangan"}, {"pos": 2, "word_orig": "יְחַסֶּדְ/ךָ֥", "strong": "H2616", "morph": "HVpi3ms/Sp2ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "mencemoohmu"}, {"pos": 3, "word_orig": "שֹׁמֵ֑עַ", "strong": "H8085", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mendengarnya"}, {"pos": 4, "word_orig": "וְ֝/דִבָּתְ/ךָ֗", "strong": "H1681", "morph": "HC/Ncfsc/Sp2ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "pergunjingan"}, {"pos": 5, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "תָשֽׁוּב", "strong": "H7725", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "hilang"}]}, {"book": 20, "chapter": 25, "verse": 11, "ayat_id": 17125, "title": "", "ayt_text": "Bagaikan buah apel emas di pinggan perak, seperti itulah perkataan yang diucapkan tepat pada waktunya.", "words": [{"pos": 1, "word_orig": "תַּפּוּחֵ֣י", "strong": "H8598", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "apel"}, {"pos": 2, "word_orig": "זָ֭הָב", "strong": "H2091", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 3, "word_orig": "בְּ/מַשְׂכִּיּ֥וֹת", "strong": "H4906", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "pinggan"}, {"pos": 4, "word_orig": "כָּ֑סֶף", "strong": "H3701", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 5, "word_orig": "דָּ֝בָ֗ר", "strong": "H1697", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkataan"}, {"pos": 6, "word_orig": "דָּבֻ֥ר", "strong": "H