"ayat_id": 17127, "title": "", "ayt_text": "Bagaikan sejuknya salju pada musim panen, seperti itulah utusan yang setia bagi mereka yang mengutusnya. Dia menyegarkan hati tuan-tuannya.", "words": [{"pos": 1, "word_orig": "כְּ/צִנַּת", "strong": "H6793", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "sejuknya"}, {"pos": 2, "word_orig": "שֶׁ֨לֶג", "strong": "H7950", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "salju"}, {"pos": 3, "word_orig": "בְּ/י֬וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "musim"}, {"pos": 4, "word_orig": "קָצִ֗יר", "strong": "H7105", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "panen"}, {"pos": 5, "word_orig": "צִ֣יר", "strong": "H6735", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "utusan"}, {"pos": 6, "word_orig": "נֶ֭אֱמָן", "strong": "H539", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "setia"}, {"pos": 7, "word_orig": "לְ/שֹׁלְחָ֑י/ו", "strong": "H7971", "morph": "HR/Vqrmpc/Sp3ms", "morph_id": "Preposisi + Verba Qal + Sp3ms", "ayt_word": "mengutusnya"}, {"pos": 8, "word_orig": "וְ/נֶ֖פֶשׁ", "strong": "H5315", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 9, "word_orig": "אֲדֹנָ֣י/ו", "strong": "H113", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "tuan-tuannya"}, {"pos": 10, "word_orig": "יָשִֽׁיב", "strong": "H7725", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyegarkan"}]}, {"book": 20, "chapter": 25, "verse": 14, "ayat_id": 17128, "title": "", "ayt_text": "Bagaik