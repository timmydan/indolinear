, {"pos": 5, "word_orig": "וְ/לֵ֥ב", "strong": "H3820", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 6, "word_orig": "מְ֝לָכִ֗ים", "strong": "H4428", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja-raja"}, {"pos": 7, "word_orig": "אֵ֣ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "חֵֽקֶר", "strong": "H2714", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terduga"}]}, {"book": 20, "chapter": 25, "verse": 4, "ayat_id": 17118, "title": "", "ayt_text": "Singkirkan sanga dari perak, maka keluarlah bejana yang indah bagi tukang perak.", "words": [{"pos": 1, "word_orig": "הָג֣וֹ", "strong": "H1898", "morph": "HVqa", "morph_id": "Verba Qal Infinitif Absolut", "ayt_word": "Singkirkan"}, {"pos": 2, "word_orig": "סִיגִ֣ים", "strong": "H5509", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sanga"}, {"pos": 3, "word_orig": "מִ/כָּ֑סֶף", "strong": "H3701", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 4, "word_orig": "וַ/יֵּצֵ֖א", "strong": "H3318", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "keluarlah"}, {"pos": 5, "word_orig": "לַ/צֹּרֵ֣ף", "strong": "H6884", "morph": "HRd/Vqrmsa", "morph_id": "Rd + Verba Qal", "ayt_word": "perak"}, {"pos": 6, "word_orig": "כֶּֽלִי", "strong": "H3627", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "yang"}]}, {"book": 20, "chapter": 25, "verse": 5, "ayat_id": 17119, "title": "", "ayt_text": "Singkirkan orang fasik dari hadapan raja, maka takhtanya akan ditegakkan oleh kebenaran.", "words": [{"pos": 1, "word_orig": "הָג֣וֹ