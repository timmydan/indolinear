strong": "H7646", "morph": "HVqi2ms/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "kekenyangan"}, {"pos": 7, "word_orig": "וַ/הֲקֵֽאתֽ/וֹ", "strong": "H6958", "morph": "HC/Vhp2ms/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Perfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "memuntahkannya"}]}, {"book": 20, "chapter": 25, "verse": 17, "ayat_id": 17131, "title": "", "ayt_text": "Biarlah kakimu jarang datang ke rumah sesamamu, supaya jangan sampai dia bosan, lalu membencimu.", "words": [{"pos": 1, "word_orig": "הֹקַ֣ר", "strong": "H3365", "morph": "HVhv2ms", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "datang"}, {"pos": 2, "word_orig": "רַ֭גְלְ/ךָ", "strong": "H7272", "morph": "HNcfsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "kakimu"}, {"pos": 3, "word_orig": "מִ/בֵּ֣ית", "strong": "H1004", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "rumah"}, {"pos": 4, "word_orig": "רֵעֶ֑/ךָ", "strong": "H7453", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "sesamamu"}, {"pos": 5, "word_orig": "פֶּן", "strong": "H6435", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jangan"}, {"pos": 6, "word_orig": "יִ֝שְׂבָּעֲ/ךָ֗", "strong": "H7646", "morph": "HVqi3ms/Sp2ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "bosan"}, {"pos": 7, "word_orig": "וּ/שְׂנֵאֶֽ/ךָ", "strong": "H8130", "morph": "HC/Vqp3ms/Sp2ms", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "membencimu"}]}, {"book": 20, "chapter": 25, "verse": 18, "ayat_id": 17132, "title": "", "ayt_text": "Bagaikan gada, atau pedang, atau anak panah yang tajam, seperti itulah orang yang mengangkat kesaksian dusta terhadap sesamany