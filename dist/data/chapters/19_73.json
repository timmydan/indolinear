[{"book": 19, "chapter": 73, "verse": 1, "ayat_id": 15022, "title": "Jilid 3<br/>(Mazmur 73-89)<br/>Pergumulan dan Pengharapan", "ayt_text": "Mazmur Asaf. Sungguh, Allah itu baik kepada Israel, kepada mereka yang hatinya murni.", "words": [{"pos": 1, "word_orig": "מִזְמ֗וֹר", "strong": "H4210", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Mazmur"}, {"pos": 2, "word_orig": "לְ/אָ֫סָ֥ף", "strong": "H623", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Asaf"}, {"pos": 3, "word_orig": "אַ֤ךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Sungguh"}, {"pos": 4, "word_orig": "ט֭וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "לְ/יִשְׂרָאֵ֥ל", "strong": "H3478", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Israel"}, {"pos": 6, "word_orig": "אֱלֹהִ֗ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 7, "word_orig": "לְ/בָרֵ֥י", "strong": "H1249", "morph": "HR/Aampc", "morph_id": "Preposisi + Aampc", "ayt_word": "murni"}, {"pos": 8, "word_orig": "לֵבָֽב", "strong": "H3824", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatinya"}]}, {"book": 19, "chapter": 73, "verse": 2, "ayat_id": 15023, "title": "", "ayt_text": "Akan tetapi, kakiku hampir tergelincir, dan langkah-langkahku hampir terpeleset.", "words": [{"pos": 1, "word_orig": "וַ/אֲנִ֗י", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": ""}, {"pos": 2, "word_orig": "כִּ֭/מְעַט", "strong": "H4592", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hampir"}, {"pos": 3, "word_orig": "נטוי", "strong": "H5186", "morph": "HVqsmsc", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "tergelincir"}, {"pos": 4, "word_orig": "נָטָ֣יוּ", "strong": "H5186", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "kakiku"}, {"pos": 5, "word_orig": "רַגְלָ֑/י", "strong": "H7272", "morph": "HNcfdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "hampir"}, {"pos": 6, "word_orig": "כְּ֝/אַ֗יִן", "strong": "H369", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "terpeleset"}, {"pos": 7, "word_orig": "שפכה", "strong": "H8210", "morph": "HVQp3fs", "morph_id": "Verba Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "langkah-langkahku"}, {"pos": 8, "word_orig": "שֻׁפְּכ֥וּ", "strong": "H8210", "morph": "HVQp3cp", "morph_id": "Verba Perfek Orang ke-3 Jamak", "ayt_word": ""}, {"pos": 9, "word_orig": "אֲשֻׁרָֽ/י", "strong": "H838", "morph": "HNcfpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": ""}]}, {"book": 19, "chapter": 73, "verse": 3, "ayat_id": 15024, "title": "", "ayt_text": "Sebab, aku iri terhadap orang sombong, ketika aku melihat kemakmuran orang fasik.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "קִ֭נֵּאתִי", "strong": "H7065", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "iri"}, {"pos": 3, "word_orig": "בַּֽ/הוֹלְלִ֑ים", "strong": "H1984", "morph": "HRd/Vqrmpa", "morph_id": "Rd + Verba Qal", "ayt_word": "sombong"}, {"pos": 4, "word_orig": "שְׁל֖וֹם", "strong": "H7965", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kemakmuran"}, {"pos": 5, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "אֶרְאֶֽה", "strong": "H7200", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "melihat"}]}, {"book": 19, "chapter": 73, "verse": 4, "ayat_id": 15025, "title": "", "ayt_text": "Sebab, tidak ada kepedihan pada mereka hingga kematian mereka; tubuh mereka gemuk.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "אֵ֖ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "ada"}, {"pos": 3, "word_orig": "חַרְצֻבּ֥וֹת", "strong": "H2784", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kepedihan"}, {"pos": 4, "word_orig": "לְ/מוֹתָ֗/ם", "strong": "H4194", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kematian"}, {"pos": 5, "word_orig": "וּ/בָרִ֥יא", "strong": "H1277", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "gemuk"}, {"pos": 6, "word_orig": "אוּלָֽ/ם", "strong": "H193", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "tubuh"}]}, {"book": 19, "chapter": 73, "verse": 5, "ayat_id": 15026, "title": "", "ayt_text": "Mereka tidak dalam kesusahan orang-orang. Mereka tidak ditimpa kemalangan seperti orang-orang.", "words": [{"pos": 1, "word_orig": "בַּ/עֲמַ֣ל", "strong": "H5999", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "kesusahan"}, {"pos": 2, "word_orig": "אֱנ֣וֹשׁ", "strong": "H582", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang-orang"}, {"pos": 3, "word_orig": "אֵינֵ֑/מוֹ", "strong": "H369", "morph": "HTn/Sp3mp", "morph_id": "Tn + Sp3mp", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "וְ/עִם", "strong": "H5973", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "seperti"}, {"pos": 5, "word_orig": "אָ֝דָ֗ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang-orang"}, {"pos": 6, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יְנֻגָּֽעוּ", "strong": "H5060", "morph": "HVPi3mp", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "kemalangan"}]}, {"book": 19, "chapter": 73, "verse": 6, "ayat_id": 15027, "title": "", "ayt_text": "Karena itu, kesombongan adalah kalung mereka, kekerasan adalah pakaiannya.", "words": [{"pos": 1, "word_orig": "לָ֭/כֵן", "strong": "H3651", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "itu"}, {"pos": 2, "word_orig": "עֲנָקַ֣תְ/מוֹ", "strong": "H6059", "morph": "HVqp3fs/Sp3mp", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "kalung"}, {"pos": 3, "word_orig": "גַאֲוָ֑ה", "strong": "H1346", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesombongan"}, {"pos": 4, "word_orig": "יַעֲטָף", "strong": "H5848", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 5, "word_orig": "שִׁ֝֗ית", "strong": "H7897", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pakaiannya"}, {"pos": 6, "word_orig": "חָמָ֥ס", "strong": "H2555", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekerasan"}, {"pos": 7, "word_orig": "לָֽ/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 19, "chapter": 73, "verse": 7, "ayat_id": 15028, "title": "", "ayt_text": "Mata mereka melotot karena kegemukan, gambaran hati mereka meluap-luap.", "words": [{"pos": 1, "word_orig": "יָ֭צָא", "strong": "H3318", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melotot"}, {"pos": 2, "word_orig": "מֵ/חֵ֣לֶב", "strong": "H2459", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegemukan"}, {"pos": 3, "word_orig": "עֵינֵ֑/מוֹ", "strong": "H5869", "morph": "HNcbdc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3mp", "ayt_word": "Mata"}, {"pos": 4, "word_orig": "עָ֝בְר֗וּ", "strong": "H5674", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "meluap-luap"}, {"pos": 5, "word_orig": "מַשְׂכִּיּ֥וֹת", "strong": "H4906", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "gambaran"}, {"pos": 6, "word_orig": "לֵבָֽב", "strong": "H3824", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}]}, {"book": 19, "chapter": 73, "verse": 8, "ayat_id": 15029, "title": "", "ayt_text": "Mereka mengejek dan dengan jahat membicarakan penindasan, mereka berbicara dalam kesombongan.", "words": [{"pos": 1, "word_orig": "יָמִ֤יקוּ", "strong": "H4167", "morph": "HVhi3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mengejek"}, {"pos": 2, "word_orig": "וִ/ידַבְּר֣וּ", "strong": "H1696", "morph": "HC/Vpi3mp", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "membicarakan"}, {"pos": 3, "word_orig": "בְ/רָ֣ע", "strong": "H7451", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "jahat"}, {"pos": 4, "word_orig": "עֹ֑שֶׁק", "strong": "H6233", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penindasan"}, {"pos": 5, "word_orig": "מִ/מָּר֥וֹם", "strong": "H4791", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesombongan"}, {"pos": 6, "word_orig": "יְדַבֵּֽרוּ", "strong": "H1696", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "berbicara"}]}, {"book": 19, "chapter": 73, "verse": 9, "ayat_id": 15030, "title": "", "ayt_text": "Mereka membuka mulut menentang langit, dan lidah mereka menjelajahi bumi.", "words": [{"pos": 1, "word_orig": "שַׁתּ֣וּ", "strong": "H8371", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menentang"}, {"pos": 2, "word_orig": "בַ/שָּׁמַ֣יִם", "strong": "H8064", "morph": "HRd/Ncmda", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Absolut", "ayt_word": "langit"}, {"pos": 3, "word_orig": "פִּי/הֶ֑ם", "strong": "H6310", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mulut"}, {"pos": 4, "word_orig": "וּ֝/לְשׁוֹנָ֗/ם", "strong": "H3956", "morph": "HC/Ncbsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "lidah"}, {"pos": 5, "word_orig": "תִּֽהֲלַ֥ךְ", "strong": "H1980", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjelajahi"}, {"pos": 6, "word_orig": "בָּ/אָֽרֶץ", "strong": "H776", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 19, "chapter": 73, "verse": 10, "ayat_id": 15031, "title": "", "ayt_text": "Karena itu, umat-Nya kembali ke sini, dan air yang penuh dialirkan kepada mereka.", "words": [{"pos": 1, "word_orig": "לָ/כֵ֤ן", "strong": "H3651", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "Karena"}, {"pos": 2, "word_orig": "ישיב", "strong": "H7725", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kembali"}, {"pos": 3, "word_orig": "יָשׁ֣וּב", "strong": "H7725", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "umat-Nya"}, {"pos": 4, "word_orig": "עַמּ֣/וֹ", "strong": "H5971", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ke"}, {"pos": 5, "word_orig": "הֲלֹ֑ם", "strong": "H1988", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "air"}, {"pos": 6, "word_orig": "וּ/מֵ֥י", "strong": "H4325", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "penuh"}, {"pos": 7, "word_orig": "מָ֝לֵ֗א", "strong": "H4392", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "dialirkan"}, {"pos": 8, "word_orig": "יִמָּ֥צוּ", "strong": "H4680", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": ""}, {"pos": 9, "word_orig": "לָֽ/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 19, "chapter": 73, "verse": 11, "ayat_id": 15032, "title": "", "ayt_text": "Mereka berkata, “Bagaimana Allah bisa tahu? Apakah ada pengetahuan pada Yang Mahatinggi?”", "words": [{"pos": 1, "word_orig": "וְֽ/אָמְר֗וּ", "strong": "H559", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "berkata"}, {"pos": 2, "word_orig": "אֵיכָ֥ה", "strong": "H349", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Bagaimana"}, {"pos": 3, "word_orig": "יָדַֽע", "strong": "H3045", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "tahu"}, {"pos": 4, "word_orig": "אֵ֑ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "וְ/יֵ֖שׁ", "strong": "H3426", "morph": "HC/Tm", "morph_id": "Konjungsi (וְ) + Tm", "ayt_word": "ada"}, {"pos": 6, "word_orig": "דֵּעָ֣ה", "strong": "H1844", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 7, "word_orig": "בְ/עֶלְיֽוֹן", "strong": "H5945", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "Yang"}]}, {"book": 19, "chapter": 73, "verse": 12, "ayat_id": 15033, "title": "", "ayt_text": "Sebenarnya, itulah orang fasik, hidup tenteram selamanya, mereka menambah kekayaannya.", "words": [{"pos": 1, "word_orig": "הִנֵּה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Sebenarnya"}, {"pos": 2, "word_orig": "אֵ֥לֶּה", "strong": "H428", "morph": "HPdxcp", "morph_id": "Pdxcp", "ayt_word": "itulah"}, {"pos": 3, "word_orig": "רְשָׁעִ֑ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 4, "word_orig": "וְ/שַׁלְוֵ֥י", "strong": "H7961", "morph": "HC/Aampc", "morph_id": "Konjungsi (וְ) + Aampc", "ayt_word": "hidup"}, {"pos": 5, "word_orig": "ע֝וֹלָ֗ם", "strong": "H5769", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}, {"pos": 6, "word_orig": "הִשְׂגּוּ", "strong": "H7685", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "menambah"}, {"pos": 7, "word_orig": "חָֽיִל", "strong": "H2428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekayaannya"}]}, {"book": 19, "chapter": 73, "verse": 13, "ayat_id": 15034, "title": "", "ayt_text": "Sebenarnya, dalam kesia-siaan, aku telah menjaga kemurnian hatiku, dan membasuh tanganku dalam ketidakbersalahan.", "words": [{"pos": 1, "word_orig": "אַךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Sebenarnya"}, {"pos": 2, "word_orig": "רִ֭יק", "strong": "H7385", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesia-siaan"}, {"pos": 3, "word_orig": "זִכִּ֣יתִי", "strong": "H2135", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "menjaga"}, {"pos": 4, "word_orig": "לְבָבִ֑/י", "strong": "H3824", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "hatiku"}, {"pos": 5, "word_orig": "וָ/אֶרְחַ֖ץ", "strong": "H7364", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "membasuh"}, {"pos": 6, "word_orig": "בְּ/נִקָּי֣וֹן", "strong": "H5356", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ketidakbersalahan"}, {"pos": 7, "word_orig": "כַּפָּֽ/י", "strong": "H3709", "morph": "HNcfdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "tanganku"}]}, {"book": 19, "chapter": 73, "verse": 14, "ayat_id": 15035, "title": "", "ayt_text": "Sebab, sepanjang hari, aku tertimpa kemalangan, dan dihajar setiap pagi.", "words": [{"pos": 1, "word_orig": "וָ/אֱהִ֣י", "strong": "H1961", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "נָ֭גוּעַ", "strong": "H5060", "morph": "HVqsmsa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "kemalangan"}, {"pos": 3, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "sepanjang"}, {"pos": 4, "word_orig": "הַ/יּ֑וֹם", "strong": "H3117", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 5, "word_orig": "וְ֝/תוֹכַחְתִּ֗/י", "strong": "H8433", "morph": "HC/Ncfsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "dihajar"}, {"pos": 6, "word_orig": "לַ/בְּקָרִֽים", "strong": "H1242", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pagi"}]}, {"book": 19, "chapter": 73, "verse": 15, "ayat_id": 15036, "title": "", "ayt_text": "Seandainya aku berkata, “Aku akan berkata seperti itu,” sebenarnya aku telah mengkhianati generasi anak-anak-Mu.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Seandainya"}, {"pos": 2, "word_orig": "אָ֭מַרְתִּי", "strong": "H559", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berkata"}, {"pos": 3, "word_orig": "אֲסַפְּרָ֥ה", "strong": "H5608", "morph": "HVph1cs", "morph_id": "Verba Piel Orang ke-1 Tunggal", "ayt_word": "berkata"}, {"pos": 4, "word_orig": "כְמ֑וֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "seperti"}, {"pos": 5, "word_orig": "הִנֵּ֤ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "sebenarnya"}, {"pos": 6, "word_orig": "ד֭וֹר", "strong": "H1755", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "generasi"}, {"pos": 7, "word_orig": "בָּנֶ֣י/ךָ", "strong": "H1121", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "anak-anak-Mu"}, {"pos": 8, "word_orig": "בָגָֽדְתִּי", "strong": "H898", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "mengkhianati"}]}, {"book": 19, "chapter": 73, "verse": 16, "ayat_id": 15037, "title": "", "ayt_text": "Ketika aku berpikir-pikir untuk mengetahui ini, hal ini sulit di mataku.", "words": [{"pos": 1, "word_orig": "וָֽ֭/אֲחַשְּׁבָ/ה", "strong": "H2803", "morph": "HC/Vpw1cs/Sh", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-1 Tunggal + Sh", "ayt_word": "berpikir-pikir"}, {"pos": 2, "word_orig": "לָ/דַ֣עַת", "strong": "H3045", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mengetahui"}, {"pos": 3, "word_orig": "זֹ֑את", "strong": "H2063", "morph": "HPdxfs", "morph_id": "Pdxfs", "ayt_word": "ini"}, {"pos": 4, "word_orig": "עָמָ֖ל", "strong": "H5999", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "sulit"}, {"pos": 5, "word_orig": "היא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "hal"}, {"pos": 6, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "mataku"}, {"pos": 7, "word_orig": "בְ/עֵינָֽ/י", "strong": "H5869", "morph": "HR/Ncbdc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": ""}]}, {"book": 19, "chapter": 73, "verse": 17, "ayat_id": 15038, "title": "", "ayt_text": "Hingga aku masuk ke tempat kudus Allah, kemudian aku mengerti kesudahan mereka.", "words": [{"pos": 1, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Hingga"}, {"pos": 2, "word_orig": "אָ֭בוֹא", "strong": "H935", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "masuk"}, {"pos": 3, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 4, "word_orig": "מִקְדְּשֵׁי", "strong": "H4720", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "tempat"}, {"pos": 5, "word_orig": "אֵ֑ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 6, "word_orig": "אָ֝בִ֗ינָה", "strong": "H995", "morph": "HVqh1cs", "morph_id": "Verba Qal Orang ke-1 Tunggal", "ayt_word": "mengerti"}, {"pos": 7, "word_orig": "לְ/אַחֲרִיתָֽ/ם", "strong": "H319", "morph": "HR/Ncfsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kesudahan"}]}, {"book": 19, "chapter": 73, "verse": 18, "ayat_id": 15039, "title": "", "ayt_text": "Sebenarnya, Engkau menempatkan mereka di tempat-tempat yang licin, Engkau menjatuhkan mereka ke dalam reruntuhan.", "words": [{"pos": 1, "word_orig": "אַ֣ךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Sebenarnya"}, {"pos": 2, "word_orig": "בַּ֭/חֲלָקוֹת", "strong": "H2513", "morph": "HR/Aafpa", "morph_id": "Preposisi + Aafpa", "ayt_word": "yang"}, {"pos": 3, "word_orig": "תָּשִׁ֣ית", "strong": "H7896", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menempatkan"}, {"pos": 4, "word_orig": "לָ֑/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 5, "word_orig": "הִ֝פַּלְתָּ֗/ם", "strong": "H5307", "morph": "HVhp2ms/Sp3mp", "morph_id": "Verba Hifil Perfek Orang ke-2 Laki-laki Tunggal + Sp3mp", "ayt_word": "menjatuhkan"}, {"pos": 6, "word_orig": "לְ/מַשּׁוּאֽוֹת", "strong": "H4876", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "reruntuhan"}]}, {"book": 19, "chapter": 73, "verse": 19, "ayat_id": 15040, "title": "", "ayt_text": "Betapa mereka binasa dalam sekejap mata, mereka habis sama sekali oleh kengerian.", "words": [{"pos": 1, "word_orig": "אֵ֤יךְ", "strong": "H349", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Betapa"}, {"pos": 2, "word_orig": "הָי֣וּ", "strong": "H1961", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": ""}, {"pos": 3, "word_orig": "לְ/שַׁמָּ֣ה", "strong": "H8047", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "binasa"}, {"pos": 4, "word_orig": "כְ/רָ֑גַע", "strong": "H7281", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mata"}, {"pos": 5, "word_orig": "סָ֥פוּ", "strong": "H5486", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "sekali"}, {"pos": 6, "word_orig": "תַ֝֗מּוּ", "strong": "H8552", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "sekali"}, {"pos": 7, "word_orig": "מִן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "oleh"}, {"pos": 8, "word_orig": "בַּלָּהֽוֹת", "strong": "H1091", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kengerian"}]}, {"book": 19, "chapter": 73, "verse": 20, "ayat_id": 15041, "title": "", "ayt_text": "Seperti mimpi ketika seseorang terbangun, ya Tuhan, ketika bangkit, Engkau akan menghina rupa mereka.", "words": [{"pos": 1, "word_orig": "כַּ/חֲל֥וֹם", "strong": "H2472", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mimpi"}, {"pos": 2, "word_orig": "מֵ/הָקִ֑יץ", "strong": "H6974", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "terbangun"}, {"pos": 3, "word_orig": "אֲ֝דֹנָ/י", "strong": "H136", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Tuhan"}, {"pos": 4, "word_orig": "בָּ/עִ֤יר", "strong": "H5782", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "bangkit"}, {"pos": 5, "word_orig": "צַלְמָ֬/ם", "strong": "H6754", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "rupa"}, {"pos": 6, "word_orig": "תִּבְזֶֽה", "strong": "H959", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menghina"}]}, {"book": 19, "chapter": 73, "verse": 21, "ayat_id": 15042, "title": "", "ayt_text": "Ketika hatiku berduka, dan buah pinggangku tertusuk-tusuk,", "words": [{"pos": 1, "word_orig": "כִּ֭י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Ketika"}, {"pos": 2, "word_orig": "יִתְחַמֵּ֣ץ", "strong": "H2556", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berduka"}, {"pos": 3, "word_orig": "לְבָבִ֑/י", "strong": "H3824", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "hatiku"}, {"pos": 4, "word_orig": "וְ֝/כִלְיוֹתַ֗/י", "strong": "H3629", "morph": "HC/Ncfpc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "pinggangku"}, {"pos": 5, "word_orig": "אֶשְׁתּוֹנָֽן", "strong": "H8150", "morph": "HVri1cs", "morph_id": "Verba Imperfek Orang ke-1 Tunggal", "ayt_word": "tertusuk-tusuk"}]}, {"book": 19, "chapter": 73, "verse": 22, "ayat_id": 15043, "title": "", "ayt_text": "aku bodoh dan tidak tahu, seperti binatang di hadapan-Mu.", "words": [{"pos": 1, "word_orig": "וַ/אֲנִי", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": "aku"}, {"pos": 2, "word_orig": "בַ֭עַר", "strong": "H1198", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "אֵדָ֑ע", "strong": "H3045", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "tahu"}, {"pos": 5, "word_orig": "בְּ֝הֵמ֗וֹת", "strong": "H929", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "binatang"}, {"pos": 6, "word_orig": "הָיִ֥יתִי", "strong": "H1961", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": ""}, {"pos": 7, "word_orig": "עִמָּֽ/ךְ", "strong": "H5973", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "hadapan-Mu"}]}, {"book": 19, "chapter": 73, "verse": 23, "ayat_id": 15044, "title": "", "ayt_text": "Namun, aku terus bersama-Mu. Engkau memegang tangan kananku.", "words": [{"pos": 1, "word_orig": "וַ/אֲנִ֣י", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": "aku"}, {"pos": 2, "word_orig": "תָמִ֣יד", "strong": "H8548", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terus"}, {"pos": 3, "word_orig": "עִמָּ֑/ךְ", "strong": "H5973", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "bersama-Mu"}, {"pos": 4, "word_orig": "אָ֝חַ֗זְתָּ", "strong": "H270", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "memegang"}, {"pos": 5, "word_orig": "בְּ/יַד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 6, "word_orig": "יְמִינִֽ/י", "strong": "H3225", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kananku"}]}, {"book": 19, "chapter": 73, "verse": 24, "ayat_id": 15045, "title": "", "ayt_text": "Engkau menuntun aku dengan nasihat-Mu, lalu Engkau membawaku kepada kemuliaan.", "words": [{"pos": 1, "word_orig": "בַּ/עֲצָתְ/ךָ֥", "strong": "H6098", "morph": "HR/Ncfsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "nasihat-Mu"}, {"pos": 2, "word_orig": "תַנְחֵ֑/נִי", "strong": "H5148", "morph": "HVhi2ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "menuntun"}, {"pos": 3, "word_orig": "וְ֝/אַחַ֗ר", "strong": "H310", "morph": "HC/D", "morph_id": "Konjungsi (וְ) + Adverbia", "ayt_word": "lalu"}, {"pos": 4, "word_orig": "כָּב֥וֹד", "strong": "H3519", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kemuliaan"}, {"pos": 5, "word_orig": "תִּקָּחֵֽ/נִי", "strong": "H3947", "morph": "HVqi2ms/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "membawaku"}]}, {"book": 19, "chapter": 73, "verse": 25, "ayat_id": 15046, "title": "", "ayt_text": "Siapa yang aku miliki di surga? Dan, bersama Engkau, Aku tidak menginginkan apa pun di atas bumi.", "words": [{"pos": 1, "word_orig": "מִי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapa"}, {"pos": 2, "word_orig": "לִ֥/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "di"}, {"pos": 3, "word_orig": "בַ/שָּׁמָ֑יִם", "strong": "H8064", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "surga"}, {"pos": 4, "word_orig": "וְ֝/עִמְּ/ךָ֗", "strong": "H5973", "morph": "HC/R/Sp2ms", "morph_id": "Konjungsi (וְ) + Preposisi + Sp2ms", "ayt_word": "bersama"}, {"pos": 5, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "חָפַ֥צְתִּי", "strong": "H2654", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "menginginkan"}, {"pos": 7, "word_orig": "בָ/אָֽרֶץ", "strong": "H776", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 19, "chapter": 73, "verse": 26, "ayat_id": 15047, "title": "", "ayt_text": "Dagingku dan hatiku boleh habis, tetapi Allah adalah gunung batu hatiku dan bagianku selama-lamanya.", "words": [{"pos": 1, "word_orig": "כָּלָ֥ה", "strong": "H3615", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "habis"}, {"pos": 2, "word_orig": "שְׁאֵרִ֗/י", "strong": "H7607", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Dagingku"}, {"pos": 3, "word_orig": "וּ/לְבָ֫בִ֥/י", "strong": "H3824", "morph": "HC/Ncmsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "hatiku"}, {"pos": 4, "word_orig": "צוּר", "strong": "H6697", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "batu"}, {"pos": 5, "word_orig": "לְבָבִ֥/י", "strong": "H3824", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) +