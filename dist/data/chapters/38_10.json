3 Jamak", "ayt_word": "melihat"}, {"pos": 7, "word_orig": "שֶׁ֔קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dusta"}, {"pos": 8, "word_orig": "וַֽ/חֲלֹמוֹת֙", "strong": "H2472", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "mimpi-mimpi"}, {"pos": 9, "word_orig": "הַ/שָּׁ֣וא", "strong": "H7723", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "palsu"}, {"pos": 10, "word_orig": "יְדַבֵּ֔רוּ", "strong": "H1696", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menceritakan"}, {"pos": 11, "word_orig": "הֶ֖בֶל", "strong": "H1892", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sia-sia"}, {"pos": 12, "word_orig": "יְנַֽחֵמ֑וּ/ן", "strong": "H5162", "morph": "HVpi3mp/Sn", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak + Sn", "ayt_word": "penghiburan"}, {"pos": 13, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Oleh"}, {"pos": 14, "word_orig": "כֵּן֙", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "itu"}, {"pos": 15, "word_orig": "נָסְע֣וּ", "strong": "H5265", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "berkeliaran"}, {"pos": 16, "word_orig": "כְמוֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "seperti"}, {"pos": 17, "word_orig": "צֹ֔אן", "strong": "H6629", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "domba"}, {"pos": 18, "word_orig": "יַעֲנ֖וּ", "strong": "H6031", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menderita"}, {"pos": 19, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Ko