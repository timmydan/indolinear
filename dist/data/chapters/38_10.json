Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 38, "chapter": 10, "verse": 8, "ayat_id": 23025, "title": "", "ayt_text": "Aku akan memanggil mereka dengan isyarat dan menghimpun mereka, karena Aku telah menebus mereka. Mereka akan bertambah banyak seperti halnya mereka telah menjadi banyak.", "words": [{"pos": 1, "word_orig": "אֶשְׁרְקָ֥ה", "strong": "H8319", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "dengan"}, {"pos": 2, "word_orig": "לָ/הֶ֛ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 3, "word_orig": "וַ/אֲקַבְּצֵ֖/ם", "strong": "H6908", "morph": "HC/Vpi1cs/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menghimpun"}, {"pos": 4, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 5, "word_orig": "פְדִיתִ֑י/ם", "strong": "H6299", "morph": "HVqp1cs/Sp3mp", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menebus"}, {"pos": 6, "word_orig": "וְ/רָב֖וּ", "strong": "H7235", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "banyak"}, {"pos": 7, "word_orig": "כְּמ֥וֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "seperti"}, {"pos": 8, "word_orig": "רָבֽוּ", "strong": "H7235", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menjadi"}]}, {"book": 38, "chapter": 10, "verse": 9, "ayat_id": 23026, "title": "", "ayt_text": "Sekalipun aku telah menyerakkan mereka ke antara bangsa-bangsa, mereka akan mengingat Aku di tempat-tempat yang jauh. Mereka akan bertahan hidup bersama anak-anak mereka, dan mereka akan kembali.", "words": [{"pos": 1, "word_orig": "וְ/אֶזְרָעֵ/ם֙", "strong": "H2232", "morph": "HC/Vqi1cs/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "men