a akan muncul batu penjuru dan dari mereka akan muncul patok kemah, dari mereka akan muncul busur perang, dari mereka akan muncul semua penguasa bersama-sama.", "words": [{"pos": 1, "word_orig": "מִמֶּ֤/נּוּ", "strong": "H4480", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": "Dari"}, {"pos": 2, "word_orig": "פִנָּה֙", "strong": "H6438", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "batu"}, {"pos": 3, "word_orig": "מִמֶּ֣/נּוּ", "strong": "H4480", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": "dari"}, {"pos": 4, "word_orig": "יָתֵ֔ד", "strong": "H3489", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "patok"}, {"pos": 5, "word_orig": "מִמֶּ֖/נּוּ", "strong": "H4480", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": "dari"}, {"pos": 6, "word_orig": "קֶ֣שֶׁת", "strong": "H7198", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "busur"}, {"pos": 7, "word_orig": "מִלְחָמָ֑ה", "strong": "H4421", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perang"}, {"pos": 8, "word_orig": "מִמֶּ֛/נּוּ", "strong": "H4480", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": "dari"}, {"pos": 9, "word_orig": "יֵצֵ֥א", "strong": "H3318", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "muncul"}, {"pos": 10, "word_orig": "כָל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 11, "word_orig": "נוֹגֵ֖שׂ", "strong": "H5065", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "penguasa"}, {"pos": 12, "word_orig": "יַחְדָּֽו", "strong": "H3162", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "bersama-sama"}]}, {"book": 38, "chapter": 10, "verse": 5, "ayat_id": 23022, "title": "", "ayt_text": "Mereka akan menjadi seperti pahlawan-pahlawan yang menginjak-injak musuh, di jalan-jalan berlumpur dalam peperangan. Mereka akan berperang, karena TUHAN menyertai mereka, dan mereka akan membuat malu para penunggang kuda.", "words": [{"pos": 1, "word_orig": "וְ/הָי֨וּ", "strong": "H1961", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menjadi"}, {"pos": 2, "word_orig": "כְ/גִבֹּרִ֜ים", "strong": "H1368", "morph": "HR/Aampa", "morph_id": "Preposisi + Aampa", "ayt_word": "pahlawan-pahlawan"}, {"pos": 3, "word_orig": "בּוֹסִ֨ים", "strong": "H947", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "menginjak-injak"}, {"pos": 4, "word_orig": "בְּ/טִ֤יט", "strong": "H2916", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "berlumpur"}, {"pos": 5, "word_orig": "חוּצוֹת֙", "strong": "H2351", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "jalan-jalan"}, {"pos": 6, "word_orig": "בַּ/מִּלְחָמָ֔ה", "strong": "H4421", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "peperangan"}, {"pos": 7, "word_orig": "וְ/נִ֨לְחֲמ֔וּ", "strong": "H3898", "morph": "HC/VNp3cp", "morph_id": "Konjungsi (וְ) + Verba Nifal Perfek Orang ke-3 Jamak", "ayt_word": "berperang"}, {"pos": 8, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 9, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 10, "word_orig": "עִמָּ֑/ם", "strong": "H5973", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": "menyertai"}, {"pos": 11, "word_orig": "וְ/הֹבִ֖ישׁוּ", "strong": "H3001", "morph": "HC/Vhp3cp", "morph_id": "Konjungsi (וְ) + Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "malu"}, {"pos": 12, "word_orig": "רֹכְבֵ֥י", "strong": "H7392", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "penunggang"}, {"pos": 13, "word_orig": "סוּסִֽים", "strong": "H5483", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kuda"}]}, {"book": 38, "chapter": 10, "verse": 6, "ayat_id": 23023, "title": "", "ayt_text": "Aku akan memperkuat kaum Yehuda, dan Aku akan menyelamatkan kaum Yusuf. Aku akan membawa mereka kembali, karena Aku berbelaskasihan kepada mereka, mereka akan menjadi orang-orang yang seolah-olah tidak pernah Aku buang karena Akulah TUHAN, Allah mereka, dan Aku akan menjawab mereka.", "words": [{"pos": 1, "word_orig": "וְ/גִבַּרְתִּ֣י", "strong": "H1396", "morph": "HC/Vpp1cs", "morph_id": "Konjungsi (וְ) + Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "memperkuat"}, {"pos": 2, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 3, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kaum"}, {"pos": 4, "word_orig": "יְהוּדָ֗ה", "strong": "H3063", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yehuda"}, {"pos": 5, "word_orig": "וְ/אֶת", "strong": "H853", "morph": "HC/To", "morph_id": "Konjungsi (וְ) + Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "בֵּ֤ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kaum"}, {"pos": 7, "word_orig": "יוֹסֵף֙", "strong": "H3130", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yusuf"}, {"pos": 8, "word_orig": "אוֹשִׁ֔יעַ", "strong": "H3467", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "menyelamatkan"}, {"pos": 9, "word_orig": "וְ/הֽוֹשְׁבוֹתִי/ם֙", "strong": "H7725", "morph": "HC/Vhp1cs/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Perfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "kembali"}, {"pos": 10, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 11, "word_orig": "רִֽחַמְתִּ֔י/ם", "strong": "H7355", "morph": "HVpp1cs/Sp3mp", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "berbelaskasihan"}, {"pos": 12, "word_orig": "וְ/הָי֖וּ", "strong": "H1961", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menjadi"}, {"pos": 13, "word_orig": "כַּ/אֲשֶׁ֣ר", "strong": "H834", "morph": "HR/Tr", "morph_id": "Preposisi + Tr", "ayt_word": "yang"}, {"pos": 14, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 15, "word_orig": "זְנַחְתִּ֑י/ם", "strong": "H2186", "morph": "HVqp1cs/Sp3mp", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "buang"}, {"pos": 16, "word_orig": "כִּ֗י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 17, "word_orig": "אֲנִ֛י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Akulah"}, {"pos": 18, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 19, "word_orig": "אֱלֹהֵי/הֶ֖ם", "strong": "H430", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "Allah"}, {"pos": 20, "word_orig": "וְ/אֶעֱנֵֽ/ם", "strong": "H6030", "morph": "HC/Vqi1cs/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menjawab"}]}, {"book": 38, "chapter": 10, "verse": 7, "ayat_id": 23024, "title": "", "ayt_text": "Efraim akan menjadi seperti seorang pahlawan, hati mereka akan bersukacita seperti seorang yang minum anggur. Anak-anak mereka akan melihatnya dan bersukacita, hati mereka akan bersorak-sorai dalam TUHAN.", "words": [{"pos": 1, "word_orig": "וְ/הָי֤וּ", "strong": "H1961", "mo