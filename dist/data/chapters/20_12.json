[{"book": 20, "chapter": 12, "verse": 1, "ayat_id": 16721, "title": "", "ayt_text": "Siapa mencintai didikan mencintai pengetahuan. tetapi mereka yang membenci teguran adalah bodoh.", "words": [{"pos": 1, "word_orig": "אֹהֵ֣ב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencintai"}, {"pos": 2, "word_orig": "מ֭וּסָר", "strong": "H4148", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "didikan"}, {"pos": 3, "word_orig": "אֹ֣הֵֽב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencintai"}, {"pos": 4, "word_orig": "דָּ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 5, "word_orig": "וְ/שֹׂנֵ֖א", "strong": "H8130", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "membenci"}, {"pos": 6, "word_orig": "תוֹכַ֣חַת", "strong": "H8433", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "teguran"}, {"pos": 7, "word_orig": "בָּֽעַר", "strong": "H1198", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}]}, {"book": 20, "chapter": 12, "verse": 2, "ayat_id": 16722, "title": "", "ayt_text": "Orang baik memperoleh perkenanan dari TUHAN, tetapi orang yang merencanakan kejahatan akan dihukum-Nya.", "words": [{"pos": 1, "word_orig": "ט֗וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "יָפִ֣יק", "strong": "H6329", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memperoleh"}, {"pos": 3, "word_orig": "רָ֭צוֹן", "strong": "H7522", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkenanan"}, {"pos": 4, "word_orig": "מֵ/יְהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וְ/אִ֖ישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 6, "word_orig": "מְזִמּ֣וֹת", "strong": "H4209", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יַרְשִֽׁיעַ", "strong": "H7561", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dihukum-Nya"}]}, {"book": 20, "chapter": 12, "verse": 3, "ayat_id": 16723, "title": "", "ayt_text": "Manusia tidak akan ditegakkan oleh kefasikan, tetapi akar orang benar tidak akan guncang.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יִכּ֣וֹן", "strong": "H3559", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ditegakkan"}, {"pos": 3, "word_orig": "אָדָ֣ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Manusia"}, {"pos": 4, "word_orig": "בְּ/רֶ֑שַׁע", "strong": "H7562", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kefasikan"}, {"pos": 5, "word_orig": "וְ/שֹׁ֥רֶשׁ", "strong": "H8328", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "akar"}, {"pos": 6, "word_orig": "צַ֝דִּיקִ֗ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 7, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "יִמּֽוֹט", "strong": "H4131", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "guncang"}]}, {"book": 20, "chapter": 12, "verse": 4, "ayat_id": 16724, "title": "", "ayt_text": "Istri yang berbudi mulia adalah mahkota suaminya, tetapi dia yang membuat malu seperti kebusukan bagi tulang suaminya.", "words": [{"pos": 1, "word_orig": "אֵֽשֶׁת", "strong": "H802", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Istri"}, {"pos": 2, "word_orig": "חַ֭יִל", "strong": "H2428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berbudi"}, {"pos": 3, "word_orig": "עֲטֶ֣רֶת", "strong": "H5850", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "mahkota"}, {"pos": 4, "word_orig": "בַּעְלָ֑/הּ", "strong": "H1167", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "suaminya"}, {"pos": 5, "word_orig": "וּ/כְ/רָקָ֖ב", "strong": "H7538", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebusukan"}, {"pos": 6, "word_orig": "בְּ/עַצְמוֹתָ֣י/ו", "strong": "H6106", "morph": "HR/Ncfpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "tulang"}, {"pos": 7, "word_orig": "מְבִישָֽׁה", "strong": "H954", "morph": "HVhrfsa", "morph_id": "Verba Hifil", "ayt_word": "membuat"}]}, {"book": 20, "chapter": 12, "verse": 5, "ayat_id": 16725, "title": "", "ayt_text": "Rencana-rencana orang benar itu adil, tetapi nasihat orang fasik itu menipu.", "words": [{"pos": 1, "word_orig": "מַחְשְׁב֣וֹת", "strong": "H4284", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "Rencana-rencana"}, {"pos": 2, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "מִשְׁפָּ֑ט", "strong": "H4941", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "adil"}, {"pos": 4, "word_orig": "תַּחְבֻּל֖וֹת", "strong": "H8458", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "nasihat"}, {"pos": 5, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "מִרְמָֽה", "strong": "H4820", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "menipu"}]}, {"book": 20, "chapter": 12, "verse": 6, "ayat_id": 16726, "title": "", "ayt_text": "Perkataan orang fasik mengadang darah, tetapi mulut orang yang lurus hati menyelamatkan mereka.", "words": [{"pos": 1, "word_orig": "דִּבְרֵ֣י", "strong": "H1697", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Perkataan"}, {"pos": 2, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "אֱרָב", "strong": "H693", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "mengadang"}, {"pos": 4, "word_orig": "דָּ֑ם", "strong": "H1818", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "darah"}, {"pos": 5, "word_orig": "וּ/פִ֥י", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 6, "word_orig": "יְ֝שָׁרִ֗ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "lurus"}, {"pos": 7, "word_orig": "יַצִּילֵֽ/ם", "strong": "H5337", "morph": "HVhi3ms/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "menyelamatkan"}]}, {"book": 20, "chapter": 12, "verse": 7, "ayat_id": 16727, "title": "", "ayt_text": "Orang fasik digulingkan sehingga mereka tidak ada lagi, tetapi rumah orang benar akan tetap berdiri.", "words": [{"pos": 1, "word_orig": "הָפ֣וֹךְ", "strong": "H2015", "morph": "HVqa", "morph_id": "Verba Qal Infinitif Absolut", "ayt_word": "digulingkan"}, {"pos": 2, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 3, "word_orig": "וְ/אֵינָ֑/ם", "strong": "H369", "morph": "HC/Tn/Sp3mp", "morph_id": "Konjungsi (וְ) + Tn + Sp3mp", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "וּ/בֵ֖ית", "strong": "H1004", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "rumah"}, {"pos": 5, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 6, "word_orig": "יַעֲמֹֽד", "strong": "H5975", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdiri"}]}, {"book": 20, "chapter": 12, "verse": 8, "ayat_id": 16728, "title": "", "ayt_text": "Seseorang dipuji sesuai dengan akal budinya, tetapi yang bengkok hatinya akan dihina.", "words": [{"pos": 1, "word_orig": "לְֽ/פִי", "strong": "H6310", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "sesuai"}, {"pos": 2, "word_orig": "שִׂ֭כְל/וֹ", "strong": "H7922", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "budinya"}, {"pos": 3, "word_orig": "יְהֻלַּל", "strong": "H1984", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dipuji"}, {"pos": 4, "word_orig": "אִ֑ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Seseorang"}, {"pos": 5, "word_orig": "וְ/נַעֲוֵה", "strong": "H5753", "morph": "HC/VNrmsc", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "bengkok"}, {"pos": 6, "word_orig": "לֵ֝֗ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatinya"}, {"pos": 7, "word_orig": "יִהְיֶ֥ה", "strong": "H1961", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "akan"}, {"pos": 8, "word_orig": "לָ/בֽוּז", "strong": "H937", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dihina"}]}, {"book": 20, "chapter": 12, "verse": 9, "ayat_id": 16729, "title": "", "ayt_text": "Lebih baik dia yang tidak terpandang, tetapi memiliki pelayan, daripada dia yang menghormati dirinya, tetapi kekurangan makanan.", "words": [{"pos": 1, "word_orig": "ט֣וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 2, "word_orig": "נִ֭קְלֶה", "strong": "H7034", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "וְ/עֶ֣בֶד", "strong": "H5650", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelayan"}, {"pos": 4, "word_orig": "ל֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 5, "word_orig": "מִ֝/מְּתַכַּבֵּ֗ד", "strong": "H3513", "morph": "HR/Vtrmsa", "morph_id": "Preposisi + Verba Hitpael", "ayt_word": "menghormati"}, {"pos": 6, "word_orig": "וַ/חֲסַר", "strong": "H2638", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "kekurangan"}, {"pos": 7, "word_orig": "לָֽחֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}]}, {"book": 20, "chapter": 12, "verse": 10, "ayat_id": 16730, "title": "", "ayt_text": "Orang benar memperhatikan nyawa hewan-hewannya, tetapi belas kasihan orang fasik itu kejam.", "words": [{"pos": 1, "word_orig": "יוֹדֵ֣עַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memperhatikan"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 3, "word_orig": "נֶ֣פֶשׁ", "strong": "H5315", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "nyawa"}, {"pos": 4, "word_orig": "בְּהֶמְתּ֑/וֹ", "strong": "H929", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hewan-hewannya"}, {"pos": 5, "word_orig": "וְֽ/רַחֲמֵ֥י", "strong": "H7356", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "kasihan"}, {"pos": 6, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 7, "word_orig": "אַכְזָרִֽי", "strong": "H394", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejam"}]}, {"book": 20, "chapter": 12, "verse": 11, "ayat_id": 16731, "title": "", "ayt_text": "Siapa mengerjakan tanahnya akan kenyang dengan makanan, tetapi dia yang mengejar kesia-siaan kekurangan akal budi.", "words": [{"pos": 1, "word_orig": "עֹבֵ֣ד", "strong": "H5647", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengerjakan"}, {"pos": 2, "word_orig": "אַ֭דְמָת/וֹ", "strong": "H127", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tanahnya"}, {"pos": 3, "word_orig": "יִֽשְׂבַּֽע", "strong": "H7646", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kenyang"}, {"pos": 4, "word_orig": "לָ֑חֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}, {"pos": 5, "word_orig": "וּ/מְרַדֵּ֖ף", "strong": "H7291", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "mengejar"}, {"pos": 6, "word_orig": "רֵיקִ֣ים", "strong": "H7386", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "kesia-siaan"}, {"pos": 7, "word_orig": "חֲסַר", "strong": "H2638", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "budi"}, {"pos": 8, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "budi"}]}, {"book": 20, "chapter": 12, "verse": 12, "ayat_id": 16732, "title": "", "ayt_text": "Orang fasik menginginkan jaring milik orang jahat, tetapi akar orang benar menghasilkan buah.", "words": [{"pos": 1, "word_orig": "חָמַ֣ד", "strong": "H2530", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menginginkan"}, {"pos": 2, "word_orig": "רָ֭שָׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 3, "word_orig": "מְצ֣וֹד", "strong": "H4685", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jaring"}, {"pos": 4, "word_orig": "רָעִ֑ים", "strong": "H7451", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "וְ/שֹׁ֖רֶשׁ", "strong": "H8328", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "akar"}, {"pos": 6, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יִתֵּֽן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghasilkan"}]}, {"book": 20, "chapter": 12, "verse": 13, "ayat_id": 16733, "title": "", "ayt_text": "Orang jahat terjerat oleh pelanggaran bibirnya, tetapi orang benar terlepas dari kesusahan.", "words": [{"pos": 1, "word_orig": "בְּ/פֶ֣שַׁע", "strong": "H6588", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pelanggaran"}, {"pos": 2, "word_orig": "שְׂ֭פָתַיִם", "strong": "H8193", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "bibirnya"}, {"pos": 3, "word_orig": "מוֹקֵ֣שׁ", "strong": "H4170", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terjerat"}, {"pos": 4, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}, {"pos": 5, "word_orig": "וַ/יֵּצֵ֖א", "strong": "H3318", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terlepas"}, {"pos": 6, "word_orig": "מִ/צָּרָ֣ה", "strong": "H6869", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesusahan"}, {"pos": 7, "word_orig": "צַדִּֽיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}]}, {"book": 20, "chapter": 12, "verse": 14, "ayat_id": 16734, "title": "", "ayt_text": "Dari buah perkataannya, seseorang dipuaskan dengan kebaikan, dan pekerjaan tangan seseorang akan dibalaskan kepadanya.", "words": [{"pos": 1, "word_orig": "מִ/פְּרִ֣י", "strong": "H6529", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "buah"}, {"pos": 2, "word_orig": "פִי", "strong": "H6310", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "perkataannya"}, {"pos": 3, "word_orig": "אִ֭ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 4, "word_orig": "יִשְׂבַּע", "strong": "H7646", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dipuaskan"}, {"pos": 5, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}, {"pos": 6, "word_orig": "וּ/גְמ֥וּל", "strong": "H1576", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pekerjaan"}, {"pos": 7, "word_orig": "יְדֵי", "strong": "H3027", "morph": "HNcbdc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 8, "word_orig": "אָ֝דָ֗ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 9, "word_orig": "ישוב", "strong": "H7725", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dibalaskan"}, {"pos": 10, "word_orig": "יָשִׁ֥יב", "strong": "H7725", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 11, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 12, "verse": 15, "ayat_id": 16735, "title": "", "ayt_text": "Jalan orang bodoh benar menurut pandangannya sendiri, tetapi orang berhikmat memperhatikan nasihat.", "words": [{"pos": 1, "word_orig": "דֶּ֣רֶךְ", "strong": "H1870", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Jalan"}, {"pos": 2, "word_orig": "אֱ֭וִיל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "יָשָׁ֣ר", "strong": "H3477", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "בְּ/עֵינָ֑י/ו", "strong": "H5869", "morph": "HR/Ncbdc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "pandangannya"}, {"pos": 5, "word_orig": "וְ/שֹׁמֵ֖עַ", "strong": "H8085", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "memperhatikan"}, {"pos": 6, "word_orig": "לְ/עֵצָ֣ה", "strong": "H6098", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "nasihat"}, {"pos": 7, "word_orig": "חָכָֽם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}]}, {"book": 20, "chapter": 12, "verse": 16, "ayat_id": 16736, "title": "", "ayt_text": "Orang bodoh menunjukkan kemarahannya saat itu juga, tetapi orang bijaksana menutupi aib.", "words": [{"pos": 1, "word_orig": "אֱוִ֗יל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 2, "word_orig": "בַּ֭/יּוֹם", "strong": "H3117", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "itu"}, {"pos": 3, "word_orig": "יִוָּדַ֣ע", "strong": "H3045", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menunjukkan"}, {"pos": 4, "word_orig": "כַּעְס֑/וֹ", "strong": "H3708", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kemarahannya"}, {"pos": 5, "word_orig": "וְ/כֹסֶ֖ה", "strong": "H3680", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menutupi"}, {"pos": 6, "word_orig": "קָל֣וֹן", "strong": "H7036", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "aib"}, {"pos": 7, "word_orig": "עָרֽוּם", "strong": "H6175", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bijaksana"}]}, {"book": 20, "chapter": 12, "verse": 17, "ayat_id": 16737, "title": "", "ayt_text": "Siapa mengucapkan kebenaran memberitahukan keadilan, tetapi saksi dusta menyatakan tipu daya.", "words": [{"pos": 1, "word_orig": "יָפִ֣יחַ", "strong": "H6315", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengucapkan"}, {"pos": 2, "word_orig": "אֱ֭מוּנָה", "strong": "H530", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "יַגִּ֣יד", "strong": "H5046", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberitahukan"}, {"pos": 4, "word_orig": "צֶ֑דֶק", "strong": "H6664", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 5, "word_orig": "וְ/עֵ֖ד", "strong": "H5707", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "saksi"}, {"pos": 6, "word_orig": "שְׁקָרִ֣ים", "strong": "H8267", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "dusta"}, {"pos": 7, "word_orig": "מִרְמָֽה", "strong": "H4820", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tipu"}]}, {"book": 20, "chapter": 12, "verse": 18, "ayat_id": 16738, "title": "", "ayt_text": "Ada yang lancang bicaranya seperti tikaman pedang, tetapi lidah orang berhikmat membawa kesembuhan.", "words": [{"pos": 1, "word_orig": "יֵ֣שׁ", "strong": "H3426", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Ada"}, {"pos": 2, "word_orig": "בּ֭וֹטֶה", "strong": "H981", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "bicaranya"}, {"pos": 3, "word_orig": "כְּ/מַדְקְר֣וֹת", "strong": "H4094", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "tikaman"}, {"pos": 4, "word_orig": "חָ֑רֶב", "strong": "H2719", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 5, "word_orig": "וּ/לְשׁ֖וֹן", "strong": "H3956", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "lidah"}, {"pos": 6, "word_orig": "חֲכָמִ֣ים", "strong": "H2450", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "מַרְפֵּֽא", "strong": "H4832", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesembuhan"}]}, {"book": 20, "chapter": 12, "verse": 19, "ayat_id": 16739, "title": "", "ayt_text": "Bibir yang benar tegak selamanya, tetapi lidah dusta hanya sekejap mata.", "words": [{"pos": 1, "word_orig": "שְֽׂפַת", "strong": "H8193", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Bibir"}, {"pos": 2, "word_orig": "אֱ֭מֶת", "strong": "H571", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "benar"}, {"pos": 3, "word_orig": "תִּכּ֣וֹן", "strong": "H3559", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "tegak"}, {"pos": 4, "word_orig": "לָ/עַ֑ד", "strong": "H5703", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}, {"pos": 5, "word_orig": "וְ/עַד", "strong": "H5704", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "hanya"}, {"pos": 6, "word_orig": "אַ֝רְגִּ֗יעָה", "strong": "H7280", "morph": "HVhh1cs", "morph_id": "Verba Hifil Orang ke-1 Tunggal", "ayt_word": "sekejap"}, {"pos": 7, "word_orig": "לְשׁ֣וֹן", "strong": "H3956", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "lidah"}, {"pos": 8, "word_orig": "שָֽׁקֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dusta"}]}, {"book": 20, "chapter": 12, "verse": 20, "ayat_id": 16740, "title": "", "ayt_text": "Tipu daya ada dalam hati orang yang merencanakan kejahatan, tetapi mereka yang menasihatkan kedamaian bersukacita.", "words": [{"pos": 1, "word_orig": "מִ֭רְמָה", "strong": "H4820", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "daya"}, {"pos": 2, "word_orig": "בְּ/לֶב", "strong": "H3820", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 3, "word_orig": "חֹ֣רְשֵׁי", "strong": "H2790", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "merencanakan"}, {"pos": 4, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatan"}, {"pos": 5, "word_orig": "וּֽ/לְ/יֹעֲצֵ֖י", "strong": "H3289", "morph": "HC/R/Vqrmpc", "morph_id": "Konjungsi (וְ) + Preposisi + Verba Qal", "ayt_word": "menasihatkan"}, {"pos": 6, "word_orig": "שָׁל֣וֹם", "strong": "H7965", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kedamaian"}, {"pos": 7, "word_orig": "שִׂמְחָֽה", "strong": "H8057", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bersukacita"}]}, {"book": 20, "chapter": 12, "verse": 21, "ayat_id": 16741, "title": "", "ayt_text": "Orang benar tidak akan menjumpai bahaya apa pun, tetapi orang fasik dipenuhi dengan kesusahan.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יְאֻנֶּ֣ה", "strong": "H579", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjumpai"}, {"pos": 3, "word_orig": "לַ/צַּדִּ֣יק", "strong": "H6662", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pun"}, {"pos": 5, "word_orig": "אָ֑וֶן", "strong": "H205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bahaya"}, {"pos": 6, "word_orig": "וּ֝/רְשָׁעִ֗ים", "strong": "H7563", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "fasik"}, {"pos": 7, "word_orig": "מָ֣לְאוּ", "strong": "H4390", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek