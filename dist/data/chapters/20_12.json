ng": "H3680", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyimpan"}, {"pos": 4, "word_orig": "דָּ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 5, "word_orig": "וְ/לֵ֥ב", "strong": "H3820", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 6, "word_orig": "כְּ֝סִילִ֗ים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יִקְרָ֥א", "strong": "H7121", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyerukan"}, {"pos": 8, "word_orig": "אִוֶּֽלֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebodohan"}]}, {"book": 20, "chapter": 12, "verse": 24, "ayat_id": 16744, "title": "", "ayt_text": "Tangan orang rajin akan memerintah, tetapi orang malas akan menjadi pekerja paksa.", "words": [{"pos": 1, "word_orig": "יַד", "strong": "H3027", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Tangan"}, {"pos": 2, "word_orig": "חָרוּצִ֥ים", "strong": "H2742", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "rajin"}, {"pos": 3, "word_orig": "תִּמְשׁ֑וֹל", "strong": "H4910", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "memerintah"}, {"pos": 4, "word_orig": "ו֝/רְמִיָּ֗ה", "strong": "H7423", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "malas"}, {"pos": 5, "word_orig": "תִּהְיֶ֥ה", "strong": "H1961", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjadi"}, {"pos": 6, "word_orig": "לָ/מַֽס", "strong": "H4522", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pekerja"}]}, {"book": 20, "chapter": 12, "verse": 25, "ayat_id": 16745, "title": "", "ayt_text": "Kekhawatiran akan membungkukkan hati orang, tetapi perkataan baik membuatnya senang.", "words": [{"pos": 1, "word_orig": "דְּאָגָ֣ה", "strong": "H1674", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kekhawatiran"}, {"pos": 2, "word_orig": "בְ/לֶב", "strong": "H3820", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 3, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "יַשְׁחֶ֑/נָּה", "strong": "H7812", "morph": "HVhi3ms/Sp3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3fs", "ayt_word": "membungkukkan"}, {"pos": 5, "word_orig": "וְ/דָבָ֖ר", "strong": "H1697", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkataan"}, {"pos": 6, "word_orig": "ט֣וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 7, "word_orig": "יְשַׂמְּחֶֽ/נָּה", "strong": "H8055", "morph": "HVpi3ms/Sp3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp3fs", "ayt_word": "senang"}]}, {"book": 20, "chapter": 12, "verse": 26, "ayat_id": 16746, "title": "", "ayt_text": "Orang benar memperhatikan sesamanya, tetapi jalan orang fasik menyesatkannya.", "words": [{"pos": 1, "word_orig": "יָתֵ֣ר", "strong": "H8446", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memperhatikan"}, {"pos": 2, "word_orig": "מֵ/רֵעֵ֣/הוּ", "strong": "H7453", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}, {"pos": 3, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "וְ/דֶ֖רֶךְ", "strong": "H1870", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 5, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "תַּתְעֵֽ/ם", "strong": "H8582", "morph": "HVhi3fs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp3mp", "ayt_word": "menyesatkannya"}]}, {"book": 20, "chapter": 12, "verse": 27, "ayat_id": 16747, "title": "", "ayt_text": "Orang malas tidak akan memanggang buruannya, tetapi orang rajin memperoleh kekayaan yang berharga.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יַחֲרֹ֣ךְ", "strong": "H2760", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memanggang"}, {"pos": 3, "word_orig": "רְמִיָּ֣ה", "strong": "H7423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "malas"}, {"pos": 4, "word_orig": "צֵיד֑/וֹ", "strong": "H6718", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "buruannya"}, {"pos": 5, "word_orig": "וְ/הוֹן", "strong": "H1952", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekayaan"}, {"pos": 6, "word_orig": "אָדָ֖ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יָקָ֣ר", "strong": "H3368", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berharga"}, {"pos": 8, "word_orig": "חָרֽוּץ", "strong": "H2742", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "rajin"}]}, {"book": 20, "chapter": 12, "verse": 28, "ayat_id": 16748, "title": "", "ayt_text": "Di jalan kebenaran terdapat kehidupan, dan di jalan itu tidak terdapat maut.", "words": [{"pos": 1, "word_orig": "בְּ/אֹֽרַח", "strong": "H734", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 2, "word_orig": "צְדָקָ֥ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "חַיִּ֑ים", "strong": "H2416", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 4, "word_orig": "וְ/דֶ֖רֶךְ", "strong": "H1870", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 5, "word_orig": "נְתִיבָ֣ה", "strong": "H5410", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 6, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "מָֽוֶת", "strong": "H4194", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}]}]