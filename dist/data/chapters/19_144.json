[{"book": 19, "chapter": 144, "verse": 1, "ayat_id": 16307, "title": "Doa untuk Kemenangan dan Kemakmuran", "ayt_text": "Mazmur Daud. Pujilah TUHAN, gunung batuku, yang mengajari tangan-tanganku dalam peperangan, dan jari-jariku dalam pertempuran.", "words": [{"pos": 1, "word_orig": "לְ/דָוִ֨ד", "strong": "H1732", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Daud"}, {"pos": 2, "word_orig": "בָּ֘ר֤וּךְ", "strong": "H1288", "morph": "HVqsmsa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "Pujilah"}, {"pos": 3, "word_orig": "יְהוָ֨ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "צוּרִ֗/י", "strong": "H6697", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "gunung"}, {"pos": 5, "word_orig": "הַֽ/מְלַמֵּ֣ד", "strong": "H3925", "morph": "HTd/Vprmsa", "morph_id": "Artikel Definit (הַ) + Verba Piel", "ayt_word": "mengajari"}, {"pos": 6, "word_orig": "יָדַ֣/י", "strong": "H3027", "morph": "HNcbdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": ""}, {"pos": 7, "word_orig": "לַ/קְרָ֑ב", "strong": "H7128", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "peperangan"}, {"pos": 8, "word_orig": "אֶ֝צְבְּעוֹתַ֗/י", "strong": "H676", "morph": "HNcfpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "jari-jariku"}, {"pos": 9, "word_orig": "לַ/מִּלְחָמָֽה", "strong": "H4421", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pertempuran"}]}, {"book": 19, "chapter": 144, "verse": 2, "ayat_id": 16308, "title": "", "ayt_text": "Kebaikanku dan kubu pertahananku, kota bentengku dan penyelamatku, perisaiku dan Dia adalah yang kepada-Nya aku berlindung, yang menundukkan bangsa-bangsa di bawahku.", "words": [{"pos": 1, "word_orig": "חַסְדִּ֥/י", "strong": "H2617", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Kebaikanku"}, {"pos": 2, "word_orig": "וּ/מְצוּדָתִ/י֮", "strong": "H4686", "morph": "HC/Ncbsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kubu"}, {"pos": 3, "word_orig": "מִשְׂגַּבִּ֪/י", "strong": "H4869", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kota"}, {"pos": 4, "word_orig": "וּֽ/מְפַלְטִ֫/י", "strong": "H6403", "morph": "HC/Vprmsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Piel + Sp1cs", "ayt_word": "penyelamatku"}, {"pos": 5, "word_orig": "לִ֥/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "מָ֭גִנִּ/י", "strong": "H4043", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "perisaiku"}, {"pos": 7, "word_orig": "וּ/ב֣/וֹ", "strong": "", "morph": "HC/R/Sp3ms", "morph_id": "Konjungsi (וְ) + Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 8, "word_orig": "חָסִ֑יתִי", "strong": "H2620", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berlindung"}, {"pos": 9, "word_orig": "הָ/רוֹדֵ֖ד", "strong": "H7286", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menundukkan"}, {"pos": 10, "word_orig": "עַמִּ֣/י", "strong": "H5971", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "bangsa-bangsa"}, {"pos": 11, "word_orig": "תַחְתָּֽ/י", "strong": "H8478", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "di"}]}, {"book": 19, "chapter": 144, "verse": 3, "ayat_id": 16309, "title": "", "ayt_text": "Ya TUHAN, apakah itu manusia sehingga Engkau mengenalnya? Atau, anak manusia, sehingga Engkau memikirkannya?", "words": [{"pos": 1, "word_orig": "יְֽהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "מָה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "apakah"}, {"pos": 3, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 4, "word_orig": "וַ/תֵּדָעֵ֑/הוּ", "strong": "H3045", "morph": "HC/Vqw2ms/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "mengenalnya"}, {"pos": 5, "word_orig": "בֶּן", "strong": "H1121", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "anak"}, {"pos": 6, "word_orig": "אֱ֝נ֗וֹשׁ", "strong": "H582", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 7, "word_orig": "וַֽ/תְּחַשְּׁבֵֽ/הוּ", "strong": "H2803", "morph": "HC/Vpw2ms/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "memikirkannya"}]}, {"book": 19, "chapter": 144, "verse": 4, "ayat_id": 16310, "title": "", "ayt_text": "Manusia itu seperti embusan napas, hari-harinya seperti bayangan yang berlalu.", "words": [{"pos": 1, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Manusia"}, {"pos": 2, "word_orig": "לַ/הֶ֣בֶל", "strong": "H1892", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "embusan"}, {"pos": 3, "word_orig": "דָּמָ֑ה", "strong": "H1819", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "seperti"}, {"pos": 4, "word_orig": "יָ֝מָ֗י/ו", "strong": "H3117", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "hari-harinya"}, {"pos": 5, "word_orig": "כְּ/צֵ֣ל", "strong": "H6738", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bayangan"}, {"pos": 6, "word_orig": "עוֹבֵֽר", "strong": "H5674", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berlalu"}]}, {"book": 19, "chapter": 144, "verse": 5, "ayat_id": 16311, "title": "", "ayt_text": "Bungkukkan langit-Mu, ya TUHAN, dan turunlah! Sentuhlah gunung-gunung sehingga mereka berasap.", "words": [{"pos": 1, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "הַט", "strong": "H5186", "morph": "HVhv2ms", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Bungkukkan"}, {"pos": 3, "word_orig": "שָׁמֶ֣י/ךָ", "strong": "H8064", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "langit-Mu"}, {"pos": 4, "word_orig": "וְ/תֵרֵ֑ד", "strong": "H3381", "morph": "HC/Vqi2ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "turunlah"}, {"pos": 5, "word_orig": "גַּ֖ע", "strong": "H5060", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Sentuhlah"}, {"pos": 6, "word_orig": "בֶּ/הָרִ֣ים", "strong": "H2022", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "gunung-gunung"}, {"pos": 7, "word_orig": "וְֽ/יֶעֱשָֽׁנוּ", "strong": "H6225", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "berasap"}]}, {"book": 19, "chapter": 144, "verse": 6, "ayat_id": 16312, "title": "", "ayt_text": "Kilatkan cahaya-cahaya, dan sebarkan mereka, lepaskan anak-anak panah-Mu, dan kacaukan mereka.", "words": [{"pos": 1, "word_orig": "בְּר֣וֹק", "strong": "H1299", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Kilatkan"}, {"pos": 2, "word_orig": "בָּ֭רָק", "strong": "H1300", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "cahaya-cahaya"}, {"pos": 3, "word_orig": "וּ/תְפִיצֵ֑/ם", "strong": "H6327", "morph": "HC/Vhi2ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal + Sp3mp", "ayt_word": "sebarkan"}, {"pos": 4, "word_orig": "שְׁלַ֥ח", "strong": "H7971", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "lepaskan"}, {"pos": 5, "word_orig": "חִ֝צֶּ֗י/ךָ", "strong": "H2671", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "וּ/תְהֻמֵּֽ/ם", "strong": "H2000", "morph": "HC/Vqi2ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal + Sp3mp", "ayt_word": "kacaukan"}]}, {"book": 19, "chapter": 144, "verse": 7, "ayat_id": 16313, "title": "", "ayt_text": "Ulurkanlah tangan-Mu dari tempat tinggi, selamatkan dan lepaskan aku dari air bah, dari tangan orang-orang asing.", "words": [{"pos": 1, "word_orig": "שְׁלַ֥ח", "strong": "H7971", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Ulurkanlah"}, {"pos": 2, "word_orig": "יָדֶ֗י/ךָ", "strong": "H3027", "morph": "HNcbdc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2ms", "ayt_word": "tangan-Mu"}, {"pos": 3, "word_orig": "מִ/מָּ֫ר֥וֹם", "strong": "H4791", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 4, "word_orig": "פְּצֵ֣/נִי", "strong": "H6475", "morph": "HVqv2ms/Sp1cs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "selamatkan"}, {"pos": 5, "word_orig": "וְ֭/הַצִּילֵ/נִי", "strong": "H5337", "morph": "HC/Vhv2ms/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "lepaskan"}, {"pos": 6, "word_orig": "מִ/מַּ֣יִם", "strong": "H4325", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}, {"pos": 7, "word_orig": "רַבִּ֑ים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "bah"}, {"pos": 8, "word_orig": "מִ֝/יַּ֗ד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 9, "word_orig": "בְּנֵ֣י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "orang-orang"}, {"pos": 10, "word_orig": "נֵכָֽר", "strong": "H5236", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "asing"}]}, {"book": 19, "chapter": 144, "verse": 8, "ayat_id": 16314, "title": "", "ayt_text": "Yang mulutnya mengucapkan dusta, dan yang tangan kanannya adalah tangan kanan kebohongan.", "words": [{"pos": 1, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "Yang"}, {"pos": 2, "word_orig": "פִּ֭י/הֶם", "strong": "H6310", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mulutnya"}, {"pos": 3, "word_orig": "דִּבֶּר", "strong": "H1696", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengucapkan"}, {"pos": 4, "word_orig": "שָׁ֑וְא", "strong": "H7723", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dusta"}, {"pos": 5, "word_orig": "וִֽ֝/ימִינָ֗/ם", "strong": "H3225", "morph": "HC/Ncfs