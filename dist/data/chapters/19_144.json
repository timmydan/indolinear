 ""}]}, {"book": 19, "chapter": 144, "verse": 10, "ayat_id": 16316, "title": "", "ayt_text": "yang memberi keselamatan kepada raja-raja, yang menyelamatkan Daud, hamba-Nya, dari pedang kejahatan.", "words": [{"pos": 1, "word_orig": "הַ/נּוֹתֵ֥ן", "strong": "H5414", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "memberi"}, {"pos": 2, "word_orig": "תְּשׁוּעָ֗ה", "strong": "H8668", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatan"}, {"pos": 3, "word_orig": "לַ/מְּלָ֫כִ֥ים", "strong": "H4428", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja-raja"}, {"pos": 4, "word_orig": "הַ֭/פּוֹצֶה", "strong": "H6475", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menyelamatkan"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "דָּוִ֥ד", "strong": "H1732", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Daud"}, {"pos": 7, "word_orig": "עַבְדּ֗/וֹ", "strong": "H5650", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hamba-Nya"}, {"pos": 8, "word_orig": "מֵ/חֶ֥רֶב", "strong": "H2719", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 9, "word_orig": "רָעָֽה", "strong": "H7451", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "kejahatan"}]}, {"book": 19, "chapter": 144, "verse": 11, "ayat_id": 16317, "title": "", "ayt_text": "Selamatkan dan lepaskan aku dari tangan orang-orang asing, yang mulutnya mengucapkan dusta, dan yang tangan kanannya adalah tangan kanan kepalsuan.", "words": [{"pos": 1, "word_orig": "פְּצֵ֥/נִי", "strong": "H6475", "morph": "HVqv2ms/Sp1cs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp1