orph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "Penguasa"}]}, {"book": 28, "chapter": 4, "verse": 19, "ayat_id": 22153, "title": "", "ayt_text": "Angin telah mengelilingi mereka dalam dengan sayap-sayapnya, dan mereka akan mendapat malu karena kurban-kurban sembelihan mereka.", "words": [{"pos": 1, "word_orig": "צָרַ֥ר", "strong": "H6887", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengelilingi"}, {"pos": 2, "word_orig": "ר֛וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Angin"}, {"pos": 3, "word_orig": "אוֹתָ֖/הּ", "strong": "H853", "morph": "HTo/Sp3fs", "morph_id": "Tanda Objek (אֵת) + Sp3fs", "ayt_word": ""}, {"pos": 4, "word_orig": "בִּ/כְנָפֶ֑י/הָ", "strong": "H3671", "morph": "HR/Ncfdc/Sp3fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3fs", "ayt_word": "sayap-sayapnya"}, {"pos": 5, "word_orig": "וְ/יֵבֹ֖שׁוּ", "strong": "H954", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mendapat"}, {"pos": 6, "word_orig": "מִ/זִּבְחוֹתָֽ/ם", "strong": "H2077", "morph": "HR/Ncmpc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "kurban-kurban"}]}]