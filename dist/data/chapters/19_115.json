_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "עֲלֵי/כֶ֑ם", "strong": "H5921", "morph": "HR/Sp2mp", "morph_id": "Preposisi + Sp2mp", "ayt_word": ""}, {"pos": 4, "word_orig": "עֲ֝לֵי/כֶ֗ם", "strong": "H5921", "morph": "HR/Sp2mp", "morph_id": "Preposisi + Sp2mp", "ayt_word": ""}, {"pos": 5, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": ""}, {"pos": 6, "word_orig": "בְּנֵי/כֶֽם", "strong": "H1121", "morph": "HNcmpc/Sp2mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2mp", "ayt_word": "anak-anakmu"}]}, {"book": 19, "chapter": 115, "verse": 15, "ayat_id": 15846, "title": "", "ayt_text": "Kiranya kamu diberkati oleh TUHAN, yang menjadikan langit dan bumi.", "words": [{"pos": 1, "word_orig": "בְּרוּכִ֣ים", "strong": "H1288", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "diberkati"}, {"pos": 2, "word_orig": "אַ֭תֶּם", "strong": "H859", "morph": "HPp2mp", "morph_id": "Pp2mp", "ayt_word": "kamu"}, {"pos": 3, "word_orig": "לַ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "עֹ֝שֵׂ֗ה", "strong": "H6213", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "menjadikan"}, {"pos": 5, "word_orig": "שָׁמַ֥יִם", "strong": "H8064", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 6, "word_orig": "וָ/אָֽרֶץ", "strong": "H776", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 19, "chapter": 115, "verse": 16, "ayat_id": 15847, "title": "", "ayt_text": "Langit adalah langit milik TUHAN, tetapi bumi telah diberikan-Nya kepada anak-anak manusia.", "words": [{"pos": 1, "word_orig": "הַ/שָּׁמַ֣יִם", "strong": "H8064", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki