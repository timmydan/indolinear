 "H3373", "morph": "HAampc", "morph_id": "Aampc", "ayt_word": "takut"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "כִּ֖י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 6, "word_orig": "לְ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 7, "word_orig": "חַסְדּֽ/וֹ", "strong": "H2617", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "Kasih"}]}, {"book": 19, "chapter": 118, "verse": 5, "ayat_id": 15875, "title": "", "ayt_text": "Dalam kesesakanku, aku berseru kepada TUHAN; TUHAN menjawab aku di tempat yang luas.", "words": [{"pos": 1, "word_orig": "מִֽן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Dalam"}, {"pos": 2, "word_orig": "הַ֭/מֵּצַ֥ר", "strong": "H4712", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesesakanku"}, {"pos": 3, "word_orig": "קָרָ֣אתִי", "strong": "H7121", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berseru"}, {"pos": 4, "word_orig": "יָּ֑הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "עָנָ֖/נִי", "strong": "H6030", "morph": "HVqp3ms/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menjawab"}, {"pos": 6, "word_orig": "בַ/מֶּרְחָ֣ב", "strong": "H4800", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 7, "word_orig": "יָֽהּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 118, "verse": 6, "ayat_id": 15876, "title": "", "ayt_text": "TUHAN bersamaku, aku takkan takut. Apa yang dapat diperbuat manusia kepadaku?", "words": [{"pos": 1, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "לִ֭/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "aku"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 4, "word_orig": "אִירָ֑א", "strong": "H3372", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "takut"}, {"pos": 5, "word_orig": "מַה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Apa"}, {"pos": 6, "word_orig": "יַּעֲשֶׂ֖ה", "strong": "H6213", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diperbuat"}, {"pos": 7, "word_orig": "לִ֣/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 8, "word_orig": "אָדָֽם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}]}, {"book": 19, "chapter": 118, "verse": 7, "ayat_id": 15877, "title": "", "ayt_text": "TUHAN bersamaku, menolong aku; aku akan memandang orang-orang yang membenciku.", "words": [{"pos": 1, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "לִ֭/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "בְּ/עֹזְרָ֑/י", "strong": "H5826", "morph": "HR/Vqrmpc/Sp1cs", "morph_id": "Preposisi + Verba Qal + Sp1cs", "ayt_word": "menolong"}, {"pos": 4, "word_orig": "וַ֝/אֲנִ֗י", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": "aku"}, {"pos": 5, "word_orig": "אֶרְאֶ֥ה", "strong": "H7200", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "memandang"}, {"pos": 6, "word_orig": "בְ/שֹׂנְאָֽ/י", "strong": "H8130", "morph": "HR/Vqrmpc/Sp1cs", "morph_id": "Preposisi + Verba Qal + Sp1cs", "ayt_word": "membenciku"}]}, {"book": 19, "chapter": 118, "verse": 8, "ayat_id": 15878, "title": "", "ayt_text": "Lebih baik berlindung kepada TUHAN, daripada memercayai manusia.", "words": [{"pos": 1, "word_orig": "ט֗וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 2, "word_orig": "לַ/חֲס֥וֹת", "strong": "H2620", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "berlindung"}, {"pos": 3, "word_orig": "בַּ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "מִ֝/בְּטֹ֗חַ", "strong": "H982", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "memercayai"}, {"pos": 5, "word_orig": "בָּ/אָדָֽם", "strong": "H120", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}]}, {"book": 19, "chapter": 118, "verse": 9, "ayat_id": 15879, "title": "", "ayt_text": "Lebih baik berlindung kepada TUHAN, daripada memercayai para penguasa.", "words": [{"pos": 1, "word_orig": "ט֗וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 2, "word_orig": "לַ/חֲס֥וֹת", "strong": "H2620", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "berlindung"}, {"pos": 3, "word_orig": "בַּ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "מִ֝/בְּטֹ֗חַ", "strong": "H982", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "memercayai"}, {"pos": 5, "word_orig": "בִּ/נְדִיבִֽים", "strong": "H5081", "morph": "HR/Aampa", "morph_id": "Preposisi + Aampa", "ayt_word": "penguasa"}]}, {"book": 19, "chapter": 118, "verse": 10, "ayat_id": 15880, "title": "", "ayt_text": "Semua bangsa mengepung aku, di dalam nama TUHAN, sebenarnya aku akan menumpas mereka.", "words": [{"pos": 1, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Semua"}, {"pos": 2, "word_orig": "גּוֹיִ֥ם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa"}, {"pos": 3, "word_orig": "סְבָב֑וּ/נִי", "strong": "H5437", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "mengepung"}, {"pos": 4, "word_orig": "בְּ/שֵׁ֥ם", "strong": "H8034", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 5, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebenarnya"}, {"pos": 7, "word_orig": "אֲמִילַֽ/ם", "strong": "H4135", "morph": "HVhi1cs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menumpas"}]}, {"book": 19, "chapter": 118, "verse": 11, "ayat_id": 15881, "title": "", "ayt_text": "Mereka mengepung aku, ya, mereka mengepung aku, di dalam nama TUHAN, sebenarnya aku akan menumpas mereka.", "words": [{"pos": 1, "word_orig": "סַבּ֥וּ/נִי", "strong": "H5437", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "mengepung"}, {"pos": 2, "word_orig": "גַם", "strong": "H1571", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "ya"}, {"pos": 3, "word_orig": "סְבָב֑וּ/נִי", "strong": "H5437", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "mengepung"}, {"pos": 4, "word_orig": "בְּ/שֵׁ֥ם", "strong": "H8034", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 5, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebenarnya"}, {"pos": 7, "word_orig": "אֲמִילַֽ/ם", "strong": "H4135", "morph": "HVhi1cs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menumpas"}]}, {"book": 19, "chapter": 118, "verse": 12, "ayat_id": 15882, "title": "", "ayt_text": "Mereka mengepung aku bagaikan lebah-lebah, mereka dipadamkan seperti api semak duri, di dalam nama TUHAN, sebenarnya aku akan menumpas mereka.", "words": [{"pos": 1, "word_orig": "סַבּ֤וּ/נִי", "strong": "H5437", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "mengepung"}, {"pos": 2, "word_orig": "כִ/דְבוֹרִ֗ים", "strong": "H1682", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "lebah-lebah"}, {"pos": 3, "word_orig": "דֹּ֭עֲכוּ", "strong": "H1846", "morph": "HVPp3cp", "morph_id": "Verba Pual Perfek Orang ke-3 Jamak", "ayt_word": "dipadamkan"}, {"pos": 4, "word_orig": "כְּ/אֵ֣שׁ", "strong": "H784", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "api"}, {"pos": 5, "word_orig": "קוֹצִ֑ים", "strong": "H6975", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "duri"}, {"pos": 6, "word_orig": "בְּ/שֵׁ֥ם", "strong": "H8034", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 7, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebenarnya"}, {"pos": 9, "word_orig": "אֲמִילַֽ/ם", "strong": "H4135", "morph": "HVhi1cs/Sp3mp", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3mp", "ayt_word": "menumpas"}]}, {"book": 19, "chapter": 118, "verse": 13, "ayat_id": 15883, "title": "", "ayt_text": "Aku didorong kuat hingga aku jatuh, tetapi TUHAN menolongku.", "words": [{"pos": 1, "word_orig": "דַּחֹ֣ה", "strong": "H1760", "morph": "HVqa", "morph_id": "Verba Qal Infinitif Absolut", "ayt_word": "didorong"}, {"pos": 2, "word_orig": "דְחִיתַ֣/נִי", "strong": "H1760", "morph": "HVqp2ms/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "kuat"}, {"pos": 3, "word_orig": "לִ/נְפֹּ֑ל", "strong": "H5307", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "jatuh"}, {"pos": 4, "word_orig": "וַ֖/יהוָ֣ה", "strong": "H3068", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "עֲזָרָֽ/נִי", "strong": "H5826", "morph": "HVqp3ms/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menolongku"}]}, {"book": 19, "chapter": 118, "verse": 14, "ayat_id": 15884, "title": "", "ayt_text": "TUHAN adalah kekuatanku dan mazmurku, Dia telah menjadi keselamatanku.", "words": [{"pos": 1, "word_orig": "עָזִּ֣/י", "strong": "H5797", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekuatanku"}, {"pos": 2, "word_orig": "וְ/זִמְרָ֣ת", "strong": "H2176", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "mazmurku"}, {"pos": 3, "word_orig": "יָ֑הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "וַֽ/יְהִי", "strong": "H1961", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 5, "word_orig": "לִ֝֗/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "לִֽ/ישׁוּעָֽה", "strong": "H3444", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatanku"}]}, {"book": 19, "chapter": 118, "verse": 15, "ayat_id": 15885, "title": "", "ayt_text": "Bunyi sorak-sorai keselamatan ada di tenda orang-orang benar: “Tangan kanan TUHAN melakukan keperkasaan,", "words": [{"pos": 1, "word_orig": "ק֤וֹל", "strong": "H6963", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Bunyi"}, {"pos": 2, "word_orig": "רִנָּ֬ה", "strong": "H7440", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sorak-sorai"}, {"pos": 3, "word_orig": "וִֽ/ישׁוּעָ֗ה", "strong": "H3444", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatan"}, {"pos": 4, "word_orig": "בְּ/אָהֳלֵ֥י", "strong": "H168", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "tenda"}, {"pos": 5, "word_orig": "צַדִּיקִ֑ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 6, "word_orig": "יְמִ֥ין", "strong": "H3225", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Tangan"}, {"pos": 7, "word_orig": "יְ֝הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "עֹ֣שָׂה", "strong": "H6213", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 9, "word_orig": "חָֽיִל", "strong": "H2428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keperkasaan"}]}, {"book": 19, "chapter": 118, "verse": 16, "ayat_id": 15886, "title": "", "ayt_text": "tangan kanan TUHAN ditinggikan, tangan kanan TUHAN melakukan keperkasaan!”", "words": [{"pos": 1, "word_orig": "יְמִ֣ין", "strong": "H3225", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kanan"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "רוֹמֵמָ֑ה", "strong": "H7426", "morph": "HVorfsa", "morph_id": "Verba", "ayt_word": "ditinggikan"}, {"pos": 4, "word_orig": "יְמִ֥ין", "strong": "H3225", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 5, "word_orig": "יְ֝הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "עֹ֣שָׂה", "strong": "H6213", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 7, "word_orig": "חָֽיִל", "strong": "H2428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keperkasaan"}]}, {"book": 19, "chapter": 118, "verse": 17, "ayat_id": 15887, "title": "", "ayt_text": "Aku takkan mati, tetapi hidup, dan akan menceritakan perbuatan-perbuatan TUHAN.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 2, "word_orig": "אָמ֥וּת", "strong": "H4191", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mati"}, {"pos": 3, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "tetapi"}, {"pos": 4, "word_orig": "אֶֽחְיֶ֑ה", "strong": "H2421", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "hidup"}, {"pos": 5, "word_orig": "וַ֝/אֲסַפֵּ֗ר", "strong": "H5608", "morph": "HC/Vpi1cs", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-1 Tunggal", "ayt_word": "menceritakan"}, {"pos": 6, "word_orig": "מַֽעֲשֵׂ֥י", "strong": "H4639", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "perbuatan-perbuatan"}, {"pos": 7, "word_orig": "יָֽהּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 118, "verse": 18, "ayat_id": 15888, "title": "", "ayt_text": "TUHAN telah menghajar aku, tetapi Dia tidak menyerahkanku kepada maut.", "words": [{"pos": 1, "word_orig": "יַסֹּ֣ר", "strong": "H3256", "morph": "HVpa", "morph_id": "Verba Piel Infinitif Absolut", "ayt_word": "menghajar"}, {"pos": 2, "word_orig": "יִסְּרַ֣/נִּי", "strong": "H3256", "morph": "HVpp3ms/Sp1cs", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menghajar"}, {"pos": 3, "word_orig": "יָּ֑הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "וְ֝/לַ/מָּ֗וֶת", "strong": "H4194", "morph": "HC/Rd/Ncmsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}, {"pos": 5, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "נְתָנָֽ/נִי", "strong": "H5414", "morph": "HVqp3ms/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menyerahkanku"}]}, {"book": 19, "chapter": 118, "verse": 19, "ayat_id": 15889, "title": "", "ayt_text": "Bukakan bagiku pintu-pintu gerbang kebenaran, aku akan masuk melaluinya dan bersyukur kepada TUHAN.", "words": [{"pos": 1, "word_orig": "פִּתְחוּ", "strong": "H6605", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Bukakan"}, {"pos": 2, "word_orig": "לִ֥/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "שַׁעֲרֵי", "strong": "H8179", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "pintu-pintu"}, {"pos": 4, "word_orig": "צֶ֑דֶק", "strong": "H6664", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 5, "word_orig": "אָֽבֹא", "strong": "H935", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "masuk"}, {"pos": 6, "word_orig": "בָ֝/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 7, "word_orig": "אוֹדֶ֥ה", "strong": "H3034", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "bersyukur"}, {"pos": 8, "word_orig": "יָֽהּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 118, "verse": 20, "ayat_id": 15890, "title": "", "ayt_text": "Inilah pintu gerbang TUHAN, orang-orang benar akan masuk melaluinya.", "words": [{"pos": 1, "word_orig": "זֶֽה", "strong": "H2088", "morph": "HPdxms", "morph_id": "Pdxms", "ayt_word": "Inilah"}, {"pos": 2, "word_orig": "הַ/שַּׁ֥עַר", "strong": "H8179", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pintu"}, {"pos": 3, "word_orig": "לַ/יהוָ֑ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "צַ֝דִּיקִ֗ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "יָבֹ֥אוּ", "strong": "H935", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "masuk"}, {"pos": 6, "word_orig": "בֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 19, "chapter": 118, "verse": 21, "ayat_id": 15891, "title": "", "ayt_text": "Aku akan bersyukur kepada-Mu karena Engkau telah menjawab aku, dan telah menjadi keselamatanku.", "words": [{"pos": 1, "word_orig": "א֭וֹדְ/ךָ", "s