-laki Jamak Absolut", "ayt_word": "bertengkar"}, {"pos": 7, "word_orig": "מִדְיָנִ֣ים", "strong": "H4079", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pemarah"}, {"pos": 8, "word_orig": "וָ/כָֽעַס", "strong": "H3708", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": ""}]}, {"book": 20, "chapter": 21, "verse": 20, "ayat_id": 17005, "title": "", "ayt_text": "Harta benda yang berharga dan minyak ada di tempat tinggal orang berhikmat, tetapi orang bodoh memboroskannya.", "words": [{"pos": 1, "word_orig": "אוֹצָ֤ר", "strong": "H214", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Harta"}, {"pos": 2, "word_orig": "נֶחְמָ֣ד", "strong": "H2530", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "berharga"}, {"pos": 3, "word_orig": "וָ֭/שֶׁמֶן", "strong": "H8081", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "minyak"}, {"pos": 4, "word_orig": "בִּ/נְוֵ֣ה", "strong": "H5116", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tempat"}, {"pos": 5, "word_orig": "חָכָ֑ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "וּ/כְסִ֖יל", "strong": "H3684", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "אָדָ֣ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 8, "word_orig": "יְבַלְּעֶֽ/נּוּ", "strong": "H1104", "morph": "HVpi3ms/Sp3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "memboroskannya"}]}, {"book": 20, "chapter": 21, "verse": 21, "ayat_id": 17006, "title": "", "ayt_text": "Siapa mengejar kebenaran dan kesetiaan akan menemukan kehidupan, kebenaran, dan kehormatan.", "words": [{"pos": 1, "word_orig": "רֹ֭דֵף", "strong": "H7291", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengejar"}, {"pos": 2, "word_orig": "צְדָקָ֣ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "וָ/חָ֑סֶד", "strong": "H2617", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesetiaan"}, {"pos": 4, "word_orig": "יִמְצָ֥א", "strong": "H4672", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menemukan"}, {"pos": 5, "word_orig": "חַ֝יִּ֗ים", "strong": "H2416", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 6, "word_orig": "צְדָקָ֥ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 7, "word_orig": "וְ/כָבֽוֹד", "strong": "H3519", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kehormatan"}]}, {"book": 20, "chapter": 21, "verse": 22, "ayat_id": 17007, "title": "", "ayt_text": "Orang berhikmat memanjat kota para pahlawan, dan meruntuhkan benteng yang mereka percayai.", "words": [{"pos": 1, "word_orig": "עִ֣יר", "strong": "H5892", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kota"}, {"pos": 2, "word_orig": "גִּ֭בֹּרִים", "strong": "H1368", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "pahlawan"}, {"pos": 3, "word_orig": "עָלָ֣ה", "strong": "H5927", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memanjat"}, {"pos": 4, "word_orig": "חָכָ֑ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 5, "word_orig": "וַ֝/יֹּ֗רֶד", "strong": "H3381", "morph": "HC/Vhw3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "meruntuhkan"}, {"pos": 6, "word_orig": "עֹ֣ז", "strong": "H5797", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "benteng"}, {"pos": 7, "word_orig": "מִבְטֶחָֽ/ה", "strong": "H4009", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "percayai"}]}, {"book": 20, "chapter": 21, "verse": 23, "ayat_id": 17008, "title": "", "ayt_text": "Orang yang menjaga mulut dan lidahnya menjaga dirinya dari kesusahan.", "words": [{"pos": 1, "word_orig": "שֹׁמֵ֣ר", "strong": "H8104", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menjaga"}, {"pos": 2, "word_orig": "פִּ֭י/ו", "strong": "H6310", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulut"}, {"pos": 3, "word_orig": "וּ/לְשׁוֹנ֑/וֹ", "strong": "H3956", "morph": "HC/Ncbsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "lidahnya"}, {"pos": 4, "word_orig": "שֹׁמֵ֖ר", "strong": "H8104", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menjaga"}, {"pos": 5, "word_orig": "מִ/צָּר֣וֹת", "strong": "H6869", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kesusahan"}, {"pos": 6, "word_orig": "נַפְשֽׁ/וֹ", "strong": "H5315", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 21, "verse": 24, "ayat_id": 17009, "title": "", "ayt_text": "Orang yang angkuh dan sombong dinamai pencemooh; dia berlaku dengan keangkuhan yang berlebihan.", "words": [{"pos": 1, "word_orig": "זֵ֣ד", "strong": "H2086", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "יָ֭הִיר", "strong": "H3093", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "sombong"}, {"pos": 3, "word_orig": "לֵ֣ץ", "strong": "H3887", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pencemooh"}, {"pos": 4, "word_orig": "שְׁמ֑/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "dinamai"}, {"pos": 5, "word_orig": "ע֝וֹשֶׂ֗ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berlaku"}, {"pos": 6, "word_orig": "בְּ/עֶבְרַ֥ת", "strong": "H5678", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "berlebihan"}, {"pos": 7, "word_orig": "זָדֽוֹן", "strong": "H2087", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keangkuhan"}]}, {"book": 20, "chapter": 21, "verse": 25, "ayat_id": 17010, "title": "", "ayt_text": "Keinginan si pemalas akan membunuhnya; sebab, tangannya menolak untuk bekerja.", "words": [{"pos": 1, "word_orig": "תַּאֲוַ֣ת", "strong": "H8378", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Keinginan"}, {"pos": 2, "word_orig": "עָצֵ֣ל", "strong": "H6102", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pemalas"}, {"pos": 3, "word_orig": "תְּמִיתֶ֑/נּוּ", "strong": "H4191", "morph": "HVhi3fs/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "membunuhnya"}, {"pos": 4, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "sebab"}, {"pos": 5, "word_orig": "מֵאֲנ֖וּ", "strong": "H3985", "morph": "HVpp3cp", "morph_id": "Verba Piel Perfek Orang ke-3 Jamak", "ayt_word": "menolak"}, {"pos": 6, "word_orig": "יָדָ֣י/ו", "strong": "H3027", "morph": "HNcbdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "tangannya"}, {"pos": 7, "word_orig": "לַ/עֲשֽׂוֹת", "strong": "H6213", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "bekerja"}]}, {"book": 20, "chapter": 21, "verse": 26, "ayat_id": 17011, "title": "", "ayt_text": "Sepanjang hari, dia terus menginginkan hasratnya, tetapi orang benar memberi, dan tidak menahan-nahan.", "words": [{"pos": 1, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Sepanjang"}, {"pos": 2, "word_orig": "הַ֭/יּוֹם", "strong": "H3117", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 3, "word_orig": "הִתְאַוָּ֣ה", "strong": "H183", "morph": "HVtp3ms", "morph_id": "Verba Hitpael Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menginginkan"}, {"pos": 4, "word_orig": "תַאֲוָ֑ה", "strong": "H8378", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hasratnya"}, {"pos": 5, "word_orig": "וְ/צַדִּ֥יק", "strong": "H6662", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "benar"}, {"pos": 6, "word_orig": "יִ֝תֵּ֗ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberi"}, {"pos": 7, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "יַחְשֹֽׂךְ", "strong": "H2820", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menahan-nahan"}]}, {"book": 20, "chapter": 21, "verse": 27, "ayat_id": 17012, "title": "", "ayt_text": "Kurban sembelihan orang fasik adalah sebuah kekejian, terlebih lagi kalau dipersembahkan dengan maksud jahat.", "words": [{"pos": 1, "word_orig": "זֶ֣בַח", "stro