 22, "chapter": 3, "verse": 7, "ayat_id": 17579, "title": "", "ayt_text": "Lihat, inilah joli Salomo! Yang mengelilinginya adalah enam puluh orang perkasa, dari antara orang-orang perkasa Israel.", "words": [{"pos": 1, "word_orig": "הִנֵּ֗ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "מִטָּת/וֹ֙", "strong": "H4296", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "joli"}, {"pos": 3, "word_orig": "שֶׁ/לִּ/שְׁלֹמֹ֔ה", "strong": "H8010", "morph": "HTr/R/Np", "morph_id": "Tr + Preposisi + Nomina Jamak", "ayt_word": "Salomo"}, {"pos": 4, "word_orig": "שִׁשִּׁ֥ים", "strong": "H8346", "morph": "HAcbpa", "morph_id": "Acbpa", "ayt_word": "enam"}, {"pos": 5, "word_orig": "גִּבֹּרִ֖ים", "strong": "H1368", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "perkasa"}, {"pos": 6, "word_orig": "סָבִ֣יב", "strong": "H5439", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "mengelilinginya"}, {"pos": 7, "word_orig": "לָ֑/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}, {"pos": 8, "word_orig": "מִ/גִּבֹּרֵ֖י", "strong": "H1368", "morph": "HR/Aampc", "morph_id": "Preposisi + Aampc", "ayt_word": "perkasa"}, {"pos": 9, "word_orig": "יִשְׂרָאֵֽל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}]}, {"book": 22, "chapter": 3, "verse": 8, "ayat_id": 17580, "title": "", "ayt_text": "Mereka semua memegang pedang, dan terlatih dalam peperangan; setiap orang dengan pedang di pinggangnya untuk berjaga-jaga terhadap kengerian pada waktu malam.", "words": [{"pos": 1, "word_orig": "כֻּלָּ/ם֙", "strong": "H3605", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "semua"}, {"pos": 2, "word_orig": "אֲחֻ֣זֵי", "strong": "H270", "morph": "HVqsmpc", "morph_id": "Verba Qal Pa