[{"book": 19, "chapter": 146, "verse": 1, "ayat_id": 16343, "title": "Pujian dan Kepercayaan", "ayt_text": "Haleluya! Pujilah TUHAN, hai jiwaku!", "words": [{"pos": 1, "word_orig": "הַֽלְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Haleluya"}, {"pos": 2, "word_orig": "יָ֡הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Haleluya"}, {"pos": 3, "word_orig": "הַלְלִ֥י", "strong": "H1984", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Pujilah"}, {"pos": 4, "word_orig": "נַ֝פְשִׁ֗/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 146, "verse": 2, "ayat_id": 16344, "title": "", "ayt_text": "Aku akan memuji TUHAN selama aku hidup, aku akan bermazmur kepada Allahku selagi aku ada.", "words": [{"pos": 1, "word_orig": "אֲהַלְלָ֣ה", "strong": "H1984", "morph": "HVph1cs", "morph_id": "Verba Piel Orang ke-1 Tunggal", "ayt_word": "memuji"}, {"pos": 2, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "בְּ/חַיָּ֑/י", "strong": "H2416", "morph": "HR/Ncmpc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "hidup"}, {"pos": 4, "word_orig": "אֲזַמְּרָ֖ה", "strong": "H2167", "morph": "HVph1cs", "morph_id": "Verba Piel Orang ke-1 Tunggal", "ayt_word": "bermazmur"}, {"pos": 5, "word_orig": "לֵֽ/אלֹהַ֣/י", "strong": "H430", "morph": "HR/Ncmpc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Allahku"}, {"pos": 6, "word_orig": "בְּ/עוֹדִֽ/י", "strong": "H5750", "morph": "HR/D/Sp1cs", "morph_id": "Preposisi + Adverbia + Sp1cs", "ayt_word": "ada"}]}, {"book": 19, "chapter": 146, "verse": 3, "ayat_id": 16345, "title": "", "ayt_text": "Jangan percaya kepada para penguasa, kepada anak manusia, yang tidak punya keselamatan.", "words": [{"pos": 1, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Jangan"}, {"pos": 2, "word_orig": "תִּבְטְח֥וּ", "strong": "H982", "morph": "HVqj2mp", "morph_id": "Verba Qal Orang ke-2 Laki-laki Jamak", "ayt_word": "percaya"}, {"pos": 3, "word_orig": "בִ/נְדִיבִ֑ים", "strong": "H5081", "morph": "HR/Aampa", "morph_id": "Preposisi + Aampa", "ayt_word": "penguasa"}, {"pos": 4, "word_orig": "בְּ/בֶן", "strong": "H1121", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "anak"}, {"pos": 5, "word_orig": "אָדָ֓ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 6, "word_orig": "שֶׁ֤/אֵֽין", "strong": "H369", "morph": "HTr/Tn", "morph_id": "Tr + Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "ל֥/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 8, "word_orig": "תְשׁוּעָֽה", "strong": "H8668", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatan"}]}, {"book": 19, "chapter": 146, "verse": 4, "ayat_id": 16346, "title": "", "ayt_text": "Ketika napasnya pergi, dia kembali sampai ke tanah, pada hari itu juga, lenyap pikiran-pikirannya.", "words": [{"pos": 1, "word_orig": "תֵּצֵ֣א", "strong": "H3318", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "pergi"}, {"pos": 2, "word_orig": "ר֭וּח/וֹ", "strong": "H7307", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "napasnya"}, {"pos": 3, "word_orig": "יָשֻׁ֣ב", "strong": "H7725", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kembali"}, {"pos": 4, "word_orig": "לְ/אַדְמָת֑/וֹ", "strong": "H127", "morph": "HR/Ncfsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tanah"}, {"pos": 5, "word_orig": "בַּ/יּ֥וֹם", "strong": "H3117", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 6, "word_orig": "הַ֝/ה֗וּא", "strong": "H1931", "morph": "HTd/Pp3ms", "morph_id": "Artikel Definit (הַ) + Pp3ms", "ayt_word": "itu"}, {"pos": 7, "word_orig": "אָבְד֥וּ", "strong": "H6", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "lenyap"}, {"pos": 8, "word_orig": "עֶשְׁתֹּנֹתָֽי/ו", "strong": "H6250", "morph": "HNcfpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "pikiran-pikirannya"}]}, {"book": 19, "chapter": 146, "verse": 5, "ayat_id": 16347, "title": "", "ayt_text": "Diberkatilah dia yang penolongnya adalah Allah Yakub, yang harapannya ada dalam TUHAN, Allahnya.", "words": [{"pos": 1, "word_orig": "אַשְׁרֵ֗י", "strong": "H835", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Diberkatilah"}, {"pos": 2, "word_orig": "שֶׁ֤/אֵ֣ל", "strong": "H410", "morph": "HTr/Ncmsc", "morph_id": "Tr + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "יַעֲקֹ֣ב", "strong": "H3290", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yakub"}, {"pos": 4, "word_orig": "בְּ/עֶזְר֑/וֹ", "strong": "H5828", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "penolongnya"}, {"pos": 5, "word_orig": "שִׂ֝בְר֗/וֹ", "strong": "H7664", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "harapannya"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 7, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "אֱלֹהָֽי/ו", "strong": "H430", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "Allahnya"}]}, {"book": 19, "chapter": 146, "verse": 6, "ayat_id": 16348, "title": "", "ayt_text": "Yang menjadikan langit dan bumi, laut dan semua yang ada di dalamnya, yang tetap setia selama-lamanya.", "words": [{"pos": 1, "word_orig": "עֹשֶׂ֤ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menjadikan"}, {"pos": 2, "word_orig": "שָׁ֘מַ֤יִם", "strong": "H8064", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 3, "word_orig": "וָ/אָ֗רֶץ", "strong": "H776", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 4, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 5, "word_orig": "הַ/יָּ֥ם", "strong": "H3220", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laut"}, {"pos": 6, "word_orig": "וְ/אֶת", "strong": "H853", "morph": "HC/To", "morph_id": "Konjungsi (וְ) + Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 8, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 9, "word_orig": "בָּ֑/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 10, "word_orig": "הַ/שֹּׁמֵ֖ר", "strong": "H8104", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "tetap"}, {"pos": 11, "word_orig": "אֱמֶ֣ת", "strong": "H571", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "setia"}, {"pos": 12, "word_orig": "לְ/עוֹלָֽם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}]}, {"book": 19, "chapter": 146, "verse": 7, "ayat_id": 16349, "title": "", "ayt_text": "Yang melaksanakan keadilan bagi yang tertindas, yang memberi makanan kepada yang lapar. TUHAN membebaskan para tahanan.", "words": [{"pos": 1, "word_orig": "עֹשֶׂ֤ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melaksanakan"}, {"pos": 2, "word_orig": "מִשְׁפָּ֨ט", "strong": "H4941", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 3, "word_orig": "לָ/עֲשׁוּקִ֗ים", "strong": "H6231", "morph": "HRd/Vqsmpa", "morph_id": "Rd + Verba Qal Partisip Pasif", "ayt_word": "tertindas"}, {"pos": 4, "word_orig": "נֹתֵ֣ן", "strong": "H5414", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memberi"}, {"pos": 5, "word_orig": "לֶ֭חֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}, {"pos": 6, "word_orig": "לָ/רְעֵבִ֑ים", "strong": "H7457", "morph": "HRd/Aampa", "morph_id": "Rd + Aampa", "ayt_word": "lapar"}, {"pos": 7, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "מַתִּ֥יר", "strong": "H5425", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "membebaskan"}, {"pos": 9, "word_orig": "אֲסוּרִֽים", "strong": "H631", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "tahanan"}]}, {"book": 19, "chapter": 146, "verse": 8, "ayat_id": 16350, "title": "", "ayt_text": "TUHAN mencelikkan yang buta, TUHAN membangkitkan orang-orang yang tertunduk. TUHAN mengasihi orang-orang benar.", "words": [{"pos": 1, "word_orig": "יְהוָ֤ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "פֹּ֘קֵ֤חַ", "strong": "H6491", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencelikkan"}, {"pos": 3, "word_orig": "עִוְרִ֗ים", "strong": "H5787", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "buta"}, {"pos": 4, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "זֹקֵ֣ף", "strong": "H2210", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membangkitkan"}, {"pos": 6, "word_orig": "כְּפוּפִ֑ים", "strong": "H3721", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "tertunduk"}, {"pos": 7, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "אֹהֵ֥ב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengasihi"}, {"pos": 9, "word_orig": "צַדִּיקִֽים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}]}, {"book": 19, "chapter": 146, "verse": 9, "ayat_id": 16351, "title": "", "ayt_text": "TUHAN melindungi orang-orang yang tinggal sementara, Dia memulihkan anak-anak yatim dan janda, tetapi jalan orang fasik Dia bengkokkan.", "words": [{"pos": 1, "word_orig": "יְהוָ֤ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "שֹׁ֘מֵ֤ר", "strong": "H8104", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melindungi"}, {"pos": 3, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 4, "word_orig": "גֵּרִ֗ים", "strong": "H1616", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "yang"}, {"pos": 5, "word_orig": "יָת֣וֹם", "strong": "H3490", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "וְ/אַלְמָנָ֣ה", "strong": "H490", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "janda"}, {"pos": 7, "word_orig": "יְעוֹדֵ֑ד", "strong": "H5749", "morph": "HVoi3ms", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memulihkan"}, {"pos": 8, "word_orig": "וְ/דֶ֖רֶךְ", "strong": "H1870", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 9, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 10, "word_orig": "יְעַוֵּֽת", "strong": "H5791", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bengkokkan"}]}, {"book": 19, "chapter": 146, "verse": 10, "ayat_id": 16352, "title": "", "ayt_text": "TUHAN akan memerintah untuk selama-lamanya, Allahmu, hai Sion, bagi segala generasi. Haleluya!", "words": [{"pos": 1, "word_orig": "יִמְלֹ֤ךְ", "strong": "H4427", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memerintah"}, {"pos": 2, "word_orig": "יְהוָ֨ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "לְ/עוֹלָ֗ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 4, "word_orig": "אֱלֹהַ֣יִ/ךְ", "strong": "H430", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "Allahmu"}, {"pos": 5, "word_orig": "צִ֭יּוֹן", "strong": "H6726", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sion"}, {"pos": 6, "word_orig": "לְ/דֹ֥ר", "strong": "H1755", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "segala"}, {"pos": 7, "word_orig": "וָ/דֹ֗ר", "strong": "H1755", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "segala"}, {"pos": 8, "word_orig": "הַֽלְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Haleluya"}, {"pos": 9, "word_orig": "יָֽהּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Haleluya"}]}]