at) Laki-laki Tunggal Absolut", "ayt_word": "didikan"}, {"pos": 7, "word_orig": "בַּֽ/יהוָה֙", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "בָטָ֔חָה", "strong": "H982", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "percaya"}, {"pos": 10, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 11, "word_orig": "אֱלֹהֶ֖י/הָ", "strong": "H430", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "Allahnya"}, {"pos": 12, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 13, "word_orig": "קָרֵֽבָה", "strong": "H7126", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mendekat"}]}, {"book": 36, "chapter": 3, "verse": 3, "ayat_id": 22824, "title": "", "ayt_text": "“Para pemimpin di tengah-tengahnya seperti singa yang mengaum; para hakimnya seperti serigala malam yang tidak meninggalkan apa pun untuk pagi hari.”", "words": [{"pos": 1, "word_orig": "שָׂרֶ֣י/הָ", "strong": "H8269", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "pemimpin"}, {"pos": 2, "word_orig": "בְ/קִרְבָּ֔/הּ", "strong": "H7130", "morph": "HR/Ncmsc/Sp3fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "di"}, {"pos": 3, "word_orig": "אֲרָי֖וֹת", "strong": "H738", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "singa"}, {"pos": 4, "word_orig": "שֹֽׁאֲגִ֑ים", "strong": "H7580", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "mengaum"}, {"pos": 5, "word_orig": "שֹׁפְטֶ֨י/הָ֙", "strong": "H8199", "morph": "HVqrmpc/Sp3fs", "morph_id": "Verba Qal + Sp3fs", "ayt_word": "hakimnya"}, {"pos": 6, "word_orig": "זְאֵ֣בֵי", "strong": "H2061", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "serigala"}, {"pos": 7, "word_orig": "עֶ֔רֶב", "strong": "H6153", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 8, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "גָרְמ֖וּ", "strong": "H1633", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "meninggalkan"}, {"pos": 10, "word_orig": "לַ/בֹּֽקֶר", "strong": "H1242", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pagi"}]}, {"book": 36, "chapter": 3, "verse": 4, "ayat_id": 22825, "title": "", "ayt_text": "“Para nabinya ceroboh, orang-orang pengkhianat, para imamnya melanggar kekudusan; mencemarkan Taurat.”", "words": [{"pos": 1, "word_orig": "נְבִיאֶ֨י/הָ֙", "strong": "H5030", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "nabinya"}, {"pos": 2, "word_orig": "פֹּֽחֲזִ֔ים", "strong": "H6348", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "ceroboh"}, {"pos": 3, "word_orig": "אַנְשֵׁ֖י", "strong": "H376", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "orang-orang"}, {"pos": 4, "word_orig": "בֹּֽגְד֑וֹת", "strong": "H900", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "pengkhianat"}, {"pos": 5, "word_orig": "כֹּהֲנֶ֨י/הָ֙", "strong": "H3548", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "imamnya"}, {"pos": 6, "word_orig": "חִלְּלוּ", "strong": "H2490", "morph