ong": "H3956", "morph": "HC/Ncbsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "lidah"}, {"pos": 9, "word_orig": "רְמִיָּ֥ה", "strong": "H7423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tipu"}, {"pos": 10, "word_orig": "בְּ/פִי/הֶֽם", "strong": "H6310", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mulut"}]}, {"book": 33, "chapter": 6, "verse": 13, "ayat_id": 22662, "title": "", "ayt_text": "“Sebab itu, aku akan membuatmu sakit dengan memukulmu, membuatmu hancur karena dosa-dosamu.”", "words": [{"pos": 1, "word_orig": "וְ/גַם", "strong": "H1571", "morph": "HC/Ta", "morph_id": "Konjungsi (וְ) + Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "אֲנִ֖י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 3, "word_orig": "הֶחֱלֵ֣יתִי", "strong": "H2470", "morph": "HVhp1cs", "morph_id": "Verba Hifil Perfek Orang ke-1 Tunggal", "ayt_word": "membuatmu"}, {"pos": 4, "word_orig": "הַכּוֹתֶ֑/ךָ", "strong": "H5221", "morph": "HVhc/Sp2ms", "morph_id": "Verba Hifil Imperatif + Sp2ms", "ayt_word": "memukulmu"}, {"pos": 5, "word_orig": "הַשְׁמֵ֖ם", "strong": "H8074", "morph": "HVha", "morph_id": "Verba Hifil Infinitif Absolut", "ayt_word": "hancur"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "karena"}, {"pos": 7, "word_orig": "חַטֹּאתֶֽ/ךָ", "strong": "H2403", "morph": "HNcfpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "dosa-dosamu"}]}, {"book": 33, "chapter": 6, "verse": 14, "ayat_id": 22663, "title": "", "ayt_text": "“Kamu akan makan, tetapi tidak menjadi kenyang. Kekosonganmu akan ada di dalammu. Kamu akan menyingkirkan sesuatu, tetapi tidak dapat menyelamatkannya. Apa yang kamu selamatkan, akan Kusera