id": "Nomina Jamak", "ayt_word": "Yerusalem"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "נִדְחֵ֖י", "strong": "H1760", "morph": "HVNrmpc", "morph_id": "Verba Nifal", "ayt_word": "terbuang"}, {"pos": 5, "word_orig": "יִשְׂרָאֵ֣ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 6, "word_orig": "יְכַנֵּֽס", "strong": "H3664", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengumpulkan"}]}, {"book": 19, "chapter": 147, "verse": 3, "ayat_id": 16355, "title": "", "ayt_text": "Dia menyembuhkan yang hancur hati, dan membalut luka-luka mereka.", "words": [{"pos": 1, "word_orig": "הָ֭/רֹפֵא", "strong": "H7495", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menyembuhkan"}, {"pos": 2, "word_orig": "לִ/שְׁב֣וּרֵי", "strong": "H7665", "morph": "HR/Vqsmpc", "morph_id": "Preposisi + Verba Qal Partisip Pasif", "ayt_word": "hancur"}, {"pos": 3, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 4, "word_orig": "וּ֝/מְחַבֵּ֗שׁ", "strong": "H2280", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "membalut"}, {"pos": 5, "word_orig": "לְ/עַצְּבוֹתָֽ/ם", "strong": "H6094", "morph": "HR/Ncfpc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "luka-luka"}]}, {"book": 19, "chapter": 147, "verse": 4, "ayat_id": 16356, "title": "", "ayt_text": "Dia menghitung jumlah bintang-bintang, Dia memberi nama-nama kepada mereka semua.", "words": [{"pos": 1, "word_orig": "מוֹנֶ֣ה", "strong": "H4487", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghitung"}, {"pos": 2, "word_orig": "מִ֭סְפָּר", "strong": "H4557", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (T