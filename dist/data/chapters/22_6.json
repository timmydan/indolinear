[{"book": 22, "chapter": 6, "verse": 1, "ayat_id": 17616, "title": "Putri-Putri Yerusalem Menjawab Pengantin Perempuan", "ayt_text": "Ke mana kekasihmu pergi, hai yang tercantik di antara para perempuan? Ke mana kekasihmu berbelok, supaya kami dapat mencarinya bersamamu?", "words": [{"pos": 1, "word_orig": "אָ֚נָה", "strong": "H575", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Ke"}, {"pos": 2, "word_orig": "הָלַ֣ךְ", "strong": "H1980", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "pergi"}, {"pos": 3, "word_orig": "דּוֹדֵ֔/ךְ", "strong": "H1730", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "kekasihmu"}, {"pos": 4, "word_orig": "הַ/יָּפָ֖ה", "strong": "H3303", "morph": "HTd/Aafsa", "morph_id": "Artikel Definit (הַ) + Aafsa", "ayt_word": "tercantik"}, {"pos": 5, "word_orig": "בַּ/נָּשִׁ֑ים", "strong": "H802", "morph": "HRd/Ncfpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "perempuan"}, {"pos": 6, "word_orig": "אָ֚נָה", "strong": "H575", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Ke"}, {"pos": 7, "word_orig": "פָּנָ֣ה", "strong": "H6437", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berbelok"}, {"pos": 8, "word_orig": "דוֹדֵ֔/ךְ", "strong": "H1730", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "kekasihmu"}, {"pos": 9, "word_orig": "וּ/נְבַקְשֶׁ֖/נּוּ", "strong": "H1245", "morph": "HC/Vpi1cp/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-1 Jamak + Sp3ms", "ayt_word": "mencarinya"}, {"pos": 10, "word_orig": "עִמָּֽ/ךְ", "strong": "H5973", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": "bersamamu"}]}, {"book": 22, "chapter": 6, "verse": 2, "ayat_id": 17617, "title": "", "ayt_text": "Kekasihku telah turun ke kebunnya, ke petak-petak rempah-rempah, untuk menggembala di kebun, dan mengumpulkan bunga-bunga bakung.", "words": [{"pos": 1, "word_orig": "דּוֹדִ/י֙", "strong": "H1730", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Kekasihku"}, {"pos": 2, "word_orig": "יָרַ֣ד", "strong": "H3381", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "turun"}, {"pos": 3, "word_orig": "לְ/גַנּ֔/וֹ", "strong": "H1588", "morph": "HR/Ncbsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kebunnya"}, {"pos": 4, "word_orig": "לַ/עֲרוּג֖וֹת", "strong": "H6170", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "petak-petak"}, {"pos": 5, "word_orig": "הַ/בֹּ֑שֶׂם", "strong": "H1314", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rempah-rempah"}, {"pos": 6, "word_orig": "לִ/רְעוֹת֙", "strong": "H7462", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "menggembala"}, {"pos": 7, "word_orig": "בַּ/גַּנִּ֔ים", "strong": "H1588", "morph": "HRd/Ncbpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "kebun"}, {"pos": 8, "word_orig": "וְ/לִ/לְקֹ֖ט", "strong": "H3950", "morph": "HC/R/Vqc", "morph_id": "Konjungsi (וְ) + Preposisi + Verba Qal Imperatif", "ayt_word": "mengumpulkan"}, {"pos": 9, "word_orig": "שֽׁוֹשַׁנִּֽים", "strong": "H7799", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "bunga-bunga"}]}, {"book": 22, "chapter": 6, "verse": 3, "ayat_id": 17618, "title": "", "ayt_text": "Aku adalah milik kekasihku, dan kekasihku adalah milikku. Dia menggembala di antara bunga-bunga bakung.", "words": [{"pos": 1, "word_orig": "אֲנִ֤י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 2, "word_orig": "לְ/דוֹדִ/י֙", "strong": "H1730", "morph": "HR/Ncmsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 3, "word_orig": "וְ/דוֹדִ֣/י", "strong": "H1730", "morph": "HC/Ncmsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "לִ֔/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 5, "word_orig": "הָ/רֹעֶ֖ה", "strong": "H7462", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "menggembala"}, {"pos": 6, "word_orig": "בַּ/שׁוֹשַׁנִּֽים", "strong": "H7799", "morph": "HRd/Ncbpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "bunga-bunga"}]}, {"book": 22, "chapter": 6, "verse": 4, "ayat_id": 17619, "title": "Pengantin Laki-laki Memuji Kekasihnya", "ayt_text": "Engkau cantik seperti Tirza, kekasihku, elok seperti Yerusalem, dan menakjubkan seperti bala tentara dengan panji-panjinya.", "words": [{"pos": 1, "word_orig": "יָפָ֨ה", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantik"}, {"pos": 2, "word_orig": "אַ֤תְּ", "strong": "H859", "morph": "HPp2fs", "morph_id": "Pp2fs", "ayt_word": "Engkau"}, {"pos": 3, "word_orig": "רַעְיָתִ/י֙", "strong": "H7474", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "כְּ/תִרְצָ֔ה", "strong": "H8656", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Tirza"}, {"pos": 5, "word_orig": "נָאוָ֖ה", "strong": "H5000", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "elok"}, {"pos": 6, "word_orig": "כִּ/ירוּשָׁלִָ֑ם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}, {"pos": 7, "word_orig": "אֲיֻמָּ֖ה", "strong": "H366", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "menakjubkan"}, {"pos": 8, "word_orig": "כַּ/נִּדְגָּלֽוֹת", "strong": "H1713", "morph": "HRd/VNrfpa", "morph_id": "Rd + Verba Nifal", "ayt_word": "tentara"}]}, {"book": 22, "chapter": 6, "verse": 5, "ayat_id": 17620, "title": "", "ayt_text": "Alihkan matamu dariku karena mereka membingungkanku. Rambutmu bagaikan kawanan kambing betina yang menuruni Gunung Gilead.", "words": [{"pos": 1, "word_orig": "הָסֵ֤בִּי", "strong": "H5437", "morph": "HVhv2fs", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Alihkan"}, {"pos": 2, "word_orig": "עֵינַ֨יִ/ךְ֙", "strong": "H5869", "morph": "HNcbdc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2fs", "ayt_word": "matamu"}, {"pos": 3, "word_orig": "מִ/נֶּגְדִּ֔/י", "strong": "H5048", "morph": "HR/R/Sp1cs", "morph_id": "Preposisi + Preposisi + Sp1cs", "ayt_word": "dariku"}, {"pos": 4, "word_orig": "שֶׁ֥/הֵ֖ם", "strong": "H1992", "morph": "HTr/Sp3mp", "morph_id": "Tr + Sp3mp", "ayt_word": "mereka"}, {"pos": 5, "word_orig": "הִרְהִיבֻ֑/נִי", "strong": "H7292", "morph": "HVhp3cp/Sp1cs", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "membingungkanku"}, {"pos": 6, "word_orig": "שַׂעְרֵ/ךְ֙", "strong": "H8181", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "Rambutmu"}, {"pos": 7, "word_orig": "כְּ/עֵ֣דֶר", "strong": "H5739", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kawanan"}, {"pos": 8, "word_orig": "הָֽ/עִזִּ֔ים", "strong": "H5795", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "betina"}, {"pos": 9, "word_orig": "שֶׁ/גָּלְשׁ֖וּ", "strong": "H1570", "morph": "HTr/Vqp3cp", "morph_id": "Tr + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "menuruni"}, {"pos": 10, "word_orig": "מִן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 11, "word_orig": "הַ/גִּלְעָֽד", "strong": "H1568", "morph": "HTd/Np", "morph_id": "Artikel Definit (הַ) + Nomina Jamak", "ayt_word": "Gilead"}]}, {"book": 22, "chapter": 6, "verse": 6, "ayat_id": 17621, "title": "", "ayt_text": "Gigimu bagaikan kawanan domba betina yang keluar dari pencuciannya. Semuanya itu beranak kembar, dan tidak satu pun dari mereka kehilangan anaknya.", "words": [{"pos": 1, "word_orig": "שִׁנַּ֨יִ/ךְ֙", "strong": "H8127", "morph": "HNcbdc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2fs", "ayt_word": "Gigimu"}, {"pos": 2, "word_orig": "כְּ/עֵ֣דֶר", "strong": "H5739", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kawanan"}, {"pos": 3, "word_orig": "הָֽ/רְחֵלִ֔ים", "strong": "H7353", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "domba"}, {"pos": 4, "word_orig": "שֶׁ/עָל֖וּ", "strong": "H5927", "morph": "HTr/Vqp3cp", "morph_id": "Tr + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "keluar"}, {"pos": 5, "word_orig": "מִן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dari"}, {"pos": 6, "word_orig": "הָ/רַחְצָ֑ה", "strong": "H7367", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pencuciannya"}, {"pos": 7, "word_orig": "שֶׁ/כֻּלָּ/ם֙", "strong": "H3605", "morph": "HTr/Ncmsc/Sp3mp", "morph_id": "Tr + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "Semuanya"}, {"pos": 8, "word_orig": "מַתְאִימ֔וֹת", "strong": "H8382", "morph": "HVhrfpa", "morph_id": "Verba Hifil", "ayt_word": "kembar"}, {"pos": 9, "word_orig": "וְ/שַׁכֻּלָ֖ה", "strong": "H7909", "morph": "HC/Aafsa", "morph_id": "Konjungsi (וְ) + Aafsa", "ayt_word": "anaknya"}, {"pos": 10, "word_orig": "אֵ֥ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "satu"}, {"pos": 11, "word_orig": "בָּ/הֶֽם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 22, "chapter": 6, "verse": 7, "ayat_id": 17622, "title": "", "ayt_text": "Pelipismu bagaikan irisan-irisan buah delima di balik cadarmu.", "words": [{"pos": 1, "word_orig": "כְּ/פֶ֤לַח", "strong": "H6400", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "irisan-irisan"}, {"pos": 2, "word_orig": "הָ/רִמּוֹן֙", "strong": "H7416", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "buah"}, {"pos": 3, "word_orig": "רַקָּתֵ֔/ךְ", "strong": "H7541", "morph": "HNcfsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "cadarmu"}, {"pos": 4, "word_orig": "מִ/בַּ֖עַד", "strong": "H1157", "morph": "HR/R", "morph_id": "Preposisi + Preposisi", "ayt_word": "di"}, {"pos": 5, "word_orig": "לְ/צַמָּתֵֽ/ךְ", "strong": "H6777", "morph": "HR/Ncfsc/Sp2fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "cadarmu"}]}, {"book": 22, "chapter": 6, "verse": 8, "ayat_id": 17623, "title": "", "ayt_text": "Ada enam puluh permaisuri, dan delapan puluh gundik, dan gadis-gadis yang tidak terhitung.", "words": [{"pos": 1, "word_orig": "שִׁשִּׁ֥ים", "strong": "H8346", "morph": "HAcbpa", "morph_id": "Acbpa", "ayt_word": "enam"}, {"pos": 2, "word_orig": "הֵ֨מָּה֙", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": ""}, {"pos": 3, "word_orig": "מְּלָכ֔וֹת", "strong": "H4436", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "permaisuri"}, {"pos": 