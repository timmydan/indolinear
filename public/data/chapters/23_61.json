[{"book": 23, "chapter": 61, "verse": 1, "ayat_id": 18845, "title": "Firman TUHAN tentang Kebebasan", "ayt_text": "Roh TUHAN Allah ada padaku karena TUHAN telah mengurapi aku untuk memberitakan kabar baik kepada orang-orang yang tertindas. Dia telah mengutus aku untuk membalut orang yang patah hati, untuk menyatakan kebebasan kepada para tawanan, dan kelepasan kepada para tahanan,", "words": [{"pos": 1, "word_orig": "ר֛וּחַ", "strong": "H7307", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Roh"}, {"pos": 2, "word_orig": "אֲדֹנָ֥/י", "strong": "H136", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "יְהוִ֖ה", "strong": "H3069", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "עָלָ֑/י", "strong": "H5921", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "padaku"}, {"pos": 5, "word_orig": "יַ֡עַן", "strong": "H3282", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "מָשַׁח֩", "strong": "H4886", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengurapi"}, {"pos": 7, "word_orig": "יְהוָ֨ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "אֹתִ֜/י", "strong": "H853", "morph": "HTo/Sp1cs", "morph_id": "Tanda Objek (אֵת) + Sp1cs", "ayt_word": ""}, {"pos": 9, "word_orig": "לְ/בַשֵּׂ֣ר", "strong": "H1319", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "baik"}, {"pos": 10, "word_orig": "עֲנָוִ֗ים", "strong": "H6035", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "tertindas"}, {"pos": 11, "word_orig": "שְׁלָחַ֨/נִי֙", "strong": "H7971", "morph": "HVqp3ms/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "mengutus"}, {"pos": 12