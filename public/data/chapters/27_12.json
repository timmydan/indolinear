[{"book": 27, "chapter": 12, "verse": 1, "ayat_id": 22083, "title": "Akhir Zaman", "ayt_text": "“Pada waktu itu akan muncul Mikhael, pemimpin besar yang akan mendampingi anak-anak bangsamu. Akan ada masa kesusahan yang belum pernah terjadi sejak bangsa-bangsa ada sampai pada waktu itu. Akan tetapi, pada waktu itu bangsamu akan terluput, yaitu setiap orang yang namanya ditemukan tertulis dalam kitab itu.", "words": [{"pos": 1, "word_orig": "וּ/בָ/עֵ֣ת", "strong": "H6256", "morph": "HC/Rd/Ncbsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 2, "word_orig": "הַ/הִיא֩", "strong": "H1931", "morph": "HTd/Pp3fs", "morph_id": "Artikel Definit (הַ) + Pp3fs", "ayt_word": "itu"}, {"pos": 3, "word_orig": "יַעֲמֹ֨ד", "strong": "H5975", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "muncul"}, {"pos": 4, "word_orig": "מִֽיכָאֵ֜ל", "strong": "H4317", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Mikhael"}, {"pos": 5, "word_orig": "הַ/שַּׂ֣ר", "strong": "H8269", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pemimpin"}, {"pos": 6, "word_orig": "הַ/גָּד֗וֹל", "strong": "H1419", "morph": "HTd/Aamsa", "morph_id": "Artikel Definit (הַ) + Aamsa", "ayt_word": "besar"}, {"pos": 7, "word_orig": "הָ/עֹמֵד֮", "strong": "H5975", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "mendampingi"}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 9, "word_orig": "בְּנֵ֣י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 10, "word_orig": "עַמֶּ/ךָ֒", "strong": "H5971", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "ban