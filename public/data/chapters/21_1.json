[{"book": 21, "chapter": 1, "verse": 1, "ayat_id": 17317, "title": "Segala Sesuatu Adalah Kesia-siaan", "ayt_text": "Kata-kata Pengkhotbah, anak Daud, raja di Yerusalem.", "words": [{"pos": 1, "word_orig": "דִּבְרֵי֙", "strong": "H1697", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Kata-kata"}, {"pos": 2, "word_orig": "קֹהֶ֣לֶת", "strong": "H6953", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Pengkhotbah"}, {"pos": 3, "word_orig": "בֶּן", "strong": "H1121", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "anak"}, {"pos": 4, "word_orig": "דָּוִ֔ד", "strong": "H1732", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Daud"}, {"pos": 5, "word_orig": "מֶ֖לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raja"}, {"pos": 6, "word_orig": "בִּ/ירוּשָׁלִָֽם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}]}, {"book": 21, "chapter": 1, "verse": 2, "ayat_id": 17318, "title": "", "ayt_text": "“Kesia-siaan atas segala kesia-siaan,” kata Pengkhotbah, “Kesia-siaan atas segala kesia-siaan! Semuanya adalah kesia-siaan.”", "words": [{"pos": 1, "word_orig": "הֲבֵ֤ל", "strong": "H1892", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Kesia-siaan"}, {"pos": 2, "word_orig": "הֲבָלִים֙", "strong": "H1892", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kesia-siaan"}, {"pos": 3, "word_orig": "אָמַ֣ר", "strong": "H559", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kata"}, {"pos": 4, "word_orig": "קֹהֶ֔לֶת", "strong": "H6953", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "