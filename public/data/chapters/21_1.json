 (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Matahari"}, {"pos": 3, "word_orig": "וּ/בָ֣א", "strong": "H935", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "terbenam"}, {"pos": 4, "word_orig": "הַ/שָּׁ֑מֶשׁ", "strong": "H8121", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "matahari"}, {"pos": 5, "word_orig": "וְ/אֶ֨ל", "strong": "H413", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "ke"}, {"pos": 6, "word_orig": "מְקוֹמ֔/וֹ", "strong": "H4725", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tempat"}, {"pos": 7, "word_orig": "שׁוֹאֵ֛ף", "strong": "H7602", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "terengah-engah"}, {"pos": 8, "word_orig": "זוֹרֵ֥חַֽ", "strong": "H2224", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "terbit"}, {"pos": 9, "word_orig": "ה֖וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "ia"}, {"pos": 10, "word_orig": "שָֽׁם", "strong": "H8033", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "di"}]}, {"book": 21, "chapter": 1, "verse": 6, "ayat_id": 17322, "title": "", "ayt_text": "Angin bertiup ke selatan, lalu berputar ke utara. Angin bertiup berputar-putar, lalu kembali ke peredarannya.", "words": [{"pos": 1, "word_orig": "הוֹלֵךְ֙", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "bertiup"}, {"pos": 2, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 3, "word_orig": "דָּר֔וֹם", "strong": "H1864", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selatan"}, {"pos": 4, "word_orig": "וְ/סוֹבֵ֖ב", "strong": "H5437", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "berputar"}, {"pos": 5, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 6, "word_orig": "צָפ֑וֹן", "strong": "H6828", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "utara"}, {"pos": 7, "word_orig": "סוֹבֵ֤ב", "strong": "H5437", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berputar-putar"}, {"pos": 8, "word_orig": "סֹבֵב֙", "strong": "H5437", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berputar-putar"}, {"pos": 9, "word_orig": "הוֹלֵ֣ךְ", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "bertiup"}, {"pos": 10, "word_orig": "הָ/ר֔וּחַ", "strong": "H7307", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Angin"}, {"pos": 11, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "ke"}, {"pos": 12, "word_orig": "סְבִיבֹתָ֖י/ו", "strong": "H5439", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "peredarannya"}, {"pos": 13, "word_orig": "שָׁ֥ב", "strong": "H7725", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "kembali"}, {"pos": 14, "word_orig": "הָ/רֽוּחַ", "strong": "H7307", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Angin"}]}, {"book": 21, "chapter": 1, "verse": 7, "ayat_id": 17323, "title": "", "ayt_text": "Segala sungai mengalir ke laut, tetapi laut tidak pernah penuh. Ke tempat sungai-sungai itu mengalir, ke sanalah mereka mengalir kembali.", "words": [{"pos": 1, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Segala"}, {"pos": 2, "word_orig": "הַ/נְּחָלִים֙", "strong": "H5158", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) 