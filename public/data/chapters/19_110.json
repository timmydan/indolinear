_word": "mayat-mayat"}, {"pos": 5, "word_orig": "מָ֥חַץ", "strong": "H4272", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghancurkan"}, {"pos": 6, "word_orig": "רֹ֝֗אשׁ", "strong": "H7218", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pimpinan"}, {"pos": 7, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 8, "word_orig": "אֶ֥רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negara"}, {"pos": 9, "word_orig": "רַבָּֽה", "strong": "H7227", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "luas"}]}, {"book": 19, "chapter": 110, "verse": 7, "ayat_id": 15794, "title": "", "ayt_text": "Dia akan minum dari lembah-lembah di tepi jalan, lalu Dia akan mengangkat kepalanya.", "words": [{"pos": 1, "word_orig": "מִ֭/נַּחַל", "strong": "H5158", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "lembah-lembah"}, {"pos": 2, "word_orig": "בַּ/דֶּ֣רֶךְ", "strong": "H1870", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 3, "word_orig": "יִשְׁתֶּ֑ה", "strong": "H8354", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "minum"}, {"pos": 4, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "tepi"}, {"pos": 5, "word_orig": "כֵּ֝֗ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Dia"}, {"pos": 6, "word_orig": "יָרִ֥ים", "strong": "H7311", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengangkat"}, {"pos": 7, "word_orig": "רֹֽאשׁ", "strong": "H7218", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kepalanya"}]