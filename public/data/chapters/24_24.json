[{"book": 24, "chapter": 24, "verse": 1, "ayat_id": 19526, "title": "Buah Ara yang Baik dan Buah Ara yang Busuk", "ayt_text": "TUHAN menunjukkan kepadaku, dan lihatlah, dua keranjang buah ara diletakkan di depan Bait Allah. Ini terjadi setelah Nebukadnezar, raja Babel, membawa Yekhonya, anak Yoyakim, raja Yehuda, sebagai tawanan bersama para pejabat Yehuda, para pengrajin, dan para tukang besi dari Yerusalem, dan membawa mereka ke Babel. Lihatlah, dua keranjang ara diletakkan di depan bait TUHAN.", "words": [{"pos": 1, "word_orig": "הִרְאַ/נִי֮", "strong": "H7200", "morph": "HVhp3ms/Sp1cs", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menunjukkan"}, {"pos": 2, "word_orig": "יְהוָה֒", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "וְ/הִנֵּ֗ה", "strong": "H2009", "morph": "HC/Tm", "morph_id": "Konjungsi (וְ) + Tm", "ayt_word": "lihatlah"}, {"pos": 4, "word_orig": "שְׁנֵי֙", "strong": "H8147", "morph": "HAcmdc", "morph_id": "Acmdc", "ayt_word": "dua"}, {"pos": 5, "word_orig": "דּוּדָאֵ֣י", "strong": "H1736", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "keranjang"}, {"pos": 6, "word_orig": "תְאֵנִ֔ים", "strong": "H8384", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "buah"}, {"pos": 7, "word_orig": "מוּעָדִ֕ים", "strong": "H3259", "morph": "HVHsmpa", "morph_id": "Verba", "ayt_word": "diletakkan"}, {"pos": 8, "word_orig": "לִ/פְנֵ֖י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "depan"}, {"pos": 9, "word_orig": "הֵיכַ֣ל", "strong": "H1964", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Bait"}, {"pos": 10, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word"