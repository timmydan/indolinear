[{"book": 19, "chapter": 116, "verse": 1, "ayat_id": 15850, "title": "Selamat dari Kematian", "ayt_text": "Aku mengasihi TUHAN karena Dia mendengar suaraku, permohonanku.", "words": [{"pos": 1, "word_orig": "אָ֭הַבְתִּי", "strong": "H157", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "mengasihi"}, {"pos": 2, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 3, "word_orig": "יִשְׁמַ֥ע", "strong": "H8085", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendengar"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "ק֝וֹלִ֗/י", "strong": "H6963", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "suaraku"}, {"pos": 7, "word_orig": "תַּחֲנוּנָֽ/י", "strong": "H8469", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "permohonanku"}]}, {"book": 19, "chapter": 116, "verse": 2, "ayat_id": 15851, "title": "", "ayt_text": "Sebab, Dia menyendengkan telinga-Nya kepadaku, maka aku akan berseru kepada-Nya pada hari-hariku.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "הִטָּ֣ה", "strong": "H5186", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyendengkan"}, {"pos": 3, "word_orig": "אָזְנ֣/וֹ", "strong": "H241", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "telinga-Nya"}, {"pos": 4, "word_orig": "לִ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "kepadaku"}, {"pos": 5, "word_orig": "וּ/בְ/יָמַ֥/י", "strong": "H3117", "morph": "HC/R/Ncmpc/Sp1cs", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "אֶקְרָֽא", "strong": "H7121", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "berseru"}]}, {"book": 19, "chapter": 116, "verse": 3, "ayat_id": 15852, "title": "", "ayt_text": "Tali-tali maut telah membelitku, dan kengerian dunia orang mati menimpaku; aku ditimpa kesesakan dan kedukaan.", "words": [{"pos": 1, "word_orig": "אֲפָפ֤וּ/נִי", "strong": "H661", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "membelitku"}, {"pos": 2, "word_orig": "חֶבְלֵי", "strong": "H2256", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "Tali-tali"}, {"pos": 3, "word_orig": "מָ֗וֶת", "strong": "H4194", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}, {"pos": 4, "word_orig": "וּ/מְצָרֵ֣י", "strong": "H4712", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "kengerian"}, {"pos": 5, "word_orig": "שְׁא֣וֹל", "strong": "H7585", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "dunia"}, {"pos": 6, "word_orig": "מְצָא֑וּ/נִי", "strong": "H4672", "morph": "HVqp3cp/Sp1cs", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "menimpaku"}, {"pos": 7, "word_orig": "צָרָ֖ה", "strong": "H6869", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesesakan"}, {"pos": 8, "word_orig": "וְ/יָג֣וֹן", "strong": "H3015", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kedukaan"}, {"pos": 9, "word_orig": "אֶמְצָֽא", "strong": "H4672", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "ditimpa"}]}, {"book": 19, "chapter": 116, "verse": 4, "ayat_id": 15853, "title": "", "ayt_text": "Lalu, aku berseru kepada nama TUHAN: “Ya TUHAN, aku berdoa, lepaskanlah jiwaku!”", "words": [{"pos": 1, "word_orig": "וּ/בְ/שֵֽׁם", "strong": "H8034", "morph": "HC/R/Ncmsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 2, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "אֶקְרָ֑א", "strong": "H7121", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "berseru"}, {"pos": 4, "word_orig": "אָנָּ֥ה", "strong": "H577", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Ya"}, {"pos": 5, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "מַלְּטָ֥/ה", "strong": "H4422", "morph": "HVpv2ms/Sh", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sh", "ayt_word": "lepaskanlah"}, {"pos": 7, "word_orig": "נַפְשִֽׁ/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}]}, {"book": 19, "chapter": 116, "verse": 5, "ayat_id": 15854, "title": "", "ayt_text": "TUHAN itu murah hati dan adil, Allah kita itu berbelaskasihan.", "words": [{"pos": 1, "word_orig": "חַנּ֣וּן", "strong": "H2587", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "murah"}, {"pos": 2, "word_orig": "יְהֹוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "וְ/צַדִּ֑יק", "strong": "H6662", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "adil"}, {"pos": 4, "word_orig": "וֵ֖/אלֹהֵ֣י/נוּ", "strong": "H430", "morph": "HC/Ncmpc/Sp1cp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cp", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "מְרַחֵֽם", "strong": "H7355", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "berbelaskasihan"}]}, {"book": 19, "chapter": 116, "verse": 6, "ayat_id": 15855, "title": "", "ayt_text": "TUHAN melindungi yang sederhana; aku lemah, dan Dia menyelamatkan aku.", "words": [{"pos": 1, "word_orig": "שֹׁמֵ֣ר", "strong": "H8104", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melindungi"}, {"pos": 2, "word_orig": "פְּתָאיִ֣ם", "strong": "H6612", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sederhana"}, {"pos": 3, "word_orig": "יְהֹוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "דַּ֝לּוֹתִ֗י", "strong": "H1809", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "lemah"}, {"pos": 5, "word_orig": "וְ/לִ֣/י", "strong": "", "morph": "HC/R/Sp1cs", "morph_id": "Konjungsi (וְ) + Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 6, "word_orig": "יְהוֹשִֽׁיעַ", "strong": "H3467", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyelamatkan"}]}, {"book": 19, "chapter": 116, "verse": 7, "ayat_id": 15856, "title": "", "ayt_text": "Hai jiwaku, kembalilah beristirahat, karena TUHAN telah membalasmu.", "words": [{"pos": 1, "word_orig": "שׁוּבִ֣י", "strong": "H7725", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "kembalilah"}, {"pos": 2, "word_orig": "נַ֭פְשִׁ/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 3, "word_orig": "לִ/מְנוּחָ֑יְ/כִי", "strong": "H4496", "morph": "HR/Ncbpc/Sp2fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "beristirahat"}, {"pos": 4, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 5, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "גָּמַ֥ל", "strong": "H1580", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membalasmu"}, {"pos": 7, "word_orig": "עָלָֽיְ/כִי", "strong": "H5921", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 19, "chapter": 116, "verse": 8, "ayat_id": 15857, "title": "", "ayt_text": "Sebab, Engkau telah melepaskan jiwaku dari maut, mataku dari air mata, kakiku dari sandungan.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "חִלַּ֥צְתָּ", "strong": "H2502", "morph": "HVpp2ms", "morph_id": "Verba Piel Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "melepaskan"}, {"pos": 3, "word_orig": "נַפְשִׁ֗/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "jiwaku"}, {"pos": 4, "word_orig": "מִ֫/מָּ֥וֶת", "strong": "H4194", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "עֵינִ֥/י", "strong": "H5869", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "mataku"}, {"pos": 7, "word_orig": "מִן", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dari"}, {"pos": 8, "word_orig": "דִּמְעָ֑ה", "strong": "H1832", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "air"}, {"pos": 9, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 10, "word_orig": "רַגְלִ֥/י", "strong": "H7272", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kakiku"}, {"pos": 11, "word_orig": "מִ/דֶּֽחִי", "strong": "H1762", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sandungan"}]}, {"book": 19, "chapter": 116, "verse": 9, "ayat_id": 15858, "title": "", "ayt_text": "Aku akan berjalan di hadapan TUHAN, di negeri orang-orang hidup.", "words": [{"pos": 1, "word_orig": "אֶ֭תְהַלֵּךְ", "strong": "H1980", "morph": "HVti1cs", "morph_id": "Verba Hitpael Imperfek Orang ke-1 Tunggal", "ayt_word": "berjalan"}, {"pos": 2, "word_orig": "לִ/פְנֵ֣י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "hadapan"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "בְּ֝/אַרְצ֗וֹת", "strong": "H776", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "negeri"}, {"pos": 5, "word_orig": "הַֽ/חַיִּֽים", "strong": "H2416", "morph": "HTd/Aampa", "morph_id": "Artikel Definit (הַ) + Aampa", "ayt_word": "hidup"}]}, {"book": 19, "chapter": 116, "verse": 10, "ayat_id": 15859, "title": "", "ayt_text": "Aku percaya, walaupun pada saat aku berkata, “Aku sangat menderita.”", "words": [{"pos": 1, "word_orig": "הֶ֭אֱמַנְתִּי", "strong": "H539", "morph": "HVhp1cs", "morph_id": "Verba Hifil Perfek Orang ke-1 Tunggal", "ayt_word": "percaya"}, {"pos": 2, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "walaupun"}, {"pos": 3, "word_orig": "אֲדַבֵּ֑ר", "strong": "H1696