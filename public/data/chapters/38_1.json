d": "tidak"}, {"pos": 23, "word_orig": "וְ/לֹֽא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "memperhatikan"}, {"pos": 24, "word_orig": "הִקְשִׁ֥יבוּ", "strong": "H7181", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": ""}, {"pos": 25, "word_orig": "אֵלַ֖/י", "strong": "H413", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "firman"}, {"pos": 26, "word_orig": "נְאֻם", "strong": "H5002", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "TUHAN"}, {"pos": 27, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": ""}]}, {"book": 38, "chapter": 1, "verse": 5, "ayat_id": 22884, "title": "", "ayt_text": "Nenek moyangmu itu, di manakah mereka? Dan, para nabi itu, apakah mereka hidup selama-lamanya?", "words": [{"pos": 1, "word_orig": "אֲבֽוֹתֵי/כֶ֖ם", "strong": "H1", "morph": "HNcmpc/Sp2mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2mp", "ayt_word": "Nenek"}, {"pos": 2, "word_orig": "אַיֵּה", "strong": "H346", "morph": "HTi", "morph_id": "Ti", "ayt_word": "di"}, {"pos": 3, "word_orig": "הֵ֑ם", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": "mereka"}, {"pos": 4, "word_orig": "וְ/הַ֨/נְּבִאִ֔ים", "strong": "H5030", "morph": "HC/Td/Ncmpa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "nabi"}, {"pos": 5, "word_orig": "הַ/לְ/עוֹלָ֖ם", "strong": "H5769", "morph": "HTi/R/Ncmsa", "morph_id": "Ti + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 6, "word_orig": "יִֽחְיֽוּ", "strong": "H2421", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "hidup"}]}, {"book": 38, "chapter": 1, "verse": 6, "ayat_id": 22885, "title": "", "ayt_text": "Bukankah firman-Ku dan ketetapan-ketetapan-Ku yang telah Aku perintahkan kepada hamba-hamba-Ku, yaitu para nabi, sudah sampai kepada nenek moyangmu? Lalu, mereka bertobat dan berkata, ‘Seperti yang TUHAN semesta alam rencanakan untuk melakukannya kepada kita sesuai dengan jalan-jalan dan perbuatan-perbuatan kami, demikianlah Dia melakukannya kepada kami!’”", "words": [{"pos": 1, "word_orig": "אַ֣ךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "דְּבָרַ֣/י", "strong": "H1697", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "firman-Ku"}, {"pos": 3, "word_orig": "וְ/חֻקַּ֗/י", "strong": "H2706", "morph": "HC/Ncmpc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "ketetapan-ketetapan-Ku"}, {"pos": 4, "word_orig": "אֲשֶׁ֤ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 5, "word_orig": "צִוִּ֨יתִי֙", "strong": "H6680", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "perintahkan"}, {"pos": 6, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "עֲבָדַ֣/י", "strong": "H5650", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "hamba-hamba-Ku"}, {"pos": 8, "word_orig": "הַ/נְּבִיאִ֔ים", "strong": "H5030", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "nabi"}, {"pos": 9, "word_orig": "הֲ/ל֥וֹא", "strong": "H3808", "morph": "HTi/Tn", "morph_id": "Ti + Tn", "ayt_word": ""}, {"pos": 10, "word_orig": "הִשִּׂ֖יגוּ", "strong": "H5381", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "sampai"}, {"pos": 11, "word_orig": "אֲבֹתֵי/כֶ֑ם", "strong": "H1", "morph": "HNcmpc/Sp2mp", "morph_id": "Nom