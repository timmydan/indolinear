yt_word": "TUHAN"}, {"pos": 16, "word_orig": "צְבָאֽוֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "alam"}]}, {"book": 38, "chapter": 1, "verse": 4, "ayat_id": 22883, "title": "", "ayt_text": "Janganlah seperti nenek moyangmu, yang kepada mereka, para nabi sebelumnya telah berseru, katanya, “Inilah firman TUHAN semesta alam, ‘Berbaliklah sekarang dari jalan-jalanmu yang jahat dan dari perbuatan-perbuatanmu yang jahat!’ Namun, mereka tidak mendengarkan dan tidak memperhatikan Aku, firman TUHAN.”", "words": [{"pos": 1, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Janganlah"}, {"pos": 2, "word_orig": "תִּהְי֣וּ", "strong": "H1961", "morph": "HVqj2mp", "morph_id": "Verba Qal Orang ke-2 Laki-laki Jamak", "ayt_word": "seperti"}, {"pos": 3, "word_orig": "כַ/אֲבֹֽתֵי/כֶ֡ם", "strong": "H1", "morph": "HR/Ncmpc/Sp2mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2mp", "ayt_word": "nenek"}, {"pos": 4, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 5, "word_orig": "קָרְאֽוּ", "strong": "H7121", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "berseru"}, {"pos": 6, "word_orig": "אֲלֵי/הֶם֩", "strong": "H413", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": "kepada"}, {"pos": 7, "word_orig": "הַ/נְּבִיאִ֨ים", "strong": "H5030", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "nabi"}, {"pos": 8, "word_orig": "הָ/רִֽאשֹׁנִ֜ים", "strong": "H7223", "morph": "HTd/Aampa", "morph_id": "Artikel Definit (הַ) + Aampa", "ayt_word": "sebelumnya"}, {"pos": 9, "word_orig": "לֵ/אמֹ֗ר", "strong": "H559", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "katanya"}, {"pos": 10, "word_orig": "כֹּ֤ה", "strong": "H3541", "morph": "HD"