word_orig": "אֵהָ֑ב", "strong": "H157", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mencariku"}, {"pos": 5, "word_orig": "וּ֝/מְשַׁחֲרַ֗/י", "strong": "H7836", "morph": "HC/Vprmpc/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Piel + Sp1cs", "ayt_word": "mendapatkanku"}, {"pos": 6, "word_orig": "יִמְצָאֻֽ/נְנִי", "strong": "H4672", "morph": "HVqi3mp/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp1cs", "ayt_word": ""}]}, {"book": 20, "chapter": 8, "verse": 18, "ayat_id": 16621, "title": "", "ayt_text": "Kekayaan dan kehormatan ada bersama denganku, juga kemakmuran yang abadi dan keadilan.", "words": [{"pos": 1, "word_orig": "עֹֽשֶׁר", "strong": "H6239", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Kekayaan"}, {"pos": 2, "word_orig": "וְ/כָב֥וֹד", "strong": "H3519", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kehormatan"}, {"pos": 3, "word_orig": "אִתִּ֑/י", "strong": "H854", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "bersama"}, {"pos": 4, "word_orig": "ה֥וֹן", "strong": "H1952", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kemakmuran"}, {"pos": 5, "word_orig": "עָ֝תֵ֗ק", "strong": "H6276", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "abadi"}, {"pos": 6, "word_orig": "וּ/צְדָקָֽה", "strong": "H6666", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keadilan"}]}, {"book": 20, "chapter": 8, "verse": 19, "ayat_id": 16622, "title": "", "ayt_text": "Buahku lebih baik daripada emas, bahkan emas murni, dan hasilku melebihi perak pilihan.", "words": [{"pos": 1, "word_orig": "ט֣וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "lebih"}, {"pos": 2, "word_orig": "פִּ֭רְיִ/י", "strong": "H6529", "morph": "HNcmsc