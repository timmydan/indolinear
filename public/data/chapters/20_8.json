_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "samudra"}, {"pos": 3, "word_orig": "חוֹלָ֑לְתִּי", "strong": "H2342", "morph": "HVOp1cs", "morph_id": "Verba Perfek Orang ke-1 Tunggal", "ayt_word": "dilahirkan"}, {"pos": 4, "word_orig": "בְּ/אֵ֥ין", "strong": "H369", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "ada"}, {"pos": 5, "word_orig": "מַ֝עְיָנ֗וֹת", "strong": "H4599", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sumber-sumber"}, {"pos": 6, "word_orig": "נִכְבַּדֵּי", "strong": "H3513", "morph": "HVNrmpc", "morph_id": "Verba Nifal", "ayt_word": "melimpah"}, {"pos": 7, "word_orig": "מָֽיִם", "strong": "H4325", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}]}, {"book": 20, "chapter": 8, "verse": 25, "ayat_id": 16628, "title": "", "ayt_text": "Sebelum gunung-gunung ditempatkan, sebelum bukit-bukit, aku dilahirkan,", "words": [{"pos": 1, "word_orig": "בְּ/טֶ֣רֶם", "strong": "H2962", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "Sebelum"}, {"pos": 2, "word_orig": "הָרִ֣ים", "strong": "H2022", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "gunung-gunung"}, {"pos": 3, "word_orig": "הָטְבָּ֑עוּ", "strong": "H2883", "morph": "HVHp3cp", "morph_id": "Verba Piel", "ayt_word": "ditempatkan"}, {"pos": 4, "word_orig": "לִ/פְנֵ֖י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "sebelum"}, {"pos": 5, "word_orig": "גְבָע֣וֹת", "strong": "H1389", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "bukit-bukit"}, {"pos": 6, "word_orig": "חוֹלָֽלְתִּי", "strong": "H2342", "morph": "HVOp1cs", "morph_id": "Verba Perfek Orang ke-1 Tunggal", "ayt_word": "dilahirkan"}]}, {"book": 20, "chapter": 8, "verse": 26, "ayat_id": 16629, "ti