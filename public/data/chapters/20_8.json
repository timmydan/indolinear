[{"book": 20, "chapter": 8, "verse": 1, "ayat_id": 16604, "title": "Hikmat Menceritakan Kisahnya", "ayt_text": "Bukankah hikmat berseru-seru, dan pengertian mengangkat suaranya?", "words": [{"pos": 1, "word_orig": "הֲ/לֹֽא", "strong": "H3808", "morph": "HTi/Tn", "morph_id": "Ti + Tn", "ayt_word": "Bukankah"}, {"pos": 2, "word_orig": "חָכְמָ֥ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 3, "word_orig": "תִקְרָ֑א", "strong": "H7121", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "berseru-seru"}, {"pos": 4, "word_orig": "וּ֝/תְבוּנָ֗ה", "strong": "H8394", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 5, "word_orig": "תִּתֵּ֥ן", "strong": "H5414", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mengangkat"}, {"pos": 6, "word_orig": "קוֹלָֽ/הּ", "strong": "H6963", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "suaranya"}]}, {"book": 20, "chapter": 8, "verse": 2, "ayat_id": 16605, "title": "", "ayt_text": "Di atas tempat-tempat tinggi di tepi-tepi jalan, di persimpangan-persimpangan jalan, di sanalah ia berdiri.", "words": [{"pos": 1, "word_orig": "בְּ/רֹאשׁ", "strong": "H7218", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "atas"}, {"pos": 2, "word_orig": "מְרוֹמִ֥ים", "strong": "H4791", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "tempat-tempat"}, {"pos": 3, "word_orig": "עֲלֵי", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 4, "word_orig": "דָ֑רֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 5, "word_orig": "בֵּ֖ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": ""}, {"pos": 6, "word_orig": "נְתִיב֣וֹת", "strong": "H5410", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "jalan"}, {"pos": 7, "word_orig": "נִצָּֽבָה", "strong": "H5324", "morph": "HVNp3fs", "morph_id": "Verba Nifal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "berdiri"}]}, {"book": 20, "chapter": 8, "verse": 3, "ayat_id": 16606, "title": "", "ayt_text": "Di samping gerbang-gerbang di depan kota, di pintu-pintu masuk, ia berseru-seru.", "words": [{"pos": 1, "word_orig": "לְ/יַד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "samping"}, {"pos": 2, "word_orig": "שְׁעָרִ֥ים", "strong": "H8179", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "gerbang-gerbang"}, {"pos": 3, "word_orig": "לְ/פִי", "strong": "H6310", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "depan"}, {"pos": 4, "word_orig": "קָ֑רֶת", "strong": "H7176", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}, {"pos": 5, "word_orig": "מְב֖וֹא", "strong": "H3996", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "masuk"}, {"pos": 6, "word_orig": "פְתָחִ֣ים", "strong": "H6607", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pintu-pintu"}, {"pos": 7, "word_orig": "תָּרֹֽנָּה", "strong": "H7442", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "berseru-seru"}]}, {"book": 20, "chapter": 8, "verse": 4, "ayat_id": 16607, "title": "", "ayt_text": "“Kepadamu, hai semua manusia, aku memanggil, dan suaraku kepada anak-anak manusia.", "words": [{"pos": 1, "word_orig": "אֲלֵי/כֶ֣ם", "strong": "H413", "morph": "HR/Sp2mp", "morph_id": "Preposisi + Sp2mp", "ayt_word": "Kepadamu"}, {"pos": 2, "word_orig": "אִישִׁ֣ים", "strong": "H376", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "manusia"}, {"pos": 3, "word_orig": "אֶקְרָ֑א", "strong": "H7121", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "memanggil"}, {"pos": 4, "word_orig": "וְ֝/קוֹלִ֗/י", "strong": "H6963", "morph": "HC/Ncmsc/Sp1cs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "suaraku"}, {"pos": 5, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 6, "word_orig": "בְּנֵ֥י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 7, "word_orig": "אָדָֽם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}]}, {"book": 20, "chapter": 8, "verse": 5, "ayat_id": 16608, "title": "", "ayt_text": "Hai orang-orang naif, pahamilah kecerdasan; hai orang-orang bodoh, pahamilah akal budi.", "words": [{"pos": 1, "word_orig": "הָבִ֣ינוּ", "strong": "H995", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "pahamilah"}, {"pos": 2, "word_orig": "פְתָאיִ֣ם", "strong": "H6612", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "orang-orang"}, {"pos": 3, "word_orig": "עָרְמָ֑ה", "strong": "H6195", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kecerdasan"}, {"pos": 4, "word_orig": "וּ֝/כְסִילִ֗ים", "strong": "H3684", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "הָבִ֥ינוּ", "strong": "H995", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "pahamilah"}, {"pos": 6, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "akal"}]}, {"book": 20, "chapter": 8, "verse": 6, "ayat_id": 16609, "title": "", "ayt_text": "Dengarkanlah, karena aku akan mengatakan perkara-perkara yang mulia, dan dari mulutku yang terbuka adalah perkara-perkara yang lurus.", "words": [{"pos": 1, "word_orig": "שִׁ֭מְעוּ", "strong": "H8085", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Dengarkanlah"}, {"pos": 2, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 3, "word_orig": "נְגִידִ֣ים", "strong": "H5057", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "mulia"}, {"pos": 4, "word_orig": "אֲדַבֵּ֑ר", "strong": "H1696", "morph": "HVpi1cs", "morph_id": "Verba Piel Imperfek Orang ke-1 Tunggal", "ayt_word": "mengatakan"}, {"pos": 5, "word_orig": "וּ/מִפְתַּ֥ח", "strong": "H4669", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "terbuka"}, {"pos": 6, "word_orig": "שְׂ֝פָתַ֗/י", "strong": "H8193", "morph": "HNcfdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "mulutku"}, {"pos": 7, "word_orig": "מֵישָׁרִֽים", "strong": "H4339", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "yang"}]}, {"book": 20, "chapter": 8, "verse": 7, "ayat_id": 16610, "title": "", "ayt_text": "Sebab, mulutku akan mengucapkan kebenaran; kefasikan adalah kekejian bagi bibirku.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "אֱ֭מֶת", "strong": "H571", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 3, "word_orig": "יֶהְגֶּ֣ה", "strong": "H1897", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengucapkan"}, {"pos": 4, "word_orig": "חִכִּ֑/י", "strong": "H2441", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "mulutku"}, {"pos": 5, "word_orig": "וְ/תוֹעֲבַ֖ת", "strong": "H8441", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 6, "word_orig": "שְׂפָתַ֣/י", "strong": "H8193", "morph": "HNcfdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "bibirku"}, {"pos": 7, "word_orig": "רֶֽשַׁע", "strong": "H7562", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kefasikan"}]}, {"book": 20, "chapter": 8, "verse": 8, "ayat_id": 16611, "title": "", "ayt_text": "Segala perkataan mulutku adalah kebenaran; tidak ada yang berbelit-belit atau serong.", "words": [{"pos": 1, "word_orig": "בְּ/צֶ֥דֶק", "strong": "H6664", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 2, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Segala"}, {"pos": 3, "word_orig": "אִמְרֵי", "strong": "H561", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "perkataan"}, {"pos": 4, "word_orig": "פִ֑/י", "strong": "H6310", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "mulutku"}, {"pos": 5, "word_orig": "אֵ֥ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "בָּ֝/הֶ֗ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 7, "word_orig": "נִפְתָּ֥ל", "strong": "H6617", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "berbelit-belit"}, {"pos": 8, "word_orig": "וְ/עִקֵּֽשׁ", "strong": "H6141", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "serong"}]}, {"book": 20, "chapter": 8, "verse": 9, "ayat_id": 16612, "title": "", "ayt_text": "Semua itu jelas bagi dia yang bijak, dan benar bagi mereka yang menemukan pengetahuan.", "words": [{"pos": 1, "word_orig": "כֻּלָּ֣/ם", "strong": "H3605", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "Semua"}, {"pos": 2, "word_orig": "נְ֭כֹחִים", "strong": "H5228", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "jelas"}, {"pos": 3, "word_orig": "לַ/מֵּבִ֑ין", "strong": "H995", "morph": "HRd/Vhrmsa", "morph_id": "Rd + Verba Hifil", "ayt_word": "bijak"}, {"pos": 4, "word_orig": "וִֽ֝/ישָׁרִ֗ים", "strong": "H3477", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "לְ/מֹ֣צְאֵי", "strong": "H4672", "morph": "HR/Vqrmpc", "morph_id": "Preposisi + Verba Qal", "ayt_word": "menemukan"}, {"pos": 6, "word_orig": "דָֽעַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 20, "chapter": 8, "verse": 10, "ayat_id": 16613, "title": "", "ayt_text": "Terimalah didikanku melebihi perak, dan pengetahuan daripada emas pilihan.", "words": [{"pos": 1, "word_orig": "קְחֽוּ", "strong": "H3947", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Terimalah"}, {"pos": 2, "word_orig": "מוּסָרִ֥/י", "strong": "H4148", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "didikanku"}, {"pos": 3, "word_orig": "וְ/אַל", "strong": "H408", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "melebihi"}, {"pos": 4, "word_orig": "כָּ֑סֶף", "strong": "H3701", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 5, "word_orig": "וְ֝/דַ֗עַת", "strong": "H1847", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "מֵ/חָר֥וּץ", "strong": "H2742", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 7, "word_orig": "נִבְחָֽר", "strong": "H977", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "pilihan"}]}, {"book": 20, "chapter": 8, "verse": 11, "ayat_id": 16614, "title": "", "ayt_text": "Sebab, hikmat lebih baik daripada batu-batu permata, dan segala sesuatu yang diinginkan orang tidak dapat dibandingkan dengannya.”", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "טוֹבָ֣ה", "strong": "H2896", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "lebih"}, {"pos": 3, "word_orig": "חָ֭כְמָה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 4, "word_orig": "מִ/פְּנִינִ֑ים", "strong": "H6443", "morph": "HR/Ncbpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "batu-batu"}, {"pos": 5, "word_orig": "וְ/כָל", "strong": "H3605", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "sesuatu"}, {"pos": 6, "word_orig": "חֲ֝פָצִ֗ים", "strong": "H2656", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "diinginkan"}, {"pos": 7, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "יִֽשְׁווּ", "strong": "H7737", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "dibandingkan"}, {"pos": 9, "word_orig": "בָֽ/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}]}, {"book": 20, "chapter": 8, "verse": 12, "ayat_id": 16615, "title": "", "ayt_text": "“Aku, hikmat, tinggal bersama dengan kecerdasan, dan aku menemukan pengetahuan dan kebijaksanaan.", "words": [{"pos": 1, "word_orig": "אֲֽנִי", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 2, "word_orig": "חָ֭כְמָה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 3, "word_orig": "שָׁכַ֣נְתִּי", "strong": "H7931", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "tinggal"}, {"pos": 4, "word_orig": "עָרְמָ֑ה", "strong": "H6195", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kecerdasan"}, {"pos": 5, "word_orig": "וְ/דַ֖עַת", "strong": "H1847", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "pengetahuan"}, {"pos": 6, "word_orig": "מְזִמּ֣וֹת", "strong": "H4209", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "kebijaksanaan"}, {"pos": 7, "word_orig": "אֶמְצָֽא", "strong": "H4672", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menemukan"}]}, {"book": 20, "chapter": 8, "verse": 13, "ayat_id": 16616, "title": "", "ayt_text": "Takut akan TUHAN adalah membenci kejahatan. Kesombongan dan kecongkakan, jalan kejahatan dan mulut yang menentang, aku membencinya.", "words": [{"pos": 1, "word_orig": "יִֽרְאַ֣ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 2, "word_orig": "יְהוָה֮", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "שְֽׂנֹ֫את", "strong": "H8130", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "membenci"}, {"pos": 4, "word_orig": "רָ֥ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatan"}, {"pos": 5, "word_orig": "גֵּ֘אָ֤ה", "strong": "H1344", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kesombongan"}, {"pos": 6, "word_orig": "וְ/גָא֨וֹן", "strong": "H1347", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kecongkakan"}, {"pos": 7, "word_orig": "וְ/דֶ֣רֶךְ", "strong": "H1870", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 8, "word_orig": "רָ֭ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejahatan"}, {"pos": 9, "word_orig": "וּ/פִ֨י", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 10, "word_orig": "תַהְפֻּכ֬וֹת", "strong": "H8419", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "menentang"}, {"pos": 11, "word_orig": "שָׂנֵֽאתִי", "strong": "H8130", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "membencinya"}]}, {"book": 20, "chapter": 8, "verse": 14, "ayat_id": 16617, "title": "", "ayt_text": "Nasihat dan suara hikmat adalah milikku; aku memiliki pengertian; aku memiliki kekuatan.", "words": [{"pos": 1, "word_orig": "לִֽ/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 2, "word_orig": "עֵ֭צָה", "strong": "H6098", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Nasihat"}, {"pos": 3, "word_orig": "וְ/תוּשִׁיָּ֑ה", "strong": "H8454", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "suara"}, {"pos": 4, "word_orig": "אֲנִ֥י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 5, "word_orig": "בִ֝ינָ֗ה", "strong": "H998", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 6, "word_orig": "לִ֣/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "memiliki"}, {"pos": 7, "word_orig": "גְבוּרָֽה", "strong": "H1369", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kekuatan"}]}, {"book": 20, "chapter": 8, "verse": 15, "ayat_id": 16618, "title": "", "ayt_text": "Oleh karena aku, raja-raja memerintah, dan penguasa-penguasa menetapkan keadilan.", "words": [{"pos": 1, "word_orig": "בִּ֭/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 2, "word_orig": "מְלָכִ֣ים", "strong": "H4428", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja-raja"}, {"pos": 3, "word_orig": "יִמְלֹ֑כוּ", "strong": "H4427", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memerintah"}, {"pos": 4, "word_orig": "וְ֝/רוֹזְנִ֗ים", "strong": "H7336", "morph": "HC/Vqrmpa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "penguasa-penguasa"}, {"pos": 5, "word_orig": "יְחֹ֣קְקוּ", "strong": "H2710", "morph": "HVmi3mp", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menetapkan"}, {"pos": 6, "wo