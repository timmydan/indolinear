[{"book": 23, "chapter": 25, "verse": 1, "ayat_id": 18120, "title": "Pujian kepada Allah", "ayt_text": "Ya TUHAN, Engkaulah Allahku. Aku meninggikan Engkau dan memuji nama-Mu karena Engkau telah melakukan hal-hal yang ajaib. Rancangan-rancangan-Mu sejak dahulu kala adalah benar dan teguh.", "words": [{"pos": 1, "word_orig": "יְהוָ֤ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "אֱלֹהַ/י֙", "strong": "H430", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Allahku"}, {"pos": 3, "word_orig": "אַתָּ֔ה", "strong": "H859", "morph": "HPp2ms", "morph_id": "Pp2ms", "ayt_word": "Engkaulah"}, {"pos": 4, "word_orig": "אֲרֽוֹמִמְ/ךָ֙", "strong": "H7311", "morph": "HVoi1cs/Sp2ms", "morph_id": "Verba Imperfek Orang ke-1 Tunggal + Sp2ms", "ayt_word": "meninggikan"}, {"pos": 5, "word_orig": "אוֹדֶ֣ה", "strong": "H3034", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "memuji"}, {"pos": 6, "word_orig": "שִׁמְ/ךָ֔", "strong": "H8034", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "nama-Mu"}, {"pos": 7, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 8, "word_orig": "עָשִׂ֖יתָ", "strong": "H6213", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "melakukan"}, {"pos": 9, "word_orig": "פֶּ֑לֶא", "strong": "H6382", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ajaib"}, {"pos": 10, "word_orig": "עֵצ֥וֹת", "strong": "H6098", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Rancangan-rancangan-Mu"}, {"pos": 11, "word_orig": "מֵֽ/רָח֖וֹק", "strong": "H7350", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "dahulu"}, {"pos": 12, "word_orig": "אֱמ֥וּנָה", "strong": "H530", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "benar"}, {"pos": 13, "word_orig": "אֹֽמֶן", "strong": "H544", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "teguh"}]}, {"book": 23, "chapter": 25, "verse": 2, "ayat_id": 18121, "title": "", "ayt_text": "Sesungguhnya, Engkau telah membuat kota itu menjadi timbunan. Kota yang berkubu menjadi puing-puing. Istana orang-orang asing tidak lagi menjadi kota, dan itu tidak akan pernah dibangun kembali.", "words": [{"pos": 1, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sesungguhnya"}, {"pos": 2, "word_orig": "שַׂ֤מְתָּ", "strong": "H7760", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "membuat"}, {"pos": 3, "word_orig": "מֵ/עִיר֙", "strong": "H5892", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}, {"pos": 4, "word_orig": "לַ/גָּ֔ל", "strong": "H1530", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "timbunan"}, {"pos": 5, "word_orig": "קִרְיָ֥ה", "strong": "H7151", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kota"}, {"pos": 6, "word_orig": "בְצוּרָ֖ה", "strong": "H1219", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "berkubu"}, {"pos": 7, "word_orig": "לְ/מַפֵּלָ֑ה", "strong": "H4654", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "puing-puing"}, {"pos": 8, "word_orig": "אַרְמ֤וֹן", "strong": "H759", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Istana"}, {"pos": 9, "word_orig": "זָרִים֙", "strong": "H2114", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 10, "word_orig": "מֵ/עִ֔יר", "strong": "H5892", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}, {"pos": 11, "word_orig": "לְ/עוֹלָ֖ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pernah"}, {"pos": 12, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 13, "word_orig": "יִבָּנֶֽה", "strong": "H1129", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dibangun"}]}, {"book": 23, "chapter": 25, "verse": 3, "ayat_id": 18122, "title": "", "ayt_text": "Oleh karena itu, orang-orang kuat akan memuliakan Engkau. Kota dari bangsa-bangsa yang kejam akan takut kepada-Mu.", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Oleh"}, {"pos": 2, "word_orig": "כֵּ֖ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "karena"}, {"pos": 3, "word_orig": "יְכַבְּד֣וּ/ךָ", "strong": "H3513", "morph": "HVpi3mp/Sp2ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak + Sp2ms", "ayt_word": "memuliakan"}, {"pos": 4, "word_orig": "עַם", "strong": "H5971", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "עָ֑ז", "strong": "H5794", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kuat"}, {"pos": 6, "word_orig": "קִרְיַ֛ת", "strong": "H7151", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Kota"}, {"pos": 7, "word_orig": "גּוֹיִ֥ם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 8, "word_orig": "עָרִיצִ֖ים", "strong": "H6184", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "kejam"}, {"pos": 9, "word_orig": "יִירָאֽוּ/ךָ", "strong": "H3372", "morph": "HVqi3mp/Sp2ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp2ms", "ayt_word": "takut"}]}, {"book": 23, "chapter": 25, "verse": 4, "ayat_id": 18123, "title": "", "ayt_text": "Sebab, Engkau telah menjadi perlindungan bagi orang lemah, perlindungan bagi orang miskin dalam kesesakannya, tempat berteduh dari badai, tempat bernaung dari panas terik. Sesungguhnya, embusan napas orang-orang kejam itu seperti angin ribut yang menerpa tembok.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "הָיִ֨יתָ", "strong": "H1961", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 3, "word_orig": "מָע֥וֹז", "strong": "H4581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perlindungan"}, {"pos": 4, "word_orig": "לַ/דָּ֛ל", "strong": "H1800", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "מָע֥וֹז", "strong": "H4581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perlindungan"}, {"pos": 6, "word_orig": "לָ/אֶבְי֖וֹן", "strong": "H34", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "בַּ/צַּר", "strong": "H6862", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "kesesakannya"}, {"pos": 8, "word_orig": "ל֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 9, "word_orig": "מַחְסֶ֤ה", "strong": "H4268", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 10, "word_orig": "מִ/זֶּ֨רֶם֙", "strong": "H2230", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "badai"}, {"pos": 11, "word_orig": "צֵ֣ל", "strong": "H6738", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bernaung"}, {"pos": 12, "word_orig": "מֵ/חֹ֔רֶב", "strong": "H2721", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terik"}, {"pos": 13, "word_orig": "כִּ֛י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sesungguhnya"}, {"pos": 14, "word_orig": "ר֥וּחַ", "strong": "H7307", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "napas"}, {"pos": 15, "word_orig": "עָרִיצִ֖ים", "strong": "H6184", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 16, "word_orig": "כְּ/זֶ֥רֶם", "strong": "H2230", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "angin"}, {"pos": 17, "word_orig": "קִֽיר", "strong": "H7023", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tembok"}]}, {"book": 23, "chapter": 25, "verse": 5, "ayat_id": 18124, "title": "", "ayt_text": "Seperti panas terik di tanah gersang, Engkau membungkam kegaduhan orang-orang asing. Seperti panas terik dalam bayangan awan, demikianlah nyanyian orang-orang kejam akan diredam.", "words": [{"pos": 1, "word_orig": "כְּ/חֹ֣רֶב", "strong": "H2721", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "panas"}, {"pos": 2, "word_orig": "בְּ/צָי֔וֹן", "strong": "H6724", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "gersang"}, {"pos": 3, "word_orig": "שְׁא֥וֹן", "strong": "H7588", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kegaduhan"}, {"pos": 4, "word_orig": "זָרִ֖ים", "strong": "H2114", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "asing"}, {"pos": 5, "word_orig": "תַּכְנִ֑יעַ", "strong": "H3665", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "membungkam"}, {"pos": 6, "word_orig": "חֹ֚רֶב", "strong": "H2721", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "panas"}, {"pos": 7, "word_orig": "בְּ/צֵ֣ל", "strong": "H6738", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bayangan"}, {"pos": 8, "word_orig": "עָ֔ב", "strong": "H5645", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "awan"}, {"pos": 9, "word_orig": "זְמִ֥יר", "strong": "H2158", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nyanyian"}, {"pos": 10, "word_orig": "עָֽרִיצִ֖ים", "strong": "H6184", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "kejam"}, {"pos": 11, "word_orig": "יַעֲנֶֽה", "strong": "H6030", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diredam"}]}, {"book": 23, "chapter": 25, "verse": 6, "ayat_id": 18125, "title": "Keselamatan bagi Bangsa-Bangsa di Sion", "ayt_text": "TUHAN semesta alam akan mempersiapkan bagi semua orang di gunung ini sebuah perjamuan dengan makanan berlemak. Suatu jamuan anggur tua dengan makanan berlemak dan bersumsum, serta anggur tua yang disaring.", "words": [{"pos": 1, "word_orig": "וְ/עָשָׂה֩", "strong": "H6213", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "mempersiapkan"}, {"pos": 2, "word_orig": "יְהוָ֨ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "צְבָא֜וֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_wo