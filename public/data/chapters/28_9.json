"morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "upah"}, {"pos": 13, "word_orig": "עַ֖ל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 14, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 15, "word_orig": "גָּרְנ֥וֹת", "strong": "H1637", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "pengirikan"}, {"pos": 16, "word_orig": "דָּגָֽן", "strong": "H1715", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "gandum"}]}, {"book": 28, "chapter": 9, "verse": 2, "ayat_id": 22211, "title": "", "ayt_text": "Tempat pengirikan gandum dan pemerasan anggur takkan memberi mereka makan, dan anggur baru akan mengecewakan mereka.", "words": [{"pos": 1, "word_orig": "גֹּ֥רֶן", "strong": "H1637", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Tempat"}, {"pos": 2, "word_orig": "וָ/יֶ֖קֶב", "strong": "H3342", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pemerasan"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 4, "word_orig": "יִרְעֵ֑/ם", "strong": "H7462", "morph": "HVqi3ms/Sp3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "memberi"}, {"pos": 5, "word_orig": "וְ/תִיר֖וֹשׁ", "strong": "H8492", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 6, "word_orig": "יְכַ֥חֶשׁ", "strong": "H3584", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengecewakan"}, {"pos": 7, "word_orig": "בָּֽ/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}]}, {"book": 28, "chapter": 9, "verse": 3, "ayat_id": 22212, "title": "", "ayt_text": "Mereka tidak akan tinggal di negeri TUHAN, tetapi Efraim akan kembali ke Mesir, dan mereka akan makan makanan najis di Asyur.", "words": [{"pos": 1, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יֵשְׁב֖וּ", "strong": "H3427", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "tinggal"}, {"pos": 3, "word_orig": "בְּ/אֶ֣רֶץ", "strong": "H776", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "negeri"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וְ/שָׁ֤ב", "strong": "H7725", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "kembali"}, {"pos": 6, "word_orig": "אֶפְרַ֨יִם֙", "strong": "H669", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Efraim"}, {"pos": 7, "word_orig": "מִצְרַ֔יִם", "strong": "H4714", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Mesir"}, {"pos": 8, "word_orig": "וּ/בְ/אַשּׁ֖וּר", "strong": "H804", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "Asyur"}, {"pos": 9, "word_orig": "טָמֵ֥א", "strong": "H2931", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "najis"}, {"pos": 10, "word_orig": "יֹאכֵֽלוּ", "strong": "H398", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "makan"}]}, {"book": 28, "chapter": 9, "verse": 4, "ayat_id": 22213, "title": "", "ayt_text": "Mereka takkan mencurahkan persembahan minuman anggur kepada TUHAN, dan kurban-kurban persembahan mereka tidak menyukakan hati-Nya. Itu akan menjadi seperti roti perkabungan, semua orang yang memakannya akan menjadi najis. Sebab, roti mereka adalah untuk kelaparan mereka sendiri, dan tidak akan masuk ke dalam Bait TUHAN.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 2, "word_orig": "יִסְּכ֨וּ", "strong": "H5258", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "persembahan"}, {"pos": 3, "word_orig": "לַ/יהוָ֥ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "יַיִן֮", "strong": "H3196", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "minuman"}, {"pos": 5, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יֶֽעֶרְבוּ", "strong": "H6148", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menyukakan"}, {"pos": 7, "word_orig": "ל/וֹ֒", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 8, "word_orig": "זִבְחֵי/הֶ֗ם", "strong": "H2077", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "persembahan"}, {"pos": 9, "word_orig": "כְּ/לֶ֤חֶם", "strong": "H3899", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "roti"}, {"pos": 10, "word_orig": "אוֹנִים֙", "strong": "H205", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "perkabungan"}, {"pos": 11, "word_orig": "לָ/הֶ֔ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 12, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 13, "word_orig": "אֹכְלָ֖י/ו", "strong": "H398", "morph": "HVqrmpc/Sp3ms", "morph_id": "Verba Qal + Sp3ms", "ayt_word": "memakannya"}, {"pos": 14, "word_orig": "יִטַמָּ֑אוּ", "strong": "H2930", "morph": "HVti3mp", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menjadi"}, {"pos": 15, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 16, "word_orig": "לַחְמָ֣/ם", "strong": "H3899", "morph": "HNcbsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "roti"}, {"pos": 17, "word_orig": "לְ/נַפְשָׁ֔/ם", "strong": "H5315", "morph": "HR/Ncbsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mereka"}, {"pos": 18, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 19, "word_orig": "יָב֖וֹא", "strong": "H935", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "masuk"}, {"pos": 20, "word_orig": "בֵּ֥ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Bait"}, {"pos": 21, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 28, "chapter": 9, "verse": 5, "ayat_id": 22214, "title": "", "ayt_text": "Apa yang akan kamu perbuat pada hari pertemuan raya, dan pada hari raya TUHAN?", "words": [{"pos": 1, "word_orig": "מַֽה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Apa"}, {"pos": 2, "word_orig": "תַּעֲשׂ֖וּ", "strong": "H6213", "morph": "HVqi2mp", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Jamak", "ayt_word": "perbuat"}, {"pos": 3, "word_orig": "לְ/י֣וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hari"}, {"pos": 4, "word_orig": "מוֹעֵ