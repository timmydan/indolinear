[{"book": 3, "chapter": 2, "verse": 1, "ayat_id": 2764, "title": "Persembahan Sajian", "ayt_text": "“Apabila seseorang mempersembahkan persembahan sajian kepada TUHAN, persembahannya harus dari tepung halus, dan dia harus menuangkan minyak ke atas tepung itu, lalu membubuhkan kemenyan di atasnya.", "words": [{"pos": 1, "word_orig": "וְ/נֶ֗פֶשׁ", "strong": "H5315", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 2, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Apabila"}, {"pos": 3, "word_orig": "תַקְרִ֞יב", "strong": "H7126", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mempersembahkan"}, {"pos": 4, "word_orig": "קָרְבַּ֤ן", "strong": "H7133", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "persembahan"}, {"pos": 5, "word_orig": "מִנְחָה֙", "strong": "H4503", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sajian"}, {"pos": 6, "word_orig": "לַֽ/יהוָ֔ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "סֹ֖לֶת", "strong": "H5560", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "halus"}, {"pos": 8, "word_orig": "יִהְיֶ֣ה", "strong": "H1961", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 9, "word_orig": "קָרְבָּנ֑/וֹ", "strong": "H7133", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "persembahannya"}, {"pos": 10, "word_orig": "וְ/יָצַ֤ק", "strong": "H3332", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menuangkan"}, {"pos": 11, "word_orig": "עָלֶ