 5, "word_orig": "בֵּ֥ין", "strong": "H996", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "antara"}, {"pos": 6, "word_orig": "שָׁדַ֖/י", "strong": "H7699", "morph": "HNcmdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "buah"}, {"pos": 7, "word_orig": "יָלִֽין", "strong": "H3885", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terletak"}]}, {"book": 22, "chapter": 1, "verse": 14, "ayat_id": 17552, "title": "", "ayt_text": "Bagiku, kekasihku seperti serumpun bunga pacar di kebun anggur En-Gedi.", "words": [{"pos": 1, "word_orig": "אֶשְׁכֹּ֨ל", "strong": "H811", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "serumpun"}, {"pos": 2, "word_orig": "הַ/כֹּ֤פֶר", "strong": "H3724", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bunga"}, {"pos": 3, "word_orig": "דּוֹדִ/י֙", "strong": "H1730", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "לִ֔/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 5, "word_orig": "בְּ/כַרְמֵ֖י", "strong": "H3754", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "kebun"}, {"pos": 6, "word_orig": "עֵ֥ין", "strong": "H5872", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": ""}, {"pos": 7, "word_orig": "גֶּֽדִי", "strong": "H5872", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "En-Gedi"}]}, {"book": 22, "chapter": 1, "verse": 15, "ayat_id": 17553, "title": "", "ayt_text": "Lihat, cantiknya engkau, kekasihku! Lihat, cantiknya engkau! Matamu bagaikan merpati.", "words": [{"pos": 1, "word_orig": "הִנָּ֤/ךְ", "strong": "H2005", "morph": "HTm/Sp2fs", "morph_id": "Tm + Sp2fs", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "יָפָה֙", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantiknya"}, {"pos": 3, "word_orig": "רַעְיָתִ֔/י", "strong": "H7474", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "הִנָּ֥/ךְ", "strong": "H2005", "morph": "HTm/Sp2fs", "morph_id": "Tm + Sp2fs", "ayt_word": "Lihat"}, {"pos": 5, "word_orig": "יָפָ֖ה", "strong": "H3303", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "cantiknya"}, {"pos": 6, "word_orig": "עֵינַ֥יִ/ךְ", "strong": "H5869", "morph": "HNcbdc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2fs", "ayt_word": "Matamu"}, {"pos": 7, "word_orig": "יוֹנִֽים", "strong": "H3123", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "merpati"}]}, {"book": 22, "chapter": 1, "verse": 16, "ayat_id": 17554, "title": "", "ayt_text": "Lihat, tampannya engkau, kekasihku! Sungguh menyenangkan! Sungguh, tempat tidur kita hijau.", "words": [{"pos": 1, "word_orig": "הִנְּ/ךָ֨", "strong": "H2005", "morph": "HTm/Sp2ms", "morph_id": "Tm + Sp2ms", "ayt_word": "Lihat"}, {"pos": 2, "word_orig": "יָפֶ֤ה", "strong": "H3303", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "tampannya"}, {"pos": 3, "word_orig": "דוֹדִ/י֙", "strong": "H1730", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kekasihku"}, {"pos": 4, "word_orig": "אַ֣ף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Sungguh"}, {"pos": 5, "word_orig": "נָעִ֔ים", "strong": "H5273", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "menyenangkan"}, {"pos": 6, "word_orig": "אַף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Sungguh"}, {"pos": 7, "word_orig": "עַרְשֵׂ֖/נוּ", "strong": "H6210", "morph": "HNcfsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "tempat"}, {"pos": 8, "word_orig": "רַעֲנָנָֽה", "strong": "H7488", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "hijau"}]}, {"book": 22, "chapter": 1, "verse": 17, "ayat_id": 17555, "title": "", "ayt_text": "Kasau rumah kita adalah pohon aras; dinding-dinding kita adalah pohon cemara.", "words": [{"pos": 1, "word_orig": "קֹר֤וֹת", "strong": "H6982", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "Kasau"}, {"pos": 2, "word_orig": "בָּתֵּ֨י/נוּ֙", "strong": "H1004", "morph": "HNcmpc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cp", "ayt_word": "rumah"}, {"pos": 3, "word_orig": "אֲרָזִ֔ים", "strong": "H730", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pohon"}, {"pos": 4, "word_orig": "רחיט/נו", "strong": "H7351", "morph": "HNcmsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "dinding-dinding"}, {"pos": 5, "word_orig": "רַהִיטֵ֖/נוּ", "strong": "H7351", "morph": "HNcmsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "pohon"}, {"pos": 6, "word_orig": "בְּרוֹתִֽים", "strong": "H1266", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": ""}]}]