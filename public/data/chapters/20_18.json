[{"book": 20, "chapter": 18, "verse": 1, "ayat_id": 16903, "title": "", "ayt_text": "Orang yang menyendiri mencari keinginannya sendiri; kemarahannya meledak terhadap setiap pertimbangan.", "words": [{"pos": 1, "word_orig": "לְֽ֭/תַאֲוָה", "strong": "H8378", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keinginannya"}, {"pos": 2, "word_orig": "יְבַקֵּ֣שׁ", "strong": "H1245", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 3, "word_orig": "נִפְרָ֑ד", "strong": "H6504", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "menyendiri"}, {"pos": 4, "word_orig": "בְּ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "setiap"}, {"pos": 5, "word_orig": "תּ֝וּשִׁיָּ֗ה", "strong": "H8454", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pertimbangan"}, {"pos": 6, "word_orig": "יִתְגַּלָּֽע", "strong": "H1566", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kemarahannya"}]}, {"book": 20, "chapter": 18, "verse": 2, "ayat_id": 16904, "title": "", "ayt_text": "Orang bodoh tidak menyukai pengertian, melainkan hanya membeberkan isi hatinya.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יַחְפֹּ֣ץ", "strong": "H2654", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyukai"}, {"pos": 3, "word_orig": "כְּ֭סִיל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 4, "word_orig": "בִּ/תְבוּנָ֑ה", "strong": "H8394", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 5, "word_orig": "כִּ֝֗י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "melainkan"}, {"pos": 6, "word_orig": "אִֽם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "hanya"}, {"pos": 7, "word_orig": "בְּ/הִתְגַּלּ֥וֹת", "strong": "H1540", "morph": "HR/Vtc", "morph_id": "Preposisi + Verba Hitpael Imperatif", "ayt_word": "membeberkan"}, {"pos": 8, "word_orig": "לִבּֽ/וֹ", "strong": "H3820", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hatinya"}]}, {"book": 20, "chapter": 18, "verse": 3, "ayat_id": 16905, "title": "", "ayt_text": "Ketika kefasikan datang, datang juga penghinaan, dan bersama-sama dengan cela, rasa malu.", "words": [{"pos": 1, "word_orig": "בְּֽ/בוֹא", "strong": "H935", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "datang"}, {"pos": 2, "word_orig": "רָ֭שָׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kefasikan"}, {"pos": 3, "word_orig": "בָּ֣א", "strong": "H935", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "datang"}, {"pos": 4, "word_orig": "גַם", "strong": "H1571", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "juga"}, {"pos": 5, "word_orig": "בּ֑וּז", "strong": "H937", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penghinaan"}, {"pos": 6, "word_orig": "וְֽ/עִם", "strong": "H5973", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "dengan"}, {"pos": 7, "word_orig": "קָל֥וֹן", "strong": "H7036", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rasa"}, {"pos": 8, "word_orig": "חֶרְפָּֽה", "strong": "H2781", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "cela"}]}, {"book": 20, "chapter": 18, "verse": 4, "ayat_id": 16906, "title": "", "ayt_text": "Perkat