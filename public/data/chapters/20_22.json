cemooh"}]}, {"book": 20, "chapter": 22, "verse": 11, "ayat_id": 17027, "title": "", "ayt_text": "Siapa mencintai kesucian hati dan bicaranya ramah akan menjadi sahabat raja.", "words": [{"pos": 1, "word_orig": "אֹהֵ֥ב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencintai"}, {"pos": 2, "word_orig": "טהור", "strong": "H2889", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "kesucian"}, {"pos": 3, "word_orig": "טְהָר", "strong": "H2889", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "kesucian"}, {"pos": 4, "word_orig": "לֵ֑ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ramah"}, {"pos": 5, "word_orig": "חֵ֥ן", "strong": "H2580", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bicaranya"}, {"pos": 6, "word_orig": "שְׂ֝פָתָ֗י/ו", "strong": "H8193", "morph": "HNcfdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "sahabat"}, {"pos": 7, "word_orig": "רֵעֵ֥/הוּ", "strong": "H7453", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "raja"}, {"pos": 8, "word_orig": "מֶֽלֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": ""}]}, {"book": 20, "chapter": 22, "verse": 12, "ayat_id": 17028, "title": "", "ayt_text": "Mata TUHAN menjaga pengetahuan, tetapi Dia meruntuhkan perkataan pengkhianat.", "words": [{"pos": 1, "word_orig": "עֵינֵ֣י", "strong": "H5869", "morph": "HNcbdc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Mata"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "נָ֣צְרוּ", "strong": "H5341", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek 