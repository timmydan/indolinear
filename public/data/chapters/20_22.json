rd": "bertemu"}, {"pos": 4, "word_orig": "עֹשֵׂ֖ה", "strong": "H6213", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "menciptakan"}, {"pos": 5, "word_orig": "כֻלָּ֣/ם", "strong": "H3605", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "semua"}, {"pos": 6, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHANlah"}]}, {"book": 20, "chapter": 22, "verse": 3, "ayat_id": 17019, "title": "", "ayt_text": "Orang bijak melihat bahaya, lalu bersembunyi, tetapi orang naif melintasinya, lalu kena celaka.", "words": [{"pos": 1, "word_orig": "עָר֤וּם", "strong": "H6175", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bijak"}, {"pos": 2, "word_orig": "רָאָ֣ה", "strong": "H7200", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melihat"}, {"pos": 3, "word_orig": "רָעָ֣ה", "strong": "H7451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bahaya"}, {"pos": 4, "word_orig": "ו/יסתר", "strong": "H5641", "morph": "HC/VNi3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersembunyi"}, {"pos": 5, "word_orig": "וְ/נִסְתָּ֑ר", "strong": "H5641", "morph": "HC/VNp3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "naif"}, {"pos": 6, "word_orig": "וּ֝/פְתָיִ֗ים", "strong": "H6612", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "melintasinya"}, {"pos": 7, "word_orig": "עָבְר֥וּ", "strong": "H5674", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "kena"}, {"pos": 8, "word_orig": "וְֽ/נֶעֱנָֽשׁוּ", "strong": "H6064", "morph": "HC/VNp3cp", "morph_id": "Konjungsi (וְ) + Verba Nifal Perfek Orang ke-3 Jamak", "ayt_word": ""}]}, {"book": 20, "chapter": 22, "verse": 4, "ayat_id": 17020, "title": "", "ayt_text": "