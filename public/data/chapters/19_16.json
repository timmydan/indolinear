[{"book": 19, "chapter": 16, "verse": 1, "ayat_id": 14094, "title": "TUHAN Mahabaik", "ayt_text": "Miktam Daud. Lindungi aku, ya Allah, karena di dalam Engkau aku berlindung.", "words": [{"pos": 1, "word_orig": "מִכְתָּ֥ם", "strong": "H4387", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Miktam"}, {"pos": 2, "word_orig": "לְ/דָוִ֑ד", "strong": "H1732", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Daud"}, {"pos": 3, "word_orig": "שָֽׁמְרֵ֥/נִי", "strong": "H8104", "morph": "HVqv2ms/Sp1cs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sp1cs", "ayt_word": "Lindungi"}, {"pos": 4, "word_orig": "אֵ֝֗ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "חָסִ֥יתִי", "strong": "H2620", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berlindung"}, {"pos": 7, "word_orig": "בָֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 19, "chapter": 16, "verse": 2, "ayat_id": 14095, "title": "", "ayt_text": "Aku berkata kepada TUHAN, “Engkau adalah Tuhanku. Tidak ada yang lebih baik.”", "words": [{"pos": 1, "word_orig": "אָמַ֣רְתְּ", "strong": "H559", "morph": "HVqp2fs", "morph_id": "Verba Qal Perfek Orang ke-2 Perempuan Tunggal", "ayt_word": "berkata"}, {"pos": 2, "word_orig": "לַֽ֭/יהוָה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "אֲדֹנָ֣/י", "strong": "H136", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "Tuhanku"}, {"pos": 4, "word_orig": "אָ֑תָּה", "strong": "H859", "morph": "HPp2ms", "morph_id": "Pp2ms", "ayt_word": "Engkau"}, {"pos": 5, "word_orig": "ט֝וֹבָתִ֗/י", "strong": "H2896", "morph": "HAafsc/Sp1cs", "morph_id": "Aafsc + Sp1cs", "ayt_word": "baik"}, {"pos": 6, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "ada"}, {"pos": 7, "word_orig": "עָלֶֽי/ךָ", "strong": "H5921", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": ""}]}, {"book": 19, "chapter": 16, "verse": 3, "ayat_id": 14096, "title": "", "ayt_text": "Orang-orang kudus yang ada di bumi, mereka adalah orang-orang mulia; di dalam mereka segala kesukaanku.", "words": [{"pos": 1, "word_orig": "לִ֭/קְדוֹשִׁים", "strong": "H6918", "morph": "HR/Aampa", "morph_id": "Preposisi + Aampa", "ayt_word": "kudus"}, {"pos": 2, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 3, "word_orig": "בָּ/אָ֣רֶץ", "strong": "H776", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 4, "word_orig": "הֵ֑מָּה", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": "mereka"}, {"pos": 5, "word_orig": "וְ֝/אַדִּירֵ֗י", "strong": "H117", "morph": "HC/Aampc", "morph_id": "Konjungsi (וְ) + Aampc", "ayt_word": "mulia"}, {"pos": 6, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 7, "word_orig": "חֶפְצִ/י", "strong": "H2656", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "kesukaanku"}, {"pos": 8, "word_orig": "בָֽ/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 19, "chapter": 16, "verse": 4, "ayat_id": 14097, "title": "", "ayt_text": "Kesusahan orang yang mengikuti ilah lain akan bertambah banyak; kurban pencurahan darah mereka takkan aku tuang, dan aku takkan menyebut nama-nama mereka di bibirku.", "words": [{"pos": 1, "word_orig": "יִרְבּ֥וּ", "strong": "H7235", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bertambah"}, {"pos": 2, "word_orig": "עַצְּבוֹתָ/ם֮", "strong": "H6094", "morph": "HNcfpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "Kesusahan"}, {"pos": 3, "word_orig": "אַחֵ֪ר", "strong": "H312", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "lain"}, {"pos": 4, "word_orig": "מָ֫הָ֥רוּ", "strong": "H4116", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": ""}, {"pos": 5, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 6, "word_orig": "אַסִּ֣יךְ", "strong": "H5258", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "tuang"}, {"pos": 7, "word_orig": "נִסְכֵּי/הֶ֣ם", "strong": "H5262", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "pencurahan"}, {"pos": 8, "word_orig": "מִ/דָּ֑ם", "strong": "H1818", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "darah"}, {"pos": 9, "word_orig": "וּֽ/בַל", "strong": "H1077", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "takkan"}, {"pos": 10, "word_orig": "אֶשָּׂ֥א", "strong": "H5375", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menyebut"}, {"pos": 11, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 12, "word_orig": "שְׁ֝מוֹתָ֗/ם", "strong": "H8034", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "nama-nama"}, {"pos": 13, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 14, "word_orig": "שְׂפָתָֽ/י", "strong": "H8193