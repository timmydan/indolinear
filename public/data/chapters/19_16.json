orph_id": "Verba Piel Perfek Orang ke-3 Jamak + Sp1cs", "ayt_word": "mengajariku"}, {"pos": 9, "word_orig": "כִלְיוֹתָֽ/י", "strong": "H3629", "morph": "HNcfpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "batinku"}]}, {"book": 19, "chapter": 16, "verse": 8, "ayat_id": 14101, "title": "", "ayt_text": "Aku selalu menempatkan TUHAN di hadapanku. Karena Dia ada di sebelah kananku, aku takkan goyah.", "words": [{"pos": 1, "word_orig": "שִׁוִּ֬יתִי", "strong": "H7737", "morph": "HVpp1cs", "morph_id": "Verba Piel Perfek Orang ke-1 Tunggal", "ayt_word": "menempatkan"}, {"pos": 2, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "לְ/נֶגְדִּ֣/י", "strong": "H5048", "morph": "HR/R/Sp1cs", "morph_id": "Preposisi + Preposisi + Sp1cs", "ayt_word": "hadapanku"}, {"pos": 4, "word_orig": "תָמִ֑יד", "strong": "H8548", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selalu"}, {"pos": 5, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Karena"}, {"pos": 6, "word_orig": "מִֽ֝/ימִינִ֗/י", "strong": "H3225", "morph": "HR/Ncfsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "sebelah"}, {"pos": 7, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 8, "word_orig": "אֶמּֽוֹט", "strong": "H4131", "morph": "HVNi1cs", "morph_id": "Verba Nifal Imperfek Orang ke-1 Tunggal", "ayt_word": "goyah"}]}, {"book": 19, "chapter": 16, "verse": 9, "ayat_id": 14102, "title": "", "ayt_text": "Karena itu, hatiku bersukacita dan kemuliaanku bergembira. Ya, tubuhku juga tinggal dengan aman.", "words": [{"pos": 1, "word_orig": "לָ/כֵ֤ן", "strong": "H3651", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "Karena"}, {"pos": 2, "word_ori