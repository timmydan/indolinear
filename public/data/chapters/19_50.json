"book": 19, "chapter": 50, "verse": 9, "ayat_id": 14678, "title": "", "ayt_text": "Aku takkan mengambil sapi jantan dari rumahmu, ataupun kambing jantan dari kandang-kandangmu.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 2, "word_orig": "אֶקַּ֣ח", "strong": "H3947", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mengambil"}, {"pos": 3, "word_orig": "מִ/בֵּיתְ/ךָ֣", "strong": "H1004", "morph": "HR/Ncmsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "rumahmu"}, {"pos": 4, "word_orig": "פָ֑ר", "strong": "H6499", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sapi"}, {"pos": 5, "word_orig": "מִ֝/מִּכְלְאֹתֶ֗י/ךָ", "strong": "H4356", "morph": "HR/Ncbpc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "kandang-kandangmu"}, {"pos": 6, "word_orig": "עַתּוּדִֽים", "strong": "H6260", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kambing"}]}, {"book": 19, "chapter": 50, "verse": 10, "ayat_id": 14679, "title": "", "ayt_text": "Sebab, segala yang hidup di hutan adalah milik-Ku, begitu juga ternak di ribuan perbukitan.", "words": [{"pos": 1, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "לִ֥/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "כָל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 4, "word_orig": "חַיְת/וֹ", "strong": "H2416", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hidup"}, {"pos":