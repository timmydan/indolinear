[{"book": 38, "chapter": 5, "verse": 1, "ayat_id": 22938, "title": "Penglihatan Keenam: Gulungan Kitab yang Terbang", "ayt_text": "Lalu, aku berbalik, dan mengangkat mataku, dan melihat, tampak sebuah gulungan kitab yang terbang.", "words": [{"pos": 1, "word_orig": "וָ/אָשׁ֕וּב", "strong": "H7725", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "berbalik"}, {"pos": 2, "word_orig": "וָ/אֶשָּׂ֥א", "strong": "H5375", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "mengangkat"}, {"pos": 3, "word_orig": "עֵינַ֖/י", "strong": "H5869", "morph": "HNcbdc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp1cs", "ayt_word": "mataku"}, {"pos": 4, "word_orig": "וָֽ/אֶרְאֶ֑ה", "strong": "H7200", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "melihat"}, {"pos": 5, "word_orig": "וְ/הִנֵּ֖ה", "strong": "H2009", "morph": "HC/Tm", "morph_id": "Konjungsi (וְ) + Tm", "ayt_word": "tampak"}, {"pos": 6, "word_orig": "מְגִלָּ֥ה", "strong": "H4039", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "gulungan"}, {"pos": 7, "word_orig": "עָפָֽה", "strong": "H5774", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "terbang"}]}, {"book": 38, "chapter": 5, "verse": 2, "ayat_id": 22939, "title": "", "ayt_text": "Kemudian, dia bertanya kepadaku, “Apakah yang kamu lihat?” Jawabku, “Aku melihat sebuah gulungan kitab yang terbang, panjangnya 20 hasta dan lebarnya 10 hasta.”", "words": [{"pos": 1, "word_orig": "וַ/יֹּ֣אמֶר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertanya"}, {"pos": 2, "word_orig": "אֵלַ֔/י", "strong": "H413", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt