, "ayt_word": "serahkan"}, {"pos": 15, "word_orig": "תְּגַלִּֽי", "strong": "H1540", "morph": "HVpj2fs", "morph_id": "Verba Piel Orang ke-2 Perempuan Tunggal", "ayt_word": ""}]}, {"book": 23, "chapter": 16, "verse": 4, "ayat_id": 17974, "title": "", "ayt_text": "Biarkan orang-orang buangan dari Moab tinggal di antaramu. Jadilah tempat perlindungan bagi mereka dari para perusak. Sebab, para pemeras sudah tiba pada penghabisan, kekerasan telah berakhir. Para penindas telah dilenyapkan dari negeri itu.", "words": [{"pos": 1, "word_orig": "יָג֤וּרוּ", "strong": "H1481", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "tinggal"}, {"pos": 2, "word_orig": "בָ/ךְ֙", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}, {"pos": 3, "word_orig": "נִדָּחַ֔/י", "strong": "H5080", "morph": "HVNsmpc/Sp1cs", "morph_id": "Verba Nifal Partisip Pasif + Sp1cs", "ayt_word": "buangan"}, {"pos": 4, "word_orig": "מוֹאָ֛ב", "strong": "H4124", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Moab"}, {"pos": 5, "word_orig": "הֱוִי", "strong": "H1933", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Jadilah"}, {"pos": 6, "word_orig": "סֵ֥תֶר", "strong": "H5643", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 7, "word_orig": "לָ֖/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 8, "word_orig": "מִ/פְּנֵ֣י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "dari"}, {"pos": 9, "word_orig": "שׁוֹדֵ֑ד", "strong": "H7703", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "perusak"}, {"pos": 10, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 11, "word_orig": "אָפֵ֤ס", "strong": "H