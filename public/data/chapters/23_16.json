[{"book": 23, "chapter": 16, "verse": 1, "ayat_id": 17971, "title": "", "ayt_text": "“Kirimkanlah domba kepada pemimpin negeri itu, dari Sela melalui padang belantara ke gunung putri Sion.", "words": [{"pos": 1, "word_orig": "שִׁלְחוּ", "strong": "H7971", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Kirimkanlah"}, {"pos": 2, "word_orig": "כַ֥ר", "strong": "H3733", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "domba"}, {"pos": 3, "word_orig": "מֹשֵֽׁל", "strong": "H4910", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "pemimpin"}, {"pos": 4, "word_orig": "אֶ֖רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}, {"pos": 5, "word_orig": "מִ/סֶּ֣לַע", "strong": "H5554", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Sela"}, {"pos": 6, "word_orig": "מִדְבָּ֑רָ/ה", "strong": "H4057", "morph": "HNcmsa/Sd", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut + Sd", "ayt_word": "padang"}, {"pos": 7, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 8, "word_orig": "הַ֖ר", "strong": "H2022", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "gunung"}, {"pos": 9, "word_orig": "בַּת", "strong": "H1323", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "putri"}, {"pos": 10, "word_orig": "צִיּֽוֹן", "strong": "H6726", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sion"}]}, {"book": 23, "chapter": 16, "verse": 2, "ayat_id": 17972, "title": "", "ayt_text": "Kemudian, seperti burung yang beterbangan, seperti sarang yang diacak-acak, demikianlah putri-putri Moab di tempat-tempat penyeberangan Sungai Arnon.", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֥ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "Kemudian"}, {"pos": 2, "word_orig": "כְ/עוֹף", "strong": "H5775", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "burung"}, {"pos": 3, "word_orig": "נוֹדֵ֖ד", "strong": "H5074", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "beterbangan"}, {"pos": 4, "word_orig": "קֵ֣ן", "strong": "H7064", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sarang"}, {"pos": 5, "word_orig": "מְשֻׁלָּ֑ח", "strong": "H7971", "morph": "HVPsmsa", "morph_id": "Verba Pual Partisip Pasif", "ayt_word": "diacak-acak"}, {"pos": 6, "word_orig": "תִּֽהְיֶ֨ינָה֙", "strong": "H1961", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "demikianlah"}, {"pos": 7, "word_orig": "בְּנ֣וֹת", "strong": "H1323", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "putri-putri"}, {"pos": 8, "word_orig": "מוֹאָ֔ב", "strong": "H4124", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Moab"}, {"pos": 9, "word_orig": "מַעְבָּרֹ֖ת", "strong": "H4569", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "tempat-tempat"}, {"pos": 10, "word_orig": "לְ/אַרְנֽוֹן", "strong": "H769", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Arnon"}]}, {"book": 23, "chapter": 16, "verse": 3, "ayat_id": 17973, "title": "", "ayt_text": "Dapatkan nasihat, buatlah keputusan. Jadikan naunganmu bagai malam di puncak siang hari. Sembunyikanlah orang-orang terbuang, jangan serahkan orang-orang yang lari.", "words": [{"pos": 1, "word_orig": "הביאו", "strong": "H935", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Dapatkan"}, {"pos": 2, "word_orig": "הָבִ֤יאִי", "strong": "H935", "morph":