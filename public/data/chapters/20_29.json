[{"book": 20, "chapter": 29, "verse": 1, "ayat_id": 17226, "title": "", "ayt_text": "Orang yang sering ditegur, tetapi tetap menegarkan tengkuk akan diremukkan seketika tanpa dapat disembuhkan.", "words": [{"pos": 1, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "תּ֭וֹכָחוֹת", "strong": "H8433", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "ditegur"}, {"pos": 3, "word_orig": "מַקְשֶׁה", "strong": "H7185", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menegarkan"}, {"pos": 4, "word_orig": "עֹ֑רֶף", "strong": "H6203", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tengkuk"}, {"pos": 5, "word_orig": "פֶּ֥תַע", "strong": "H6621", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "seketika"}, {"pos": 6, "word_orig": "יִ֝שָּׁבֵ֗ר", "strong": "H7665", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diremukkan"}, {"pos": 7, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tanpa"}, {"pos": 8, "word_orig": "מַרְפֵּֽא", "strong": "H4832", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "disembuhkan"}]}, {"book": 20, "chapter": 29, "verse": 2, "ayat_id": 17227, "title": "", "ayt_text": "Ketika orang benar bertambah banyak, rakyat bersukacita, tetapi ketika orang fasik memerintah, rakyat mengeluh.", "words": [{"pos": 1, "word_orig": "בִּ/רְב֣וֹת", "strong": "H7235", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "banyak"}, {"pos": 2, "word_orig": "צַ֭דִּיקִים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "יִשְׂמַ֣ח", "strong": "H8055", "morph": "HVqi3ms", "morph_id": "Verba Qal Im