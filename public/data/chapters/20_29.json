"morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 29, "verse": 11, "ayat_id": 17236, "title": "", "ayt_text": "Orang bodoh mengeluarkan seluruh kemarahannya, tetapi orang berhikmat berdiam menahannya.", "words": [{"pos": 1, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "seluruh"}, {"pos": 2, "word_orig": "ר֭וּח/וֹ", "strong": "H7307", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kemarahannya"}, {"pos": 3, "word_orig": "יוֹצִ֣יא", "strong": "H3318", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengeluarkan"}, {"pos": 4, "word_orig": "כְסִ֑יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 5, "word_orig": "וְ֝/חָכָ֗ם", "strong": "H2450", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "בְּ/אָח֥וֹר", "strong": "H268", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berdiam"}, {"pos": 7, "word_orig": "יְשַׁבְּחֶֽ/נָּה", "strong": "H7623", "morph": "HVpi3ms/Sp3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal + Sp3fs", "ayt_word": "menahannya"}]}, {"book": 20, "chapter": 29, "verse": 12, "ayat_id": 17237, "title": "", "ayt_text": "Jika pemerintah menghiraukan perkataan dusta, semua pegawainya akan menjadi fasik.", "words": [{"pos": 1, "word_orig": "מֹ֭שֵׁל", "strong": "H4910", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "pemerintah"}, {"pos": 2, "word_orig": "מַקְשִׁ֣יב", "strong": "H7181", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menghiraukan"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 4, "word_orig": "דְּבַר", "strong": "H1697", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "perkataan"}, {"pos": 5, "word_orig": "שָׁ֑קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dusta"}, {"pos": 6, "word_orig": "כָּֽל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 7, "word_orig": "מְשָׁרְתָ֥י/ו", "strong": "H8334", "morph": "HVprmpc/Sp3ms", "morph_id": "Verba Piel + Sp3ms", "ayt_word": "pegawainya"}, {"pos": 8, "word_orig": "רְשָׁעִֽים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}]}, {"book": 20, "chapter": 29, "verse": 13, "ayat_id": 17238, "title": "", "ayt_text": "Si miskin dan si penindas bertemu; TUHAN yang memberikan terang bagi mata keduanya.", "words": [{"pos": 1, "word_orig": "רָ֤שׁ", "strong": "H7326", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "miskin"}, {"pos": 2, "word_orig": "וְ/אִ֣ישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": ""}, {"pos": 3, "word_orig": "תְּכָכִ֣ים", "strong": "H8501", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "penindas"}, {"pos": 4, "word_orig": "נִפְגָּ֑שׁוּ", "strong": "H6298", "morph": "HVNp3cp", "morph_id": "Verba Nifal Perfek Orang ke-3 Jamak", "ayt_word": "bertemu"}, {"pos": 5, "word_orig": "מֵ֤אִיר", "strong": "H215", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memberikan"}, {"pos": 6, "word_orig": "עֵינֵ֖י", "strong": "H5869", "morph": "HNcbdc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "mata"}, {"pos": 7, "word_orig": "שְׁנֵי/הֶ֣ם", "strong": "H8147", "morph": "HAcmdc/Sp3mp", "morph_id": "Acmdc + Sp3mp", "ayt_word": "keduanya"}, {"pos": 8, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 20, "chapter": 29, "verse": 14, "ayat_id": 17239, "title": "", "ayt_text": "Jika seorang raja mengadili orang miskin dengan adil, takhtanya akan kukuh untuk selama-lamanya.", "words": [{"pos": 1, "word_orig": "מֶ֤לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raja"}, {"pos": 2, "word_orig": "שׁוֹפֵ֣ט", "strong": "H8199", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengadili"}, {"pos": 3, "word_orig": "בֶּֽ/אֱמֶ֣ת", "strong": "H571", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "adil"}, {"pos": 4, "word_orig": "דַּלִּ֑ים", "strong": "H1800", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "כִּ֝סְא֗/וֹ", "strong": "H3678", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "takhtanya"}, {"pos": 6, "word_orig": "לָ/עַ֥ד", "strong": "H5703", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 7, "word_orig": "יִכּֽוֹן", "strong": "H3559", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kukuh"}]}, {"book": 20, "chapter": 29, "verse": 15, "ayat_id": 17240, "title": "", "ayt_text": "Rotan dan teguran memberikan hikmat, tetapi anak yang dibiarkan akan mempermalukan ibunya.", "words": [{"pos": 1, "word_orig": "שֵׁ֣בֶט", "strong": "H7626", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Rotan"}, {"pos": 2, "word_orig": "וְ֭/תוֹכַחַת", "strong": "H8433", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "teguran"}, {"pos": 3, "word_orig": "יִתֵּ֣ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberikan"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 5, "word_orig": "וְ/נַ֥עַר", "strong": "H5288", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 6, "word_orig": "מְ֝שֻׁלָּ֗ח", "strong": "H7971", "morph": "HVPsmsa", "morph_id": "Verba Pual Partisip Pasif", "ayt_word": "dibiarkan"}, {"pos": 7, "word_orig": "מֵבִ֥ישׁ", "strong": "H954", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "mempermalukan"}, {"pos": 8, "word_orig": "אִמּֽ/וֹ", "strong": "H517", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ibunya"}]}, {"book": 20, "chapter": 29, "verse": 16, "ayat_id": 17241, "title": "", "ayt_text": "Ketika orang fasik bertambah banyak, pelanggaran bertambah banyak, tetapi orang benar akan melihat kejatuhan mereka.", "words": [{"pos": 1, "word_orig": "בִּ/רְב֣וֹת", "strong": "H7235", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "banyak"}, {"pos": 2, "word_orig": "רְ֭שָׁעִים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 3, "word_orig": "יִרְבֶּה", "strong": "H7235", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertambah"}, {"pos": 4, "word_orig": "פָּ֑שַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelanggaran"}, {"pos": 5, "word_orig": "וְ֝/צַדִּיקִ֗ים", "strong": "H6662", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "בְּֽ/מַפַּלְתָּ֥/ם", "strong": "H4658", "morph": "HR/Ncfsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kejatuhan"}, {"pos": 7, "word_orig": "יִרְאֽוּ", "strong": "H7200", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "melihat"}]}, {"book": 20, "chapter": 29, "verse": 17, "ayat_id": 17242, "title": "", "ayt_text": "Didiklah anakmu, maka dia akan memberimu ketenteraman, dan mendatangkan kesenangan bagi jiwamu.", "words": [{"pos": 1, "word_orig": "יַסֵּ֣ר", "strong": "H3256", "morph": "HVpv2ms", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Didiklah"}, {"pos": 2, "word_orig": "בִּ֭נְ/ךָ", "strong": "H1121", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "anakmu"}, {"pos": 3, "word_orig": "וִֽ/ינִיחֶ֑/ךָ", "strong": "H5117", "morph": "HC/Vhi3ms/Sp2ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "ketenteraman"}, {"pos": 4, "word_orig": "וְ/יִתֵּ֖ן", "strong": "H5414", "morph": "HC/Vqi3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendatangkan"}, {"pos": 5, "word_orig": "מַעֲדַנִּ֣ים", "strong": "H4574", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "kesenangan"}, {"pos": 6, "word_orig": "לְ/נַפְשֶֽׁ/ךָ", "strong": "H5315", "morph": "HR/Ncbsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "jiwamu"}]}, {"book": 20, "chapter": 29, "verse": 18, "ayat_id": 17243, "title": "", "ayt_text": "Tanpa ada wahyu, rakyat menjadi tidak terkendali, tetapi berbahagialah mereka yang memelihara hukum.", "words": [{"pos": 1, "word_orig": "בְּ/אֵ֣ין", "strong": "H369", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "Tanpa"}, {"pos": 2, "word_orig": "חָ֭זוֹן", "strong": "H2377", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "wahyu"}, {"pos": 3, "word_orig": "יִפָּ֣רַֽע", "strong": "H6544", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "עָ֑ם", "strong": "H5971", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rakyat"}, {"pos": 5, "word_orig": "וְ/שֹׁמֵ֖ר", "strong": "H8104", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "memelihara"}, {"pos": 6, "word_orig": "תּוֹרָ֣ה", "strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 7, "word_orig": "אַשְׁרֵֽ/הוּ", "strong": "H835", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "berbahagialah"}]}, {"book": 20, "chapter": 29, "verse": 19, "ayat_id": 17244, "title": "", "ayt_text": "Seorang hamba tidak dapat dididik hanya dengan perkataan, karena walaupun dia mengerti, dia tidak akan menanggapi.", "words": [{"pos": 1, "word_orig": "בִּ֭/דְבָרִים", "strong": "H1697", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "perkataan"}, {"pos": 2, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "יִוָּ֣סֶר", "strong": "H3256", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dididik"}, {"pos": 4, "word_orig": "עָ֑בֶד", "strong": "H5650", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hamba"}, {"pos": 5, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "יָ֝בִ֗ין", "strong": "H995", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengerti"}, {"pos": 7, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "מַעֲנֶֽה", "strong": "H4617", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menanggapi"}]}, {"book": 20, "chapter": 29, "verse": 20, "ayat_id": 17245, "title": "", "ayt_text": "Apakah kamu melihat orang yang terburu-buru bicaranya? Harapan orang bodoh lebih banyak daripada orang itu.", "words": [{"pos": 1, "word_orig": "חָזִ֗יתָ", "strong": "H2372", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "melihat"}, {"pos": 2, "word_orig": "אִ֭ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 3, "word_orig": "אָ֣ץ", "strong": "H213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "terburu-buru"}, {"pos": 4, "word_orig": "בִּ/דְבָרָ֑י/ו", "strong": "H1697", "morph": "HR/Ncmpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "bicaranya"}, {"pos": 5, "word_orig": "תִּקְוָ֖ה", "strong": "H8615", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Harapan"}, {"pos": 6, "word_orig": "לִ/כְסִ֣יל", "strong": "H3684", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "מִמֶּֽ/נּוּ", "strong": "H4480", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "daripada"}]}, {"book": 20, "chapter": 29, "verse": 21, "ayat_id": 17246, "title": "", "ayt_text": "Orang yang memanjakan hambanya sejak masa kecilnya pada akhirnya akan menjadikan dia penerusnya.", "words": [{"pos": 1, "word_orig": "מְפַנֵּ֣ק", "strong": "H6445", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "memanjakan"}, {"pos": 2, "word_orig": "מִ/נֹּ֣עַר", "strong": "H5290", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kecilnya"}, {"pos": 3, "word_orig": "עַבְדּ֑/וֹ", "strong": "H5650", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hambanya"}, {"pos": 4, "word_orig": "וְ֝/אַחֲרִית֗/וֹ", "strong": "H319", "morph": "HC/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "akhirnya"}, {"pos": 5, "word_orig": "יִהְיֶ֥ה", "strong": "H1961", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadikan"}, {"pos": 6, "word_orig": "מָנֽוֹן", "strong": "H4497", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penerusnya"}]}, {"book": 20, "chapter": 29, "verse": 22, "ayat_id": 17247, "title": "", "ayt_text": "Seorang pemarah menimbulkan pertengkaran, dan orang yang cepat gusar banyak pelanggarannya.", "words": [{"pos": 1, "word_orig": "אִֽישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Seorang"}, {"pos": 2, "word_orig": "אַ֭ף", "strong": "H639", "morph": "HTa", "morph_id": "Ta", "ayt_word": "pemarah"}, {"pos": 3, "word_orig": "יְגָרֶ֣ה", "strong": "H1624", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menimbulkan"}, {"pos": 4, "word_orig": "מָד֑וֹן", "strong": "H4066", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pertengkaran"}, {"pos": 5, "word_orig": "וּ/בַ֖עַל", "strong": "H1167", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 6, "word_orig": "חֵמָ֣ה", "strong": "H2534", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "gusar"}, {"pos": 7, "word_orig": "רַב", "strong": "H7227", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "banyak"}, {"pos": 8, "word_orig": "פָּֽשַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelanggarannya"}]}, {"book": 20, "chapter": 29, "verse": 23, "ayat_id": 17248, "title": "", "ayt_text": "Keangkuhan seseorang akan merendahkan dirinya, tetapi orang yang rendah hati akan menerima pujian.", "words": [{"pos": 1, "word_orig": "גַּאֲוַ֣ת", "strong": "H1346", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Keangkuhan"}, {"pos": 2, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seseorang"}, {"pos": 3, "word_orig": "תַּשְׁפִּילֶ֑/נּוּ", "strong": "H8213", "morph": "HVhi3fs/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "merendahkan"}, {"pos": 4, "word_orig": "וּ/שְׁפַל", "strong": "H8217", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "rendah"}, {"pos": 5, "word_orig": "ר֝֗וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "hati"}, {"pos": 6, "word_orig": "יִתְמֹ֥ךְ", "strong": "H8551", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menerima"}, {"pos": 7, "word_orig": "כָּבֽוֹד", "strong": "H3519", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "pujian"}]}, {"book": 20, "chapter": 29, "verse": 24, "ayat_id": 17249, "title": "", "ayt_text": "Orang yang berbagi dengan pencuri membenci dirinya; dia mendengar kutukan, tetapi tidak memberitahukannya.", "words": [{"pos": 1, "word_orig": "חוֹלֵ֣ק", "strong": "H2505", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berbagi"}, {"pos": 2, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dengan"}, {"pos": 3, "word_orig": "גַּ֭נָּב", "strong": "H1590", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pencuri"}, {"pos": 4, "word_orig": "שׂוֹנֵ֣א", "strong": "H8130", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membenci"}, {"pos": 5, "word_orig": "נַפְשׁ֑/וֹ", "strong": "H5315", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "dirinya"}, {"pos": 6, "word_orig": "אָלָ֥ה", "strong": "H423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kutukan"}, {"pos": 7, "word_orig": "יִ֝שְׁמַ֗ע", "strong": "H8085", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendengar"}, {"pos": 8, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "יַגִּֽיד", "strong": "H5046", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberitahukannya"}]}, {"book": 20, "chapter": 29, "verse": 25, "ayat_id": 17250, "title": "", "ayt_text": "Takut akan manusia mendatangkan jerat, tetapi orang yang percaya kepada TUHAN akan ditinggikan.", "words": [{"pos": 1, "word_orig": "חֶרְדַּ֣ת", "strong": "H2731", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 2, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 3, "word_orig": "יִתֵּ֣ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendatangkan"}, {"pos": 4, "word_orig": "מוֹקֵ֑שׁ", "strong": "H4170", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "jerat"}, {"pos": 5, "word_orig": "וּ/בוֹטֵ֖חַ", "strong": "H982", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "percaya"}, {"pos": 6, "word_orig": "בַּ/יהוָ֣ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "יְשֻׂגָּֽב", "strong": "H7682", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ditinggikan"}]}, {"book": 20, "chapter": 29, "verse": 26, "ayat_id": 17251, "title": "", "ayt_text": "Banyak orang mencari muka kepada pemerintah, tetapi dari TUHAN, manusia memperoleh keadilan.", "words": [{"pos": 1, "word_orig": "רַ֭בִּים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "Banyak"}, {"pos": 2, "word_orig": "מְבַקְשִׁ֣ים", "strong": "H1245", "morph": "HVprmpa", "morph_id": "Verba Piel", "ayt_word": "mencari"}, {"pos": 3, "word_orig": "פְּנֵי", "strong": "H6440", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "muka"}, {"pos": 4, "word_orig": "מוֹשֵׁ֑ל", "strong": "H4910", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "pemerintah"}, {"pos": 5, "word_orig": "וּ֝/מֵ/יְהוָ֗ה", "strong": "H3068", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "מִשְׁפַּט", "strong": "H4941", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keadilan"}, {"pos": 7, "word_orig": "אִֽישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}]}, {"book": 20, "chapter": 29, "verse": 27, "ayat_id": 17252, "title": "", "ayt_text": "Orang yang tidak adil adalah kekejian bagi orang benar, dan orang yang lurus jalannya adalah kekejian bagi orang fasik.", "words": [{"pos": 1, "word_orig": "תּוֹעֲבַ֣ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 2, "word_orig": "צַ֭דִּיקִים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 4, "word_orig": "עָ֑וֶל", "strong": "H5766", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "וְ/תוֹעֲבַ֖ת", "strong": "H8441", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 6, "word_orig": "רָשָׁ֣ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יְשַׁר", "strong": "H3477", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "orang"}, {"pos": 8, "word_orig": "דָּֽרֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalannya"}]}]