[{"book": 19, "chapter": 14, "verse": 1, "ayat_id": 14082, "title": "Nyanyian tentang Si Bodoh", "ayt_text": "Kepada pemimpin pujian: Nyanyian Daud. Orang bodoh berkata dalam hatinya, “Tidak ada Allah.” Mereka rusak, dan melakukan perbuatan keji; tidak ada yang berbuat baik.", "words": [{"pos": 1, "word_orig": "לַ/מְנַצֵּ֗חַ", "strong": "H5329", "morph": "HRd/Vprmsa", "morph_id": "Rd + Verba Piel", "ayt_word": "pujian"}, {"pos": 2, "word_orig": "לְ/דָ֫וִ֥ד", "strong": "H1732", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Daud"}, {"pos": 3, "word_orig": "אָ֘מַ֤ר", "strong": "H559", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berkata"}, {"pos": 4, "word_orig": "נָבָ֣ל", "strong": "H5036", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 5, "word_orig": "בְּ֭/לִבּ/וֹ", "strong": "H3820", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hatinya"}, {"pos": 6, "word_orig": "אֵ֣ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Tidak"}, {"pos": 7, "word_orig": "אֱלֹהִ֑ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 8, "word_orig": "הִֽשְׁחִ֗יתוּ", "strong": "H7843", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "rusak"}, {"pos": 9, "word_orig": "הִֽתְעִ֥יבוּ", "strong": "H8581", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "keji"}, {"pos": 10, "word_orig": "עֲלִילָ֗ה", "strong": "H5949", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perbuatan"}, {"pos": 11, "word_orig": "אֵ֣ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 12, "word_orig": "עֹֽשֵׂה", "strong": "H6213", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "berbuat"}, {"pos": 13, "word_orig": "טֽוֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}]}, {"book": 19, "chapter": 14, "verse": 2, "ayat_id": 14083, "title": "", "ayt_text": "TUHAN melihat ke bawah dari surga kepada anak-anak manusia, untuk melihat jika ada seseorang yang bijaksana yang mencari Allah.", "words": [{"pos": 1, "word_orig": "יְֽהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "מִ/שָּׁמַיִם֮", "strong": "H8064", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "surga"}, {"pos": 3, "word_orig": "הִשְׁקִ֪יף", "strong": "H8259", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melihat"}, {"pos": 4, "word_orig": "עַֽל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 5, "word_orig": "בְּנֵי", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "אָ֫דָ֥ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 7, "word_orig": "לִ֭/רְאוֹת", "strong": "H7200", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melihat"}, {"pos": 8, "word_orig": "הֲ/יֵ֣שׁ", "strong": "H3426", "morph": "HTi/Tm", "morph_id": "Ti + Tm", "ayt_word": "ada"}, {"pos": 9, "word_orig": "מַשְׂכִּ֑יל", "strong": "H7919", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "seseorang"}, {"pos": 10, "word_orig": "דֹּ֝רֵשׁ", "strong": "H1875", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencari"}, {"pos": 11, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 12, "word_orig": "אֱלֹהִֽים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Kons