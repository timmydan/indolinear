ord_orig": "פָ֑חַד", "strong": "H6343", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "besar"}, {"pos": 4, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 5, "word_orig": "אֱ֝לֹהִ֗ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 6, "word_orig": "בְּ/ד֣וֹר", "strong": "H1755", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keturunan"}, {"pos": 7, "word_orig": "צַדִּֽיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 19, "chapter": 14, "verse": 6, "ayat_id": 14087, "title": "", "ayt_text": "Kamu mempermalukan nasihat orang tertindas, tetapi TUHAN ialah tempat perlindungannya.", "words": [{"pos": 1, "word_orig": "עֲצַת", "strong": "H6098", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "nasihat"}, {"pos": 2, "word_orig": "עָנִ֥י", "strong": "H6041", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "תָבִ֑ישׁוּ", "strong": "H954", "morph": "HVhi2mp", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Jamak", "ayt_word": "mempermalukan"}, {"pos": 4, "word_orig": "כִּ֖י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "tetapi"}, {"pos": 5, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "מַחְסֵֽ/הוּ", "strong": "H4268", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tempat"}]}, {"book": 19, "chapter": 14, "verse": 7, "ayat_id": 14088, "title": "", "ayt_text": "Kiranya keselamatan bagi orang Israel datang dari Sion! Ketika TUHAN memulihkan keadaan umat-Nya, Yakub akan be