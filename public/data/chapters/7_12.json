[{"book": 7, "chapter": 12, "verse": 1, "ayat_id": 6871, "title": "Yefta dan Efraim", "ayt_text": "Orang Efraim dikerahkan, lalu mereka menyeberang ke Zafon, dan berkata kepada Yefta, “Mengapa engkau menyeberang untuk berperang melawan keturunan Amon tanpa memanggil kami untuk maju menyertaimu? Kami akan membakar rumahmu dengan api.”", "words": [{"pos": 1, "word_orig": "וַ/יִּצָּעֵק֙", "strong": "H6817", "morph": "HC/VNw3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dikerahkan"}, {"pos": 2, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 3, "word_orig": "אֶפְרַ֔יִם", "strong": "H669", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Efraim"}, {"pos": 4, "word_orig": "וַֽ/יַּעֲבֹ֖ר", "strong": "H5674", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyeberang"}, {"pos": 5, "word_orig": "צָפ֑וֹנָ/ה", "strong": "H6828", "morph": "HNcfsa/Sd", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut + Sd", "ayt_word": "Zafon"}, {"pos": 6, "word_orig": "וַ/יֹּאמְר֨וּ", "strong": "H559", "morph": "HC/Vqw3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "berkata"}, {"pos": 7, "word_orig": "לְ/יִפְתָּ֜ח", "strong": "H3316", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yefta"}, {"pos": 8, "word_orig": "מַדּ֣וּעַ", "strong": "H4069", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Mengapa"}, {"pos": 9, "word_orig": "עָבַ֣רְתָּ", "strong": "H5674", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menyeberang"}, {"pos": 10, "word_orig": "לְ/הִלָּחֵ֣ם", "strong": "H3898", "morph": "HR/VNc", "morph_id": "Preposisi + Verba Nifal Imperatif", "ayt_word": "berperang"}, {"p