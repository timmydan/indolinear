rd_orig": "לִ֝/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "bagiku"}, {"pos": 9, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "melawan"}, {"pos": 10, "word_orig": "פֹּ֥עֲלֵי", "strong": "H6466", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "orang-orang"}, {"pos": 11, "word_orig": "אָֽוֶן", "strong": "H205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kefasikan"}]}, {"book": 19, "chapter": 94, "verse": 17, "ayat_id": 15449, "title": "", "ayt_text": "Jika TUHAN tidak menjadi penolongku, jiwaku akan segera berdiam di tempat sunyi.", "words": [{"pos": 1, "word_orig": "לוּלֵ֣י", "strong": "H3884", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "עֶזְרָ֣תָ/ה", "strong": "H5833", "morph": "HNcfsa/Sh", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut + Sh", "ayt_word": "penolongku"}, {"pos": 4, "word_orig": "לִּ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 5, "word_orig": "כִּ/מְעַ֓ט", "strong": "H4592", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "segera"}, {"pos": 6, "word_orig": "שָֽׁכְנָ֖ה", "strong": "H7931", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "berdiam"}, {"pos": 7, "word_orig": "דוּמָ֣ה", "strong": "H1745", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sunyi"}, {"pos": 8, "word_orig": "נַפְשִֽׁ/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": ""}]}, {"book": 19, "chapter": 94, "verse": 18, "ayat_id": 15450, "title": "", "ayt_text": "Jika aku berkata, “Kakiku tergelincir,” kasih setia-Mu, ya TUHAN, menopang aku.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "אָ֭מַרְתִּי", "strong": "H559", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berkata"}, {"pos": 3, "word_orig": "מָ֣טָה", "strong": "H4131", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "tergelincir"}, {"pos": 4, "word_orig": "רַגְלִ֑/י", "strong": "H7272", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Kakiku"}, {"pos": 5, "word_orig": "חַסְדְּ/ךָ֥", "strong": "H2617", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "kasih"}, {"pos": 6, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "יִסְעָדֵֽ/נִי", "strong": "H5582", "morph": "HVqi3ms/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menopang"}]}, {"book": 19, "chapter": 94, "verse": 19, "ayat_id": 15451, "title": "", "ayt_text": "Ketika pikiranku bertambah-tambah di dalam batinku, penghiburan-penghiburan-Mu menyenangkan jiwaku.", "words": [{"pos": 1, "word_orig": "בְּ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "bertambah-tambah"}, {"pos": 2, "word_orig": "שַׂרְעַפַּ֣/י", "strong": "H8312", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "pikiranku"}, {"pos": 3, "word_orig": "בְּ/קִרְבִּ֑/י", "strong": "H7130", "morph": "HR/Ncmsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs",