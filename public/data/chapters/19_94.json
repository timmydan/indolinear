 Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}]}, {"book": 19, "chapter": 94, "verse": 11, "ayat_id": 15443, "title": "", "ayt_text": "TUHAN mengetahui rancangan-rancangan manusia, mereka itu seembusan napas.", "words": [{"pos": 1, "word_orig": "יְֽהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "יֹ֭דֵעַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengetahui"}, {"pos": 3, "word_orig": "מַחְשְׁב֣וֹת", "strong": "H4284", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "rancangan-rancangan"}, {"pos": 4, "word_orig": "אָדָ֑ם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 5, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 6, "word_orig": "הֵ֥מָּה", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": "mereka"}, {"pos": 7, "word_orig": "הָֽבֶל", "strong": "H1892", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seembusan"}]}, {"book": 19, "chapter": 94, "verse": 12, "ayat_id": 15444, "title": "", "ayt_text": "Diberkatilah orang yang Engkau didik, ya TUHAN, dan yang Engkau ajari hukum-Mu,", "words": [{"pos": 1, "word_orig": "אַשְׁרֵ֤י", "strong": "H835", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Diberkatilah"}, {"pos": 2, "word_orig": "הַ/גֶּ֣בֶר", "strong": "H1397", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 3, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 4, "word_orig": "תְּיַסְּרֶ֣/נּוּ", "strong": "H3256", "morph": "HVpi2ms/Sp3ms", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "didik"}, {"pos": 5, "word_orig": "יָּ֑הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "וּֽ/מִ/תּוֹרָתְ/ךָ֥", "strong": "H8451", "morph": "HC/R/Ncfsc/Sp2ms", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "hukum-Mu"}, {"pos": 7, "word_orig": "תְלַמְּדֶֽ/נּוּ", "strong": "H3925", "morph": "HVpi2ms/Sp3ms", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Tunggal + Sp3ms", "ayt_word": "ajari"}]}, {"book": 19, "chapter": 94, "verse": 13, "ayat_id": 15445, "title": "", "ayt_text": "untuk menenangkan dia dari hari-hari kesengsaraan, sampai lubang digali bagi orang-orang fasik.", "words": [{"pos": 1, "word_orig": "לְ/הַשְׁקִ֣יט", "strong": "H8252", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "menenangkan"}, {"pos": 2, "word_orig": "ל֭/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 3, "word_orig": "מִ֣/ימֵי", "strong": "H3117", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "hari-hari"}, {"pos": 4, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kesengsaraan"}, {"pos": 5, "word_orig": "עַ֤ד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sampai"}, {"pos": 6, "word_orig": "יִכָּרֶ֖ה", "strong": "H3738", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "digali"}, {"pos": 7, "word_orig": "לָ/רָשָׁ֣ע", "strong": "H7563", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "orang-orang"}, {"pos": 8, "word_orig": "שָֽׁחַת", "strong": "H7845", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "lubang"}]}, {"book": 19, "chapter": 94, "verse": 14, "ayat_id": 15446, "title": "", "ayt_text": "Sebab, TUHAN takkan membiarkan umat-Nya; Dia takkan meninggalkan milik pusaka-Nya.", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 3, "word_orig": "יִטֹּ֣שׁ", "strong": "H5203", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membiarkan"}, {"pos": 4, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "עַמּ֑/וֹ", "strong": "H5971", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "umat-Nya"}, {"pos": 6, "word_orig": "וְ֝/נַחֲלָת֗/וֹ", "strong": "H5159", "morph": "HC/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "milik"}, {"pos": 7, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 8, "word_orig": "יַעֲזֹֽב", "strong": "H5800", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "meninggalkan"}]}, {"book": 19, "chapter": 94, "verse": 15, "ayat_id": 15447, "title": "", "ayt_text": "Sebab, keadilan akan kembali kepada kebenaran, dan semua orang yang lurus hati akan mengikutinya.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 3, "word_orig": "צֶ֭דֶק", "strong": "H6664", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 4, "word_orig": "יָשׁ֣וּב", "strong": "H7725", "morph": "HVqi3ms", "morph_id": "Verba Qal I