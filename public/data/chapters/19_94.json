[{"book": 19, "chapter": 94, "verse": 1, "ayat_id": 15433, "title": "Doa untuk Pembalasan", "ayt_text": "Ya TUHAN, Allah Pembalas, ya Allah Pembalas, bersinarlah!", "words": [{"pos": 1, "word_orig": "אֵל", "strong": "H410", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Allah"}, {"pos": 2, "word_orig": "נְקָמ֥וֹת", "strong": "H5360", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Pembalas"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "אֵ֖ל", "strong": "H410", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "נְקָמ֣וֹת", "strong": "H5360", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Pembalas"}, {"pos": 6, "word_orig": "הוֹפִֽיַע", "strong": "H3313", "morph": "HVhv2ms", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "bersinarlah"}]}, {"book": 19, "chapter": 94, "verse": 2, "ayat_id": 15434, "title": "", "ayt_text": "Bangkitlah, ya Hakim bumi, balaslah orang-orang sombong!", "words": [{"pos": 1, "word_orig": "הִ֭נָּשֵׂא", "strong": "H5375", "morph": "HVNv2ms", "morph_id": "Verba Nifal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Bangkitlah"}, {"pos": 2, "word_orig": "שֹׁפֵ֣ט", "strong": "H8199", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "Hakim"}, {"pos": 3, "word_orig": "הָ/אָ֑רֶץ", "strong": "H776", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}, {"pos": 4, "word_orig": "הָשֵׁ֥ב", "strong": "H7725", "morph": "HVhv2ms", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 5, "word_orig": "גְּ֝מ֗וּל", "strong": "H1576", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "balaslah"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 7, "word_orig": "גֵּאִֽים", "strong": "H1343", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "sombong"}]}, {"book": 19, "chapter": 94, "verse": 3, "ayat_id": 15435, "title": "", "ayt_text": "Berapa lama lagi orang-orang fasik, ya TUHAN, berapa lama lagi orang-orang fasik akan bersukaria?", "words": [{"pos": 1, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Berapa"}, {"pos": 2, "word_orig": "מָתַ֖י", "strong": "H4970", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Berapa"}, {"pos": 3, "word_orig": "רְשָׁעִ֥ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "berapa"}, {"pos": 6, "word_orig": "מָ֝תַ֗י", "strong": "H4970", "morph": "HTi", "morph_id": "Ti", "ayt_word": "lama"}, {"pos": 7, "word_orig": "רְשָׁעִ֥ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 8, "word_orig": "יַעֲלֹֽזוּ", "strong": "H5937", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bersukaria"}]}, {"book": 19, "chapter": 94, "verse": 4, "ayat_id": 15436, "title": "", "ayt_text": "Mereka menumpahkan kata-kata congkak; semua pelaku kejahatan membanggakan diri.", "words": [{"pos": 1, "word_orig": "יַבִּ֣יעוּ", "strong": "H5042", "morph": "HVhi3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menumpahkan"}, {"pos": 2, "word_orig": "יְדַבְּר֣וּ", "strong": "H1696", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_