orph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "memberikan"}, {"pos": 6, "word_orig": "וָ/אֵ֔שׁ", "strong": "H784", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "anak"}, {"pos": 7, "word_orig": "וְ/תִֽימֲר֖וֹת", "strong": "H8490", "morph": "HC/Ncfpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "sundal"}, {"pos": 8, "word_orig": "עָשָֽׁן", "strong": "H6227", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perempuan"}]}, {"book": 29, "chapter": 3, "verse": 4, "ayat_id": 22348, "title": "", "ayt_text": "“Lagi pula, apakah sangkut pautnya kamu dengan Aku, hai Tirus, Sidon, dan seluruh wilayah Filistin? Apakah kamu akan membalas perbuatan-Ku? Jikalau kamu melakukan perbuatan terhadap Aku, dengan cepat dan dengan segera, Aku akan mengembalikan perbuatanmu ke atas kepalamu sendiri.", "words": [{"pos": 1, "word_orig": "הַ/שֶּׁ֨מֶשׁ֙", "strong": "H8121", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "pula"}, {"pos": 2, "word_orig": "יֵהָפֵ֣ךְ", "strong": "H2015", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "apakah"}, {"pos": 3, "word_orig": "לְ/חֹ֔שֶׁךְ", "strong": "H2822", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kamu"}, {"pos": 4, "word_orig": "וְ/הַ/יָּרֵ֖חַ", "strong": "H3394", "morph": "HC/Td/Ncmsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": ""}, {"pos": 5, "word_orig": "לְ/דָ֑ם", "strong": "H1818", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Tirus"}, {"pos": 6, "word_orig": "לִ/פְנֵ֗י", "strong": "H6440", "morph": "HR/Ncbpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "Sidon"}, {"pos": 7, "word_orig": "בּ֚וֹא", "strong": "H935", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "seluruh"}, {"pos": 8, "word_orig": "י֣וֹם", "strong": "H3117", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "wilayah"}, {"pos": 9, "word_orig": "יְהוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Filistin"}, {"pos": 10, "word_orig": "הַ/גָּד֖וֹל", "strong": "H1419", "morph": "HTd/Aamsa", "morph_id": "Artikel Definit (הַ) + Aamsa", "ayt_word": "perbuatan-Ku"}, {"pos": 11, "word_orig": "וְ/הַ/נּוֹרָֽא", "strong": "H3372", "morph": "HC/Td/VNrmsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Verba Nifal", "ayt_word": "kamu"}]}, {"book": 29, "chapter": 3, "verse": 5, "ayat_id": 22349, "title": "", "ayt_text": "Sebab, kamu telah mengambil perak-Ku dan emas-Ku, dan telah membawa barang-barang-Ku yang berharga ke dalam baitmu.”", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֗ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "כֹּ֧ל", "strong": "H3605", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak-Ku"}, {"pos": 3, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "emas-Ku"}, {"pos": 4, "word_orig": "יִקְרָ֛א", "strong": "H7121", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengambil"}, {"pos": 5, "word_orig": "בְּ/שֵׁ֥ם", "strong": "H8034", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "barang-barang-Ku"}, {"pos": 6, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_