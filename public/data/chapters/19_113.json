[{"book": 19, "chapter": 113, "verse": 1, "ayat_id": 15815, "title": "Siapakah yang Seperti TUHAN, Allah Kita?", "ayt_text": "Haleluya! Pujilah, hai hamba-hamba TUHAN! Pujilah nama TUHAN!", "words": [{"pos": 1, "word_orig": "הַ֥לְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Haleluya"}, {"pos": 2, "word_orig": "יָ֨הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Haleluya"}, {"pos": 3, "word_orig": "הַ֭לְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Pujilah"}, {"pos": 4, "word_orig": "עַבְדֵ֣י", "strong": "H5650", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "hamba-hamba"}, {"pos": 5, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "הַֽ֝לְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Pujilah"}, {"pos": 7, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 8, "word_orig": "שֵׁ֥ם", "strong": "H8034", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 9, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 113, "verse": 2, "ayat_id": 15816, "title": "", "ayt_text": "Nama TUHAN dipuji, dari sekarang ini sampai selamanya.", "words": [{"pos": 1, "word_orig": "יְהִ֤י", "strong": "H1961", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "שֵׁ֣ם", "strong": "H8034", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Nama"}, {"pos": 3, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "מְבֹרָ֑ךְ", "strong": "H1288", "morph": "HVPsmsa", "morph_id": "Verba Pual Partisip Pasif", "ayt_word": "dipuji"}, {"pos": 5, "word_orig": "מֵֽ֝/עַתָּ֗ה", "strong": "H6258", "morph": "HR/D", "morph_id": "Preposisi + Adverbia", "ayt_word": "sekarang"}, {"pos": 6, "word_orig": "וְ/עַד", "strong": "H5704", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "sampai"}, {"pos": 7, "word_orig": "עוֹלָֽם", "strong": "H5769", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}]}, {"book": 19, "chapter": 113, "verse": 3, "ayat_id": 15817, "title": "", "ayt_text": "Dari tempat matahari terbit sampai terbenamnya, nama TUHAN dipuji-puji.", "words": [{"pos": 1, "word_orig": "מִ/מִּזְרַח", "strong": "H4217", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Dari"}, {"pos": 2, "word_orig": "שֶׁ֥מֶשׁ", "strong": "H8121", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "matahari"}, {"pos": 3, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sampai"}, {"pos": 4, "word_orig": "מְבוֹא֑/וֹ", "strong": "H3996", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "terbenamnya"}, {"pos": 5, "word_orig": "מְ֝הֻלָּ֗ל", "strong": "H1984", "morph": "HVPsmsa", "morph_id": "Verba Pual Partisip Pasif", "ayt_word": "dipuji-puji"}, {"pos": 6, "word_orig": "שֵׁ֣ם", "strong": "H8034", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 7, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 113, "verse": 4, "ayat_id": 15818, "title": "", "ayt_text": "TUHAN itu tinggi mengatasi segala bangsa, kemuliaan-Nya mengatasi langit.", "words": [{"pos": 1, "word_orig": "רָ֖ם", "strong": "H7311", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "tinggi"}, {"pos": 2, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "mengatasi"}, {"pos": 3, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 4, "word_orig": "גּוֹיִ֥ם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa"}, {"pos": 5, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "עַ֖ל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "mengatasi"}, {"pos": 7, "word_orig": "הַ/שָּׁמַ֣יִם", "strong": "H8064", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 8, "word_orig": "כְּבוֹדֽ/וֹ", "strong": "H3519", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kemuliaan-Nya"}]}, {"book": 19, "chapter": 113, "verse": 5, "ayat_id": 15819, "title": "", "ayt_text": "Siapa seperti TUHAN, Allah kita, yang bertakhta di tempat tinggi,", "words": [{"pos": 1, "word_orig": "מִ֭י", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapa"}, {"pos": 2, "word_orig": "כַּ/יהוָ֣ה", "strong": "H3068", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "אֱלֹהֵ֑י/נוּ", "strong": "H430", "morph": "HNcmpc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cp", "ayt_word": "Allah"}, {"pos": 4, "word_orig": "הַֽ/מַּגְבִּיהִ֥י", "strong": "H1361", "morph": "HTd/Vhrmsc", "morph_id": "Artikel Definit (הַ) + Verba Hifil", "ayt_word": "tempat"}, {"pos": 5, "word_orig": "לָ/שָֽׁבֶת", "strong": "H3427", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "bertakhta"}]}, {"book": 19, "chapter": 113, "verse": 6, "ayat_id": 15820, "title": "", "ayt_text": "yang merendah, untuk melihat ke langit dan bumi?", "words": [{"pos": 1, "word_orig": "הַֽ/מַּשְׁפִּילִ֥י", "strong": "H8213", "morph": "HTd/Vhrmsc", "morph_id": "Artikel Definit (הַ) + Verba Hifil", "ayt_word": "merendah"}, {"pos": 2, "word_orig": "לִ/רְא֑וֹת", "strong": "H7200", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melihat"}, {"pos": 3, "word_orig": "בַּ/שָּׁמַ֥יִם", "strong": "H8064", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 4, "word_orig": "וּ/בָ/אָֽרֶץ", "strong": "H776", "morph": "HC/Rd/Ncbsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 19, "chapter": 113, "verse": 7, "ayat_id": 15821, "title": "", "ayt_text": "Dia membangkitkan orang miskin dari debu, dan mengangkat orang melarat dari tumpukan sampah,", "words": [{"pos": 1, "word_orig": "מְקִֽימִ֣י", "strong": "H6965", "morph": "HVhrmsc", "morph_id": "Verba Hifil", "ayt_word": "membangkitkan"}, {"pos": 2, "word_orig": "מֵ/עָפָ֣ר", "strong": "H6083", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "debu"}, {"pos": 3, "word_orig": "דָּ֑ל", "strong": "H1800", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 4, "word_orig": "מֵֽ֝/אַשְׁפֹּ֗ת", "strong": "H830", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sampah"}, {"pos": 5, "word_orig": "יָרִ֥ים", "strong": "H7311", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengangkat"}, {"pos": 6, "word_orig": "אֶבְיֽוֹן", "strong": "H34", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 19, "chapter": 113, "verse": 8, "ayat_id": 15822, "title": "", "ayt_text": "untuk mendudukkan mereka bersama para penguasa, bersama para penguasa umat-Nya.", "words": [{"pos": 1, "word_orig": "לְ/הוֹשִׁיבִ֥י", "strong": "H3427", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "mendudukkan"}, {"pos": 2, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "bersama"}, {"pos": 3, "word_orig": "נְדִיבִ֑ים", "strong": "H5081", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "penguasa"}, {"pos": 4, "word_orig": "עִ֝֗ם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "bersama"}, {"pos": 5, "word_orig": "נְדִיבֵ֥י", "strong": "H5081", "morph": "HAampc", "morph_id": "Aampc", "ayt_word": "penguasa"}, {"pos": 6, "word_orig": "עַמּֽ/וֹ", "strong": "H5971", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "umat-Nya"}]}, {"book": 19, "chapter": 113, "verse": 9, "ayat_id": 15823, "title": "", "ayt_text": "Dia menjadikan perempuan mandul di dalam rumah, sebagai ibu dari anak-anak, yang berbahagia. Haleluya!", "words": [{"pos": 1, "word_orig": "מֽוֹשִׁיבִ֨י", "strong": "H3427", "morph": "HVhrmsc", "morph_id": "Verba Hifil", "ayt_word": ""}, {"pos": 2, "word_orig": "עֲקֶ֬רֶת", "strong": "H6135", "morph": "HAafsc", "morph_id": "Aafsc", "ayt_word": "mandul"}, {"pos": 3, "word_orig": "הַ/בַּ֗יִת", "strong": "H1004", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rumah"}, {"pos": 4, "word_orig": "אֵֽם", "strong": "H517", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "ibu"}, {"pos": 5, "word_orig": "הַ/בָּנִ֥ים", "strong": "H1121", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "שְׂמֵחָ֗ה", "strong": "H8056", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "berbahagia"}, {"pos": 7, "word_orig": "הַֽלְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Haleluya"}, {"pos": 8, "word_orig": "יָֽהּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Haleluya"}]}]