[{"book": 13, "chapter": 20, "verse": 1, "ayat_id": 10928, "title": "Yoab Membinasakan Orang Amon", "ayt_text": "Pada waktu pergantian tahun, saat raja-raja pergi berperang, Yoab memimpin pasukan tentaranya untuk memusnahkan negeri orang Amon. Dia maju dan mengepung kota Raba, sementara Daud tetap tinggal di Yerusalem. Yoab mengalahkan kota Raba dan meruntuhkannya.", "words": [{"pos": 1, "word_orig": "וַ/יְהִ֡י", "strong": "H1961", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "Pada"}, {"pos": 2, "word_orig": "לְ/עֵת֩", "strong": "H6256", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "waktu"}, {"pos": 3, "word_orig": "תְּשׁוּבַ֨ת", "strong": "H8666", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "pergantian"}, {"pos": 4, "word_orig": "הַ/שָּׁנָ֜ה", "strong": "H8141", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tahun"}, {"pos": 5, "word_orig": "לְ/עֵ֣ת", "strong": "H6256", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "saat"}, {"pos": 6, "word_orig": "צֵ֣את", "strong": "H3318", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "pergi"}, {"pos": 7, "word_orig": "הַ/מְּלָכִ֗ים", "strong": "H4428", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "raja-raja"}, {"pos": 8, "word_orig": "וַ/יִּנְהַ֣ג", "strong": "H5090", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memimpin"}, {"pos": 9, "word_orig": "יוֹאָב֩", "strong": "H3097", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yoab"}, {"pos": 10, "word_orig": "אֶת", "