sa", "morph_id": "Artikel Definit (הַ) + Nomina Laki-laki Tunggal Absolut", "ayt_word": "Yahudi"}, {"pos": 4, "word_orig": "מִשְׁנֶה֙", "strong": "H4932", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kedua"}, {"pos": 5, "word_orig": "לַ/מֶּ֣לֶךְ", "strong": "H4428", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Raja"}, {"pos": 6, "word_orig": "אֲחַשְׁוֵר֔וֹשׁ", "strong": "H325", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ahasyweros"}, {"pos": 7, "word_orig": "וְ/גָדוֹל֙", "strong": "H1419", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "termasyhur"}, {"pos": 8, "word_orig": "לַ/יְּהוּדִ֔ים", "strong": "H3064", "morph": "HRd/Ngmpa", "morph_id": "Rd + Nomina Laki-laki Jamak Absolut", "ayt_word": "Yahudi"}, {"pos": 9, "word_orig": "וְ/רָצ֖וּי", "strong": "H7521", "morph": "HC/Vqsmsa", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Pasif", "ayt_word": "disenangi"}, {"pos": 10, "word_orig": "לְ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "banyak"}, {"pos": 11, "word_orig": "אֶחָ֑י/ו", "strong": "H251", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "laki-lakinya"}, {"pos": 12, "word_orig": "דֹּרֵ֥שׁ", "strong": "H1875", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mencari"}, {"pos": 13, "word_orig": "טוֹב֙", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 14, "word_orig": "לְ/עַמּ֔/וֹ", "strong": "H5971", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "bangsanya"}, {"pos": 15, "word_orig": "וְ/דֹבֵ֥ר", "strong": "H1696", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mem