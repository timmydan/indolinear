u"}, {"pos": 7, "word_orig": "וָ/אֵֽפֶר", "strong": "H665", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "abu"}]}, {"book": 18, "chapter": 42, "verse": 7, "ayat_id": 13930, "title": "TUHAN Menegur Sahabat-Sahabat Ayub", "ayt_text": "Setelah TUHAN mengucapkan firman itu kepada Ayub, Dia berfirman kepada Elifas, orang Teman, “Murka-Ku menyala terhadap kamu dan terhadap kedua sahabatmu karena kamu tidak mengatakan apa yang benar tentang Aku seperti hamba-Ku, Ayub.", "words": [{"pos": 1, "word_orig": "וַ/יְהִ֗י", "strong": "H1961", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "אַחַ֨ר", "strong": "H310", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Setelah"}, {"pos": 3, "word_orig": "דִּבֶּ֧ר", "strong": "H1696", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengucapkan"}, {"pos": 4, "word_orig": "יְהוָ֛ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "הַ/דְּבָרִ֥ים", "strong": "H1697", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "firman"}, {"pos": 7, "word_orig": "הָ/אֵ֖לֶּה", "strong": "H428", "morph": "HTd/Pdxcp", "morph_id": "Artikel Definit (הַ) + Pdxcp", "ayt_word": "itu"}, {"pos": 8, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 9, "word_orig": "אִיּ֑וֹב", "strong": "H347", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ayub"}, {"pos": 10, "word_orig": "וַ/יֹּ֨אמֶר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ay