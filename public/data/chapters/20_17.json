"morph": "HVtp3ms", "morph_id": "Verba Hitpael Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "meledak"}, {"pos": 7, "word_orig": "הָ/רִ֥יב", "strong": "H7379", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "perbantahan"}, {"pos": 8, "word_orig": "נְטֽוֹשׁ", "strong": "H5203", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "tinggalkanlah"}]}, {"book": 20, "chapter": 17, "verse": 15, "ayat_id": 16889, "title": "", "ayt_text": "Dia yang membenarkan orang fasik dan dia yang menghukum orang benar, keduanya merupakan kekejian bagi TUHAN.", "words": [{"pos": 1, "word_orig": "מַצְדִּ֣יק", "strong": "H6663", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "membenarkan"}, {"pos": 2, "word_orig": "רָ֭שָׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "וּ/מַרְשִׁ֣יעַ", "strong": "H7561", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "menghukum"}, {"pos": 4, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "תּוֹעֲבַ֥ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 6, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 8, "word_orig": "שְׁנֵי/הֶֽם", "strong": "H8147", "morph": "HAcmdc/Sp3mp", "morph_id": "Acmdc + Sp3mp", "ayt_word": "keduanya"}]}, {"book": 20, "chapter": 17, "verse": 16, "ayat_id": 16890, "title": "", "ayt_text": "Mengapa orang bodoh memiliki uang di tangannya untuk membeli hikmat, padahal dia tidak berakal budi?", "words": [{"pos": 1, "word_orig": "לָ/מָּה", "strong": "H4100", "