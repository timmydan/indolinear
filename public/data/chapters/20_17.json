ord_orig": "יִפְנֶ֣ה", "strong": "H6437", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berpaling"}, {"pos": 10, "word_orig": "יַשְׂכִּֽיל", "strong": "H7919", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "beruntung"}]}, {"book": 20, "chapter": 17, "verse": 9, "ayat_id": 16883, "title": "", "ayt_text": "Seseorang yang menutupi pelanggaran mencari kasih, tetapi dia yang mengungkit-ungkit perkara memisahkan sahabat karib.", "words": [{"pos": 1, "word_orig": "מְֽכַסֶּה", "strong": "H3680", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menutupi"}, {"pos": 2, "word_orig": "פֶּ֭שַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelanggaran"}, {"pos": 3, "word_orig": "מְבַקֵּ֣שׁ", "strong": "H1245", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "mencari"}, {"pos": 4, "word_orig": "אַהֲבָ֑ה", "strong": "H160", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kasih"}, {"pos": 5, "word_orig": "וְ/שֹׁנֶ֥ה", "strong": "H8138", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "mengungkit-ungkit"}, {"pos": 6, "word_orig": "בְ֝/דָבָ֗ר", "strong": "H1697", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perkara"}, {"pos": 7, "word_orig": "מַפְרִ֥יד", "strong": "H6504", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memisahkan"}, {"pos": 8, "word_orig": "אַלּֽוּף", "strong": "H441", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "sahabat"}]}, {"book": 20, "chapter": 17, "verse": 10, "ayat_id": 16884, "title": "", "ayt_text": "Satu teguran lebih meresap pada orang yang berpengertian daripada seratus pukulan pada orang bodoh.", "words": [{"pos": 1, "word_orig": "תֵּ֣חַת", "strong": "H5181", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "meresap"}, {"pos": 2, "word_orig": "גְּעָרָ֣ה", "strong": "H1606", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "teguran"}, {"pos": 3, "word_orig": "בְ/מֵבִ֑ין", "strong": "H995", "morph": "HR/Vhrmsa", "morph_id": "Preposisi + Verba Hifil", "ayt_word": "berpengertian"}, {"pos": 4, "word_orig": "מֵ/הַכּ֖וֹת", "strong": "H5221", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "pukulan"}, {"pos": 5, "word_orig": "כְּסִ֣יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "מֵאָֽה", "strong": "H3967", "morph": "HAcbsa", "morph_id": "Acbsa", "ayt_word": "seratus"}]}, {"book": 20, "chapter": 17, "verse": 11, "ayat_id": 16885, "title": "", "ayt_text": "Orang jahat hanya mencari pemberontakan, tetapi utusan yang kejam akan diutus kepadanya.", "words": [{"pos": 1, "word_orig": "אַךְ", "strong": "H389", "morph": "HTa", "morph_id": "Ta", "ayt_word": "hanya"}, {"pos": 2, "word_orig": "מְרִ֥י", "strong": "H4805", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pemberontakan"}, {"pos": 3, "word_orig": "יְבַקֶּשׁ", "strong": "H1245", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 4, "word_orig": "רָ֑ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}, {"pos": 5, "word_orig": "וּ/מַלְאָ֥ךְ", "strong": "H4397", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "utusan"}, {"pos": 6, "word_orig": "אַ֝כְזָרִ֗י", "strong": "H394", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kejam"}, {"pos": 7, "word_orig": "יְשֻׁלַּח", "strong": "H7971", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diutus"}, {"pos": 8, "word_orig": "בּ