s Jamak Konstruk (Terikat)", "ayt_word": "bagi"}, {"pos": 9, "word_orig": "רֵעֵֽ/הוּ", "strong": "H7453", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sesamanya"}]}, {"book": 20, "chapter": 17, "verse": 19, "ayat_id": 16893, "title": "", "ayt_text": "Dia yang suka bertengkar menyukai perselisihan; dia yang meninggikan pintunya mencari kehancuran.", "words": [{"pos": 1, "word_orig": "אֹ֣הֵֽב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "suka"}, {"pos": 2, "word_orig": "פֶּ֭שַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bertengkar"}, {"pos": 3, "word_orig": "אֹהֵ֣ב", "strong": "H157", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyukai"}, {"pos": 4, "word_orig": "מַצָּ֑ה", "strong": "H4683", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perselisihan"}, {"pos": 5, "word_orig": "מַגְבִּ֥יהַּ", "strong": "H1361", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "meninggikan"}, {"pos": 6, "word_orig": "פִּ֝תְח֗/וֹ", "strong": "H6607", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "pintunya"}, {"pos": 7, "word_orig": "מְבַקֶּשׁ", "strong": "H1245", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "mencari"}, {"pos": 8, "word_orig": "שָֽׁבֶר", "strong": "H7667", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kehancuran"}]}, {"book": 20, "chapter": 17, "verse": 20, "ayat_id": 16894, "title": "", "ayt_text": "Orang yang bengkok hatinya tidak akan menemukan kebaikan, dan orang yang lidahnya menipu akan jatuh ke dalam celaka.", "words": [{"pos": 1, "word_orig": "עִקֶּשׁ", "strong": "H6141", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "bengkok"}, {"pos": 2, "word_orig": "לֵ֭ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatinya"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יִמְצָא", "strong": "H4672", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menemukan"}, {"pos": 5, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}, {"pos": 6, "word_orig": "וְ/נֶהְפָּ֥ךְ", "strong": "H2015", "morph": "HC/VNrmsa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "menipu"}, {"pos": 7, "word_orig": "בִּ֝/לְשׁוֹנ֗/וֹ", "strong": "H3956", "morph": "HR/Ncbsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "lidahnya"}, {"pos": 8, "word_orig": "יִפּ֥וֹל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}, {"pos": 9, "word_orig": "בְּ/רָעָֽה", "strong": "H7451", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "celaka"}]}, {"book": 20, "chapter": 17, "verse": 21, "ayat_id": 16895, "title": "", "ayt_text": "Dia yang melahirkan orang bodoh mendapat dukacita, dan ayah orang bodoh tidak memiliki sukacita.", "words": [{"pos": 1, "word_orig": "יֹלֵ֣ד", "strong": "H3205", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melahirkan"}, {"pos": 2, "word_orig": "כְּ֭סִיל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "לְ/ת֣וּגָה", "strong": "H8424", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "dukacita"}, {"pos": 4, "word_orig": "ל֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 5, "word_orig": "וְ/לֹֽא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יִ֝שְׂמַ֗ח", "strong": "H8055", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "sukacita"}, {"pos": 7, "word_orig": "אֲבִ֣י", "strong": "H1", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "ayah"}, {"pos": 8, "word_orig": "נָבָֽל", "strong": "H5036", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}]}, {"book": 20, "chapter": 17, "verse": 22, "ayat_id": 16896, "title": "", "ayt_text": "Hati yang bersukacita adalah obat yang baik, tetapi semangat yang patah mengeringkan tulang-tulang.", "words": [{"pos": 1, "word_orig": "לֵ֣ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Hati"}, {"pos": 2, "word_orig": "שָׂ֭מֵחַ", "strong": "H8056", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bersukacita"}, {"pos": 3, "word_orig": "יֵיטִ֣ב", "strong": "H3190", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "baik"}, {"pos": 4, "word_orig": "גֵּהָ֑ה", "strong": "H1456", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "obat"}, {"pos": 5, "word_orig": "וְ/ר֥וּחַ", "strong": "H7307", "morph": "HC/Ncbsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "semangat"}, {"pos": 6, "word_orig": "נְ֝כֵאָ֗ה", "strong": "H5218", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "patah"}, {"pos": 7, "word_orig": "תְּיַבֶּשׁ", "strong": "H3001", "morph": "HVpi3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mengeringkan"}, {"pos": 8, "word_orig": "גָּֽרֶם", "strong": "H1634", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tulang-tulang"}]}, {"book": 20, "chapter": 17, "verse": 23, "ayat_id": 16897, "title": "", "ayt_text": "Orang fasik menerima suap dalam dada untuk membelokkan jalan keadilan.", "words": [{"pos": 1, "word_orig": "שֹׁ֣חַד", "strong": "H7810", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "suap"}, {"pos": 2, "word_orig": "מֵ֭/חֵיק", "strong": "H2436", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "dada"}, {"pos": 3, "word_orig": "רָשָׁ֣ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Orang"}, {"pos": 4, "word_orig": "יִקָּ֑ח", "strong": "H3947", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menerima"}, {"pos": 5, "word_orig": "לְ֝/הַטּ֗וֹת", "strong": "H5186", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "membelokkan"}, {"pos": 6, "word_orig": "אָרְח֥וֹת", "strong": "H734", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 7, "word_orig": "מִשְׁפָּֽט", "strong": "H4941", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}]}, {"book": 20, "chapter": 17, "verse": 24, "ayat_id": 16898, "title": "", "ayt_text": "Pandangan orang berpengertian tertuju pada hikmat, tetapi mata orang bodoh pada ujung-ujung bumi.", "words": [{"pos": 1, "word_orig": "אֶת", "strong": "H854", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 2, "word_orig": "פְּנֵ֣י", "strong": "H6440", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": ""}, {"pos": 3, "word_orig": "מֵבִ֣ין", "strong": "H995", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "berpengertian"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 5, "word_orig": "וְ/עֵינֵ֥י", "strong": "H5869", "morph": "HC/Ncbdc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "mata"}, {"pos": 6, "word_orig": "כְ֝סִ֗יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "בִּ/קְצֵה", "strong": "H7097", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "ujung-ujung"}, {"pos": 8, "word_orig": "אָֽרֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 20, "chapter": 17, "verse": 25, "ayat_id": 16899, "title": "", "ayt_text": "Anak yang bodoh adalah kedukaan bagi ayahnya, dan kepedihan hati bagi dia yang melahirkannya.", "words": [{"pos": 1, "word_orig": "כַּ֣עַס", "strong": "H3708", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kedukaan"}, {"pos": 2, "word_orig": "לְ֭/אָבִי/ו", "strong": "H1", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ayahnya"}, {"pos": 3, "word_orig": "בֵּ֣ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Anak"}, {"pos": 4, "word_orig": "כְּסִ֑יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 5, "word_orig": "וּ֝/מֶ֗מֶר", "strong": "H4470", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 6, "word_orig": "לְ/יוֹלַדְתּֽ/וֹ", "strong": "H3205", "morph": "HR/Vqrfsc/Sp3ms", "morph_id": "Preposisi + Verba Qal + Sp3ms", "ayt_word": "melahirkannya"}]}, {"book": 20, "chapter": 17, "verse": 26, "ayat_id": 16900, "title": "", "ayt_text": "Menghukum orang benar tidaklah baik, begitu juga memukul orang yang berbudi mulia atas kejujuran mereka.", "words": [{"pos": 1, "word_orig": "גַּ֤ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "juga"}, {"pos": 2, "word_orig": "עֲנ֣וֹשׁ", "strong": "H6064", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "Menghukum"}, {"pos": 3, "word_orig": "לַ/צַּדִּ֣יק", "strong": "H6662", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidaklah"}, {"pos": 5, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 6, "word_orig": "לְ/הַכּ֖וֹת", "strong": "H5221", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "memukul"}, {"pos": 7, "word_orig": "נְדִיבִ֣ים", "strong": "H5081", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "berbudi"}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 9, "word_orig": "יֹֽשֶׁר", "strong": "H3476", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kejujuran"}]}, {"book": 20, "chapter": 17, "verse": 27, "ayat_id": 16901, "title": "", "ayt_text": "Dia yang menahan perkataannya memiliki pengetahuan, dan dia yang berpengertian memiliki roh yang tenang.", "words": [{"pos": 1, "word_orig": "חוֹשֵׂ֣ךְ", "strong": "H2820", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menahan"}, {"pos": 2, "word_orig": "אֲ֭מָרָי/ו", "strong": "H561", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "perkataannya"}, {"pos": 3, "word_orig": "יוֹדֵ֣עַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memiliki"}, {"pos": 4, "word_orig": "דָּ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 5, "word_orig": "ו/קר", "strong": "H7119", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "yang"}, {"pos": 6, "word_orig": "יְקַר", "strong": "H3368", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "roh"}, {"pos": 7, "word_orig": "ר֝֗וּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "dia"}, {"pos": 8, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "berpengertian"}, {"pos": 9, "word_orig": "תְּבוּנָֽה", "strong": "H8394", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": ""}]}, {"book": 20, "chapter": 17, "verse": 28, "ayat_id": 16902, "title": "", "ayt_text": "Orang bodoh pun, ketika berdiam diri, disangka berhikmat; ketika dia mengatupkan bibirnya, dia disangka berpengertian.", "words": [{"pos": 1, "word_orig": "גַּ֤ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "אֱוִ֣יל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "מַ֭חֲרִישׁ", "strong": "H2790", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "berdiam"}, {"pos": 4, "word_orig": "חָכָ֣ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 5, "word_orig": "יֵחָשֵׁ֑ב", "strong": "H2803", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "disangka"}, {"pos": 6, "word_orig": "אֹטֵ֖ם", "strong": "H331", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengatupkan"}, {"pos": 7, "word_orig": "שְׂפָתָ֣י/ו", "strong": "H8193", "morph": "HNcfdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "bibirnya"}, {"pos": 8, "word_orig": "נָבֽוֹן", "strong": "H995", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "berpengertian"}]}]