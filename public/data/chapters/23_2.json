"strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 22, "word_orig": "וּ/דְבַר", "strong": "H1697", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "firman"}, {"pos": 23, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 24, "word_orig": "מִ/ירוּשָׁלִָֽם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}]}, {"book": 23, "chapter": 2, "verse": 4, "ayat_id": 17690, "title": "", "ayt_text": "Dia akan menjadi hakim di antara bangsa-bangsa dan memutuskan perkara bagi banyak orang. Mereka akan menempa pedang mereka menjadi mata bajak, dan tombak mereka menjadi sabit. Bangsa tidak akan mengangkat pedang melawan bangsa, dan mereka tidak akan lagi belajar berperang.", "words": [{"pos": 1, "word_orig": "וְ/שָׁפַט֙", "strong": "H8199", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "hakim"}, {"pos": 2, "word_orig": "בֵּ֣ין", "strong": "H996", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "antara"}, {"pos": 3, "word_orig": "הַ/גּוֹיִ֔ם", "strong": "H1471", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 4, "word_orig": "וְ/הוֹכִ֖יחַ", "strong": "H3198", "morph": "HC/Vhq3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Orang ke-3 Laki-laki Tunggal", "ayt_word": "perkara"}, {"pos": 5, "word_orig": "לְ/עַמִּ֣ים", "strong": "H5971", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "orang"}, {"pos": 6, "word_orig": "רַבִּ֑ים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "banyak"}, {"pos": 7, "word_orig": "וְ/כִתְּת֨וּ", "strong": "H3807", "morph": "HC/Vpq3cp", "morph_id": "Konjungsi (וְ) + Verba Piel Orang ke-3 Jamak", "ayt_word": "menempa"}, {"pos": 8, "word_orig": "חַרְבוֹתָ֜/ם", "strong": "H2719", "morph": "HNcfpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "pedang"}, {"pos": 9, "word_orig": "לְ/אִתִּ֗ים", "strong": "H855", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "mata"}, {"pos": 10, "word_orig": "וַ/חֲנִיתֽוֹתֵי/הֶם֙", "strong": "H2595", "morph": "HC/Ncfpc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "tombak"}, {"pos": 11, "word_orig": "לְ/מַזְמֵר֔וֹת", "strong": "H4211", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "sabit"}, {"pos": 12, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 13, "word_orig": "יִשָּׂ֨א", "strong": "H5375", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengangkat"}, {"pos": 14, "word_orig": "ג֤וֹי", "strong": "H1471", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Bangsa"}, {"pos": 15, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "melawan"}, {"pos": 16, "word_orig": "גּוֹי֙", "strong": "H1471", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bangsa"}, {"pos": 17, "word_orig": "חֶ֔רֶב", "strong": "H2719", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 18, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 19, "word_orig": "יִלְמְד֥וּ", "strong": "H3925", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "belajar"}, {"pos": 20, "word_orig": "ע֖וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lagi"}, {"pos": 21, "word_orig": "מִלְחָמָֽה", "strong": "H4421", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berperang"}]}, {"book": 23, "chapter": 2, "verse": 5, "ayat_id": 17691, "title": "", "ayt_text": "Hai, keluarga Yakub, mari kita berjalan dalam terang TUHAN.", "words": [{"pos": 1, "word_orig": "בֵּ֖ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keluarga"}, {"pos": 2, "word_orig": "יַעֲקֹ֑ב", "strong": "H3290", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yakub"}, {"pos": 3, "word_orig": "לְכ֥וּ", "strong": "H3212", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "mari"}, {"pos": 4, "word_orig": "וְ/נֵלְכָ֖ה", "strong": "H3212", "morph": "HC/Vqh1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-1 Jamak", "ayt_word": "berjalan"}, {"pos": 5, "word_orig": "בְּ/א֥וֹר", "strong": "H216", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "terang"}, {"pos": 6, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 23, "chapter": 2, "verse": 6, "ayat_id": 17692, "title": "", "ayt_text": "Sebab, Engkau telah meninggalkan umat-Mu, keluarga Yakub, karena mereka dipenuhi dengan pengaruh dari adat ketimuran, mereka peramal seperti orang-orang Filistin, dan mereka bertepuk tangan dengan anak-anak orang asing.", "words": [{"pos": 1, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "נָטַ֗שְׁתָּה", "strong": "H5203", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "meninggalkan"}, {"p