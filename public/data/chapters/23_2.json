ahnya.", "words": [{"pos": 1, "word_orig": "וַ/תִּמָּלֵ֤א", "strong": "H4390", "morph": "HC/VNw3fs", "morph_id": "Konjungsi (וְ) + Verba Nifal Waw Konsekutif Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "penuh"}, {"pos": 2, "word_orig": "אַרְצ/וֹ֙", "strong": "H776", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "Tanah"}, {"pos": 3, "word_orig": "כֶּ֣סֶף", "strong": "H3701", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 4, "word_orig": "וְ/זָהָ֔ב", "strong": "H2091", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 5, "word_orig": "וְ/אֵ֥ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "קֵ֖צֶה", "strong": "H7097", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "batasnya"}, {"pos": 7, "word_orig": "לְ/אֹצְרֹתָ֑י/ו", "strong": "H214", "morph": "HR/Ncmpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "kekayaan"}, {"pos": 8, "word_orig": "וַ/תִּמָּלֵ֤א", "strong": "H4390", "morph": "HC/VNw3fs", "morph_id": "Konjungsi (וְ) + Verba Nifal Waw Konsekutif Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "penuh"}, {"pos": 9, "word_orig": "אַרְצ/וֹ֙", "strong": "H776", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "Tanah"}, {"pos": 10, "word_orig": "סוּסִ֔ים", "strong": "H5483", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kuda"}, {"pos": 11, "word_orig": "וְ/אֵ֥ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 12, "word_orig": "קֵ֖צֶה", "strong": "H7097", "morph