[{"book": 23, "chapter": 2, "verse": 1, "ayat_id": 17687, "title": "Sion sebagai Pusat Kerajaan Damai", "ayt_text": "Inilah firman yang dinyatakan kepada Yesaya, anak Amos, tentang Yehuda dan Yerusalem.", "words": [{"pos": 1, "word_orig": "הַ/דָּבָר֙", "strong": "H1697", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "firman"}, {"pos": 2, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 3, "word_orig": "חָזָ֔ה", "strong": "H2372", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dinyatakan"}, {"pos": 4, "word_orig": "יְשַֽׁעְיָ֖הוּ", "strong": "H3470", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yesaya"}, {"pos": 5, "word_orig": "בֶּן", "strong": "H1121", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "anak"}, {"pos": 6, "word_orig": "אָמ֑וֹץ", "strong": "H531", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Amos"}, {"pos": 7, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "tentang"}, {"pos": 8, "word_orig": "יְהוּדָ֖ה", "strong": "H3063", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yehuda"}, {"pos": 9, "word_orig": "וִ/ירוּשָׁלִָֽם", "strong": "H3389", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Yerusalem"}]}, {"book": 23, "chapter": 2, "verse": 2, "ayat_id": 17688, "title": "", "ayt_text": "Akan terjadi pada hari-hari terakhir, gunung kediaman TUHAN akan didirikan di puncak gunung-gunung; dan akan ditinggikan melebihi bukit-bukit, dan semua bangsa akan beramai-ramai ke sana.", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֣ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "terjadi"}, {"pos": 2, "word_orig": "בְּ/אַחֲרִ֣ית", "strong": "H319", "mor