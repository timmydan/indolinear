si (וְ) + Pp3ms", "ayt_word": "Dialah"}, {"pos": 9, "word_orig": "מַֽעֲרִֽצְ/כֶֽם", "strong": "H6206", "morph": "HVhrmsc/Sp2mp", "morph_id": "Verba Hifil + Sp2mp", "ayt_word": "gentar"}]}, {"book": 23, "chapter": 8, "verse": 14, "ayat_id": 17822, "title": "", "ayt_text": "Kemudian, Dia akan menjadi tempat kudus, tetapi menjadi batu sandungan dan batu yang menjatuhkan bagi kedua keluarga Israel; menjadi perangkap dan jerat bagi penghuni Yerusalem.", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֖ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 2, "word_orig": "לְ/מִקְדָּ֑שׁ", "strong": "H4720", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 3, "word_orig": "וּ/לְ/אֶ֣בֶן", "strong": "H68", "morph": "HC/R/Ncfsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "batu"}, {"pos": 4, "word_orig": "נֶ֠גֶף", "strong": "H5063", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "menjatuhkan"}, {"pos": 5, "word_orig": "וּ/לְ/צ֨וּר", "strong": "H6697", "morph": "HC/R/Ncmsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": ""}, {"pos": 6, "word_orig": "מִכְשׁ֜וֹל", "strong": "H4383", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "batu"}, {"pos": 7, "word_orig": "לִ/שְׁנֵ֨י", "strong": "H8147", "morph": "HR/Acmdc", "morph_id": "Preposisi + Acmdc", "ayt_word": "kedua"}, {"pos": 8, "word_orig": "בָתֵּ֤י", "strong": "H1004", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "keluarga"}, {"pos": 9, "word_orig": "יִשְׂרָאֵל֙", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos