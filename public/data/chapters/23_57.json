annya"}, {"pos": 7, "word_orig": "נְכֹחֽ/וֹ", "strong": "H5228", "morph": "HAamsc/Sp3ms", "morph_id": "Aamsc + Sp3ms", "ayt_word": "lurus"}]}, {"book": 23, "chapter": 57, "verse": 3, "ayat_id": 18769, "title": "", "ayt_text": "“Akan tetapi kamu, mendekatlah kemari, hai anak-anak peramal, keturunan pezina dan pelacur.", "words": [{"pos": 1, "word_orig": "וְ/אַתֶּ֥ם", "strong": "H859", "morph": "HC/Pp2mp", "morph_id": "Konjungsi (וְ) + Pp2mp", "ayt_word": "kamu"}, {"pos": 2, "word_orig": "קִרְבוּ", "strong": "H7126", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "mendekatlah"}, {"pos": 3, "word_orig": "הֵ֖נָּה", "strong": "H2008", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "kemari"}, {"pos": 4, "word_orig": "בְּנֵ֣י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 5, "word_orig": "עֹנְנָ֑ה", "strong": "H6049", "morph": "HVorfsa", "morph_id": "Verba", "ayt_word": "peramal"}, {"pos": 6, "word_orig": "זֶ֥רַע", "strong": "H2233", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keturunan"}, {"pos": 7, "word_orig": "מְנָאֵ֖ף", "strong": "H5003", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "pezina"}, {"pos": 8, "word_orig": "וַ/תִּזְנֶֽה", "strong": "H2181", "morph": "HC/Vqw3fs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "pelacur"}]}, {"book": 23, "chapter": 57, "verse": 4, "ayat_id": 18770, "title": "", "ayt_text": "Siapakah yang kamu ejek? Terhadap siapakah kamu membuka mulut dan menjulurkan lidah? Bukankah kamu anak-anak pemberontak, keturunan pendusta,", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ejek"}, {"pos": 2, "word_orig": "מִי֙", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siap