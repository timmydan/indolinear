3, "title": "", "ayt_text": "Karena kejahatan ketamakannya Aku murka, dan memukul dia. Aku menyembunyikan wajah-Ku dan murka, tetapi, mereka tetap berpaling ke jalan yang dipilih hatinya.", "words": [{"pos": 1, "word_orig": "בַּ/עֲוֺ֥ן", "strong": "H5771", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "kejahatan"}, {"pos": 2, "word_orig": "בִּצְע֛/וֹ", "strong": "H1215", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ketamakannya"}, {"pos": 3, "word_orig": "קָצַ֥פְתִּי", "strong": "H7107", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "murka"}, {"pos": 4, "word_orig": "וְ/אַכֵּ֖/הוּ", "strong": "H5221", "morph": "HC/Vhi1cs/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-1 Tunggal + Sp3ms", "ayt_word": "memukul"}, {"pos": 5, "word_orig": "הַסְתֵּ֣ר", "strong": "H5641", "morph": "HVha", "morph_id": "Verba Hifil Infinitif Absolut", "ayt_word": "menyembunyikan"}, {"pos": 6, "word_orig": "וְ/אֶקְצֹ֑ף", "strong": "H7107", "morph": "HC/Vqi1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "murka"}, {"pos": 7, "word_orig": "וַ/יֵּ֥לֶךְ", "strong": "H3212", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berpaling"}, {"pos": 8, "word_orig": "שׁוֹבָ֖ב", "strong": "H7726", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berpaling"}, {"pos": 9, "word_orig": "בְּ/דֶ֥רֶךְ", "strong": "H1870", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 10, "word_orig": "לִבּֽ/וֹ", "strong": "H3820", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hatinya"}]}, {"book": 23, "chapter": 57, "verse"