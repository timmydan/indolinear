[{"book": 18, "chapter": 22, "verse": 1, "ayat_id": 13391, "title": "Elifas Menasihati Ayub untuk Bertobat", "ayt_text": "Kemudian, Elifas, orang Teman, menjawab, katanya,", "words": [{"pos": 1, "word_orig": "וַ֭/יַּעַן", "strong": "H6030", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjawab"}, {"pos": 2, "word_orig": "אֱלִיפַ֥ז", "strong": "H464", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Elifas"}, {"pos": 3, "word_orig": "הַֽ/תֵּמָנִ֗י", "strong": "H8489", "morph": "HTd/Ngmsa", "morph_id": "Artikel Definit (הַ) + Nomina Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "וַ/יֹּאמַֽר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "katanya"}]}, {"book": 18, "chapter": 22, "verse": 2, "ayat_id": 13392, "title": "", "ayt_text": "“Dapatkah manusia menguntungkan Allah? Tentu, orang yang bijaksana menguntungkan bagi dirinya sendiri?", "words": [{"pos": 1, "word_orig": "הַ/לְ/אֵ֥ל", "strong": "H410", "morph": "HTi/R/Ncmsa", "morph_id": "Ti + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 2, "word_orig": "יִסְכָּן", "strong": "H5532", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menguntungkan"}, {"pos": 3, "word_orig": "גָּ֑בֶר", "strong": "H1397", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 4, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Tentu"}, {"pos": 5, "word_orig": "יִסְכֹּ֖ן", "strong": "H5532", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menguntungkan"}, {"pos": 6, "word_orig": "עָלֵ֣י/מוֹ", "strong": "H5921", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "bagi"}, {"pos": 7, "word_orig": "מַשְׂכִּֽיל", "strong": "H7919", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "orang"}]}, {"book": 18, "chapter": 22, "verse": 3, "ayat_id": 13393, "title": "", "ayt_text": "Apakah menjadi kesenangan bagi Yang Mahakuasa jika kamu ada di sisi yang benar? Apakah ada keuntungan bagi-Nya jika kamu membuat jalan-jalanmu tidak bercela?", "words": [{"pos": 1, "word_orig": "הַ/חֵ֣פֶץ", "strong": "H2656", "morph": "HTi/Ncmsa", "morph_id": "Ti + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesenangan"}, {"pos": 2, "word_orig": "לְ֭/שַׁדַּי", "strong": "H7706", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yang"}, {"pos": 3, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 4, "word_orig": "תִצְדָּ֑ק", "strong": "H6663", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "benar"}, {"pos": 5, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "Apakah"}, {"pos": 6, "word_orig": "בֶּ֝֗צַע", "strong": "H1215", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keuntungan"}, {"pos": 7, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 8, "word_orig": "תַתֵּ֥ם", "strong": "H8552", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "bercela"}, {"pos": 9, "word_orig": "דְּרָכֶֽי/ךָ", "strong": "H1870", "morph": "HNcbpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "jalan-jalanmu"}]}, {"book": 18, "chapter": 22, "verse": 4, "ayat_id": 13394, "title": "", "ayt_text": "Apakah karena ketakutanmu akan Dia sehingga Dia menegurmu, dan masuk ke pengadilan bersamamu?", "words": [{"pos": 1, "word_orig": "הֲֽ֭/מִ/יִּרְאָ֣תְ/ךָ", "strong": "H3374", "morph": "HTi/R/Ncfsc/Sp2ms", "morph_id": "Ti + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "ketakutanmu"}, {"pos": 2, "word_orig": "יֹכִיחֶ֑/ךָ", "strong": "H3198", "morph": "HVhi3ms/Sp2ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp2ms", "ayt_word": "menegurmu"}, {"pos": 3, "word_orig": "יָב֥וֹא", "strong": "H935", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "masuk"}, {"pos": 4, "word_orig": "עִ֝מְּ/ךָ֗", "strong": "H5973", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": "ke"}, {"pos": 5, "word_orig": "בַּ/מִּשְׁפָּֽט", "strong": "H4941", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengadilan"}]}, {"book": 18, "chapter": 22, "verse": 5, "ayat_id": 13395, "title": "", "ayt_text": "Bukankah kefasikanmu besar, dan kesalahan-kesalahanmu tidak terhingga?", "words": [{"pos": 1, "word_orig": "הֲ/לֹ֣א", "strong": "H3808", "morph": "HTi/Tn", "morph_id": "Ti + Tn", "ayt_word": "Bukankah"}, {"pos": 2, "word_orig": "רָעָֽתְ/ךָ֣", "strong": "H7451", "morph": "HNcfsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "kefasikanmu"}, {"pos": 3, "word_orig": "רַבָּ֑ה", "strong": "H7227", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "besar"}, {"pos": 4, "word_orig": "וְ/אֵֽין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "קֵ֝֗ץ", "strong": "H7093", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terhingga"}, {"pos": 6, "word_orig": "לַ/עֲוֺנֹתֶֽי/ךָ", "strong": "H5771", "morph": "HR/Ncbpc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "kesalahan-kesalahanmu"}]}, {"book": 18, "chapter": 22, "verse": 6, "ayat_id": 13396, "title": "", "ayt_text": "Sebab, kamu telah mengambil ikrar saudara-saudaramu tanpa alasan, dan merampas pakaian orang-orang telanjang.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "תַחְבֹּ֣ל", "strong": "H2254", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "ikrar"}, {"pos": 3, "word_orig": "אַחֶ֣י/ךָ", "strong": "H251", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "saudara-saudaramu"}, {"pos": 4, "word_orig": "חִנָּ֑ם", "strong": "H2600", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "tanpa"}, {"pos": 5, "word_orig": "וּ/בִגְדֵ֖י", "strong": "H899", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "pakaian"}, {"pos": 6, "word_orig": "עֲרוּמִּ֣ים", "strong": "H6174", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 7, "word_orig": "תַּפְשִֽׁיט", "strong": "H6584", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "merampas"}]}, {"book": 18, "chapter": 22, "verse": 7, "ayat_id": 13397, "title": "", "ayt_text": "Kamu tidak memberi air untuk minum kepada mereka yang lelah, dan kamu telah menahan roti bagi yang lapar.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "מַ֭יִם", "strong": "H4325", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}, {"pos": 3, "word_orig": "עָיֵ֣ף", "strong": "H5889", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "lelah"}, {"pos": 4, "word_orig": "תַּשְׁקֶ֑ה", "strong": "H8248", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "minum"}, {"pos": 5, "word_orig": "וּ֝/מֵ/רָעֵ֗ב", "strong": "H7457", "morph": "HC/R/Aamsa", "morph_id": "Konjungsi (וְ) + Preposisi + Aamsa", "ayt_word": "lapar"}, {"pos": 6, "word_orig": "תִּֽמְנַֽע", "strong": "H4513", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menahan"}, {"pos": 7, "word_orig": "לָֽחֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "roti"}]}, {"book": 18, "chapter": 22, "verse": 8, "ayat_id": 13398, "title": "", "ayt_text": "Orang yang berkuasa memiliki tanah, dan orang terhormat tinggal di dalamnya.", "words": [{"pos": 1, "word_orig": "וְ/אִ֣ישׁ", "strong": "H376", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "זְ֭רוֹעַ", "strong": "H2220", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "berkuasa"}, {"pos": 3, "word_orig": "ל֣/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 4, "word_orig": "הָ/אָ֑רֶץ", "strong": "H776", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "tanah"}, {"pos": 5, "word_orig": "וּ/נְשׂ֥וּא", "strong": "H5375", "morph": "HC/Vqsmsc", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Pasif", "ayt_word": "terhormat"}, {"pos": 6, "word_orig": "פָ֝נִ֗ים", "strong": "H6440", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "terhormat"}, {"pos": 7, "word_orig": "יֵ֣שֶׁב", "strong": "H3427", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dalamnya"}, {"pos": 8, "word_orig": "בָּֽ/הּ", "strong": "", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}]}, {"book": 18, "chapter": 22, "verse": 9, "ayat_id": 13399, "title": "", "ayt_text": "Kamu telah menyuruh janda-janda pergi dengan tangan hampa, dan lengan anak-anak yatim kauremukkan.", "words": [{"pos": 1, "word_orig": "אַ֭לְמָנוֹת", "strong": "H490", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "janda-janda"}, {"pos": 2, "word_orig": "שִׁלַּ֣חְתָּ", "strong": "H7971", "morph": "HVpp2ms", "morph_id": "Verba Piel Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "pergi"}, {"pos": 3, "word_orig": "רֵיקָ֑ם", "strong": "H7387", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "tangan"}, {"pos": 4, "word_orig": "וּ/זְרֹע֖וֹת", "strong": "H2220", "morph": "HC/Ncbpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "lengan"}, {"pos": 5, "word_orig": "יְתֹמִ֣ים", "strong": "H3490", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "יְדֻכָּֽא", "strong": "H1792", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kauremukkan"}]}, {"book": 18, "chapter": 22, "verse": 10, "ayat_id": 13400, "title": "", "ayt_text": "Itu sebabnya, perangkap ada di sekelilingmu, dan ketakutan yang tiba-tiba mengejutkanmu,", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 2, "word_orig": "כֵּ֭ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "sebabnya"}, {"pos": 3, "word_orig": "סְבִיבוֹתֶ֣י/ךָ", "strong": "H5439", "morph": "HNcbpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "sekelilingmu"}, {"pos": 4, "word_orig": "פַחִ֑ים", "strong": "H6341", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "perangkap"}, {"pos": 5, "word_orig": "וִֽ֝/יבַהֶלְ/ךָ", "strong": "H926", "morph": "HC/Vpi3ms/Sp2ms", "morph_id"