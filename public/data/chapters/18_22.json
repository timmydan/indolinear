, "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "firman-Nya"}, {"pos": 7, "word_orig": "בִּ/לְבָבֶֽ/ךָ", "strong": "H3824", "morph": "HR/Ncmsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "hatimu"}]}, {"book": 18, "chapter": 22, "verse": 23, "ayat_id": 13413, "title": "", "ayt_text": "Jika kamu kembali kepada Yang Mahakuasa, kamu akan dibangunkan. Jika kamu menjauhkan kefasikan dari kemahmu,", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "תָּשׁ֣וּב", "strong": "H7725", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "kembali"}, {"pos": 3, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 4, "word_orig": "שַׁ֭דַּי", "strong": "H7706", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yang"}, {"pos": 5, "word_orig": "תִּבָּנֶ֑ה", "strong": "H1129", "morph": "HVNi2ms", "morph_id": "Verba Nifal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "dibangunkan"}, {"pos": 6, "word_orig": "תַּרְחִ֥יק", "strong": "H7368", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menjauhkan"}, {"pos": 7, "word_orig": "עַ֝וְלָ֗ה", "strong": "H5766", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kefasikan"}, {"pos": 8, "word_orig": "מֵ/אָהֳלֶֽ/ךָ", "strong": "H168", "morph": "HR/Ncmsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "kemahmu"}]}, {"book": 18, "chapter": 22, "verse": 24, "ayat_id": 13414, "title": "", "ayt_text": "jika kamu menaruh emas ke dalam debu, dan emas Ofir di antara batu-batu di sungai kering,", "words": [{"pos": 1, "word_orig": "וְ/שִׁית", "strong": "H7896", "morph": "HC/Vqv2ms", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "menaruh"}, {"pos": 2, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 3, "word_orig": "עָפָ֥ר", "strong": "H6083", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "debu"}, {"pos": 4, "word_orig": "בָּ֑צֶר", "strong": "H1220", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 5, "word_orig": "וּ/בְ/צ֖וּר", "strong": "H6697", "morph": "HC/R/Ncmsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "batu-batu"}, {"pos": 6, "word_orig": "נְחָלִ֣ים", "strong": "H5158", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sungai"}, {"pos": 7, "word_orig": "אוֹפִֽיר", "strong": "H211", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ofir"}]}, {"book": 18, "chapter": 22, "verse": 25, "ayat_id": 13415, "title": "", "ayt_text": "Yang Mahakuasa akan menjadi emasmu dan perakmu yang berharga.", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֣ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 2, "word_orig": "שַׁדַּ֣י", "strong": "H7706", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yang"}, {"pos": 3, "word_orig": "בְּצָרֶ֑י/ךָ", "strong": "H1220", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "emasmu"}, {"pos": 4, "word_orig": "וְ/כֶ֖סֶף", "strong": "H3701", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "perakmu"}, {"pos": 5, "word_orig": "תּוֹעָפ֣וֹת", "strong": "H8443", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "berharga"}, {"pos": 6, "word_orig": "לָֽ/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}]}, {"book": 18, "chapter": 22, "verse": 26, "ayat_id": 13416, "title": "", "ayt_text": "Dengan begitu, kamu akan bergembira dalam Yang Mahakuasa, dan akan mengangkat wajahmu kepada Allah.", "words": [{"pos": 1, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "אָ֭ז", "strong": "H227", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "begitu"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 4, "word_orig": "שַׁדַּ֣י", "strong": "H7706", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yang"}, {"pos": 5, "word_orig": "תִּתְעַנָּ֑ג", "strong": "H6026", "morph": "HVti2ms", "morph_id": "Verba Hitpael Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "bergembira"}, {"pos": 6, "word_orig": "וְ/תִשָּׂ֖א", "strong": "H5375", "morph": "HC/Vqi2ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengangkat"}, {"pos": 7, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 8, "word_orig": "אֱל֣וֹהַּ", "strong": "H433", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 9, "word_orig": "פָּנֶֽי/ךָ", "strong": "H6440", "morph": "HNcbpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "wajahmu"}]}, {"book": 18, "chapter": 22, "verse": 27, "ayat_id": 13417, "title": "", "ayt_text": "Kamu akan berdoa kepada-Nya, dan Dia akan mendengarmu, dan kamu akan membayar nazar-nazarmu.", "words": [{"pos": 1, "word_orig": "תַּעְתִּ֣יר", "strong": "H6279", "morph": "HVhi2ms", "morph_id": "Verba Hifil Imperfe