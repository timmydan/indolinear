 "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "הַ/בְעַ֖ד", "strong": "H1157", "morph": "HTi/R", "morph_id": "Ti + Preposisi", "ayt_word": "melalui"}, {"pos": 6, "word_orig": "עֲרָפֶ֣ל", "strong": "H6205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}, {"pos": 7, "word_orig": "יִשְׁפּֽוֹט", "strong": "H8199", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghakimi"}]}, {"book": 18, "chapter": 22, "verse": 14, "ayat_id": 13404, "title": "", "ayt_text": "Awan-awan tebal menyelubungi-Nya sehingga Dia tidak melihat kita, dan Dia berjalan di kolong langit.’", "words": [{"pos": 1, "word_orig": "עָבִ֣ים", "strong": "H5645", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "tebal"}, {"pos": 2, "word_orig": "סֵֽתֶר", "strong": "H5643", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "menyelubungi-Nya"}, {"pos": 3, "word_orig": "ל֭/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 4, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "יִרְאֶ֑ה", "strong": "H7200", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melihat"}, {"pos": 6, "word_orig": "וְ/ח֥וּג", "strong": "H2329", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kolong"}, {"pos": 7, "word_orig": "שָׁ֝מַ֗יִם", "strong": "H8064", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 8, "word_orig": "יִתְהַלָּֽךְ", "strong": "H1980", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berjalan"}]}, {"book": 18, "chapter": 22, "verse": 15, "ayat_id": 13405, "title": "", "ayt_text": "Akankah kamu tetap menuruti jalan yang lama, yang dilewati oleh orang-orang jahat?", "words": [{"pos": 1, "word_orig": "הַ/אֹ֣רַח", "strong": "H734", "morph": "HTi/Ncbsc", "morph_id": "Ti + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 2, "word_orig": "עוֹלָ֣ם", "strong": "H5769", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "lama"}, {"pos": 3, "word_orig": "תִּשְׁמֹ֑ר", "strong": "H8104", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menuruti"}, {"pos": 4, "word_orig": "אֲשֶׁ֖ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 5, "word_orig": "דָּרְכ֣וּ", "strong": "H1869", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "dilewati"}, {"pos": 6, "word_orig": "מְתֵי", "strong": "H4962", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "orang-orang"}, {"pos": 7, "word_orig": "אָֽוֶן", "strong": "H205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "jahat"}]}, {"book": 18, "chapter": 22, "verse": 16, "ayat_id": 13406, "title": "", "ayt_text": "Siapa yang ditangkap sebelum waktu mereka, dan dasar-dasar siapa yang dihanyutkan oleh banjir?", "words": [{"pos": 1, "word_orig": "אֲשֶֽׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 2, "word_orig": "קֻמְּט֥וּ", "strong": "H7059", "morph": "HVPp3cp", "morph_id": "Verba Pual Perfek Orang ke-3 Jamak", "ayt_word": "ditangkap"}, {"pos": 3, "word_orig": "וְ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "sebelum"}, {"pos": 4, "word_orig": "עֵ֑ת", "strong": "H6256", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 5, "word_orig": "נָ֝הָ֗ר", "strong": "H5104", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "banjir"}, {"pos": 6, "word_orig": "יוּצַ֥ק", "strong": "H3332", "morph": "HVHi3ms", "morph_id": "Verba", "ayt_word": "dihanyutkan"}, {"pos": 7, "word_orig": "יְסוֹדָֽ/ם", "strong": "H3247", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "dasar-dasar"}]}, {"book": 18, "chapter": 22, "verse": 17, "ayat_id": 13407, "title": "", "ayt_text": "Mereka berkata kepada Allah, ‘Tinggalkanlah kami!’ dan, ‘Apa yang bisa diperbuat oleh Yang Mahakuasa terhadap kami?’", "words": [{"pos": 1, "word_orig": "הָ/אֹמְרִ֣ים", "strong": "H559", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "berkata"}, {"pos": 2, "word_orig": "לָ֭/אֵל", "strong": "H410", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "ס֣וּר", "strong": "H5493", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Tinggalkanlah"}, {"pos": 4, "word_orig": "מִמֶּ֑/נּוּ", "strong": "H4480", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": ""}, {"pos": 5, "word_orig": "וּ/מַה", "strong": "H4100", "morph": "HC/Ti", "morph_id": "Konjungsi (וְ) + Ti", "ayt_word": "Apa"}, {"pos": 6, "word_orig": "יִּפְעַ֖ל", "strong": "H6466", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diperbuat"}, {"pos": 7, "word_orig": "שַׁדַּ֣י", "strong": "H7706", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Mahakuasa"}, {"pos": 8, "word_orig": "לָֽ/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 18, "chapter": 22, "verse": 18, "ayat_id": 13408, "title": "", "ayt_text": "Akan tetapi, Dia memenuhi rumah mereka dengan hal-hal yang baik. Namun, nasihat orang fasik jauh dariku.", "words": [{"pos": 1, "word_orig": "וְ/ה֤וּא", "strong": "H1931", "morph": "HC/Pp3ms", "morph_id": "Konjungsi (וְ) + Pp3ms", "ayt_word": "Dia"}, {"pos": 2, "word_orig": "מִלֵּ֣א", "strong": "H4390", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memenuhi"}, {"pos": 3, "word_orig": "בָתֵּי/הֶ֣ם", "strong": "H1004", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "rumah"}, {"pos": 4, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "וַ/עֲצַ֥ת", "strong": "H6098", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "nasihat"}, {"pos": 6, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "רָ֣חֲקָה", "strong": "H7368", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "jauh"}, {"pos": 8, "word_orig": "מֶֽ/נִּי", "strong": "H4480", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "dariku"}]}, {"book": 18, "chapter": 22, "verse": 19, "ayat_id": 13409, "title": "", "ayt_text": "Orang benar melihatnya, dan bersukaria, dan orang-orang tidak bersalah mengejek mereka, katanya,", "words": [{"pos": 1, "word_orig": "יִרְא֣וּ", "strong": "H7200", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "melihatnya"}, {"pos": 2, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "וְ/יִשְׂמָ֑חוּ", "strong": "H8055", "morph": "HC/Vqi3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bersukaria"}, {"pos": 4, "word_orig": "וְ֝/נָקִ֗י", "strong": "H5355", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "יִלְעַג", "strong": "H3932", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengejek"}, {"pos": 6, "word_orig": "לָֽ/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 18, "chapter": 22, "verse": 20, "ayat_id": 13410, "title": "", "ayt_text": "‘Benar, musuh-musuh kami sudah dihancurkan, dan api memakan sisa-sisa yang mereka tinggalkan!’", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": ""}, {"pos": 3, "word_orig": "נִכְחַ֣ד", "strong": "H3582", "morph": "HVNp3ms", "morph_id": "Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dihancurkan"}, {"pos": 4, "word_orig": "קִימָ֑/נוּ", "strong": "H7009", "morph": "HNcmsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "musuh-musuh"}, {"pos": 5, "word_orig": "וְ֝/יִתְרָ֗/ם", "strong": "H3499", "morph": "HC/Ncmsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "tinggalkan"}, {"pos": 6, "word_orig": "אָ֣כְלָה", "strong": "H398", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "memakan"}, {"pos": 7, "word_orig": "אֵֽשׁ", "strong": "H784", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "api"}]}, {"book": 18, "chapter": 22, "verse": 21, "ayat_id": 13411, "title": "", "ayt_text": "Menyerahlah kepada Allah, dan berdamailah. Dengan cara ini, kebaikan akan datang kepadamu.", "words": [{"pos": 1, "word_orig": "הַסְכֶּן", "strong": "H5532", "morph": "HVhv2ms", "morph_id"