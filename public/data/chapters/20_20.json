h": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 7, "word_orig": "יִתְגַּלָּֽע", "strong": "H1566", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "cepat"}]}, {"book": 20, "chapter": 20, "verse": 4, "ayat_id": 16959, "title": "", "ayt_text": "Pemalas tidak membajak pada musim dingin; dia akan mencari pada musim menuai, dan tidak mendapat apa-apa.", "words": [{"pos": 1, "word_orig": "מֵ֭/חֹרֶף", "strong": "H2779", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "musim"}, {"pos": 2, "word_orig": "עָצֵ֣ל", "strong": "H6102", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Pemalas"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יַחֲרֹ֑שׁ", "strong": "H2790", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membajak"}, {"pos": 5, "word_orig": "ישאל", "strong": "H7592", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencari"}, {"pos": 6, "word_orig": "וְ/שָׁאַ֖ל", "strong": "H7592", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menuai"}, {"pos": 7, "word_orig": "בַּ/קָּצִ֣יר", "strong": "H7105", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "וָ/אָֽיִן", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": ""}]}, {"book": 20, "chapter": 20, "verse": 5, "ayat_id": 16960, "title": "", "ayt_text": "Rancangan dalam hati manusia itu seperti air yang dalam, tetapi orang berpengertian akan menimbanya.", "words": [{"pos": 1, "word_orig": "מַ֣יִם", "strong": "H4325", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}, {"pos": 2, "word_or