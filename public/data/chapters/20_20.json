: "H5869", "morph": "HNcbdc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2ms", "ayt_word": "matamu"}, {"pos": 8, "word_orig": "שְֽׂבַֽע", "strong": "H7646", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "kenyang"}, {"pos": 9, "word_orig": "לָֽחֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}]}, {"book": 20, "chapter": 20, "verse": 14, "ayat_id": 16969, "title": "", "ayt_text": "“Jelek, jelek,” kata pembeli, tetapi sesudah dia pergi, dia membanggakan diri.", "words": [{"pos": 1, "word_orig": "רַ֣ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Jelek"}, {"pos": 2, "word_orig": "רַ֭ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jelek"}, {"pos": 3, "word_orig": "יֹאמַ֣ר", "strong": "H559", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kata"}, {"pos": 4, "word_orig": "הַ/קּוֹנֶ֑ה", "strong": "H7069", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "pembeli"}, {"pos": 5, "word_orig": "וְ/אֹזֵ֥ל", "strong": "H235", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "pergi"}, {"pos": 6, "word_orig": "ל֝֗/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 7, "word_orig": "אָ֣ז", "strong": "H227", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "sesudah"}, {"pos": 8, "word_orig": "יִתְהַלָּֽל", "strong": "H1984", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membanggakan"}]}, {"book": 20, "chapter": 20, "verse": 15, "ayat_id": 16970, "title": "", "ayt_text": "Ada emas dan batu permata yang melimpah, tetapi bibir berpengetahuan adalah permata yang berharga.", "words": [{"pos": 1, "word_orig": "יֵ֣שׁ", "strong": "H3426", "mor