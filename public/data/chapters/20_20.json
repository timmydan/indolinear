Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulutnya"}, {"pos": 8, "word_orig": "חָצָֽץ", "strong": "H2687", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kerikil"}]}, {"book": 20, "chapter": 20, "verse": 18, "ayat_id": 16973, "title": "", "ayt_text": "Rancangan teguh karena pertimbangan; karena itu, lakukanlah peperangan dengan tuntunan.", "words": [{"pos": 1, "word_orig": "מַ֭חֲשָׁבוֹת", "strong": "H4284", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Rancangan"}, {"pos": 2, "word_orig": "בְּ/עֵצָ֣ה", "strong": "H6098", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pertimbangan"}, {"pos": 3, "word_orig": "תִכּ֑וֹן", "strong": "H3559", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "teguh"}, {"pos": 4, "word_orig": "וּ֝/בְ/תַחְבֻּל֗וֹת", "strong": "H8458", "morph": "HC/R/Ncfpa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "tuntunan"}, {"pos": 5, "word_orig": "עֲשֵׂ֣ה", "strong": "H6213", "morph": "HVqv2ms", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "lakukanlah"}, {"pos": 6, "word_orig": "מִלְחָמָֽה", "strong": "H4421", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "peperangan"}]}, {"book": 20, "chapter": 20, "verse": 19, "ayat_id": 16974, "title": "", "ayt_text": "Dia yang berjalan-jalan menyebarkan fitnah membuka rahasia; karena itu, jangan bergaul dengan orang yang bibirnya bocor.", "words": [{"pos": 1, "word_orig": "גּֽוֹלֶה", "strong": "H1540", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membuka"}, {"pos": 2, "word_orig": "סּ֭וֹד", "strong": "H5475", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki T