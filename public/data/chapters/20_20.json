h_id": "Acmdc + Sp3mp", "ayt_word": "keduanya"}]}, {"book": 20, "chapter": 20, "verse": 11, "ayat_id": 16966, "title": "", "ayt_text": "Anak-anak pun dikenal melalui perbuatannya, apakah dia murni, dan apakah dia jujur.", "words": [{"pos": 1, "word_orig": "גַּ֣ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "pun"}, {"pos": 2, "word_orig": "בְּ֭/מַעֲלָלָי/ו", "strong": "H4611", "morph": "HR/Ncmpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "perbuatannya"}, {"pos": 3, "word_orig": "יִתְנַכֶּר", "strong": "H5234", "morph": "HVti3ms", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dikenal"}, {"pos": 4, "word_orig": "נָ֑עַר", "strong": "H5288", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Anak-anak"}, {"pos": 5, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "apakah"}, {"pos": 6, "word_orig": "זַ֖ךְ", "strong": "H2134", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "murni"}, {"pos": 7, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "apakah"}, {"pos": 8, "word_orig": "יָשָׁ֣ר", "strong": "H3477", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jujur"}, {"pos": 9, "word_orig": "פָּעֳלֽ/וֹ", "strong": "H6467", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 20, "verse": 12, "ayat_id": 16967, "title": "", "ayt_text": "Telinga yang mendengar dan mata yang melihat, TUHAN pula yang telah menjadikan keduanya.", "words": [{"pos": 1, "word_orig": "אֹ֣זֶן", "strong": "H241", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Telinga"}, {"pos": 2, "word_orig": "שֹׁ֭מַעַת", "strong": "H8085", "morph": "HVqrfsa", "morph_id": "Verb