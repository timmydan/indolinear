6963, "title": "", "ayt_text": "Raja yang duduk di atas takhta pengadilan menyerakkan semua yang jahat dengan matanya.", "words": [{"pos": 1, "word_orig": "מֶ֗לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Raja"}, {"pos": 2, "word_orig": "יוֹשֵׁ֥ב", "strong": "H3427", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "duduk"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 4, "word_orig": "כִּסֵּא", "strong": "H3678", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "takhta"}, {"pos": 5, "word_orig": "דִ֑ין", "strong": "H1779", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengadilan"}, {"pos": 6, "word_orig": "מְזָרֶ֖ה", "strong": "H2219", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menyerakkan"}, {"pos": 7, "word_orig": "בְ/עֵינָ֣י/ו", "strong": "H5869", "morph": "HR/Ncbdc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "matanya"}, {"pos": 8, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 9, "word_orig": "רָֽע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}]}, {"book": 20, "chapter": 20, "verse": 9, "ayat_id": 16964, "title": "", "ayt_text": "Siapa dapat berkata, “Aku telah membersihkan hatiku; aku bersih dari dosaku”?", "words": [{"pos": 1, "word_orig": "מִֽי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapa"}, {"pos": 2, "word_orig": "יֹ֭אמַר", "strong": "H559", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berkata"}, {"pos": 3, "word_orig": "זִכִּ֣יתִי", "strong": "H2135", "morph": "H