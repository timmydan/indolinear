ְ) + Verba Qal", "ayt_word": "percaya"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 7, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "יְדֻשָּֽׁן", "strong": "H1878", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kelimpahan"}]}, {"book": 20, "chapter": 28, "verse": 26, "ayat_id": 17223, "title": "", "ayt_text": "Orang yang percaya kepada hatinya sendiri adalah orang bodoh, tetapi orang yang berjalan dalam hikmat, dia akan diselamatkan.", "words": [{"pos": 1, "word_orig": "בּוֹטֵ֣חַ", "strong": "H982", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "percaya"}, {"pos": 2, "word_orig": "בְּ֭/לִבּ/וֹ", "strong": "H3820", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hatinya"}, {"pos": 3, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "adalah"}, {"pos": 4, "word_orig": "כְסִ֑יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "וְ/הוֹלֵ֥ךְ", "strong": "H1980", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "berjalan"}, {"pos": 6, "word_orig": "בְּ֝/חָכְמָ֗ה", "strong": "H2451", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 7, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "dia"}, {"pos": 8, "word_orig": "יִמָּלֵֽט", "strong": "H4422", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diselamatkan"}]}, {"book": 20, "chapter": 28, "verse": 27, "ayat_id": 17224, "title": "", "ayt_text": "Orang yang memberi kepada orang miskin tidak akan kekurangan, tetapi sia