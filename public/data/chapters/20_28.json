[{"book": 20, "chapter": 28, "verse": 1, "ayat_id": 17198, "title": "", "ayt_text": "Orang fasik melarikan diri walaupun tidak ada yang mengejarnya, tetapi orang benar merasa berani seperti singa muda.", "words": [{"pos": 1, "word_orig": "נָ֣סוּ", "strong": "H5127", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "diri"}, {"pos": 2, "word_orig": "וְ/אֵין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "ada"}, {"pos": 3, "word_orig": "רֹדֵ֣ף", "strong": "H7291", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengejarnya"}, {"pos": 4, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "fasik"}, {"pos": 5, "word_orig": "וְ֝/צַדִּיקִ֗ים", "strong": "H6662", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "כִּ/כְפִ֥יר", "strong": "H3715", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "muda"}, {"pos": 7, "word_orig": "יִבְטָֽח", "strong": "H982", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berani"}]}, {"book": 20, "chapter": 28, "verse": 2, "ayat_id": 17199, "title": "", "ayt_text": "Ketika suatu negeri memberontak, ada banyak penguasanya, tetapi dengan orang yang berpengertian dan berpengetahuan, negeri itu akan tetap bertahan.", "words": [{"pos": 1, "word_orig": "בְּ/פֶ֣שַֽׁע", "strong": "H6588", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "memberontak"}, {"pos": 2, "word_orig": "אֶ֭רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}, {"pos": 3, "word_orig": "רַבִּ֣ים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "banyak"}, {"pos": 4, "word_orig": "שָׂרֶ֑י/הָ", "strong": "H8269", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "penguasanya"}, {"pos": 5, "word_orig": "וּ/בְ/אָדָ֥ם", "strong": "H120", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 6, "word_orig": "מֵבִ֥ין", "strong": "H995", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "berpengertian"}, {"pos": 7, "word_orig": "יֹ֝דֵ֗עַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berpengetahuan"}, {"pos": 8, "word_orig": "כֵּ֣ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "itu"}, {"pos": 9, "word_orig": "יַאֲרִֽיךְ", "strong": "H748", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertahan"}]}, {"book": 20, "chapter": 28, "verse": 3, "ayat_id": 17200, "title": "", "ayt_text": "Orang miskin yang menindas orang lemah bagaikan hujan deras yang tidak menyisakan makanan.", "words": [{"pos": 1, "word_orig": "גֶּ֣בֶר", "strong": "H1397", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "רָ֭שׁ", "strong": "H7326", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "miskin"}, {"pos": 3, "word_orig": "וְ/עֹשֵׁ֣ק", "strong": "H6231", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menindas"}, {"pos": 4, "word_orig": "דַּלִּ֑ים", "strong": "H1800", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "מָטָ֥ר", "strong": "H4306", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hujan"}, {"pos": 6, "word_orig": "סֹ֝חֵ֗ף", "strong": "H5502", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "deras"}, {"pos": 7, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "לָֽחֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}]}, {"book": 20, "chapter": 28, "verse": 4, "ayat_id": 17201, "title": "", "ayt_text": "Orang yang mengabaikan hukum memuji orang fasik, tetapi orang yang memelihara hukum melawan mereka.", "words": [{"pos": 1, "word_orig": "עֹזְבֵ֣י", "strong": "H5800", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "mengabaikan"}, {"pos": 2, "word_orig": "ת֭וֹרָה", "strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 3, "word_orig": "יְהַֽלְל֣וּ", "strong": "H1984", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memuji"}, {"pos": 4, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "וְ/שֹׁמְרֵ֥י", "strong": "H8104", "morph": "HC/Vqrmpc", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "memelihara"}, {"pos": 6, "word_orig": "ת֝וֹרָ֗ה", "strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 7, "word_orig": "יִתְגָּ֥רוּ", "strong": "H1624", "morph": "HVti3mp", "morph_id": "Verba Hitpael Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "melawan"}, {"pos": 8, "word_orig": "בָֽ/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 20, "chapter": 28, "verse": 5, "ayat_id": 17202, "title": "", "ayt_text": "Orang jahat tidak mengerti keadilan, tetapi mereka yang mencari TUHAN mengerti segala sesuatu.", "words": [{"pos": 1, "word_orig": "אַנְשֵׁי", "strong": "H376", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "רָ֭ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יָבִ֣ינוּ", "strong": "H995", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mengerti"}, {"pos": 5, "word_orig": "מִשְׁפָּ֑ט", "strong": "H4941", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 6, "word_orig": "וּ/מְבַקְשֵׁ֥י", "strong": "H1245", "morph": "HC/Vprmpc", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "mencari"}, {"pos": 7, "word_orig": "יְ֝הוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "יָבִ֥ינוּ", "strong": "H995", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mengerti"}, {"pos": 9, "word_orig": "כֹֽל", "strong": "H3605", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "segala"}]}, {"book": 20, "chapter": 28, "verse": 6, "ayat_id": 17203, "title": "", "ayt_text": "Lebih baik orang miskin yang berjalan dalam kejujuran daripada orang kaya yang bengkok jalannya.", "words": [{"pos": 1, "word_orig": "טֽוֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 2, "word_orig": "רָ֭שׁ", "strong": "H7326", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "miskin"}, {"pos": 3, "word_orig": "הוֹלֵ֣ךְ", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berjalan"}, {"pos": 4, "word_orig": "בְּ/תֻמּ֑/וֹ", "strong": "H8537", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kejujuran"}, {"pos": 5, "word_orig": "מֵ/עִקֵּ֥שׁ", "strong": "H6141", "morph": "HR/Aamsc", "morph_id": "Preposisi + Aamsc", "ayt_word": "bengkok"}, {"pos": 6, "word_orig": "דְּ֝רָכַ֗יִם", "strong": "H1870", "morph": "HNcbda", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Absolut", "ayt_word": "jalannya"}, {"pos": 7, "word_orig": "וְ/ה֣וּא", "strong": "H1931", "morph": "HC/Pp3ms", "morph_id": "Konjungsi (וְ) + Pp3ms", "ayt_word": ""}, {"pos": 8, "word_orig": "עָשִֽׁיר", "strong": "H6223", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 20, "chapter": 28, "verse": 7, "ayat_id": 17204, "title": "", "ayt_text": "Orang yang memelihara hukum adalah anak yang berpengertian, tetapi siapa bergaul dengan orang yang rakus mempermalukan ayahnya.", "words": [{"pos": 1, "word_orig": "נוֹצֵ֣ר", "strong": "H5341", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memelihara"}, {"pos": 2, "word_orig": "תּ֭וֹרָה", "strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 3, "word_orig": "בֵּ֣ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 4, "word_orig": "מֵבִ֑ין", "strong": "H995", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "berpengertian"}, {"pos": 5, "word_orig": "וְ/רֹעֶה", "strong": "H7462", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "bergaul"}, {"pos": 6, "word_orig": "זֽ֝וֹלְלִ֗ים", "strong": "H2151", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "rakus"}, {"pos": 7, "word_orig": "יַכְלִ֥ים", "strong": "H3637", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mempermalukan"}, {"pos": 8, "word_orig": "אָבִֽי/ו", "strong": "H1", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ayahnya"}]}, {"book": 20, "chapter": 28, "verse": 8, "ayat_id": 17205, "title": "", "ayt_text": "Orang yang memperbanyak hartanya dengan riba dan bunga uang mengumpulkannya bagi orang yang berbelaskasihan kepada orang miskin.", "words": [{"pos": 1, "word_orig": "מַרְבֶּ֣ה", "strong": "H7235", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memperbanyak"}, {"pos": 2, "word_orig": "ה֭וֹנ/וֹ", "strong": "H1952", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hartanya"}, {"pos": 3, "word_orig": "בְּ/נֶ֣שֶׁךְ", "strong": "H5392", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "riba"}, {"pos": 4, "word_orig": "ו/ב/תרבית", "strong": "H8636", "morph": "HC/R/Ncfsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bunga"}, {"pos": 5, "word_orig": "וְ/תַרְבִּ֑ית", "strong": "H8636", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berbelaskasihan"}, {"pos": 6, "word_orig": "לְ/חוֹנֵ֖ן", "strong": "H2603", "morph": "HR/Vqrmsa", "morph_id": "Preposisi + Verba Qal", "ayt_word": "orang"}, {"pos": 7, "word_orig": "דַּלִּ֣ים", "strong": "H1800", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "mengumpulkannya"}, {"pos": 8, "word_orig": "יִקְבְּצֶֽ/נּוּ", "strong": "H6908", "morph": "HVqi3ms/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": ""}]}, {"book": 20, "chapter": 28, "verse": 9, "ayat_id": 17206, "title": "", "ayt_text": "Orang yang memalingkan telinganya dari mendengarkan hukum, bahkan doanya adalah kekejian.", "words": [{"pos": 1, "word_orig": "מֵסִ֣יר", "strong": "H5493", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "memalingkan"}, {"pos": 2, "word_orig": "אָ֭זְנ/וֹ", "strong": "H241", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "telinganya"}, {"pos": 3, "word_orig": "מִ/שְּׁמֹ֣עַ", "strong": "H8085", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mendengarkan"}, {"pos": 4, "word_orig": "תּוֹרָ֑ה", "strong": "H8451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hukum"}, {"pos": 5, "word_orig": "גַּֽם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "bahkan"}, {"pos": 6, "word_orig": "תְּ֝פִלָּת֗/וֹ", "strong": "H8605", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "doanya"}, {"pos": 7, "word_orig": "תּוֹעֵבָֽה", "strong": "H8441", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kekejian"}]}, {"book": 20, "chapter": 28, "verse": 10, "ayat_id": 17207, "title": "", "ayt_text": "Orang yang menyesatkan orang jujur ke jalan yang jahat akan jatuh ke lubangnya sendiri, tetapi orang yang tidak bercela akan mewarisi kebaikan.", "words": [{"pos": 1, "word_orig": "מַשְׁגֶּ֤ה", "strong": "H7686", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menyesatkan"}, {"pos": 2, "word_orig": "יְשָׁרִ֨ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "בְּ/דֶ֥רֶךְ", "strong": "H1870", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 4, "word_orig": "רָ֗ע", "strong": "H7451", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "jahat"}, {"pos": 5, "word_orig": "בִּ/שְׁחוּת֥/וֹ", "strong": "H7816", "morph": "HR/Ncfsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "lubangnya"}, {"pos": 6, "word_orig": "הֽוּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "sendiri"}, {"pos": 7, "word_orig": "יִפּ֑וֹל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}, {"pos": 8, "word_orig": "וּ֝/תְמִימִ֗ים", "strong": "H8549", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "bercela"}, {"pos": 9, "word_orig": "יִנְחֲלוּ", "strong": "H5157", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mewarisi"}, {"pos": 10, "word_orig": "טֽוֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kebaikan"}]}, {"book": 20, "chapter": 28, "verse": 11, "ayat_id": 17208, "title": "", "ayt_text": "Orang kaya itu berhikmat menurut pandangannya sendiri, tetapi orang miskin yang berpengertian menyelidiki dia.", "words": [{"pos": 1, "word_orig": "חָכָ֣ם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 2, "word_orig": "בְּ֭/עֵינָי/ו", "strong": "H5869", "morph": "HR/Ncbdc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "pandangannya"}, {"pos": 3, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 4, "word_orig": "עָשִׁ֑יר", "strong": "H6223", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kaya"}, {"pos": 5, "word_orig": "וְ/דַ֖ל", "strong": "H1800", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "miskin"}, {"pos": 6, "word_orig": "מֵבִ֣ין", "strong": "H995", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "berpengertian"}, {"pos": 7, "word_orig": "יַחְקְרֶֽ/נּוּ", "strong": "H2713", "morph": "HVqi3ms/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "menyelidiki"}]}, {"book": 20, "chapter": 28, "verse": 12, "ayat_id": 17209, "title": "", "ayt_text": "Ketika orang benar menang, ada kemuliaan besar, tetapi ketika orang fasik bangkit, orang-orang menyembunyikan dirinya.", "words": [{"pos": 1, "word_orig": "בַּ/עֲלֹ֣ץ", "strong": "H5970", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "menang"}, {"pos": 2, "word_orig": "צַ֭דִּיקִים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "רַבָּ֣ה", "strong": "H7227", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "besar"}, {"pos": 4, "word_orig": "תִפְאָ֑רֶת", "strong": "H8597", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kemuliaan"}, {"pos": 5, "word_orig": "וּ/בְ/ק֥וּם", "strong": "H6965", "morph": "HC/R/Vqc", "morph_id": "Konjungsi (וְ) + Preposisi + Verba Qal Imperatif", "ayt_word": "bangkit"}, {"pos": 6, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 7, "word_orig": "יְחֻפַּ֥שׂ", "strong": "H2664", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyembunyikan"}, {"pos": 8, "word_orig": "אָדָֽם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang-orang"}]}, {"book": 20, "chapter": 28, "verse": 13, "ayat_id": 17210, "title": "", "ayt_text": "Orang yang menyembunyikan pelanggarannya tidak akan beruntung, tetapi orang yang mengakui dan meninggalkannya akan beroleh belas kasihan.", "words": [{"pos": 1, "word_orig": "מְכַסֶּ֣ה", "strong": "H3680", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menyembunyikan"}, {"pos": 2, "word_orig": "פְ֭שָׁעָי/ו", "strong": "H6588", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "pelanggarannya"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יַצְלִ֑יחַ", "strong": "H6743", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "beruntung"}, {"pos": 5, "word_orig": "וּ/מוֹדֶ֖ה", "strong": "H3034", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "mengakui"}, {"pos": 6, "word_orig": "וְ/עֹזֵ֣ב", "strong": "H5800", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "meninggalkannya"}, {"pos": 7, "word_orig": "יְרֻחָֽם", "strong": "H7355", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "belas"}]}, {"book": 20, "chapter": 28, "verse": 14, "ayat_id": 17211, "title": "", "ayt_text": "Berbahagialah orang yang senantiasa waspada, tetapi orang yang mengeraskan hatinya akan jatuh ke dalam kejahatan.", "words": [{"pos": 1, "word_orig": "אַשְׁרֵ֣י", "strong": "H835", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Berbahagialah"}, {"pos": 2, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 3, "word_orig": "מְפַחֵ֣ד", "strong": "H6342", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "waspada"}, {"pos": 4, "word_orig": "תָּמִ֑יד", "strong": "H8548", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "senantiasa"}, {"pos": 5, "word_orig": "וּ/מַקְשֶׁ֥ה", "strong": "H7185", "morph": "HC/Vhrmsa", "morph_id": "Konjungsi (וְ) + Verba Hifil", "ayt_word": "mengeraskan"}, {"pos": 6, "word_orig": "לִ֝בּ֗/וֹ", "strong": "H3820", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hatinya"}, {"pos": 7, "word_orig": "יִפּ֥וֹל", "strong": "H5307", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jatuh"}, {"pos": 8, "word_orig": "בְּ/רָעָֽה", "strong": "H7451", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kejahatan"}]}, {"book": 20, "chapter": 28, "verse": 15, "ayat_id": 17212, "title": "", "ayt_text": "Bagaikan singa yang meraung atau beruang yang menyerbu, seperti itulah orang fasik yang memerintah atas rakyat miskin.", "words": [{"pos": 1, "word_orig": "אֲרִי", "strong": "H738", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "singa"}, {"pos": 2, "word_orig": "נֹ֭הֵם", "strong": "H5098", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "meraung"}, {"pos": 3, "word_orig": "וְ/דֹ֣ב", "strong": "H1677", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "beruang"}, {"pos": 4, "word_orig": "שׁוֹקֵ֑ק", "strong": "H8264", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyerbu"}, {"pos": 5, "word_orig": "מֹשֵׁ֥ל", "strong": "H4910", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "memerintah"}, {"pos": 6, "word_orig": "רָ֝שָׁ֗ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "עַ֣ל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 8, "word_orig": "עַם", "strong": "H5971", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rakyat"}, {"pos": 9, "word_orig": "דָּֽל", "strong": "H1800", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "miskin"}]}, {"book": 20, "chapter": 28, "verse": 16, "ayat_id": 17213, "title": "", "ayt_text": "Seorang pemimpin yang kekurangan pengertian adalah seorang penindas besar, tetapi orang yang membenci laba yang tidak jujur memperpanjang hari-harinya.", "words": [{"pos": 1, "word_orig": "נָגִ֗יד", "strong": "H5057", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pemimpin"}, {"pos": 2, "word_orig": "חֲסַ֣ר", "strong": "H2638", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "kekurangan"}, {"pos": 3, "word_orig": "תְּ֭בוּנוֹת", "strong": "H8394", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "pengertian"}, {"pos": 4, "word_orig": "וְ/רַ֥ב", "strong": "H7227", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "besar"}, {"pos": 5, "word_orig": "מַעֲשַׁקּ֑וֹת", "strong": "H4642", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "penindas"}, {"pos": 6, "word_orig": "שנאי", "strong": "H8130", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "membenci"}, {"pos": 7, "word_orig": "שֹׂ֥נֵא", "strong": "H8130", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "laba"}, {"pos": 8, "word_orig": "בֶ֝֗צַע", "strong": "H1215", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "memperpanjang"}, {"pos": 9, "word_orig": "יַאֲרִ֥יךְ", "strong": "H748", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "hari-harinya"}, {"pos": 10, "word_orig": "יָמִֽים", "strong": "H3117", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": ""}]}, {"book": 20, "chapter": 28, "verse": 17, "ayat_id": 17214, "title": "", "ayt_text": "Orang yang menanggung darah orang lain akan melarikan diri sampai ke liang kubur; jangan ada orang yang menolongnya.", "words": [{"pos": 1, "word_orig": "אָ֭דָם", "strong": "H120", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "עָשֻׁ֣ק", "strong": "H6231", "morph": "HVqsmsa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "menanggung"}, {"pos": 3, "word_orig": "בְּ/דַם", "strong": "H1818", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "darah"}, {"pos": 4, "word_orig": "נָפֶשׁ", "strong": "H5315", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "orang"}, {"pos": 5, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Prep