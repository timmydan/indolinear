r": 28, "verse": 19, "ayat_id": 17216, "title": "", "ayt_text": "Siapa mengerjakan tanahnya akan kenyang dengan makanan, tetapi dia yang mengejar kesia-siaan akan kenyang dengan kemiskinan.", "words": [{"pos": 1, "word_orig": "עֹבֵ֣ד", "strong": "H5647", "morph": "HVqrmsc", "morph_id": "Verba Qal", "ayt_word": "mengerjakan"}, {"pos": 2, "word_orig": "אַ֭דְמָת/וֹ", "strong": "H127", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tanahnya"}, {"pos": 3, "word_orig": "יִֽשְׂבַּֽע", "strong": "H7646", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kenyang"}, {"pos": 4, "word_orig": "לָ֑חֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "makanan"}, {"pos": 5, "word_orig": "וּ/מְרַדֵּ֥ף", "strong": "H7291", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "mengejar"}, {"pos": 6, "word_orig": "רֵ֝קִ֗ים", "strong": "H7386", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "kesia-siaan"}, {"pos": 7, "word_orig": "יִֽשְׂבַּֽע", "strong": "H7646", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kenyang"}, {"pos": 8, "word_orig": "רִֽישׁ", "strong": "H7389", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kemiskinan"}]}, {"book": 20, "chapter": 28, "verse": 20, "ayat_id": 17217, "title": "", "ayt_text": "Orang yang setia akan memperoleh banyak berkat, tetapi dia yang tergesa-gesa menjadi kaya tidak akan terlepas dari hukuman.", "words": [{"pos": 1, "word_orig": "אִ֣ישׁ", "strong": "H376", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "אֱ֭מוּנוֹת", "strong": "H530", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "setia"}, {"pos": 3, "word_orig": "רַב", "strong": "H7227", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "banyak"}, {"pos": 4, "word_orig": "בְּרָכ֑וֹת", "strong": "H1293", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "berkat"}, {"pos": 5, "word_orig": "וְ/אָ֥ץ", "strong": "H213", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "tergesa-gesa"}, {"pos": 6, "word_orig": "לְ֝/הַעֲשִׁ֗יר", "strong": "H6238", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "kaya"}, {"pos": 7, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "יִנָּקֶֽה", "strong": "H5352", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terlepas"}]}, {"book": 20, "chapter": 28, "verse": 21, "ayat_id": 17218, "title": "", "ayt_text": "Memandang muka itu tidak baik, karena demi sepotong roti, orang dapat melakukan pelanggaran.", "words": [{"pos": 1, "word_orig": "הַֽכֵּר", "strong": "H5234", "morph": "HVha", "morph_id": "Verba Hifil Infinitif Absolut", "ayt_word": "Memandang"}, {"pos": 2, "word_orig": "פָּנִ֥ים", "strong": "H6440", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "muka"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "ט֑וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 5, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": ""}, {"pos": 6, "word_orig": "פַּת", "strong": "H6595", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "sepotong"}, {"pos": 7, "word_orig": "לֶ֝֗חֶם", "strong": "H3899", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tun