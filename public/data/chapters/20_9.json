[{"book": 20, "chapter": 9, "verse": 1, "ayat_id": 16640, "title": "Undangan Hikmat dan Undangan Kebodohan", "ayt_text": "Hikmat telah membangun rumahnya; ia telah menggali ketujuh tiangnya.", "words": [{"pos": 1, "word_orig": "חָ֭כְמוֹת", "strong": "H2454", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Hikmat"}, {"pos": 2, "word_orig": "בָּנְתָ֣ה", "strong": "H1129", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "membangun"}, {"pos": 3, "word_orig": "בֵיתָ֑/הּ", "strong": "H1004", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "rumahnya"}, {"pos": 4, "word_orig": "חָצְבָ֖ה", "strong": "H2672", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menggali"}, {"pos": 5, "word_orig": "עַמּוּדֶ֣י/הָ", "strong": "H5982", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "tiangnya"}, {"pos": 6, "word_orig": "שִׁבְעָֽה", "strong": "H7651", "morph": "HAcmsa", "morph_id": "Acmsa", "ayt_word": "ketujuh"}]}, {"book": 20, "chapter": 9, "verse": 2, "ayat_id": 16641, "title": "", "ayt_text": "Ia telah memotong ternak sembelihannya, mencampur anggurnya, dan menata mejanya.", "words": [{"pos": 1, "word_orig": "טָבְחָ֣ה", "strong": "H2873", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "memotong"}, {"pos": 2, "word_orig": "טִ֭בְחָ/הּ", "strong": "H2874", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "sembelihannya"}, {"pos": 3, "word_orig": "מָסְכָ֣ה", "strong": "H4537", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mencampur"}, {"pos": 4, "word_orig": "יֵינָ֑/הּ", "strong": "H3196", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Kons