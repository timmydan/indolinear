tif Orang ke-2 Laki-laki Jamak", "ayt_word": "minumlah"}, {"pos": 5, "word_orig": "בְּ/יַ֣יִן", "strong": "H3196", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 6, "word_orig": "מָסָֽכְתִּי", "strong": "H4537", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "kucampur"}]}, {"book": 20, "chapter": 9, "verse": 6, "ayat_id": 16645, "title": "", "ayt_text": "Tinggalkanlah kenaifanmu, dan hiduplah, serta berjalanlah di jalan pengertian.”", "words": [{"pos": 1, "word_orig": "עִזְב֣וּ", "strong": "H5800", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Tinggalkanlah"}, {"pos": 2, "word_orig": "פְתָאיִ֣ם", "strong": "H6612", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kenaifanmu"}, {"pos": 3, "word_orig": "וִֽ/חְי֑וּ", "strong": "H2421", "morph": "HC/Vqv2mp", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "hiduplah"}, {"pos": 4, "word_orig": "וְ֝/אִשְׁר֗וּ", "strong": "H833", "morph": "HC/Vqv2mp", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "berjalanlah"}, {"pos": 5, "word_orig": "בְּ/דֶ֣רֶךְ", "strong": "H1870", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 6, "word_orig": "בִּינָֽה", "strong": "H998", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengertian"}]}, {"book": 20, "chapter": 9, "verse": 7, "ayat_id": 16646, "title": "", "ayt_text": "Siapa mendidik seorang pencemooh mendapatkan malu bagi dirinya sendiri; siapa menegur orang fasik mendapatkan cela.", "words": [{"pos": 1, "word_orig": "יֹ֤סֵ֨ר", "strong": "H3256", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mendidik"}, {"pos": 2, "wo