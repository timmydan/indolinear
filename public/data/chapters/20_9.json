rse": 13, "ayat_id": 16652, "title": "Jalan Kebodohan", "ayt_text": "Perempuan yang bodoh itu cerewet; dia naif, dan tidak tahu apa-apa.", "words": [{"pos": 1, "word_orig": "אֵ֣שֶׁת", "strong": "H802", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Perempuan"}, {"pos": 2, "word_orig": "כְּ֭סִילוּת", "strong": "H3687", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "הֹֽמִיָּ֑ה", "strong": "H1993", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "cerewet"}, {"pos": 4, "word_orig": "פְּ֝תַיּ֗וּת", "strong": "H6615", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "naif"}, {"pos": 5, "word_orig": "וּ/בַל", "strong": "H1077", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יָ֥דְעָה", "strong": "H3045", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "tahu"}, {"pos": 7, "word_orig": "מָּֽה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "apa-apa"}]}, {"book": 20, "chapter": 9, "verse": 14, "ayat_id": 16653, "title": "", "ayt_text": "Dia duduk di pintu rumahnya, di atas kursi di tempat-tempat tinggi di kota,", "words": [{"pos": 1, "word_orig": "וְֽ֭/יָשְׁבָה", "strong": "H3427", "morph": "HC/Vqp3fs", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "duduk"}, {"pos": 2, "word_orig": "לְ/פֶ֣תַח", "strong": "H6607", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pintu"}, {"pos": 3, "word_orig": "בֵּיתָ֑/הּ", "strong": "H1004", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "rumahnya"}, {"pos": 4, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 5, "word_orig": "כִּ֝סֵּ֗א", "strong": "H3678", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kursi"}, {"pos": 6, "word_orig": "מְרֹ֣מֵי", "strong": "H4791", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "tempat-tempat"}, {"pos": 7, "word_orig": "קָֽרֶת", "strong": "H7176", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kota"}]}, {"book": 20, "chapter": 9, "verse": 15, "ayat_id": 16654, "title": "", "ayt_text": "sambil berseru-seru kepada orang yang lewat di jalan, yang berjalan lurus di jalan mereka,", "words": [{"pos": 1, "word_orig": "לִ/קְרֹ֥א", "strong": "H7121", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "berseru-seru"}, {"pos": 2, "word_orig": "לְ/עֹֽבְרֵי", "strong": "H5674", "morph": "HR/Vqrmpc", "morph_id": "Preposisi + Verba Qal", "ayt_word": "lewat"}, {"pos": 3, "word_orig": "דָ֑רֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "jalan"}, {"pos": 4, "word_orig": "הַֽ֝/מְיַשְּׁרִ֗ים", "strong": "H3474", "morph": "HTd/Vprmpa", "morph_id": "Artikel Definit (הַ) + Verba Piel", "ayt_word": "lurus"}, {"pos": 5, "word_orig": "אֹֽרְחוֹתָֽ/ם", "strong": "H734", "morph": "HNcbpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "jalan"}]}, {"book": 20, "chapter": 9, "verse": 16, "ayat_id": 16655, "title": "", "ayt_text": "“Siapa yang naif, singgahlah ke sini.” Lalu, kepada yang kekurangan akal budi, dia berkata,", "words": [{"pos": 1, "word_orig": "מִי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapa"}, {"pos": 2, "word_orig": "פֶ֭תִי", "strong": "H6612", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "naif"}, {"pos": 3, "word_or