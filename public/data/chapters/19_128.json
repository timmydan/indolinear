[{"book": 19, "chapter": 128, "verse": 1, "ayat_id": 16128, "title": "Berkat di Bumi", "ayt_text": "Nyanyian Ziarah. Diberkatilah setiap orang yang takut akan TUHAN, yang berjalan pada jalan-jalan-Nya.", "words": [{"pos": 1, "word_orig": "שִׁ֗יר", "strong": "H7892", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Nyanyian"}, {"pos": 2, "word_orig": "הַֽ/מַּ֫עֲל֥וֹת", "strong": "H4609", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Ziarah"}, {"pos": 3, "word_orig": "אַ֭שְׁרֵי", "strong": "H835", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Diberkatilah"}, {"pos": 4, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "setiap"}, {"pos": 5, "word_orig": "יְרֵ֣א", "strong": "H3373", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "takut"}, {"pos": 6, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "הַ֝/הֹלֵ֗ךְ", "strong": "H1980", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "berjalan"}, {"pos": 8, "word_orig": "בִּ/דְרָכָֽי/ו", "strong": "H1870", "morph": "HR/Ncbpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalan-jalan-Nya"}]}, {"book": 19, "chapter": 128, "verse": 2, "ayat_id": 16129, "title": "", "ayt_text": "Kamu akan makan hasil pekerjaan tanganmu, kamu akan bahagia dan itu baik bagimu.", "words": [{"pos": 1, "word_orig": "יְגִ֣יעַ", "strong": "H3018", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hasil"}, {"pos": 2, "word_orig": "כַּ֭פֶּי/ךָ", "strong": "H3709", "morph": "HNcfdc/Sp2ms", "morph_id": "Nomina Konstruk (T