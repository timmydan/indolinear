id": 5554, "title": "", "ayt_text": "Anak laki-laki sulung yang dimilikinya dianggap sebagai anak suaminya yang mati supaya nama saudaranya yang telah meninggal itu tidak terhapus dari antara orang Israel.", "words": [{"pos": 1, "word_orig": "וְ/הָיָ֗ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": ""}, {"pos": 2, "word_orig": "הַ/בְּכוֹר֙", "strong": "H1060", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Anak"}, {"pos": 3, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 4, "word_orig": "תֵּלֵ֔ד", "strong": "H3205", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "dimilikinya"}, {"pos": 5, "word_orig": "יָק֕וּם", "strong": "H6965", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dianggap"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sebagai"}, {"pos": 7, "word_orig": "שֵׁ֥ם", "strong": "H8034", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 8, "word_orig": "אָחִ֖י/ו", "strong": "H251", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "saudaranya"}, {"pos": 9, "word_orig": "הַ/מֵּ֑ת", "strong": "H4191", "morph": "HTd/Vqrmsa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "mati"}, {"pos": 10, "word_orig": "וְ/לֹֽא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 11, "word_orig": "יִמָּחֶ֥ה", "strong": "H4229", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terhapus"}, {"pos": 12, "word_orig": "שְׁמ֖/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": ""}, {"pos": 13, "word_orig": "מִ/יִּשְׂרָאֵֽל", "strong": "H3478", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Israel"}]}, {"book": 5, "chapter": 25, "verse": 7, "ayat_id": 5555, "title": "", "ayt_text": "Akan tetapi, jika laki-laki itu tidak mau mengambil istri saudaranya maka istri saudaranya itu harus pergi ke pintu gerbang menghadap para tua-tua dan berkata, “Saudara suamiku menolak mempertahankan nama saudaranya di Israel. Dia tidak mau melaksanakan tugas saudaranya kepadaku.”", "words": [{"pos": 1, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "jika"}, {"pos": 2, "word_orig": "לֹ֤א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "יַחְפֹּץ֙", "strong": "H2654", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mau"}, {"pos": 4, "word_orig": "הָ/אִ֔ישׁ", "strong": "H376", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laki-laki"}, {"pos": 5, "word_orig": "לָ/קַ֖חַת", "strong": "H3947", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mengambil"}, {"pos": 6, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 7, "word_orig": "יְבִמְתּ֑/וֹ", "strong": "H2994", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "istri"}, {"pos": 8, "word_orig": "וְ/עָלְתָה֩", "strong": "H5927", "morph": "HC/Vqq3fs", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Perempuan Tunggal", "ayt_word": "pergi"}, {"pos": 9, "word_orig": "יְבִמְתּ֨/וֹ", "strong": "H2994", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal