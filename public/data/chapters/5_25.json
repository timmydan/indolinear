[{"book": 5, "chapter": 25, "verse": 1, "ayat_id": 5549, "title": "", "ayt_text": "Apabila ada perselisihan di antara dua orang, mereka harus pergi ke pengadilan. Para hakim akan memutuskan, yang benar kepada yang benar dan yang salah kepada yang salah.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Apabila"}, {"pos": 2, "word_orig": "יִהְיֶ֥ה", "strong": "H1961", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ada"}, {"pos": 3, "word_orig": "רִיב֙", "strong": "H7379", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "perselisihan"}, {"pos": 4, "word_orig": "בֵּ֣ין", "strong": "H996", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "antara"}, {"pos": 5, "word_orig": "אֲנָשִׁ֔ים", "strong": "H376", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "orang"}, {"pos": 6, "word_orig": "וְ/נִגְּשׁ֥וּ", "strong": "H5066", "morph": "HC/VNq3cp", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Jamak", "ayt_word": "pergi"}, {"pos": 7, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 8, "word_orig": "הַ/מִּשְׁפָּ֖ט", "strong": "H4941", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengadilan"}, {"pos": 9, "word_orig": "וּ/שְׁפָט֑וּ/ם", "strong": "H8199", "morph": "HC/Vqq3cp/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Jamak + Sp3mp", "ayt_word": "memutuskan"}, {"pos": 10, "word_orig": "וְ/הִצְדִּ֨יקוּ֙", "strong": "H6663", "morph": "HC/Vhq3cp", "morph_id": "Konjungsi (וְ) + Verba Hifil Orang ke-3 Jamak", "ayt_word": "benar"}, {"pos": 11, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 12, "word_orig": "הַ/צַּדִּ֔יק", "strong": "H6662", "morph":