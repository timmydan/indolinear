, {"book": 5, "chapter": 25, "verse": 10, "ayat_id": 5558, "title": "", "ayt_text": "Di Israel, namanya akan disebut, “Keluarga yang sandalnya dilepaskan”.", "words": [{"pos": 1, "word_orig": "וְ/נִקְרָ֥א", "strong": "H7121", "morph": "HC/VNq3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Laki-laki Tunggal", "ayt_word": "disebut"}, {"pos": 2, "word_orig": "שְׁמ֖/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "namanya"}, {"pos": 3, "word_orig": "בְּ/יִשְׂרָאֵ֑ל", "strong": "H3478", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Israel"}, {"pos": 4, "word_orig": "בֵּ֖ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Keluarga"}, {"pos": 5, "word_orig": "חֲל֥וּץ", "strong": "H2502", "morph": "HVqsmsc", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "dilepaskan"}, {"pos": 6, "word_orig": "הַ/נָּֽעַל", "strong": "H5275", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sandalnya"}]}, {"book": 5, "chapter": 25, "verse": 11, "ayat_id": 5559, "title": "", "ayt_text": "Jika dua orang berkelahi satu sama lain, lalu istri salah seorang datang untuk menolong suaminya dari tangan orang yang menyerangnya, lalu mengulurkan tangannya dan memegang kemaluan laki-laki lain itu,", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יִנָּצ֨וּ", "strong": "H5327", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "berkelahi"}, {"pos": 3, "word_orig": "אֲנָשִׁ֤ים", "strong": "H376", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "יַחְדָּו֙", "strong": "H3162", "morph": "