ang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "dipukul"}, {"pos": 9, "word_orig": "לְ/פָנָ֔י/ו", "strong": "H6440", "morph": "HR/Ncbpc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "hadapannya"}, {"pos": 10, "word_orig": "כְּ/דֵ֥י", "strong": "H1767", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "dengan"}, {"pos": 11, "word_orig": "רִשְׁעָת֖/וֹ", "strong": "H7564", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kesalahannya"}, {"pos": 12, "word_orig": "בְּ/מִסְפָּֽר", "strong": "H4557", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Jumlah"}]}, {"book": 5, "chapter": 25, "verse": 3, "ayat_id": 5551, "title": "", "ayt_text": "Jangan pukul seseorang lebih dari 40 kali, karena lebih daripada itu berarti hidup orang itu tidak berharga bagimu.", "words": [{"pos": 1, "word_orig": "אַרְבָּעִ֥ים", "strong": "H705", "morph": "HAcbpa", "morph_id": "Acbpa", "ayt_word": "40"}, {"pos": 2, "word_orig": "יַכֶּ֖/נּוּ", "strong": "H5221", "morph": "HVhi3ms/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "pukul"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Jangan"}, {"pos": 4, "word_orig": "יֹסִ֑יף", "strong": "H3254", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "lebih"}, {"pos": 5, "word_orig": "פֶּן", "strong": "H6435", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "יֹסִ֨יף", "strong": "H3254", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "lebih"}, {"pos": 7, "word_orig": "לְ/הַכֹּת֤/וֹ", "strong": "H5221", "morph": "HR/Vhc/Sp3ms", "morph_id": "Preposisi + Verba Hifil Imperatif + Sp3ms", "ayt_word": ""}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 9, "word_orig": "אֵ֨לֶּה֙", "strong": "H428", "morph": "HPdxcp", "morph_id": "Pdxcp", "ayt_word": "itu"}, {"pos": 10, "word_orig": "מַכָּ֣ה", "strong": "H4347", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": ""}, {"pos": 11, "word_orig": "רַבָּ֔ה", "strong": "H7227", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": ""}, {"pos": 12, "word_orig": "וְ/נִקְלָ֥ה", "strong": "H7034", "morph": "HC/VNq3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Laki-laki Tunggal", "ayt_word": "berharga"}, {"pos": 13, "word_orig": "אָחִ֖י/ךָ", "strong": "H251", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "orang"}, {"pos": 14, "word_orig": "לְ/עֵינֶֽי/ךָ", "strong": "H5869", "morph": "HR/Ncbdc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp2ms", "ayt_word": "bagimu"}]}, {"book": 5, "chapter": 25, "verse": 4, "ayat_id": 5552, "title": "", "ayt_text": "Jangan menutup mulut sapi yang sedang mengirik.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Jangan"}, {"pos": 2, "word_orig": "תַחְסֹ֥ם", "strong": "H2629", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menutup"}, {"pos": 3, "word_orig": "שׁ֖וֹר", "strong": "H7794", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sapi"}, {"pos": 4, "word_orig": "בְּ/דִישֽׁ/וֹ", "strong": "H1758", "morph": "HR/Vqc/Sp3ms", "morph_id": "Preposisi + Verba Qal Imperatif + Sp3ms", "ayt_word": "mengirik"}]}, {"book": 5, "chapter": 25, "verse": 5, "ayat_id": 5553, "title": "", "ayt_text": "Jika dua orang yang bersaudara tinggal bersama, dan salah satu dari mereka mati, dan tidak mempunyai anak laki-laki, istri dari yang mati itu tidak boleh menikah dengan orang di luar keluarga suaminya. Saudara suaminya harus menghampirinya dan menjadikannya sebagai istri. Dia harus melakukan tugas saudaranya sebagai suami terhadap istri itu.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יֵשְׁב֨וּ", "strong": "H3427", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "tinggal"}, {"pos": 3, "word_orig": "אַחִ֜ים", "strong": "H251", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bersaudara"}, {"pos": 4, "word_orig": "יַחְדָּ֗ו", "strong": "H3162", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "bersama"}, {"pos": 5, "word_orig": "וּ/מֵ֨ת", "strong": "H4191", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "mati"}, {"pos": 6, "word_orig": "אַחַ֤ד", "strong": "H259", "morph": "HAcmsa", "morph_id": "Acmsa", "ayt_word": "satu"}, {"pos": 7, "word_orig": "מֵ/הֶם֙", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": "mereka"}, {"pos": 8, "word_orig": "וּ/בֵ֣ן", "strong": "H1121", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laki-laki"}, {"pos": 9, "word_orig": "אֵֽין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 10, "word_orig": "ל֔/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 11, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 12, "word_orig": "תִהְיֶ֧ה", "strong": "H1961", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": ""}, {"pos": 13, "word_orig": "אֵֽשֶׁת", "stron