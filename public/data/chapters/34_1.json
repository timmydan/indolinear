ruk (Terikat)", "ayt_word": "kaki-Nya"}, {"pos": 16, "word_orig": "רַגְלָֽי/ו", "strong": "H7272", "morph": "HNcfdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 34, "chapter": 1, "verse": 4, "ayat_id": 22689, "title": "", "ayt_text": "Ia menghardik laut dan mengeringkannya, segala sungai dijadikan-Nya kering. Basan dan Karmel merana, dan bunga-bunga Lebanon menjadi layu.", "words": [{"pos": 1, "word_orig": "גּוֹעֵ֤ר", "strong": "H1605", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghardik"}, {"pos": 2, "word_orig": "בַּ/יָּם֙", "strong": "H3220", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laut"}, {"pos": 3, "word_orig": "וַֽ/יַּבְּשֵׁ֔/הוּ", "strong": "H3001", "morph": "HC/Vpw3ms/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "mengeringkannya"}, {"pos": 4, "word_orig": "וְ/כָל", "strong": "H3605", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 5, "word_orig": "הַ/נְּהָר֖וֹת", "strong": "H5104", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sungai"}, {"pos": 6, "word_orig": "הֶֽחֱרִ֑יב", "strong": "H2717", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kering"}, {"pos": 7, "word_orig": "אֻמְלַ֤ל", "strong": "H535", "morph": "HVKp3ms", "morph_id": "Verba Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merana"}, {"pos": 8, "word_orig": "בָּשָׁן֙", "strong": "H1316", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Basan"}, {"pos": 9, "word_orig": "וְ/כַרְמֶ֔ל", "strong": "H3760", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Karmel"}, {"pos": 10, "word_orig": "וּ/פֶ֥רַח", 