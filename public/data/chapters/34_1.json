, "strong": "H5921", "morph": "HR/R/Sp2fs", "morph_id": "Preposisi + Preposisi + Sp2fs", "ayt_word": "atasmu"}, {"pos": 5, "word_orig": "וּ/מוֹסְרֹתַ֖יִ/ךְ", "strong": "H4147", "morph": "HC/Ncbpc/Sp2fs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "tali-tali"}, {"pos": 6, "word_orig": "אֲנַתֵּֽק", "strong": "H5423", "morph": "HVpi1cs", "morph_id": "Verba Piel Imperfek Orang ke-1 Tunggal", "ayt_word": "memutuskan"}]}, {"book": 34, "chapter": 1, "verse": 14, "ayat_id": 22699, "title": "", "ayt_text": "“Inilah perintah TUHAN atasmu, “Tidak akan ada lagi keturunan dengan namamu. Dari rumah ilahmu, Aku akan melenyapkan patung pahatan dan patung tuangan. Aku akan menyediakan kuburmu, sebab kamu terkutuk.”", "words": [{"pos": 1, "word_orig": "וְ/צִוָּ֤ה", "strong": "H6680", "morph": "HC/Vpp3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "perintah"}, {"pos": 2, "word_orig": "עָלֶ֨י/ךָ֙", "strong": "H5921", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": ""}, {"pos": 3, "word_orig": "יְהוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "akan"}, {"pos": 5, "word_orig": "יִזָּרַ֥ע", "strong": "H2232", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "keturunan"}, {"pos": 6, "word_orig": "מִ/שִּׁמְ/ךָ֖", "strong": "H8034", "morph": "HR/Ncmsc/Sp2ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "namamu"}, {"pos": 7, "word_orig": "ע֑וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lagi"}, {"pos": 8, "word_orig": "מִ/בֵּ֨ית", "strong": "H1004", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "ruma