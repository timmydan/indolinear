a"}, {"pos": 7, "word_orig": "יְרַדֶּף", "strong": "H7291", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengejar"}, {"pos": 8, "word_orig": "חֹֽשֶׁךְ", "strong": "H2822", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}]}, {"book": 34, "chapter": 1, "verse": 9, "ayat_id": 22694, "title": "Firman TUHAN kepada Yehuda dan Niniwe", "ayt_text": "Apakah kamu bermaksud menentang TUHAN? Ia akan menghabisi semuanya. Kesusahan tidak akan timbul dua kali.", "words": [{"pos": 1, "word_orig": "מַה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Apakah"}, {"pos": 2, "word_orig": "תְּחַשְּׁבוּ/ן֙", "strong": "H2803", "morph": "HVpi2mp/Sn", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Jamak + Sn", "ayt_word": "bermaksud"}, {"pos": 3, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "menentang"}, {"pos": 4, "word_orig": "יְהוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "כָּלָ֖ה", "strong": "H3617", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "menghabisi"}, {"pos": 6, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "Ia"}, {"pos": 7, "word_orig": "עֹשֶׂ֑ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "semuanya"}, {"pos": 8, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "תָק֥וּם", "strong": "H6965", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "timbul"}, {"pos": 10, "word_orig": "פַּעֲמַ֖יִם", "strong": "H6471", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "kali"}, {"pos": 11, "word_orig": "צָרָֽה", "strong": "H6869", "morph": "