v2mp", "morph_id": "Konjungsi (וְ) + Verba Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "jantan"}, {"pos": 4, "word_orig": "הָשִׁ֥יבוּ", "strong": "H7725", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Ingatlah"}, {"pos": 5, "word_orig": "פוֹשְׁעִ֖ים", "strong": "H6586", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "pemberontak"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 7, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pikiranmu"}]}, {"book": 23, "chapter": 46, "verse": 9, "ayat_id": 18596, "title": "", "ayt_text": "Ingatlah hal-hal yang dahulu kala karena Akulah Allah dan tidak ada yang lain. Akulah Allah dan tidak ada yang lain seperti Aku,", "words": [{"pos": 1, "word_orig": "זִכְר֥וּ", "strong": "H2142", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Ingatlah"}, {"pos": 2, "word_orig": "רִאשֹׁנ֖וֹת", "strong": "H7223", "morph": "HAafpa", "morph_id": "Aafpa", "ayt_word": "dahulu"}, {"pos": 3, "word_orig": "מֵ/עוֹלָ֑ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kala"}, {"pos": 4, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 5, "word_orig": "אָנֹכִ֥י", "strong": "H595", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Akulah"}, {"pos": 6, "word_orig": "אֵל֙", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 7, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "ע֔וֹד", "strong": "H5750", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "lain"}, {"pos": 9, "word_orig": "אֱלֹהִ֖ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 10, "word_orig": "וְ/אֶ֥פֶס", "strong": "H657", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "lain"}, {"pos": 11, "word_orig": "כָּמֽוֹ/נִי", "strong": "H3644", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "seperti"}]}, {"book": 23, "chapter": 46, "verse": 10, "ayat_id": 18597, "title": "", "ayt_text": "yang menyatakan akhir sesuatu dari sejak awal, dan hal-hal yang belum terjadi dari zaman dahulu kala, dengan berkata, “Rencana-Ku akan tetap teguh dan Aku akan menyelesaikan semua kehendak-Ku”;", "words": [{"pos": 1, "word_orig": "מַגִּ֤יד", "strong": "H5046", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menyatakan"}, {"pos": 2, "word_orig": "מֵֽ/רֵאשִׁית֙", "strong": "H7225", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "awal"}, {"pos": 3, "word_orig": "אַחֲרִ֔ית", "strong": "H319", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "akhir"}, {"pos": 4, "word_orig": "וּ/מִ/קֶּ֖דֶם", "strong": "H6924", "morph": "HC/R/Ncmsa", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sejak"}, {"pos": 5, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 6, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "belum"}, {"pos": 7, "word_orig": "נַעֲשׂ֑וּ", "strong": "H6213", "morph": "HVNp3cp", "morph_id": "Verba Nifal Perfek Orang ke-3 Jamak", "ayt_word": "terjadi"}, {"pos": 8, "word_orig": "אֹמֵר֙", "strong": "H559", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berkata"}, {"pos": 9, "word_orig": "עֲצָתִ֣/י", "strong": "H60