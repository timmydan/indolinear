[{"book": 23, "chapter": 46, "verse": 1, "ayat_id": 18588, "title": "Allah-Allah Palsu Tidak Berguna", "ayt_text": "Bel bertekuk lutut, Nebo membungkuk; Patung-patung mereka dimuatkan di atas binatang dan ternak. Barang-barang yang kamu bawa ini memberatkan, itu menjadi beban bagi binatang yang lelah.", "words": [{"pos": 1, "word_orig": "כָּרַ֥ע", "strong": "H3766", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bertekuk"}, {"pos": 2, "word_orig": "בֵּל֙", "strong": "H1078", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Bel"}, {"pos": 3, "word_orig": "קֹרֵ֣ס", "strong": "H7164", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membungkuk"}, {"pos": 4, "word_orig": "נְב֔וֹ", "strong": "H5015", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Nebo"}, {"pos": 5, "word_orig": "הָיוּ֙", "strong": "H1961", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "dimuatkan"}, {"pos": 6, "word_orig": "עֲצַבֵּי/הֶ֔ם", "strong": "H6091", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "Patung-patung"}, {"pos": 7, "word_orig": "לַ/חַיָּ֖ה", "strong": "H2416", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "binatang"}, {"pos": 8, "word_orig": "וְ/לַ/בְּהֵמָ֑ה", "strong": "H929", "morph": "HC/Rd/Ncfsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "ternak"}, {"pos": 9, "word_orig": "נְשֻׂאֹתֵי/כֶ֣ם", "strong": "H5385", "morph": "HVqsfpc/Sp2mp", "morph_id": "Verba Qal Partisip Pasif + Sp2mp", "ayt_word": "Barang-barang"}, {"pos": 10, "word_orig": "עֲמוּס֔וֹת", "strong": "H6006", "morph": "HVqsfpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "memberatkan"}, {"pos": 11, "word_orig": "מַשָּׂ֖א", "strong": "H4853", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "beban"}, {"pos": 12, "word_orig": "לַ/עֲיֵפָֽה", "strong": "H5889", "morph": "HR/Aafsa", "morph_id": "Preposisi + Aafsa", "ayt_word": "lelah"}]}, {"book": 23, "chapter": 46, "verse": 2, "ayat_id": 18589, "title": "", "ayt_text": "Mereka membungkuk, mereka sujud bersama-sama. Mereka tidak dapat mengamankan beban itu; justru mereka sendiri pergi ke penawanan.", "words": [{"pos": 1, "word_orig": "קָרְס֤וּ", "strong": "H7164", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "membungkuk"}, {"pos": 2, "word_orig": "כָֽרְעוּ֙", "strong": "H3766", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "sujud"}, {"pos": 3, "word_orig": "יַחְדָּ֔ו", "strong": "H3162", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "bersama-sama"}, {"pos": 4, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "יָכְל֖וּ", "strong": "H3201", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "dapat"}, {"pos": 6, "word_orig": "מַלֵּ֣ט", "strong": "H4422", "morph": "HVpc", "morph_id": "Verba Piel Imperatif", "ayt_word": "mengamankan"}, {"pos": 7, "word_orig": "מַשָּׂ֑א", "strong": "H4853", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "beban"}, {"pos": 8, "word_orig": "וְ/נַפְשָׁ֖/ם", "strong": "H5315", "morph": "HC/Ncbsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "mereka"}, {"pos": 9, "word_orig": "בַּ/שְּׁבִ֥י", "strong": "H7628", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "penawanan"}, {"pos": 10, "word_orig": "הָלָֽכָה", "strong": "H1980", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "pergi"}]}, {"book": 23, "chapter": 46, "verse": 3, "ayat_id": 18590, "title": "", "ayt_text": "Dengarlah Aku, hai keluarga Yakub, dan semua yang tersisa dari keluarga Israel, yang telah Kutopang sejak dalam kandungan dan telah Kubawa sejak lahir.", "words": [{"pos": 1, "word_orig": "שִׁמְע֤וּ", "strong": "H8085", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Dengarlah"}, {"pos": 2, "word_orig": "אֵלַ/י֙", "strong": "H413", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 3, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keluarga"}, {"pos": 4, "word_orig": "יַעֲקֹ֔ב", "strong": "H3290", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yakub"}, {"pos": 5, "word_orig": "וְ/כָל", "strong": "H3605", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "שְׁאֵרִ֖ית", "strong": "H7611", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "tersisa"}, {"pos": 7, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keluarga"}, {"pos": 8, "word_orig": "יִשְׂרָאֵ֑ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 9, "word_orig": "הַֽ/עֲמֻסִים֙", "strong": "H6006", "morph": "HTd/Vqsmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal Partisip Pasif", "ayt_word": "Kutopang"}, {"pos": 10, "word_orig": "מִנִּי", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sejak"}, {"pos": 11, "word_orig": "בֶ֔טֶן", "strong": "H990", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kandungan"}, {"pos": 12, "word_orig": "הַ/נְּשֻׂאִ֖ים", "strong": "H5375", "morph": "HTd/Vqsmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal Partisip Pasif", "ayt_word": "Kubawa"}, {"pos": 13, "word_orig": "מִנִּי", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sejak"}, {"pos": 14, "word_orig": "רָֽחַם", "strong": "H7356", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "lahir"}]}, {"book": 23, "chapter": 46, "verse": 4, "ayat_id": 18591, "title": "", "ayt_text": "Bahkan, sampai masa tuamu, Aku tetap Dia dan sampai putih rambutmu, Aku akan menggendongmu. Aku telah membuatnya dan Aku akan menggendong, bahkan Aku akan membawa dan akan menyelamatkanmu.", "words": [{"pos": 1, "word_orig": "וְ/עַד", "strong": "H5704", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "sampai"}, {"pos": 2, "word_orig": "זִקְנָה֙", "strong": "H2209", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "masa"}, {"pos": 3, "word_orig": "אֲנִ֣י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 4, "word_orig": "ה֔וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "Dia"}, {"pos": 5, "word_orig": "וְ/עַד", "strong": "H5704", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "sampai"}, {"pos": 6, "word_orig": "שֵיבָ֖ה", "strong": "H7872", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "rambutmu"}, {"pos": 7, "word_orig": "אֲנִ֣י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 8, "word_orig": "אֶסְבֹּ֑ל", "strong": "H5445", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menggendongmu"}, {"pos": 9, "word_orig": "אֲנִ֤י", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "Aku"}, {"pos": 10, "word_orig": "עָשִׂ֨יתִי֙", "strong": "H6213", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "membuatnya"}, {"pos": 11, "word_orig": "וַ/אֲנִ֣י", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": "Aku"}, {"pos": 12, "word_orig": "אֶשָּׂ֔א", "strong": "H5375", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menggendong"}, {"pos": 13, "word_orig": "וַ/אֲנִ֥י", "strong": "H589", "morph": "HC/Pp1cs", "morph_id": "Konjungsi (וְ) + Pp1cs", "ayt_word": "Aku"}, {"pos": 14, "word_orig": "אֶסְבֹּ֖ל", "strong": "H5445", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "membawa"}, {"pos": 15, "word_orig": "וַ/אֲמַלֵּֽט", "strong": "H4422", "morph": "HC/Vpi1cs", "morph_id": "Konjungsi (וְ) + Verba Piel Imperfek Orang ke-1 Tunggal", "ayt_word": "menyelamatkanmu"}]}, {"book": 23, "chapter": 46, "verse": 5, "ayat_id": 18592, "title": "", "ayt_text": "Dengan siapakah kamu akan menyamakan Aku dan membuat-Ku sama, dan membandingkan Aku sehingga kami menjadi serupa?", "words": [{"pos": 1, "word_orig": "לְ/מִ֥י", "strong": "H4310", "morph": "HR/Ti", "morph_id": "Preposisi + Ti", "ayt_word": "siapakah"}, {"pos": 2, "word_orig": "תְדַמְי֖וּ/נִי", "strong": "H1819", "morph": "HVpi2mp/Sp1cs", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Jamak + Sp1cs", "ayt_word": "menyamakan"}, {"pos": 3, "word_orig": "וְ/תַשְׁו֑וּ", "strong": "H7737", "morph": "HC/Vhi2mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-2 Laki-laki Jamak", "ayt_word": "membuat-Ku"}, {"pos": 4, "word_orig": "וְ/תַמְשִׁל֖וּ/נִי", "strong": "H4911", "morph": "HC/Vhi2mp/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-2 Laki-laki Jamak + Sp1cs", "ayt_word": "membandingkan"}, {"pos": 5, "word_orig": "וְ/נִדְמֶֽה", "strong": "H1819", "morph": "HC/Vqi1cp", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-1 Jamak", "ayt_word": "menjadi"}]}, {"book": 23, "chapter": 46, "verse": 6, "ayat_id": 18593, "title": "", "ayt_text": "Mereka mencurahkan emas dari kantong, menimbang perak dengan neraca, mengupah pandai emas, dan membuatnya menjadi dewa. Kemudian, mereka sujud dan menyembahnya.", "words": [{"pos": 1, "word_orig": "הַ/זָּלִ֤ים", "strong": "H2107", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "mencurahkan"}, {"pos": 2, "word_orig": "זָהָב֙", "strong": "H2091", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "emas"}, {"pos": 3, "word_orig": "מִ/כִּ֔יס", "strong": "H3599", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kantong"}, {"pos": 4, "word_orig": "וְ/כֶ֖סֶף", "strong": "H3701", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 5, "word_orig": "בַּ/קָּנֶ֣ה", "strong": "H7070", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "neraca"}, {"pos": 6, "word_orig": "יִשְׁקֹ֑לוּ", "strong": "H8254", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menimbang"}, {"pos": 7, "word_orig": "יִשְׂכְּר֤וּ", "strong": "H7936", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mengupah"}, {"pos": 8, "word_orig": "צוֹרֵף֙", "strong": "H6884", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "pandai"}, {"pos": 9, "word_orig": "וְ/יַעֲשֵׂ֣/הוּ", "strong": "H6213", "morph": "HC/Vqi3ms/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "membuatnya"}, {"pos": 10, "word_orig": "אֵ֔ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dewa"}, {"pos": 11, "word_orig": "יִסְגְּד֖וּ", "strong": "H5456", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "sujud"}, {"pos": 12, "word_orig": "אַף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": "Kemudian"}, {"pos": 13, "word_orig": "יִֽשְׁתַּחֲוּֽוּ", "strong": "H7812", "morph": "HVvi3mp", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menyembahnya"}]}, {"book": 23, "chapter": 46, "verse": 7, "ayat_id": 18594, "title": "", "ayt_text": "Mereka mengangkatnya ke atas bahu dan membawanya. Mereka akan menempatkannya di tempatnya, jadi berdirilah ia di sana. Ia tidak dapat bergerak dari tempatnya. Sekalipun seseorang menangis kepadanya, patung itu tidak dapat menjawab ataupun membebaskan orang itu dari masalahnya.", "words": [{"pos": 1, "word_orig": "יִ֠שָּׂאֻ/הוּ", "strong": "H5375", "morph": "HVqi3mp/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp3ms", "ayt_word": "mengangkatnya"}, {"pos": 2, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 3, "word_orig": "כָּתֵ֨ף", "strong": "H3802", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bahu"}, {"pos": 4, "word_orig": "יִסְבְּלֻ֜/הוּ", "strong": "H5445", "morph": "HVqi3mp/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp3ms", "ayt_word": "membawanya"}, {"pos": 5, "word_orig": "וְ/יַנִּיחֻ֤/הוּ", "strong": "H3240", "morph": "HC/Vhi3mp/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak + Sp3ms", "ayt_word": "menempatkannya"}, {"pos": 6, "word_orig": "תַחְתָּי/ו֙", "strong": "H8478", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "di"}, {"pos": 7, "word_orig": "וְ/יַֽעֲמֹ֔ד", "strong": "H5975", "morph": "HC/Vqi3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdirilah"}, {"pos": 8, "word_orig": "מִ/מְּקוֹמ֖/וֹ", "strong": "H4725", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "dari"}, {"pos": 9, "word_orig": "לֹ֣א", "strong"