[{"book": 23, "chapter": 3, "verse": 1, "ayat_id": 17709, "title": "Hukuman TUHAN terhadap Penyesat", "ayt_text": "Lihatlah, TUHAN, Allah semesta alam, akan mengambil dari Yerusalem dan Yehuda, semua persediaan dan dukungan, semua persediaan roti dan semua persediaan air,", "words": [{"pos": 1, "word_orig": "כִּי֩", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "הִנֵּ֨ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 3, "word_orig": "הָ/אָד֜וֹן", "strong": "H113", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Allah"}, {"pos": 5, "word_orig": "צְבָא֗וֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "alam"}, {"pos": 6, "word_orig": "מֵסִ֤יר", "strong": "H5493", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "mengambil"}, {"pos": 7, "word_orig": "מִ/ירוּשָׁלִַ֨ם֙", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}, {"pos": 8, "word_orig": "וּ/מִ֣/יהוּדָ֔ה", "strong": "H3063", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "Yehuda"}, {"pos": 9, "word_orig": "מַשְׁעֵ֖ן", "strong": "H4937", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "persediaan"}, {"pos": 10, "word_orig": "וּ/מַשְׁעֵנָ֑ה", "strong": "H4938", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "dukungan"}, {"pos": 11, "word_orig": "כֹּ֚ל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 12, "word_orig": "מִשְׁעַן", "strong":