, "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "penatua"}]}, {"book": 23, "chapter": 3, "verse": 3, "ayat_id": 17711, "title": "", "ayt_text": "kepala pasukan lima puluh dan orang-orang terhormat, para penasihat dan tukang sihir, serta para ahli mantra.", "words": [{"pos": 1, "word_orig": "שַׂר", "strong": "H8269", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pasukan"}, {"pos": 2, "word_orig": "חֲמִשִּׁ֖ים", "strong": "H2572", "morph": "HAcbpa", "morph_id": "Acbpa", "ayt_word": "puluh"}, {"pos": 3, "word_orig": "וּ/נְשׂ֣וּא", "strong": "H5375", "morph": "HC/Vqsmsc", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Pasif", "ayt_word": "terhormat"}, {"pos": 4, "word_orig": "פָנִ֑ים", "strong": "H6440", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "orang-orang"}, {"pos": 5, "word_orig": "וְ/יוֹעֵ֛ץ", "strong": "H3289", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "penasihat"}, {"pos": 6, "word_orig": "וַ/חֲכַ֥ם", "strong": "H2450", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "sihir"}, {"pos": 7, "word_orig": "חֲרָשִׁ֖ים", "strong": "H2791", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "tukang"}, {"pos": 8, "word_orig": "וּ/נְב֥וֹן", "strong": "H995", "morph": "HC/VNrmsc", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "ahli"}, {"pos": 9, "word_orig": "לָֽחַשׁ", "strong": "H3908", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mantra"}]}, {"book": 23, "chapter": 3, "verse": 4, "ayat_id": 17712, "title": "", "ayt_text": "“Aku akan membuat orang-orang muda menjadi pemimpin mereka, dan anak-anak akan memerintah atas mereka.", "words": [{"pos": 1, "word_orig": "וְ/נָתַתִּ֥י", "strong": "H5414", "morph": "HC/Vqq1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-1 Tunggal", "ayt_word": "membuat"}, {"pos": 2, "word_orig": "נְעָרִ֖ים", "strong": "H5288", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "muda"}, {"pos": 3, "word_orig": "שָׂרֵי/הֶ֑ם", "strong": "H8269", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "pemimpin"}, {"pos": 4, "word_orig": "וְ/תַעֲלוּלִ֖ים", "strong": "H8586", "morph": "HC/Ncmpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "anak-anak"}, {"pos": 5, "word_orig": "יִמְשְׁלוּ", "strong": "H4910", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memerintah"}, {"pos": 6, "word_orig": "בָֽ/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 23, "chapter": 3, "verse": 5, "ayat_id": 17713, "title": "", "ayt_text": "Orang-orang itu akan menindas satu sama lain dan oleh saudara mereka; yang muda akan kurang ajar terhadap yang tua, dan yang hina terhadap yang mulia.”", "words": [{"pos": 1, "word_orig": "וְ/נִגַּ֣שׂ", "strong": "H5065", "morph": "HC/VNq3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menindas"}, {"pos": 2, "word_orig": "הָ/עָ֔ם", "strong": "H5971", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Orang-orang"}, {"pos": 3, "word_orig": "אִ֥ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sama"}, {"pos": 4, "word_orig": "בְּ/אִ֖ישׁ", "strong": "H376", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "satu"}, {"pos": 5, "word_orig": "וְ/אִ֣ישׁ", "strong": "H376", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sama"}, {"pos": 6, "word_orig": "בְּ/רֵעֵ֑/הוּ", "strong": "H7453", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "saudara"}, {"pos": 7, "word_orig": "יִרְהֲב֗וּ", "strong": "H7292", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "kurang"}, {"pos": 8, "word_orig": "הַ/נַּ֨עַר֙", "strong": "H5288", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "muda"}, {"pos": 9, "word_orig": "בַּ/זָּקֵ֔ן", "strong": "H2205", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "tua"}, {"pos": 10, "word_orig": "וְ/הַ/נִּקְלֶ֖ה", "strong": "H7034", "morph": "HC/Td/VNrmsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Verba Nifal", "ayt_word": "hina"}, {"pos": 11, "word_orig": "בַּ/נִּכְבָּֽד", "strong": "H3513", "morph": "HRd/VNsmsa", "morph_id": "Rd + Verba Nifal Partisip Pasif", "ayt_word": "mulia"}]}, {"book": 23, "chapter": 3, "verse": 6, "ayat_id": 17714, "title": "", "ayt_text": "Ketika seorang laki-laki memegang saudaranya dari keluarganya sendiri dan berkata kepadanya, “Kamu masih punya sehelai baju, kamu harus menjadi pemimpin kami, semua reruntuhan ini berada di bawah kekuasaanmu.”", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Ketika"}, {"pos": 2, "word_orig": "יִתְפֹּ֨שׂ", "strong": "H8610", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memegang"}, {"pos": 3, "word_orig": "אִ֤ישׁ", "strong": "H376", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laki-laki"}, {"pos": 4, "word_orig": "בְּ/אָחִי/ו֙", "strong": "H251", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "saudaranya"}, {"pos": 5, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keluarganya"}, {"pos": 6, "word_orig": "אָבִ֔י/ו", "strong": "H1", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "keluarganya"}, {"pos": 7, "word_orig": "שִׂמְלָ֣ה", "strong": "H8071", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "baju"}, {"pos": 8, "word_orig": "לְ/כָ֔ה", "strong": "", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": ""}, {"pos": 9, "word_orig": "קָצִ֖ין", "strong": "H7101", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pemimpin"}, {"pos": 10, "word_orig": "תִּֽהְיֶה", "strong": "H1961", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 11, "word_orig": "לָּ֑/נוּ", "strong": "", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": ""}, {"pos": 12, "word_orig": "וְ/הַ/מַּכְשֵׁלָ֥ה", "strong": "H4384", "morph": "HC/Td/Ncfsa", "morph_id": "Konjungsi (וְ) + Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "reruntuhan"}, {"pos": 13, "word_orig": "הַ/זֹּ֖את", "strong": "H2063", "morph": "HTd/Pdxfs", "morph_id": "Artikel Definit (הַ) + Pdxfs", "ayt_word": "ini"}, {"pos": 14, "word_orig": "תַּ֥חַת", "strong": "H8478", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 15, "word_orig": "יָדֶֽ/ךָ", "strong": "H3027", "morph": "HNcbsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "kekuasaanmu"}]}, {"book": 23, "chapter": 3, "verse": 7, "ayat_id": 17715, "title": "", "ayt_text": "Namun, pada waktu itu, dia akan menolak dan berkata, “Aku tidak dapat menjadi penyembuhmu, di rumahku tidak ada roti ataupun pakaian. Jangan buat aku menjadi pemimpin bangs