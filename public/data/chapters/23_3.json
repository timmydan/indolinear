"ayt_word": "ditimpakan"}, {"pos": 8, "word_orig": "לּֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 23, "chapter": 3, "verse": 12, "ayat_id": 17720, "title": "", "ayt_text": "Oh, bangsaku! Anak-anaklah yang menjadi penindas mereka, dan perempuan-perempuanlah yang memerintah atas mereka. Oh, bangsaku, para pemimpinmu menyesatkan engkau, dan mereka telah mengacaukan jalan yang seharusnya kamu lalui.", "words": [{"pos": 1, "word_orig": "עַמִּ/י֙", "strong": "H5971", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "bangsaku"}, {"pos": 2, "word_orig": "נֹגְשָׂ֣י/ו", "strong": "H5065", "morph": "HVqrmpc/Sp3ms", "morph_id": "Verba Qal + Sp3ms", "ayt_word": "penindas"}, {"pos": 3, "word_orig": "מְעוֹלֵ֔ל", "strong": "H5953", "morph": "HVmrmsa", "morph_id": "Verba", "ayt_word": "Anak-anaklah"}, {"pos": 4, "word_orig": "וְ/נָשִׁ֖ים", "strong": "H802", "morph": "HC/Ncfpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "perempuan-perempuanlah"}, {"pos": 5, "word_orig": "מָ֣שְׁלוּ", "strong": "H4910", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "memerintah"}, {"pos": 6, "word_orig": "ב֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 7, "word_orig": "עַמִּ/י֙", "strong": "H5971", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "bangsaku"}, {"pos": 8, "word_orig": "מְאַשְּׁרֶ֣י/ךָ", "strong": "H833", "morph": "HVprmpc/Sp2ms", "morph_id": "Verba Piel + Sp2ms", "ayt_word": "pemimpinmu"}, {"pos": 9, "word_orig": "מַתְעִ֔ים", "strong": "H8582", "morph": "HVhrmpa", "morph_id": "Verba Hifil", "ayt_word": "menyesatkan"}, {"pos": 10, "word_orig": "וְ/דֶ֥רֶךְ", "strong": "H1870", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terika