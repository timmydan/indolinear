ong": "H1280", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "palang-palang"}]}, {"book": 34, "chapter": 3, "verse": 14, "ayat_id": 22727, "title": "", "ayt_text": "Timbalah air untuk menghadapi pengepungan, kuatkanlah kubu-kubumu! Pijaklah tanah liat, injak-injaklah lumpur, kuatkanlah cetakan batu bata!", "words": [{"pos": 1, "word_orig": "מֵ֤י", "strong": "H4325", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "air"}, {"pos": 2, "word_orig": "מָצוֹר֙", "strong": "H4692", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengepungan"}, {"pos": 3, "word_orig": "שַֽׁאֲבִי", "strong": "H7579", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Timbalah"}, {"pos": 4, "word_orig": "לָ֔/ךְ", "strong": "", "morph": "HR/Sp2fs", "morph_id": "Preposisi + Sp2fs", "ayt_word": ""}, {"pos": 5, "word_orig": "חַזְּקִ֖י", "strong": "H2388", "morph": "HVpv2fs", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "kuatkanlah"}, {"pos": 6, "word_orig": "מִבְצָרָ֑יִ/ךְ", "strong": "H4013", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "kubu-kubumu"}, {"pos": 7, "word_orig": "בֹּ֧אִי", "strong": "H935", "morph": "HVqv2fs", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "injak-injaklah"}, {"pos": 8, "word_orig": "בַ/טִּ֛יט", "strong": "H2916", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "lumpur"}, {"pos": 9, "word_orig": "וְ/רִמְסִ֥י", "strong": "H7429", "morph": "HC/Vqv2fs", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "Pijaklah"}, {"pos": 10, "word_orig": "בַ/חֹ֖מֶר", "strong": "H2563", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "liat"}, {"pos": 11, "word_orig": "הַחֲזִ֥יקִי", "strong": "H2388", "morph": "HVhv2fs", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "kuatkanlah"}, {"pos": 12, "word_orig": "מַלְבֵּֽן", "strong": "H4404", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "batu"}]}, {"book": 34, "chapter": 3, "verse": 15, "ayat_id": 22728, "title": "", "ayt_text": "Di sana, api akan melalapmu, pedang akan melahapmu, dan memakanmu seperti belalang pelahap. Perbesar jumlahmu seperti belalang pelahap, perbanyak dirimu seperti belalang pindahan.", "words": [{"pos": 1, "word_orig": "שָׁ֚ם", "strong": "H8033", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "sana"}, {"pos": 2, "word_orig": "תֹּאכְלֵ֣/ךְ", "strong": "H398", "morph": "HVqi3fs/Sp2fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp2fs", "ayt_word": "melalapmu"}, {"pos": 3, "word_orig": "אֵ֔שׁ", "strong": "H784", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "api"}, {"pos": 4, "word_orig": "תַּכְרִיתֵ֣/ךְ", "strong": "H3772", "morph": "HVhi3fs/Sp2fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal + Sp2fs", "ayt_word": "melahapmu"}, {"pos": 5, "word_orig": "חֶ֔רֶב", "strong": "H2719", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 6, "word_orig": "תֹּאכְלֵ֖/ךְ", "strong": "H398", "morph": "HVqi3fs/Sp2fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp2fs", "ayt_word": "memakanmu"}, {"pos": 7, "word_orig": "כַּ/יָּ֑לֶק", "strong": "H3218", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "belalang"}, {"pos": 8, "word_orig": "הִתְכַּבֵּ֣ד", "strong": "H3513", "morph": "HVtv2ms", "morph_id": "Verba Hitpael Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "jumlahmu"}, {"pos": 9, "word_orig": "כַּ/יֶּ֔לֶק", "strong": "H3218", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelahap"}, {"pos": 10, "word_orig": "הִֽתְכַּבְּדִ֖י", "strong": "H3513", "morph": "HVtv2fs", "morph_id": "Verba Hitpael Partisip Aktif Orang ke-2 Perempuan Tunggal", "ayt_word": "dirimu"}, {"pos": 11, "word_orig": "כָּ/אַרְבֶּֽה", "strong": "H697", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pindahan"}]}, {"book": 34, "chapter": 3, "verse": 16, "ayat_id": 22729, "title": "", "ayt_text": "Kamu memperbanyak pedagang-pedagangmu melebihi bintang-bintang di langit. Seperti belalang pelompat yang mengembangkan sayap, lalu terbang.", "words": [{"pos": 1, "word_orig": "הִרְבֵּית֙", "strong": "H7235", "morph": "HVhp2fs", "morph_id": "Verba Hifil Perfek Orang ke-2 Perempuan Tunggal", "ayt_word": "memperbanyak"}, {"pos": 2, "word_orig": "רֹֽכְלַ֔יִ/ךְ", "strong": "H7402", "morph": "HVqrmpc/Sp2fs", "morph_id": "Verba Qal + Sp2fs", "ayt_word": "pedagang-pedagangmu"}, {"pos": 3, "word_orig": "מִ/כּוֹכְבֵ֖י", "strong": "H3556", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "bintang-bintang"}, {"pos": 4, "word_orig": "הַ/שָּׁמָ֑יִם", "strong": "H8064", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 5, "word_orig": "יֶ֥לֶק", "strong": "H3218", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "belalang"}, {"pos": 6, "word_orig": "פָּשַׁ֖ט", "strong": "H6584", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengembangkan"}, {"pos": 7, "word_orig": "וַ/יָּעֹֽף", "strong": "H5774", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terbang"}]}, {"book": 34, "chapter": 3, "verse": 17, "ayat_id": 22730, "title": "", "ayt_text": "Para pembesarmu seperti belalang pindahan, dan para panglimamu seperti kawanan belalang, yang hinggap di tembok-tembok pada musim dingin. Akan tetapi, ketika matahari terbit, mereka lari menghilang dan tidak diketahui lagi tempatnya.", "words": [{"pos": 1, "word_orig": "מִנְּזָרַ֨יִ/ךְ֙", "strong": "H4502", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "pembesarmu"}, {"pos": 2, "word_orig": "כָּֽ/אַרְבֶּ֔ה", "strong": "H697", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pindahan"}, {"pos": 3, "word_orig": "וְ/טַפְסְרַ֖יִ/ךְ", "strong": "H2951", "morph": "HC/Ncmpc/Sp2fs", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "panglimamu"}, {"pos": 4, "word_orig": "כְּ/ג֣וֹב", "strong": "H1462", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kawanan"}, {"pos": 5, "word_orig": "גֹּבָ֑י", "strong": "H1462", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "belalang"}, {"pos": 6, "word_orig": "הַֽ/חוֹנִ֤ים", "strong": "H2583", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "hinggap"}, {"pos": 7, "word_orig": "בַּ/גְּדֵרוֹת֙", "strong": "H1448", "morph": "HRd/Ncfpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "tembok-tembok"}, {"pos": 8, "word_orig": "בְּ/י֣וֹם", "strong": "H3117", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "musim"}, {"pos": 9, "word_orig": "קָרָ֔ה", "strong": "H7135", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tu