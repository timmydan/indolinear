[{"book": 34, "chapter": 3, "verse": 1, "ayat_id": 22714, "title": "Hukuman bagi Niniwe", "ayt_text": "Celakalah kota penumpah darah! Seluruhnya kebohongan belaka, penuh dengan rampasan, yang mangsanya tidak pernah lolos!", "words": [{"pos": 1, "word_orig": "ה֖וֹי", "strong": "H1945", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Celakalah"}, {"pos": 2, "word_orig": "עִ֣יר", "strong": "H5892", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kota"}, {"pos": 3, "word_orig": "דָּמִ֑ים", "strong": "H1818", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "darah"}, {"pos": 4, "word_orig": "כֻּלָּ֗/הּ", "strong": "H3605", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "Seluruhnya"}, {"pos": 5, "word_orig": "כַּ֤חַשׁ", "strong": "H3585", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kebohongan"}, {"pos": 6, "word_orig": "פֶּ֨רֶק֙", "strong": "H6563", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rampasan"}, {"pos": 7, "word_orig": "מְלֵאָ֔ה", "strong": "H4395", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "penuh"}, {"pos": 8, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "pernah"}, {"pos": 9, "word_orig": "יָמִ֖ישׁ", "strong": "H4185", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "lolos"}, {"pos": 10, "word_orig": "טָֽרֶף", "strong": "H2964", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mangsanya"}]}, {"book": 34, "chapter": 3, "verse": 2, "ayat_id": 22715, "title": "", "ayt_text": "Suara cambukan dan derak-derik roda! Kuda lari menderap dan kereta melompat-lompat!", "words": [{"pos": 1, "word_orig": "ק֣וֹל", "strong": "H6963", "morph": "