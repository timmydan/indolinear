id": "Aampc + Sp3fs", "ayt_word": "pembesarnya"}, {"pos": 18, "word_orig": "רֻתְּק֥וּ", "strong": "H7576", "morph": "HVPp3cp", "morph_id": "Verba Pual Perfek Orang ke-3 Jamak", "ayt_word": "dibelenggu"}, {"pos": 19, "word_orig": "בַ/זִּקִּֽים", "strong": "H2131", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "rantai"}]}, {"book": 34, "chapter": 3, "verse": 11, "ayat_id": 22724, "title": "", "ayt_text": "Kamu juga akan menjadi mabuk, kamu akan bersembunyi, engkau juga akan mencari tempat perlindungan terhadap musuh.", "words": [{"pos": 1, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "juga"}, {"pos": 2, "word_orig": "אַ֣תְּ", "strong": "H859", "morph": "HPp2fs", "morph_id": "Pp2fs", "ayt_word": "Kamu"}, {"pos": 3, "word_orig": "תִּשְׁכְּרִ֔י", "strong": "H7937", "morph": "HVqi2fs", "morph_id": "Verba Qal Imperfek Orang ke-2 Perempuan Tunggal", "ayt_word": "menjadi"}, {"pos": 4, "word_orig": "תְּהִ֖י", "strong": "H1961", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "akan"}, {"pos": 5, "word_orig": "נַֽעֲלָמָ֑ה", "strong": "H5956", "morph": "HVNsfsa", "morph_id": "Verba Nifal Partisip Pasif", "ayt_word": "bersembunyi"}, {"pos": 6, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "juga"}, {"pos": 7, "word_orig": "אַ֛תְּ", "strong": "H859", "morph": "HPp2fs", "morph_id": "Pp2fs", "ayt_word": "engkau"}, {"pos": 8, "word_orig": "תְּבַקְשִׁ֥י", "strong": "H1245", "morph": "HVpi2fs", "morph_id": "Verba Piel Imperfek Orang ke-2 Perempuan Tunggal", "ayt_word": "mencari"}, {"pos": 9, "word_orig": "מָע֖וֹז", "strong": "H4581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perlindungan"}, {"pos": 10, "word_orig": "מֵ/אוֹיֵֽב", "strong": "H341", "morph": "HR/Vqrmsa", "morph_id": "Preposisi + Verba Qal", "ayt_word": "musuh"}]}, {"book": 34, "chapter": 3, "verse": 12, "ayat_id": 22725, "title": "", "ayt_text": "Semua kubumu seperti pohon ara dengan buah ara pertama. Jika diayunkan, jatuhlah buahnya ke dalam mulut pemakannya.", "words": [{"pos": 1, "word_orig": "כָּ֨ל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Semua"}, {"pos": 2, "word_orig": "מִבְצָרַ֔יִ/ךְ", "strong": "H4013", "morph": "HNcmpc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2fs", "ayt_word": "kubumu"}, {"pos": 3, "word_orig": "תְּאֵנִ֖ים", "strong": "H8384", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "ara"}, {"pos": 4, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dengan"}, {"pos": 5, "word_orig": "בִּכּוּרִ֑ים", "strong": "H1061", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "buah"}, {"pos": 6, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 7, "word_orig": "יִנּ֕וֹעוּ", "strong": "H5128", "morph": "HVNi3mp", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "diayunkan"}, {"pos": 8, "word_orig": "וְ/נָפְל֖וּ", "strong": "H5307", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "jatuhlah"}, {"pos": 9, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dalam"}, {"pos": 10, "word_orig": "פִּ֥י", "strong": "H6310", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 11, "word_orig": "אוֹכֵֽל", "strong": "H398", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "pemakannya"}]}, {"book": 34, "chapter": 3, "verse": 13, "ayat_id": 22726, "title": "", "ayt_text": "Sesungguhnya, pasukan yang berada di tengah-tengahmu ada