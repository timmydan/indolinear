": "וּ/מִצְרַ֖יִם", "strong": "H4714", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Mesir"}, {"pos": 4, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tanpa"}, {"pos": 5, "word_orig": "קֵ֑צֶה", "strong": "H7097", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "batas"}, {"pos": 6, "word_orig": "פּ֣וּט", "strong": "H6316", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Put"}, {"pos": 7, "word_orig": "וְ/לוּבִ֔ים", "strong": "H3864", "morph": "HC/Ngmpa", "morph_id": "Konjungsi (וְ) + Nomina Laki-laki Jamak Absolut", "ayt_word": "Libia"}, {"pos": 8, "word_orig": "הָי֖וּ", "strong": "H1961", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "adalah"}, {"pos": 9, "word_orig": "בְּ/עֶזְרָתֵֽ/ךְ", "strong": "H5833", "morph": "HR/Ncfsc/Sp2fs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "penolongnya"}]}, {"book": 34, "chapter": 3, "verse": 10, "ayat_id": 22723, "title": "", "ayt_text": "Akan tetapi, ia sendiri pergi ke dalam pembuangan, sebagai tawanan. Anak-anaknya diremukkan kepalanya di ujung setiap jalan. Orang membuang undi atas orang-orang yang dihormati, dan semua pembesarnya dibelenggu dengan rantai.", "words": [{"pos": 1, "word_orig": "גַּם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "הִ֗יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "ia"}, {"pos": 3, "word_orig": "לַ/גֹּלָה֙", "strong": "H1473", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pembuangan"}, {"pos": 4, "word_orig": "הָלְכָ֣ה", "strong": "H1980", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "pergi"}, {"pos": 5, "word_orig": "בַ/שֶּׁ֔בִי", "strong": "H7628", "morph": "H