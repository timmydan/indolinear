", "ayt_word": "menyerang"}, {"pos": 3, "word_orig": "וְ/לַ֤הַב", "strong": "H3851", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "menyala-nyala"}, {"pos": 4, "word_orig": "חֶ֨רֶב֙", "strong": "H2719", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pedang"}, {"pos": 5, "word_orig": "וּ/בְרַ֣ק", "strong": "H1300", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "berkilat-kilat"}, {"pos": 6, "word_orig": "חֲנִ֔ית", "strong": "H2595", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tombak"}, {"pos": 7, "word_orig": "וְ/רֹ֥ב", "strong": "H7230", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Banyak"}, {"pos": 8, "word_orig": "חָלָ֖ל", "strong": "H2491", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "terbunuh"}, {"pos": 9, "word_orig": "וְ/כֹ֣בֶד", "strong": "H3514", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "bertimbun-timbun"}, {"pos": 10, "word_orig": "פָּ֑גֶר", "strong": "H6297", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bangkainya"}, {"pos": 11, "word_orig": "וְ/אֵ֥ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "Tidak"}, {"pos": 12, "word_orig": "קֵ֨צֶה֙", "strong": "H7097", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "habisnya"}, {"pos": 13, "word_orig": "לַ/גְּוִיָּ֔ה", "strong": "H1472", "morph": "HRd/Ncfsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "mayat-mayat"}, {"pos": 14, "word_orig": "יכשלו", "strong": "H3782", "morph": "HVNi3mp", 