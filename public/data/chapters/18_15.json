word": "membohongi"}, {"pos": 5, "word_orig": "נִתְעָ֑ה", "strong": "H8582", "morph": "HVNp3ms", "morph_id": "Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "karena"}, {"pos": 6, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "kesia-siaan"}, {"pos": 7, "word_orig": "שָׁ֝֗וְא", "strong": "H7723", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "menjadi"}, {"pos": 8, "word_orig": "תִּהְיֶ֥ה", "strong": "H1961", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "upahnya"}, {"pos": 9, "word_orig": "תְמוּרָתֽ/וֹ", "strong": "H8545", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": ""}]}, {"book": 18, "chapter": 15, "verse": 32, "ayat_id": 13236, "title": "", "ayt_text": "Hal ini akan digenapi sebelum waktunya, dan ranting-rantingnya tidak akan menjadi hijau.", "words": [{"pos": 1, "word_orig": "בְּֽ/לֹא", "strong": "H3808", "morph": "HR/Tn", "morph_id": "Preposisi + Tn", "ayt_word": "sebelum"}, {"pos": 2, "word_orig": "י֭וֹמ/וֹ", "strong": "H3117", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "waktunya"}, {"pos": 3, "word_orig": "תִּמָּלֵ֑א", "strong": "H4390", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "digenapi"}, {"pos": 4, "word_orig": "וְ֝/כִפָּת֗/וֹ", "strong": "H3712", "morph": "HC/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ranting-rantingnya"}, {"pos": 5, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "רַעֲנָֽנָה", "strong": "H7488", "morph": "HVkp3fs", "morph_id": "Verba Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "hijau"}]}, {"book": 18, "chapter": 15, "verse": 33, "ayat_id": 13237, "title": "", "ayt_text": "Dia akan menggugurkan buah anggurnya yang belum matang, seperti pohon anggur, dan akan merontokkan kuncup bunganya, seperti pohon zaitun.", "words": [{"pos": 1, "word_orig": "יַחְמֹ֣ס", "strong": "H2554", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menggugurkan"}, {"pos": 2, "word_orig": "כַּ/גֶּ֣פֶן", "strong": "H1612", "morph": "HRd/Ncbsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "pohon"}, {"pos": 3, "word_orig": "בִּסְר֑/וֹ", "strong": "H1154", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "yang"}, {"pos": 4, "word_orig": "וְ/יַשְׁלֵ֥ךְ", "strong": "H7993", "morph": "HC/Vhi3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merontokkan"}, {"pos": 5, "word_orig": "כַּ֝/זַּ֗יִת", "strong": "H2132", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "zaitun"}, {"pos": 6, "word_orig": "נִצָּתֽ/וֹ", "strong": "H5328", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "bunganya"}]}, {"book": 18, "chapter": 15, "verse": 34, "ayat_id": 13238, "title": "", "ayt_text": "Sebab, kumpulan orang tidak beriman itu mandul, dan api akan membakar tenda-tenda penerima suap.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "עֲדַ֣ת", "strong": "H5712", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kumpulan"}, {"pos": 3, "word_orig": "חָנֵ֣ף", "strong": "H2611", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 4, "word_orig": "גַּלְמ֑וּד", "strong": "H1565", "morph": "HAamsa", "morp