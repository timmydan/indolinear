ah"}, {"pos": 8, "word_orig": "יְשֹׁדֵ֖ד", "strong": "H7703", "morph": "HVmi3ms", "morph_id": "Verba Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "meruntuhkan"}, {"pos": 9, "word_orig": "מַצֵּבוֹתָֽ/ם", "strong": "H4676", "morph": "HNcfpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "tugu-tugu"}]}, {"book": 28, "chapter": 10, "verse": 3, "ayat_id": 22229, "title": "", "ayt_text": "Sekarang mereka akan berkata, “Kita tidak mempunyai raja karena kita tidak takut kepada TUHAN. Akan tetapi, apa yang dapat diperbuat raja bagi kita?”", "words": [{"pos": 1, "word_orig": "כִּ֤י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "עַתָּה֙", "strong": "H6258", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Sekarang"}, {"pos": 3, "word_orig": "יֹֽאמְר֔וּ", "strong": "H559", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "berkata"}, {"pos": 4, "word_orig": "אֵ֥ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "מֶ֖לֶךְ", "strong": "H4428", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "raja"}, {"pos": 6, "word_orig": "לָ֑/נוּ", "strong": "", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": ""}, {"pos": 7, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 8, "word_orig": "לֹ֤א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "יָרֵ֨אנוּ֙", "strong": "H3372", "morph": "HVqp1cp", "morph_id": "Verba Qal Perfek Orang ke-1 Jamak", "ayt_word": "takut"}, {"pos": 10, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 11, "word_orig": "יְהֹוָ֔ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUH