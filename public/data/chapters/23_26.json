tan"}, {"pos": 3, "word_orig": "פְּקָד֑וּ/ךָ", "strong": "H6485", "morph": "HVqp3cp/Sp2ms", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp2ms", "ayt_word": "mencari"}, {"pos": 4, "word_orig": "צָק֣וּ/ן", "strong": "H6694", "morph": "HVqp3cp/Sn", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sn", "ayt_word": "menumpahkan"}, {"pos": 5, "word_orig": "לַ֔חַשׁ", "strong": "H3908", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "doa"}, {"pos": 6, "word_orig": "מוּסָרְ/ךָ֖", "strong": "H4148", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "hajaran-Mu"}, {"pos": 7, "word_orig": "לָֽ/מוֹ", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}]}, {"book": 23, "chapter": 26, "verse": 17, "ayat_id": 18148, "title": "", "ayt_text": "Seperti perempuan mengandung yang menggeliat kesakitan, berteriak-teriak karena mendekati waktu melahirkan, demikianlah kami dahulu di hadapan-Mu, ya TUHAN.", "words": [{"pos": 1, "word_orig": "כְּמ֤וֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Seperti"}, {"pos": 2, "word_orig": "הָרָה֙", "strong": "H2030", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "mengandung"}, {"pos": 3, "word_orig": "תַּקְרִ֣יב", "strong": "H7126", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mendekati"}, {"pos": 4, "word_orig": "לָ/לֶ֔דֶת", "strong": "H3205", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melahirkan"}, {"pos": 5, "word_orig": "תָּחִ֥יל", "strong": "H2342", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menggeliat"}, {"pos": 6, "word_orig": "תִּזְעַ֖ק", "strong": "H2199", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "berteriak-teriak"}, {"pos": 7, "word_orig": "בַּ/חֲבָלֶ֑י/הָ", 