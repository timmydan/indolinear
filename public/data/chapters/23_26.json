26, "verse": 7, "ayat_id": 18138, "title": "", "ayt_text": "Jalan orang benar itu lurus. Yang Mahatulus, ratakanlah jalan orang benar.", "words": [{"pos": 1, "word_orig": "אֹ֥רַח", "strong": "H734", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Jalan"}, {"pos": 2, "word_orig": "לַ/צַּדִּ֖יק", "strong": "H6662", "morph": "HRd/Aamsa", "morph_id": "Rd + Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "מֵֽישָׁרִ֑ים", "strong": "H4339", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "lurus"}, {"pos": 4, "word_orig": "יָשָׁ֕ר", "strong": "H3477", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Yang"}, {"pos": 5, "word_orig": "מַעְגַּ֥ל", "strong": "H4570", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 6, "word_orig": "צַדִּ֖יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "תְּפַלֵּֽס", "strong": "H6424", "morph": "HVpi2ms", "morph_id": "Verba Piel Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "ratakanlah"}]}, {"book": 23, "chapter": 26, "verse": 8, "ayat_id": 18139, "title": "", "ayt_text": "Di jalan keadilan-Mu, ya TUHAN, kami telah menantikan Engkau. Nama-Mu dan kemasyhuran-Mu adalah kesukaan hati kami.", "words": [{"pos": 1, "word_orig": "אַ֣ף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "אֹ֧רַח", "strong": "H734", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 3, "word_orig": "מִשְׁפָּטֶ֛י/ךָ", "strong": "H4941", "morph": "HNcmpc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp2ms", "ayt_word": "keadilan-Mu"}, {"pos": 4, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "wor