melalap"}]}, {"book": 23, "chapter": 26, "verse": 12, "ayat_id": 18143, "title": "", "ayt_text": "TUHAN, Engkau akan menetapkan damai sejahtera bagi kami, karena Engkau jugalah yang mengerjakan bagi kami, semua pekerjaan kami.", "words": [{"pos": 1, "word_orig": "יְהוָ֕ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "תִּשְׁפֹּ֥ת", "strong": "H8239", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "menetapkan"}, {"pos": 3, "word_orig": "שָׁל֖וֹם", "strong": "H7965", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "damai"}, {"pos": 4, "word_orig": "לָ֑/נוּ", "strong": "", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": ""}, {"pos": 5, "word_orig": "כִּ֛י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 6, "word_orig": "גַּ֥ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": "jugalah"}, {"pos": 7, "word_orig": "כָּֽל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 8, "word_orig": "מַעֲשֵׂ֖י/נוּ", "strong": "H4639", "morph": "HNcmpc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cp", "ayt_word": "pekerjaan"}, {"pos": 9, "word_orig": "פָּעַ֥לְתָּ", "strong": "H6466", "morph": "HVqp2ms", "morph_id": "Verba Qal Perfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "mengerjakan"}, {"pos": 10, "word_orig": "לָּֽ/נוּ", "strong": "", "morph": "HR/Sp1cp", "morph_id": "Preposisi + Sp1cp", "ayt_word": ""}]}, {"book": 23, "chapter": 26, "verse": 13, "ayat_id": 18144, "title": "Allah Memberikan Hidup Baru", "ayt_text": "Ya TUHAN, Allah kami, tuan-tuan lain selain Engkau pernah memerintah kami. Akan tetapi, hanya nama-Mu saja yang kami sebut.", "words": [{"pos": 1, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "אֱלֹהֵ֔י/נוּ", "strong": "H430", "morph": "HNcmpc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cp", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "בְּעָל֥וּ/נוּ", "strong": "H1166", "morph": "HVqp3cp/Sp1cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak + Sp1cp", "ayt_word": "memerintah"}, {"pos": 4, "word_orig": "אֲדֹנִ֖ים", "strong": "H113", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "tuan-tuan"}, {"pos": 5, "word_orig": "זֽוּלָתֶ֑/ךָ", "strong": "H2108", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": "selain"}, {"pos": 6, "word_orig": "לְ/בַד", "strong": "H905", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hanya"}, {"pos": 7, "word_orig": "בְּ/ךָ֖", "strong": "", "morph": "HR/Sp2ms", "morph_id": "Preposisi + Sp2ms", "ayt_word": ""}, {"pos": 8, "word_orig": "נַזְכִּ֥יר", "strong": "H2142", "morph": "HVhi1cp", "morph_id": "Verba Hifil Imperfek Orang ke-1 Jamak", "ayt_word": "sebut"}, {"pos": 9, "word_orig": "שְׁמֶֽ/ךָ", "strong": "H8034", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "nama-Mu"}]}, {"book": 23, "chapter": 26, "verse": 14, "ayat_id": 18145, "title": "", "ayt_text": "Mereka telah mati, tidak akan hidup lagi. Mereka telah menjadi arwah, tidak akan bangkit lagi. Demikianlah Engkau telah menghukum dan memusnahkan mereka, serta menghapus segala ingatan tentang mereka.", "words": [{"pos": 1, "word_orig": "מֵתִים֙", "strong": "H4191", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "mati"}, {"pos": 2, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "יִחְי֔וּ", "strong": "H2421", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Oran