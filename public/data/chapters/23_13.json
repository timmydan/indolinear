": "לִ/מְקֻדָּשָׁ֑/י", "strong": "H6942", "morph": "HR/VPsmpc/Sp1cs", "morph_id": "Preposisi + Verba Pual Partisip Pasif + Sp1cs", "ayt_word": "Kutahbiskan"}, {"pos": 4, "word_orig": "גַּ֣ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 5, "word_orig": "קָרָ֤אתִי", "strong": "H7121", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "memanggil"}, {"pos": 6, "word_orig": "גִבּוֹרַ/י֙", "strong": "H1368", "morph": "HAampc/Sp1cs", "morph_id": "Aampc + Sp1cs", "ayt_word": "pahlawan-Ku"}, {"pos": 7, "word_orig": "לְ/אַפִּ֔/י", "strong": "H639", "morph": "HR/Ncmsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "murka-Ku"}, {"pos": 8, "word_orig": "עַלִּיזֵ֖י", "strong": "H5947", "morph": "HAampc", "morph_id": "Aampc", "ayt_word": "beria-ria"}, {"pos": 9, "word_orig": "גַּאֲוָתִֽ/י", "strong": "H1346", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "bangga"}]}, {"book": 23, "chapter": 13, "verse": 4, "ayat_id": 17911, "title": "", "ayt_text": "Ada suara riuh di pegunungan, seperti suara orang yang sangat banyak jumlahnya! Sebuah suara keributan dari kerajaan-kerajaan, dari bangsa-bangsa yang berkumpul. TUHAN semesta alam sedang menghimpun tentara untuk berperang.", "words": [{"pos": 1, "word_orig": "ק֥וֹל", "strong": "H6963", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "suara"}, {"pos": 2, "word_orig": "הָמ֛וֹן", "strong": "H1995", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "riuh"}, {"pos": 3, "word_orig": "בֶּֽ/הָרִ֖ים", "strong": "H2022", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pegunungan"}, {"pos": 4, "word_orig": "דְּמ֣וּת", "strong": "H1823", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "seperti"}, {"pos": 5, "word_orig": "עַם", "strong": "H5971", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 6, "word_orig": "רָ֑ב", "strong": "H7227", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "banyak"}, {"pos": 7, "word_orig": "ק֠וֹל", "strong": "H6963", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "suara"}, {"pos": 8, "word_orig": "שְׁא֞וֹן", "strong": "H7588", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "keributan"}, {"pos": 9, "word_orig": "מַמְלְכ֤וֹת", "strong": "H4467", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "kerajaan-kerajaan"}, {"pos": 10, "word_orig": "גּוֹיִם֙", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 11, "word_orig": "נֶֽאֱסָפִ֔ים", "strong": "H622", "morph": "HVNrmpa", "morph_id": "Verba Nifal", "ayt_word": "berkumpul"}, {"pos": 12, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 13, "word_orig": "צְבָא֔וֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "alam"}, {"pos": 14, "word_orig": "מְפַקֵּ֖ד", "strong": "H6485", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menghimpun"}, {"pos": 15, "word_orig": "צְבָ֥א", "strong": "H6635", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tentara"}, {"pos": 16, "word_orig": "מִלְחָמָֽה", "strong": "H4421", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berperang"}]}, {"book": 23, "chapter": 13, "verse": 5, "ayat_id": 17912, "title": "", "ayt_text": "Mereka datang dari negeri yang jauh; dari ujung langit. TUHAN dan senjata kemurkaan-Nya akan menghancurkan seluruh bumi.”", "words": [{"pos": 1, "word_orig": "בָּאִ֛ים", "strong": "H935", "morph": "HVqrmpa", "morph_id": "Verba Qal", "ayt_word": "datang"}, {"pos": 2, "word_orig": "מֵ/אֶ֥רֶץ", "strong": "H776", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "negeri"}, {"pos": 3, "word_orig": "מֶרְחָ֖ק", "strong": "H4801", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "jauh"}, {"pos": 4, "word_orig": "מִ/קְצֵ֣ה", "strong": "H7097", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "ujung"}, {"pos": 5, "word_orig": "הַ/שָּׁמָ֑יִם", "strong": "H8064", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 6, "word_orig": "יְהוָה֙", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 7, "word_orig": "וּ/כְלֵ֣י", "strong": "H3627", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "senjata"}, {"pos": 8, "word_orig": "זַעְמ֔/וֹ", "strong": "H2195", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kemurkaan-Nya"}, {"pos": 9, "word_orig": "לְ/חַבֵּ֖ל", "strong": "H2254", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "menghancurkan"}, {"pos": 10, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "seluruh"}, {"pos": 11, "word_orig": "הָ/אָֽרֶץ", "strong": "H776", "morph": "HTd/Ncbsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 23, "chapter": 13, "verse": 6, "ayat_id": 17913, "title": "", "ayt_text": "Mengeranglah karena hari TUHAN sudah dekat! Hari itu akan datang sebagai penghancuran dari Yang Mahakuasa.", "words": [{"pos": 1, "word_orig": "הֵילִ֕ילוּ", "strong": "H3213", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Mengeranglah"}, {"pos": 2, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 3, "word_orig": "קָר֖וֹב", "strong": "H7138", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "dekat"}, {"pos": 4, "word_orig": "י֣וֹם", "strong": "H3117", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hari"}, {"pos": 5, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 6, "word_orig": "כְּ/שֹׁ֖ד", "strong": "H7701", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penghancuran"}, {"pos": 7, "word_orig": "מִ/שַּׁדַּ֥י", "strong": "H7706", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Mahakuasa"}, {"pos": 8, "word_orig": "יָבֽוֹא", "strong": "H935", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "datang"}]}, {"book": 23, "chapter": 13, "verse": 7, "ayat_id": 17914, "title": "", "ayt_text": "Oleh karena itu, semua tangan akan terkulai, dan hati setiap orang akan menjadi luluh.", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "karena"}, {"pos": 2, "word_orig": "כֵּ֖ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "karena"}, {"pos": 3, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 4, "word_orig": "יָדַ֣יִם", "strong": "H3027", "morph": "HNcbda", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Absolut", "ayt_word": "tangan"}, {"pos": 5, "word_orig": "תִּרְפֶּ֑ינָה", "strong": "H7503", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "terkulai"}, {"pos": 6, "word_orig": "וְ/כָל", "strong": "H3605", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "setiap"}, {"pos": 7, "word_orig": "לְבַ֥ב", "strong": "H3824", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 8, "word_orig": "אֱנ֖וֹשׁ", "strong": "H582", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 9, "word_orig": "יִמָּס", "strong": "H4549", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "luluh"}]}, {"book": 23, "chapter": 13, "verse": 8, "ayat_id": 17915, "title": "", "ayt_text": "Mereka akan ketakutan. Rasa sakit dan penderitaan akan menguasai mereka. Mereka akan menggeliat seperti wanita yang sedang bersalin, mereka akan heran dan melihat satu sama lain, wajah mereka akan seperti nyala api.", "words": [{"pos": 1, "word_orig": "וְֽ/נִבְהָ֓לוּ", "strong": "H926", "morph": "HC/VNq3cp", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Jamak", "ayt_word": "ketakutan"}, {"pos": 2, "word_orig": "צִירִ֤ים", "strong": "H6735", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "penderitaan"}, {"pos": 3, "word_orig": "וַֽ/חֲבָלִים֙", "strong": "H2256", "morph": "HC/Ncmpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sakit"}, {"pos": 4, "word_orig": "יֹֽאחֵז֔וּ/ן", "strong": "H270", "morph": "HVqi3mp/Sn", "morph_id": "Verba Qal Imp