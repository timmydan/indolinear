word_orig": "בֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 23, "chapter": 13, "verse": 18, "ayat_id": 17925, "title": "", "ayt_text": "Busur mereka akan merobohkan para pemuda. Mereka tidak akan berbelas kasihan kepada buah kandungan, mata mereka juga tidak mengasihani anak-anak.", "words": [{"pos": 1, "word_orig": "וּ/קְשָׁת֖וֹת", "strong": "H7198", "morph": "HC/Ncfpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Busur"}, {"pos": 2, "word_orig": "נְעָרִ֣ים", "strong": "H5288", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pemuda"}, {"pos": 3, "word_orig": "תְּרַטַּ֑שְׁנָה", "strong": "H7376", "morph": "HVpi3fp", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "merobohkan"}, {"pos": 4, "word_orig": "וּ/פְרִי", "strong": "H6529", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "buah"}, {"pos": 5, "word_orig": "בֶ֨טֶן֙", "strong": "H990", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kandungan"}, {"pos": 6, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יְרַחֵ֔מוּ", "strong": "H7355", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "kasihan"}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 9, "word_orig": "בָּנִ֖ים", "strong": "H1121", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "anak-anak"}, {"pos": 10, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 11, "word_orig": "תָח֥וּס", "strong": "H2347", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3