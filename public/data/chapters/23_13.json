h"}, {"pos": 5, "word_orig": "בָתֵּי/הֶ֖ם", "strong": "H1004", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "Rumah-rumah"}, {"pos": 6, "word_orig": "אֹחִ֑ים", "strong": "H255", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "burung"}, {"pos": 7, "word_orig": "וְ/שָׁ֤כְנוּ", "strong": "H7931", "morph": "HC/Vqq3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Jamak", "ayt_word": "tinggal"}, {"pos": 8, "word_orig": "שָׁם֙", "strong": "H8033", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "sana"}, {"pos": 9, "word_orig": "בְּנ֣וֹת", "strong": "H1323", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "Burung-burung"}, {"pos": 10, "word_orig": "יַֽעֲנָ֔ה", "strong": "H3284", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Burung-burung"}, {"pos": 11, "word_orig": "וּ/שְׂעִירִ֖ים", "strong": "H8163", "morph": "HC/Ncmpa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "liar"}, {"pos": 12, "word_orig": "יְרַקְּדוּ", "strong": "H7540", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bermain-main"}, {"pos": 13, "word_orig": "שָֽׁם", "strong": "H8033", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "di"}]}, {"book": 23, "chapter": 13, "verse": 22, "ayat_id": 17929, "title": "", "ayt_text": "Anjing-anjing hutan akan melolong di rumah-rumah yang terbengkalai, dan serigala-serigala akan berada di dalam istana-istana mereka yang mewah. Kesudahan Babel akan segera tiba, hari-harinya tidak akan diperpanjang.”", "words": [{"pos": 1, "word_orig": "וְ/עָנָ֤ה", "strong": "H6030", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "melolong"}, {"pos": 2, "word_orig": "אִיִּים֙", "strong": "H338", "