orph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pemimpin"}]}, {"book": 28, "chapter": 7, "verse": 4, "ayat_id": 22183, "title": "", "ayt_text": "Mereka semua orang-orang yang bersundal, mereka seperti tungku api panas yang tukang rotinya, berhenti membesarkan api dari saat meremas adonan sampai adonan memuai.", "words": [{"pos": 1, "word_orig": "כֻּלָּ/ם֙", "strong": "H3605", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "semua"}, {"pos": 2, "word_orig": "מְנָ֣אֲפִ֔ים", "strong": "H5003", "morph": "HVprmpa", "morph_id": "Verba Piel", "ayt_word": "bersundal"}, {"pos": 3, "word_orig": "כְּמ֣וֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "seperti"}, {"pos": 4, "word_orig": "תַנּ֔וּר", "strong": "H8574", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tungku"}, {"pos": 5, "word_orig": "בֹּעֵ֖רָה", "strong": "H1197", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "api"}, {"pos": 6, "word_orig": "מֵֽ/אֹפֶ֑ה", "strong": "H644", "morph": "HR/Vqrmsa", "morph_id": "Preposisi + Verba Qal", "ayt_word": "tukang"}, {"pos": 7, "word_orig": "יִשְׁבּ֣וֹת", "strong": "H7673", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berhenti"}, {"pos": 8, "word_orig": "מֵעִ֔יר", "strong": "H5782", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "membesarkan"}, {"pos": 9, "word_orig": "מִ/לּ֥וּשׁ", "strong": "H3888", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "meremas"}, {"pos": 10, "word_orig": "בָּצֵ֖ק", "strong": "H1217", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "adonan"}, {"pos": 11, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "sampai"}, {"pos": 12, "word_orig": "חֻמְצָתֽ/וֹ", "strong": "H2556", "morph": "HVqc/Sp3ms", "morph_id": "Verba Qal Imperatif + Sp3ms", "ayt_word": "memuai"}]}, {"book": 28, "chapter": 7, "verse": 5, "ayat_id": 22184, "title": "", "ayt_text": "Pada hari raja kita, para pemimpin menjadi sakit karena panasnya anggur. Dia mengulurkan tangannya kepada para pencemooh.", "words": [{"pos": 1, "word_orig": "י֣וֹם", "strong": "H3117", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hari"}, {"pos": 2, "word_orig": "מַלְכֵּ֔/נוּ", "strong": "H4428", "morph": "HNcmsc/Sp1cp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cp", "ayt_word": "raja"}, {"pos": 3, "word_orig": "הֶחֱל֥וּ", "strong": "H2470", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "menjadi"}, {"pos": 4, "word_orig": "שָׂרִ֖ים", "strong": "H8269", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pemimpin"}, {"pos": 5, "word_orig": "חֲמַ֣ת", "strong": "H2534", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "panasnya"}, {"pos": 6, "word_orig": "מִ/יָּ֑יִן", "strong": "H3196", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 7, "word_orig": "מָשַׁ֥ךְ", "strong": "H4900", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengulurkan"}, {"pos": 8, "word_orig": "יָד֖/וֹ", "strong": "H3027", "morph": "HNcbsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tangannya"}, {"pos": 9, "word_orig": "אֶת", "strong": "H854", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 10, "word_orig": "לֹצְצִֽים", "strong": "H3945", "morph": "HVormpa", "morph_id": "Verba", "ayt_word": "pencemooh"}]}, {"book": 28, "chapter": 7, "verse": 6, "ayat_id": 22185, "title": "", "ayt_text": "Hati mereka seperti tungku mereka mendekat dengan tipu muslihat. Sepanjang malam kemarahan mereka menyala-nyala, ketika pagi tiba menjadi lautan api yang menjilat-jilat.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 2, "word_orig": "קֵרְב֧וּ", "strong": "H7126", "morph": "HVpp3cp", "morph_id": "Verba Piel Perfek Orang ke-3 Jamak", "ayt_word": "mendekat"}, {"pos": 3, "word_orig": "כַ/תַּנּ֛וּר", "strong": "H8574", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tungku"}, {"pos": 4, "word_orig": "לִבָּ֖/ם", "strong": "H3820", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "Hati"}, {"pos": 5, "word_orig": "בְּ/אָרְבָּ֑/ם", "strong": "H693", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "muslihat"}, {"pos": 6, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Sepanjang"}, {"pos": 7, "word_orig": "הַ/לַּ֨יְלָה֙", "strong": "H3915", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 8, "word_orig": "יָשֵׁ֣ן", "strong": "H3463", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kemarahan"}, {"pos": 9, "word_orig": "אֹֽפֵ/הֶ֔ם", "strong": "H644", "morph": "HVqrmsc/Sp3mp", "morph_id": "Verba Qal + Sp3mp", "ayt_word": "kemarahan"}, {"pos": 10, "word_orig": "בֹּ֕קֶר", "strong": "H1242", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pagi"}, {"pos": 11, "word_orig": "ה֥וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": ""}, {"pos": 12, "word_orig": "בֹעֵ֖ר", "strong": "H1197", "morph": "HVqrmsa",