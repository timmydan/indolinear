[{"book": 28, "chapter": 7, "verse": 1, "ayat_id": 22180, "title": "", "ayt_text": "Ketika Aku akan menyembuhkan Israel, kesalahan Efraim disingkapkan, juga kejahatan-kejahatan Samaria. Sebab, mereka melakukan penipuan; pencuri memaksa masuk, dan gerombolan merampok di jalanan.", "words": [{"pos": 1, "word_orig": "כְּ/רָפְאִ֣/י", "strong": "H7495", "morph": "HR/Vqc/Sp1cs", "morph_id": "Preposisi + Verba Qal Imperatif + Sp1cs", "ayt_word": "menyembuhkan"}, {"pos": 2, "word_orig": "לְ/יִשְׂרָאֵ֗ל", "strong": "H3478", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Israel"}, {"pos": 3, "word_orig": "וְ/נִגְלָ֞ה", "strong": "H1540", "morph": "HC/VNp3ms", "morph_id": "Konjungsi (וְ) + Verba Nifal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "disingkapkan"}, {"pos": 4, "word_orig": "עֲוֺ֤ן", "strong": "H5771", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "kesalahan"}, {"pos": 5, "word_orig": "אֶפְרַ֨יִם֙", "strong": "H669", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Efraim"}, {"pos": 6, "word_orig": "וְ/רָע֣וֹת", "strong": "H7451", "morph": "HC/Ncfpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "kejahatan-kejahatan"}, {"pos": 7, "word_orig": "שֹֽׁמְר֔וֹן", "strong": "H8111", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Samaria"}, {"pos": 8, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 9, "word_orig": "פָעֲל֖וּ", "strong": "H6466", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "melakukan"}, {"pos": 10, "word_orig": "שָׁ֑קֶר", "strong": "H8267", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penipuan"}, {"pos": 11, "word_orig": "וְ/גַנָּ֣ב", "strong": "H1590", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pencuri"}, {"pos": 12, "word_orig": "יָב֔וֹא", "strong": "H935", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "masuk"}, {"pos": 13, "word_orig": "פָּשַׁ֥ט", "strong": "H6584", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merampok"}, {"pos": 14, "word_orig": "גְּד֖וּד", "strong": "H1416", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "gerombolan"}, {"pos": 15, "word_orig": "בַּ/חֽוּץ", "strong": "H2351", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "di"}]}, {"book": 28, "chapter": 7, "verse": 2, "ayat_id": 22181, "title": "", "ayt_text": "Akan tetapi, mereka tidak berpikir bahwa Aku mengingat semua kejahatan mereka. Sekarang, perbuatan-perbuatan mereka mengepung mereka. Mereka ada di hadapan-Ku.", "words": [{"pos": 1, "word_orig": "וּ/בַל", "strong": "H1077", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יֹֽאמְרוּ֙", "strong": "H559", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": ""}, {"pos": 3, "word_orig": "לִ/לְבָבָ֔/ם", "strong": "H3824", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "berpikir"}, {"pos": 4, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 5, "word_orig": "רָעָתָ֖/ם", "strong": "H7451", "morph": "HNcfsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kejahatan"}, {"pos": 6, "word_orig": "זָכָ֑רְתִּי", "strong": "H2142", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "mengingat"}, {"pos": 7, "word_orig": "ע