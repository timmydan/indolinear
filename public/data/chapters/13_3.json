 "sembilan"}]}, {"book": 13, "chapter": 3, "verse": 9, "ayat_id": 10371, "title": "", "ayt_text": "Semua itu adalah anak-anak Daud, tidak termasuk anak-anak dari gundik-gundiknya. Tamar adalah saudara perempuan mereka.", "words": [{"pos": 1, "word_orig": "כֹּ֖ל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Semua"}, {"pos": 2, "word_orig": "בְּנֵ֣י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 3, "word_orig": "דָוִ֑יד", "strong": "H1732", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Daud"}, {"pos": 4, "word_orig": "מִ/לְּ/בַ֥ד", "strong": "H905", "morph": "HR/R/Ncmsc", "morph_id": "Preposisi + Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "בְּֽנֵי", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "פִֽילַגְשִׁ֖ים", "strong": "H6370", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "gundik-gundiknya"}, {"pos": 7, "word_orig": "וְ/תָמָ֥ר", "strong": "H8559", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Tamar"}, {"pos": 8, "word_orig": "אֲחוֹתָֽ/ם", "strong": "H269", "morph": "HNcfsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "saudara"}]}, {"book": 13, "chapter": 3, "verse": 10, "ayat_id": 10372, "title": "Raja-Raja Yehuda sesudah Daud", "ayt_text": "Anak Salomo adalah Rehabeam, anak Rehabeam adalah Abia, anak Abia adalah Asa, anak Asa adalah Yosafat,", "words": [{"pos": 1, "word_orig": "וּ/בֶן", "strong": "H1121", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Ana