", "ayt_word": "memerintah"}, {"pos": 15, "word_orig": "בִּ/ירוּשָׁלִָֽם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}]}, {"book": 13, "chapter": 3, "verse": 5, "ayat_id": 10367, "title": "", "ayt_text": "Inilah anak-anak yang dilahirkan baginya di Yerusalem: Simea, Sobab, Natan, dan Salomo, keempatnya dari Batsyua, anak perempuan Amiel,", "words": [{"pos": 1, "word_orig": "וְ/אֵ֥לֶּה", "strong": "H428", "morph": "HC/Pdxcp", "morph_id": "Konjungsi (וְ) + Pdxcp", "ayt_word": "Inilah"}, {"pos": 2, "word_orig": "נוּלְּדוּ", "strong": "H3205", "morph": "HVNp3cp", "morph_id": "Verba Nifal Perfek Orang ke-3 Jamak", "ayt_word": "dilahirkan"}, {"pos": 3, "word_orig": "ל֖/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 4, "word_orig": "בִּ/ירוּשָׁלָ֑יִם", "strong": "H3389", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Yerusalem"}, {"pos": 5, "word_orig": "שִׁ֠מְעָא", "strong": "H8092", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Simea"}, {"pos": 6, "word_orig": "וְ/שׁוֹבָ֞ב", "strong": "H7727", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Sobab"}, {"pos": 7, "word_orig": "וְ/נָתָ֤ן", "strong": "H5416", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Natan"}, {"pos": 8, "word_orig": "וּ/שְׁלֹמֹה֙", "strong": "H8010", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Salomo"}, {"pos": 9, "word_orig": "אַרְבָּעָ֔ה", "strong": "H702", "morph": "HAcmsa", "morph_id": "Acmsa", "ayt_word": "keempatnya"}, {"pos": 10, "word_orig": "לְ/בַת", "strong": "H1340", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": ""}, {"pos": 11, "word_orig": "שׁ֖וּעַ", "strong": "H1340", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Batsyua"}, {"pos": 12, "word_orig": "בַּת", "strong": "H1323", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Teri