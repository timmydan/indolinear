word": "anak"}]}, {"book": 13, "chapter": 3, "verse": 17, "ayat_id": 10379, "title": "Keluarga Daud sesudah Pembuangan ke Babel", "ayt_text": "Keturunan Yekhonya, orang tahanan itu, adalah Sealtiel, anaknya laki-laki,", "words": [{"pos": 1, "word_orig": "וּ/בְנֵי֙", "strong": "H1121", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Keturunan"}, {"pos": 2, "word_orig": "יְכָנְיָ֣ה", "strong": "H3204", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yekhonya"}, {"pos": 3, "word_orig": "אַסִּ֔ר", "strong": "H617", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 4, "word_orig": "שְׁאַלְתִּיאֵ֖ל", "strong": "H7597", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sealtiel"}, {"pos": 5, "word_orig": "בְּנֽ/וֹ", "strong": "H1121", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "anaknya"}]}, {"book": 13, "chapter": 3, "verse": 18, "ayat_id": 10380, "title": "", "ayt_text": "Malkhiram, Pedaya, Syenasar, Yekamya, Hosama, dan Nedabya.", "words": [{"pos": 1, "word_orig": "וּ/מַלְכִּירָ֥ם", "strong": "H4443", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Malkhiram"}, {"pos": 2, "word_orig": "וּ/פְדָיָ֖ה", "strong": "H6305", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Pedaya"}, {"pos": 3, "word_orig": "וְ/שֶׁנְאַצַּ֑ר", "strong": "H8137", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Syenasar"}, {"pos": 4, "word_orig": "יְקַמְיָ֥ה", "strong": "H3359", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yekamya"}, {"pos": 5, "word_orig": "הוֹשָׁמָ֖ע", "strong": "H1953", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Hosama"}, {"pos": 6, "word_orig": "וּ/נְדַבְיָֽה", "strong": "H5072", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Nedabya"}]}, {"book": 13, "chapter": 3, "verse": 19, "ayat_id": 10381, "title": "", "ayt_text": "Keturunan Pedaya adalah Zerubabel dan Simei. Keturunan Zerubabel adalah Mesulam dan Hananya. Selomit adalah saudara perempuan mereka.", "words": [{"pos": 1, "word_orig": "וּ/בְנֵ֣י", "strong": "H1121", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Keturunan"}, {"pos": 2, "word_orig": "פְדָיָ֔ה", "strong": "H6305", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Pedaya"}, {"pos": 3, "word_orig": "זְרֻבָּבֶ֖ל", "strong": "H2216", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Zerubabel"}, {"pos": 4, "word_orig": "וְ/שִׁמְעִ֑י", "strong": "H8096", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Simei"}, {"pos": 5, "word_orig": "וּ/בֶן", "strong": "H1121", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Keturunan"}, {"pos": 6, "word_orig": "זְרֻבָּבֶל֙", "strong": "H2216", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Zerubabel"}, {"pos": 7, "word_orig": "מְשֻׁלָּ֣ם", "strong": "H4918", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Mesulam"}, {"pos": 8, "word_orig": "וַ/חֲנַנְיָ֔ה", "strong": "H2608", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Hananya"}, {"pos": 9, "word_orig": "וּ/שְׁלֹמִ֖ית", "strong": "H8019", "morph": "HC/Np", "morph_id": "Konjungsi (וְ) + Nomina Jamak", "ayt_word": "Selomit"}, {"pos": 10, "word_orig": "אֲחוֹתָֽ/ם", "strong": "H269", "morph": "HNcfsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "perempuan"}]}, {"book": 13, "chapter": 3, "verse": 20, "ayat_id": 10382, "title": "", "ayt_text": "Ada pula lima orang lainnya: Hasuba, Ohel, Berekhya, Hasaja, dan Yusab-Hesed.", "words": [{"pos": 1, "word_orig": "וַ/חֲשֻׁב