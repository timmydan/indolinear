_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengumban"}, {"pos": 9, "word_orig": "וְ/שָׁת֥וּ", "strong": "H8354", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "minum"}, {"pos": 10, "word_orig": "הָמ֖וּ", "strong": "H1993", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "gaduh"}, {"pos": 11, "word_orig": "כְּמוֹ", "strong": "H3644", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "seperti"}, {"pos": 12, "word_orig": "יָ֑יִן", "strong": "H3196", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anggur"}, {"pos": 13, "word_orig": "וּ/מָֽלְאוּ֙", "strong": "H4390", "morph": "HC/Vqp3cp", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "penuh"}, {"pos": 14, "word_orig": "כַּ/מִּזְרָ֔ק", "strong": "H4219", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mangkuk"}, {"pos": 15, "word_orig": "כְּ/זָוִיּ֖וֹת", "strong": "H2106", "morph": "HR/Ncfpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "penjuru-penjuru"}, {"pos": 16, "word_orig": "מִזְבֵּֽחַ", "strong": "H4196", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "mazbah"}]}, {"book": 38, "chapter": 9, "verse": 16, "ayat_id": 23016, "title": "", "ayt_text": "TUHAN, Allah mereka, akan menyelamatkan mereka pada hari itu sebagai kawanan domba umat-Nya. Sebab mereka seperti batu-batu permata mahkota yang berkilauan, di tanah-Nya.", "words": [{"pos": 1, "word_orig": "וְֽ/הוֹשִׁיעָ֞/ם", "strong": "H3467", "morph": "HC/Vhp3ms/Sp3mp", "morph_id": "Konjungsi (וְ) + Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "menyelamatkan"}, {"pos": 2, "word_orig": "יְהוָ֧ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "wo