d_orig": "רְ֭שָׁעִים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "תּוֹעֲבַ֣ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וּ/תְפִלַּ֖ת", "strong": "H8605", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "doa"}, {"pos": 6, "word_orig": "יְשָׁרִ֣ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "רְצוֹנֽ/וֹ", "strong": "H7522", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "diperkenan"}]}, {"book": 20, "chapter": 15, "verse": 9, "ayat_id": 16817, "title": "", "ayt_text": "Jalan orang fasik adalah kekejian bagi TUHAN, tetapi Dia mengasihi orang yang mengejar kebenaran.", "words": [{"pos": 1, "word_orig": "תּוֹעֲבַ֣ת", "strong": "H8441", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kekejian"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "דֶּ֣רֶךְ", "strong": "H1870", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Jalan"}, {"pos": 4, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "וּ/מְרַדֵּ֖ף", "strong": "H7291", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "mengejar"}, {"pos": 6, "word_orig": "צְדָקָ֣ה", "strong": "H6666", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran