 {"pos": 3, "word_orig": "תֵּיטִ֣יב", "strong": "H3190", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "diterima"}, {"pos": 4, "word_orig": "דָּ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 5, "word_orig": "וּ/פִ֥י", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 6, "word_orig": "כְ֝סִילִ֗ים", "strong": "H3684", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יַבִּ֥יעַ", "strong": "H5042", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mencurahkan"}, {"pos": 8, "word_orig": "אִוֶּֽלֶת", "strong": "H200", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebodohan"}]}, {"book": 20, "chapter": 15, "verse": 3, "ayat_id": 16811, "title": "", "ayt_text": "Mata TUHAN ada di segala tempat, mengawasi orang yang jahat dan orang yang baik.", "words": [{"pos": 1, "word_orig": "בְּֽ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 2, "word_orig": "מָ֭קוֹם", "strong": "H4725", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tempat"}, {"pos": 3, "word_orig": "עֵינֵ֣י", "strong": "H5869", "morph": "HNcbdc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Mata"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "צֹ֝פ֗וֹת", "strong": "H6822", "morph": "HVqrfpa", "morph_id": "Verba Qal", "ayt_word": "mengawasi"}, {"pos": 6, "word_orig": "רָעִ֥ים", "strong": "H7451", "morph"