, "ayt_word": "bodoh"}, {"pos": 2, "word_orig": "יִ֭נְאַץ", "strong": "H5006", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghina"}, {"pos": 3, "word_orig": "מוּסַ֣ר", "strong": "H4148", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "didikan"}, {"pos": 4, "word_orig": "אָבִ֑י/ו", "strong": "H1", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ayahnya"}, {"pos": 5, "word_orig": "וְ/שֹׁמֵ֖ר", "strong": "H8104", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "memelihara"}, {"pos": 6, "word_orig": "תּוֹכַ֣חַת", "strong": "H8433", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "teguran"}, {"pos": 7, "word_orig": "יַעְרִֽם", "strong": "H6191", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bijak"}]}, {"book": 20, "chapter": 15, "verse": 6, "ayat_id": 16814, "title": "", "ayt_text": "Di rumah orang benar terdapat banyak harta benda, tetapi kesusahan menimpa penghasilan orang fasik.", "words": [{"pos": 1, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "rumah"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "חֹ֣סֶן", "strong": "H2633", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "harta"}, {"pos": 4, "word_orig": "רָ֑ב", "strong": "H7227", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "banyak"}, {"pos": 5, "word_orig": "וּ/בִ/תְבוּאַ֖ת", "strong": "H8393", "morph": "HC/R/Ncfsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "penghasil