 Laki-laki Tunggal + Sp3ms", "ayt_word": "mengejarnya"}]}, {"book": 28, "chapter": 8, "verse": 4, "ayat_id": 22199, "title": "", "ayt_text": "Mereka mengangkat raja, tetapi tidak melalui Aku. Mereka mengangkat pemimpin-pemimpin, tetapi Aku tidak mengetahuinya. Dengan emas dan perak mereka, mereka membuat berhala bagi kehancuran mereka sendiri,", "words": [{"pos": 1, "word_orig": "הֵ֤ם", "strong": "H1992", "morph": "HPp3mp", "morph_id": "Pp3mp", "ayt_word": "Mereka"}, {"pos": 2, "word_orig": "הִמְלִיכוּ֙", "strong": "H4427", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "raja"}, {"pos": 3, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "מִמֶּ֔/נִּי", "strong": "H4480", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "melalui"}, {"pos": 5, "word_orig": "הֵשִׂ֖ירוּ", "strong": "H8323", "morph": "HVhp3cp", "morph_id": "Verba Hifil Perfek Orang ke-3 Jamak", "ayt_word": "pemimpin-pemimpin"}, {"pos": 6, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יָדָ֑עְתִּי", "strong": "H3045", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "mengetahuinya"}, {"pos": 8, "word_orig": "כַּסְפָּ֣/ם", "strong": "H3701", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "perak"}, {"pos": 9, "word_orig": "וּ/זְהָבָ֗/ם", "strong": "H2091", "morph": "HC/Ncmsc/Sp3mp", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "emas"}, {"pos": 10, "word_orig": "עָשׂ֤וּ", "strong": "H6213", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "membuat"}, {"pos": 11, "word_orig": "לָ/הֶם֙", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 12, "word_orig": "עֲצַבִּ֔ים", "strong": "H6091", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "berhala"}, {"pos": 13, "word_orig": "לְמַ֖עַן", "strong": "H4616", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "bagi"}, {"pos": 14, "word_orig": "יִכָּרֵֽת", "strong": "H3772", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kehancuran"}]}, {"book": 28, "chapter": 8, "verse": 5, "ayat_id": 22200, "title": "", "ayt_text": "Aku telah membuang anak sapimu, hai Samaria. Murka-Ku menyala-nyala terhadap mereka! Berapa lama mereka tidak mampu untuk tidak bersalah?", "words": [{"pos": 1, "word_orig": "זָנַח֙", "strong": "H2186", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuang"}, {"pos": 2, "word_orig": "עֶגְלֵ֣/ךְ", "strong": "H5695", "morph": "HNcmsc/Sp2fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2fs", "ayt_word": "anak"}, {"pos": 3, "word_orig": "שֹֽׁמְר֔וֹן", "strong": "H8111", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Samaria"}, {"pos": 4, "word_orig": "חָרָ֥ה", "strong": "H2734", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyala-nyala"}, {"pos": 5, "word_orig": "אַפִּ֖/י", "strong": "H639", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "Murka-Ku"}, {"pos": 6, "word_orig": "בָּ֑/ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 7, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Berapa"}, {"pos": 8, "word_orig": "מָתַ֕י", "strong": "H4970", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Berapa"}, {"pos": 9, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 10, "word_orig": "יוּ