[{"book": 28, "chapter": 8, "verse": 1, "ayat_id": 22196, "title": "Penyembahan Ilah Membawa Kebinasaan", "ayt_text": "Tiuplah trompet! Seperti burung rajawali yang menunggu di atas rumah TUHAN. Sebab, mereka telah melanggar perjanjian-Ku, dan memberontak terhadap hukum-Ku.", "words": [{"pos": 1, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 2, "word_orig": "חִכְּ/ךָ֣", "strong": "H2441", "morph": "HNcmsc/Sp2ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp2ms", "ayt_word": "Tiuplah"}, {"pos": 3, "word_orig": "שֹׁפָ֔ר", "strong": "H7782", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "trompet"}, {"pos": 4, "word_orig": "כַּ/נֶּ֖שֶׁר", "strong": "H5404", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rajawali"}, {"pos": 5, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 6, "word_orig": "בֵּ֣ית", "strong": "H1004", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "rumah"}, {"pos": 7, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 8, "word_orig": "יַ֚עַן", "strong": "H3282", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 9, "word_orig": "עָבְר֣וּ", "strong": "H5674", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "melanggar"}, {"pos": 10, "word_orig": "בְרִיתִ֔/י", "strong": "H1285", "morph": "HNcfsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "perjanjian-Ku"}, {"pos": 11, "word_orig": "וְ/עַל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": "terhadap"}, {"pos": 12, "word_orig": "תּוֹרָתִ֖/י", "strong": "H8451", "morp