[{"book": 3, "chapter": 12, "verse": 1, "ayat_id": 3046, "title": "Peraturan tentang Ibu yang Melahirkan", "ayt_text": "TUHAN berfirman kepada Musa, firman-Nya,", "words": [{"pos": 1, "word_orig": "וַ/יְדַבֵּ֥ר", "strong": "H1696", "morph": "HC/Vpw3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berfirman"}, {"pos": 2, "word_orig": "יְהוָ֖ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 4, "word_orig": "מֹשֶׁ֥ה", "strong": "H4872", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Musa"}, {"pos": 5, "word_orig": "לֵּ/אמֹֽר", "strong": "H559", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "firman-Nya"}]}, {"book": 3, "chapter": 12, "verse": 2, "ayat_id": 3047, "title": "", "ayt_text": "“Katakanlah kepada bangsa Israel perkataan ini: ‘Apabila seorang perempuan mengandung dan melahirkan anak laki-laki, dia akan najis selama tujuh hari, sebagaimana ketika datang bulan, dia menjadi najis.", "words": [{"pos": 1, "word_orig": "דַּבֵּ֞ר", "strong": "H1696", "morph": "HVpv2ms", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "Katakanlah"}, {"pos": 2, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 3, "word_orig": "בְּנֵ֤י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "bangsa"}, {"pos": 4, "word_orig": "יִשְׂרָאֵל֙", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 5, "word_orig": "לֵ/אמֹ֔ר", "strong": "H559", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "perkataan"}, {"pos": 6, "word_orig": "אִשָּׁה֙", "strong": "H802", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perempuan"}, {"pos": 7, "word_orig": "כִּ֣י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Apabila"}, {"pos": 8, "word_orig": "תַזְרִ֔יעַ", "strong": "H2232", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "mengandung"}, {"pos": 9, "word_orig": "וְ/יָלְדָ֖ה", "strong": "H3205", "morph": "HC/Vqq3fs", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Perempuan Tunggal", "ayt_word": "melahirkan"}, {"pos": 10, "word_orig": "זָכָ֑ר", "strong": "H2145", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "laki-laki"}, {"pos": 11, "word_orig": "וְ/טָֽמְאָה֙", "strong": "H2930", "morph": "HC/Vqq3fs", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Perempuan Tunggal", "ayt_word": "najis"}, {"pos": 12, "word_orig": "שִׁבְעַ֣ת", "strong": "H7651", "morph": "HAcmsc", "morph_id": "Acmsc", "ayt_word": "tujuh"}, {"pos": 13, "word_orig": "יָמִ֔ים", "strong": "H3117", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "hari"}, {"pos": 14, "word_orig": "כִּ/ימֵ֛י", "strong": "H3117", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": ""}, {"pos": 15, "word_orig": "נִדַּ֥ת", "strong": "H5079", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "bulan"}, {"pos": 16, "word_orig": "דְּוֺתָ֖/הּ", "strong": "H1738", "morph": "HVqc/Sp3fs", "morph_id": "Verba Qal Imperatif + Sp3fs", "ayt_word": "datang"}, {"pos": 17, "word_orig": "תִּטְמָֽא", "strong": "H2930", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "najis"}]}, {"book": 3, "chapter": 12, "verse": 3, "ayat_id": 3048, "title": "", "ayt_text": "Pada hari kedelapan, daging kulit khitan bayi itu harus disunat.", "words": [{"pos": 1, "word_orig": "וּ/בַ/יּ֖וֹם", "strong": "H3117", "mor