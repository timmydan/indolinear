s Tunggal Absolut", "ayt_word": "lidah"}, {"pos": 8, "word_orig": "רְמִיָּֽה", "strong": "H7423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "penipu"}]}, {"book": 19, "chapter": 120, "verse": 4, "ayat_id": 16079, "title": "", "ayt_text": "Anak-anak panah tajam milik seorang pahlawan, dengan bara api kayu arar.", "words": [{"pos": 1, "word_orig": "חִצֵּ֣י", "strong": "H2671", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "panah"}, {"pos": 2, "word_orig": "גִבּ֣וֹר", "strong": "H1368", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pahlawan"}, {"pos": 3, "word_orig": "שְׁנוּנִ֑ים", "strong": "H8150", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "tajam"}, {"pos": 4, "word_orig": "עִ֝֗ם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dengan"}, {"pos": 5, "word_orig": "גַּחֲלֵ֥י", "strong": "H1513", "morph": "HNcbpc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat)", "ayt_word": "bara"}, {"pos": 6, "word_orig": "רְתָמִֽים", "strong": "H7574", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kayu"}]}, {"book": 19, "chapter": 120, "verse": 5, "ayat_id": 16080, "title": "", "ayt_text": "Celakalah aku karena aku orang yang tinggal sementara di Mesekh, aku tinggal di antara tenda-tenda Kedar!", "words": [{"pos": 1, "word_orig": "אֽוֹיָה", "strong": "H190", "morph": "HTj", "morph_id": "Tj", "ayt_word": "Celakalah"}, {"pos": 2, "word_orig": "לִ֭/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "aku"}, {"pos": 3, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "karena"}, {"pos": 4, "word_orig": "גַ֣רְתִּי", "strong": "H1481", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "tinggal"}, {"pos": 5, "word_orig": "מֶ֑שֶׁ