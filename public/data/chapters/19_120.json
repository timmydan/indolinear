[{"book": 19, "chapter": 120, "verse": 1, "ayat_id": 16076, "title": "Doa Melawan Lidah Penipu", "ayt_text": "Nyanyian Ziarah. Dalam kesesakanku, aku berseru kepada TUHAN, dan Dia menjawab aku.", "words": [{"pos": 1, "word_orig": "שִׁ֗יר", "strong": "H7892", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Nyanyian"}, {"pos": 2, "word_orig": "הַֽ/מַּ֫עֲל֥וֹת", "strong": "H4609", "morph": "HTd/Ncfpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Ziarah"}, {"pos": 3, "word_orig": "אֶל", "strong": "H413", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "kepada"}, {"pos": 4, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "בַּ/צָּרָ֣תָ/ה", "strong": "H6869", "morph": "HRd/Ncfsa/Sh", "morph_id": "Rd + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut + Sh", "ayt_word": "kesesakanku"}, {"pos": 6, "word_orig": "לִּ֑/י", "strong": "", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": ""}, {"pos": 7, "word_orig": "קָ֝רָ֗אתִי", "strong": "H7121", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berseru"}, {"pos": 8, "word_orig": "וַֽ/יַּעֲנֵֽ/נִי", "strong": "H6030", "morph": "HC/Vqw3ms/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menjawab"}]}, {"book": 19, "chapter": 120, "verse": 2, "ayat_id": 16077, "title": "", "ayt_text": "“Lepaskan aku, ya TUHAN, dari bibir pendusta, dari lidah pengkhianat.”", "words": [{"pos": 1, "word_orig": "יְֽהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "הַצִּ֣ילָ/ה", "strong": "H5337", "morph": "HVhv2ms/Sh", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Tunggal + Sh", "ayt_word": "Lepaskan"}, {"pos": 3, "word_orig": "נַ֭פְשִׁ/י"