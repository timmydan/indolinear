": "יִשְׂרָאֵ֣ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 3, "word_orig": "בְּ/עֹשָׂ֑י/ו", "strong": "H6213", "morph": "HR/Vqrmpc/Sp3ms", "morph_id": "Preposisi + Verba Qal + Sp3ms", "ayt_word": "Penciptanya"}, {"pos": 4, "word_orig": "בְּנֵֽי", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 5, "word_orig": "צִ֝יּ֗וֹן", "strong": "H6726", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Sion"}, {"pos": 6, "word_orig": "יָגִ֥ילוּ", "strong": "H1523", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bersorak-sorai"}, {"pos": 7, "word_orig": "בְ/מַלְכָּֽ/ם", "strong": "H4428", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "raja"}]}, {"book": 19, "chapter": 149, "verse": 3, "ayat_id": 16389, "title": "", "ayt_text": "Biarlah mereka memuji nama-Nya dengan tari-tarian, biarlah mereka menyanyikan mazmur kepada-Nya dengan rebana dan kecapi.", "words": [{"pos": 1, "word_orig": "יְהַֽלְל֣וּ", "strong": "H1984", "morph": "HVpj3mp", "morph_id": "Verba Piel Orang ke-3 Laki-laki Jamak", "ayt_word": "memuji"}, {"pos": 2, "word_orig": "שְׁמ֣/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "nama-Nya"}, {"pos": 3, "word_orig": "בְ/מָח֑וֹל", "strong": "H4234", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "tari-tarian"}, {"pos": 4, "word_orig": "בְּ/תֹ֥ף", "strong": "H8596", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rebana"}, {"pos": 5, "word_orig": "וְ֝/כִנּ֗וֹר", "strong": "H3658", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kecapi"}, {"pos": 6, "word_orig": "יְזַמְּרוּ", "strong": "H2167", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mazmur"}, {"pos": 7, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 19, "chapter": 149, "verse": 4, "ayat_id": 16390, "title": "", "ayt_text": "Sebab, TUHAN berkenan kepada umat-Nya, Dia memahkotai orang-orang rendah hati dengan keselamatan.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "רוֹצֶ֣ה", "strong": "H7521", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berkenan"}, {"pos": 3, "word_orig": "יְהוָ֣ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "בְּ/עַמּ֑/וֹ", "strong": "H5971", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "umat-Nya"}, {"pos": 5, "word_orig": "יְפָאֵ֥ר", "strong": "H6286", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memahkotai"}, {"pos": 6, "word_orig": "עֲ֝נָוִ֗ים", "strong": "H6035", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "hati"}, {"pos": 7, "word_orig": "בִּ/ישׁוּעָֽה", "strong": "H3444", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "keselamatan"}]}, {"book": 19, "chapter": 149, "verse": 5, "ayat_id": 16391, "title": "", "ayt_text": "Biarlah orang-orang saleh bersukaria dalam kemuliaan, biarlah mereka bersorak-sorai di atas tempat tidurnya.", "words": [{"pos": 1, "word_orig": "יַעְלְז֣וּ", "strong": "H5937", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bersukaria"}, {"pos": 2, "word_orig": "חֲסִידִ֣ים", "strong": "H2623", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang-orang"}, {"pos": 3, "word_orig": "בְּ/כָב֑וֹד", "strong": "H3519", "morph": "HR/Ncbsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "kemuliaan"}, {"pos": 4, "word_orig": "יְ֝רַנְּנ֗וּ", "strong": "H7442", "morph": "HVpi3mp", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bersorak-sorai"}, {"pos": 5, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 6, "word_orig": "מִשְׁכְּבוֹתָֽ/ם", "strong": "H4904", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "tempat"}]}, {"book": 19, "chapter": 149, "verse": 6, "ayat_id": 16392, "title": "", "ayt_text": "Biarlah pujian yang agung kepada Allah ada di dalam kerongkongan mereka, dan pedang bermata dua di tangan mereka,", "words": [{"pos": 1, "word_orig": "רוֹמְמ֣וֹת", "strong": "H7319", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "agung"}, {"pos": 2, "word_orig": "אֵ֭ל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 3, "word_orig": "בִּ/גְרוֹנָ֑/ם", "strong": "H1627", "morph": "HR/Ncmsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kerongkongan"}, {"pos": 4, "word_orig": "וְ/חֶ֖רֶב", "strong": "H2719", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "pedang"}, {"pos": 5, "word_orig": "פִּֽיפִיּ֣וֹת", "strong": "H6374", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "bermata"}, {"pos": 6, "word_orig": "בְּ/יָדָֽ/ם", "strong": "H3027", "morph": "HR/Ncbsc/Sp3mp", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "tangan"}]}, {"book": 19, "chapter": 149, "verse": 7, "ayat_id": 16393, "title": "", "ayt_text": "untuk mengadakan pembalasan atas bangsa-bangsa, penghukuman atas suku-suku bangsa,", "words": [{"pos": 1, "word_orig": "לַ/עֲשׂ֣וֹת", "strong": "H6213", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "mengadakan"}, {"pos": 2, "word_orig": "נְ֭קָמָה", "strong": "H5360", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pembalasan"}, {"pos": 3, "word_orig": "בַּ/גּוֹיִ֑ם", "strong": "H1471", "morph": "HRd/Ncmpa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}, {"pos": 4, "word_orig": "תּֽ֝וֹכֵחֹ֗ת", "strong": "H8433", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "penghukuman"}, {"pos": 5, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": ""}, {"pos": 6, "word_orig": "אֻמִּֽים", "strong": "H3816", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "suku-suku"}]}, {"book": 19, "chapter": 149, "verse": 8, "ayat_id": 16394, "title": "", "ayt_text": "untuk membelenggu raja-raja mereka dengan rantai, dan orang-orang terhormat mereka dengan belenggu-belenggu besi,", "words": [{"pos": 1, "word_orig": "לֶ/אְסֹ֣ר", "strong": "H631", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "membelenggu"}, {"pos": 2, "word_orig": "מַלְכֵי/הֶ֣ם", "strong": "H4428", "morph": "HNcmpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "raja-raja"}, {"pos": 3, "word_orig": "בְּ/זִקִּ֑ים", "strong": "H2131", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "rantai"}, {"pos": 4, "word_orig": "וְ֝/נִכְבְּדֵי/הֶ֗ם", "strong": "H3513", "morph": "H