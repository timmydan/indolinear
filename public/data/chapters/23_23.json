k (Terikat) Laki-laki Jamak Absolut", "ayt_word": "muda"}, {"pos": 16, "word_orig": "רוֹמַ֥מְתִּי", "strong": "H7311", "morph": "HVop1cs", "morph_id": "Verba Perfek Orang ke-1 Tunggal", "ayt_word": "mengurus"}, {"pos": 17, "word_orig": "בְתוּלֽוֹת", "strong": "H1330", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "anak-anak"}]}, {"book": 23, "chapter": 23, "verse": 5, "ayat_id": 18083, "title": "", "ayt_text": "Ketika berita ini sampai ke Mesir, mereka akan gemetar karena berita tentang Tirus itu.", "words": [{"pos": 1, "word_orig": "כַּֽ/אֲשֶׁר", "strong": "H834", "morph": "HR/Tr", "morph_id": "Preposisi + Tr", "ayt_word": "Ketika"}, {"pos": 2, "word_orig": "שֵׁ֖מַע", "strong": "H8088", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "berita"}, {"pos": 3, "word_orig": "לְ/מִצְרָ֑יִם", "strong": "H4714", "morph": "HR/Np", "morph_id": "Preposisi + Nomina Jamak", "ayt_word": "Mesir"}, {"pos": 4, "word_orig": "יָחִ֖ילוּ", "strong": "H2342", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "gemetar"}, {"pos": 5, "word_orig": "כְּ/שֵׁ֥מַע", "strong": "H8088", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "berita"}, {"pos": 6, "word_orig": "צֹֽר", "strong": "H6865", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Tirus"}]}, {"book": 23, "chapter": 23, "verse": 6, "ayat_id": 18084, "title": "", "ayt_text": "Menyeberanglah ke Tarsis! Merataplah, hai penduduk pesisir!", "words": [{"pos": 1, "word_orig": "עִבְר֖וּ", "strong": "H5674", "morph": "HVqv2mp", "morph_id": "Verba Qal Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Menyeberanglah"}, {"pos": 2, "word_orig": "תַּרְשִׁ֑ישָׁ/ה", "strong": "H8659", "morph": "HNp/Sd", "morph_id": "Nomina Jamak + Sd", "ayt_word": "Tarsis"}, {"pos": 3, "word_orig": "הֵילִ֖ילוּ", "strong": "H3213", "morph": "HVhv2mp", "morph_id": "Verba Hifil Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Merataplah"}, {"pos": 4, "word_orig": "יֹ֥שְׁבֵי", "strong": "H3427", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "penduduk"}, {"pos": 5, "word_orig": "אִֽי", "strong": "H339", "morph": "HTj", "morph_id": "Tj", "ayt_word": "pesisir"}]}, {"book": 23, "chapter": 23, "verse": 7, "ayat_id": 18085, "title": "", "ayt_text": "Inikah kotamu yang penuh kegembiraan, yang didirikan sejak dahulu kala, yang kakinya membawanya pergi ke tempat-tempat jauh untuk tinggal di sana?", "words": [{"pos": 1, "word_orig": "הֲ/זֹ֥את", "strong": "H2063", "morph": "HTi/Pdxfs", "morph_id": "Ti + Pdxfs", "ayt_word": "Inikah"}, {"pos": 2, "word_orig": "לָ/כֶ֖ם", "strong": "", "morph": "HR/Sp2mp", "morph_id": "Preposisi + Sp2mp", "ayt_word": ""}, {"pos": 3, "word_orig": "עַלִּיזָ֑ה", "strong": "H5947", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "penuh"}, {"pos": 4, "word_orig": "מִֽ/ימֵי", "strong": "H3117", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "sejak"}, {"pos": 5, "word_orig": "קֶ֤דֶם", "strong": "H6924", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "dahulu"}, {"pos": 6, "word_orig": "קַדְמָתָ/הּ֙", "strong": "H6927", "morph": "HNcfsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "didirikan"}, {"pos": 7, "word_orig": "יֹבִל֣וּ/הָ", "strong": "H2986", "morph": "HVhi3mp/Sp3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak + Sp3fs", "ayt_word": "pergi"}, {"pos": 8, "word_orig": "רַגְלֶ֔י/הָ", "strong": "H7272", "morph": "HNcfdc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3fs", "ayt_word": "kakinya"}, {"pos": 9, "word_orig": "מֵֽ/רָח֖וֹק", "strong": "H7350", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "jauh"}, {"pos": 10, "word_orig": "לָ/גֽוּר", "strong": "H1481", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "di"}]}, {"book": 23, "chapter": 23, "verse": 8, "ayat_id": 18086, "title": "", "ayt_text": "Siapakah yang telah merencanakan hal ini terhadap Tirus, kota yang menganugerahkan mahkota, yang saudagar-saudagarnya adalah para pembesar dan pedagang-pedagangnya adalah orang terhormat di bumi?", "words": [{"pos": 1, "word_orig": "מִ֚י", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapakah"}, {"pos": 2, "word_orig": "יָעַ֣ץ", "strong": "H3289", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "merencanakan"}, {"pos": 3, "word_orig": "זֹ֔את", "strong": "H2063", "morph": "HPdxfs", "morph_id": "Pdxfs", "ayt_word": "ini"}, {"pos": 4, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "terhadap"}, {"pos": 5, "word_orig": "צֹ֖ר", "strong": "H6865", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Tirus"}, {"pos": 6, "word_orig": "הַ/מַּֽעֲטִירָ֑ה", "strong": "H5849", "morph": "HTd/Vhrfsa", "morph_id": "Artikel Definit (הַ) + Verba Hifil", "ayt_word": "menganugerahkan"}, {"pos": 7, "word_orig": "אֲשֶׁ֤ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 8, "word_orig": "סֹחֲרֶ֨י/ה֙", "strong": "H5503", "morph": "HVqrmpc/Sp3fs", "morph_id": "Verba Qal + Sp3fs", "ayt_word": "saudagar-saudagarnya"}, {"pos": 9, "word_orig": "שָׂרִ֔ים", "strong": "H8269", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pembesar"}, {"pos": 10, "word_orig": "כִּנְעָנֶ֖י/הָ", "strong": "H3667", "morph": "HNcmpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "pedagang-pedagangnya"}, {"pos": 11, "word_orig": "נִכְבַּדֵּי", "strong": "H3513", "morph": "HVNrmpc", "morph_id": "Verba Nifal", "ayt_word": "terhormat"}, {"pos": 12, "word_orig": "אָֽרֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "bumi"}]}, {"book": 23, "chapter": 23, "verse": 9, "ayat_id": 18087, "title": "", "ayt_text": "TUHAN semesta alamlah yang telah merencanakannya, untuk menajiskan kebanggaan semua keindahan, untuk merendahkan semua yang terhormat di bumi.", "words": [{"pos": 1, "word_orig": "יְהוָ֥ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 2, "word_orig": "צְבָא֖וֹת", "strong": "H6635", "morph": "HNcbpa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "alamlah"}, {"pos": 3, "word_orig": "יְעָצָ֑/הּ", "strong": "H3289", "morph": "HVqp3ms/Sp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp3fs", "ayt_word": "merencanakannya"}, {"pos": 4, "word_orig": "לְ/חַלֵּל֙", "strong": "H2490", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "menajiskan"}, {"pos": 5, "word_orig": "גְּא֣וֹן", "strong": "H1347", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kebanggaan"}, {"pos": 6, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 7, "word_orig": "צְבִ֔י", "strong": "H6643", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keindahan"}, {"pos": 8, "word_orig": "לְ/הָקֵ֖ל", "strong": "H7043", "morph": "HR/Vhc", "morph_id": "Preposisi + Verba Hifil Imperatif", "ayt_word": "merendahkan"}, {"pos": 9, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 10, "word_orig": "נִכְבַּדֵּי", "strong": "H3513", "morph": "HVNrmpc", "morph_id": "Verba Nifal", "ayt_word": "terhormat"}, {"pos": 11, "word_o