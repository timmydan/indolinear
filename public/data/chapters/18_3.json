[{"book": 18, "chapter": 3, "verse": 1, "ayat_id": 12906, "title": "Ayub Mengutuk Hari Kelahirannya", "ayt_text": "Setelah itu, Ayub membuka mulutnya, dan mengutuk hari lahirnya.", "words": [{"pos": 1, "word_orig": "אַחֲרֵי", "strong": "H310", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Setelah"}, {"pos": 2, "word_orig": "כֵ֗ן", "strong": "H3651", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "itu"}, {"pos": 3, "word_orig": "פָּתַ֤ח", "strong": "H6605", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membuka"}, {"pos": 4, "word_orig": "אִיּוֹב֙", "strong": "H347", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ayub"}, {"pos": 5, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 6, "word_orig": "פִּ֔י/הוּ", "strong": "H6310", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "mulutnya"}, {"pos": 7, "word_orig": "וַ/יְקַלֵּ֖ל", "strong": "H7043", "morph": "HC/Vpw3ms", "morph_id": "Konjungsi (וְ) + Verba Piel Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengutuk"}, {"pos": 8, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 9, "word_orig": "יוֹמֽ/וֹ", "strong": "H3117", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "hari"}]}, {"book": 18, "chapter": 3, "verse": 2, "ayat_id": 12907, "title": "", "ayt_text": "Ayub menjawab, dan berkata,", "words": [{"pos": 1, "word_orig": "וַ/יַּ֥עַן", "strong": "H6030", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjawab"}, {"pos": 2, "word_orig": "אִיּ֗וֹב", "strong": "H347", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ayub"}, {"pos": 3, "word_orig": "וַ/יֹּאמַֽר", "strong": "