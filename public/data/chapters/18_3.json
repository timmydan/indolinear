": "itu"}, {"pos": 3, "word_orig": "יִקָּחֵ֪/ה֫וּ", "strong": "H3947", "morph": "HVqi3ms/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "menguasainya"}, {"pos": 4, "word_orig": "אֹ֥פֶל", "strong": "H652", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kegelapan"}, {"pos": 5, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יִ֭חַדְּ", "strong": "H2302", "morph": "HVqj3ms", "morph_id": "Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersukacita"}, {"pos": 7, "word_orig": "בִּ/ימֵ֣י", "strong": "H3117", "morph": "HR/Ncmpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "hari-hari"}, {"pos": 8, "word_orig": "שָׁנָ֑ה", "strong": "H8141", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "setahun"}, {"pos": 9, "word_orig": "בְּ/מִסְפַּ֥ר", "strong": "H4557", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hitungan"}, {"pos": 10, "word_orig": "יְ֝רָחִ֗ים", "strong": "H3391", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bulan-bulan"}, {"pos": 11, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 12, "word_orig": "יָבֹֽא", "strong": "H935", "morph": "HVqj3ms", "morph_id": "Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "termasuk"}]}, {"book": 18, "chapter": 3, "verse": 7, "ayat_id": 12912, "title": "", "ayt_text": "Lihatlah, biarlah malam itu menjadi mandul; biarlah tidak ada sorak sukacita yang masuk.", "words": [{"pos": 1, "word_orig": "הִנֵּ֤ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "הַ/לַּ֣יְלָה", "strong": "H3915", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}, {"pos": 3, "word_orig": "הַ֭/הוּא", "strong": "H1931", "morph": "HTd/Pp3ms", "morph_id": "Artikel Definit (הַ) + Pp3ms", "ayt_word": "itu"}, {"pos": 4, "word_orig": "יְהִ֣י", "strong": "H1961", "morph": "HVqj3ms", "morph_id": "Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjadi"}, {"pos": 5, "word_orig": "גַלְמ֑וּד", "strong": "H1565", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "mandul"}, {"pos": 6, "word_orig": "אַל", "strong": "H408", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "תָּבֹ֖א", "strong": "H935", "morph": "HVqj3fs", "morph_id": "Verba Qal Orang ke-3 Perempuan Tunggal", "ayt_word": "masuk"}, {"pos": 8, "word_orig": "רְנָנָ֣ה", "strong": "H7445", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sukacita"}, {"pos": 9, "word_orig": "בֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 18, "chapter": 3, "verse": 8, "ayat_id": 12913, "title": "", "ayt_text": "Biarlah para pengutuk hari mengutuki hari itu, yaitu orang-orang yang siap membangunkan Lewiatan.", "words": [{"pos": 1, "word_orig": "יִקְּבֻ֥/הוּ", "strong": "H5344", "morph": "HVqi3mp/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak + Sp3ms", "ayt_word": "mengutuki"}, {"pos": 2, "word_orig": "אֹרְרֵי", "strong": "H779", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "pengutuk"}, {"pos": 3, "word_orig": "י֑וֹם", "strong": "H3117", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hari"}, {"pos": 4, "word_orig": "הָ֝/עֲתִידִ֗ים", "strong": "H6264", "morph": "HTd/Aampa", "morph_id": "Artikel Definit (הַ) + Aampa", "ayt_word": "siap"}, {"pos": 5, "word_orig": "עֹרֵ֥ר", "strong": "H5782", "morph": "HVoc", "morph_id": "Verba Imperatif", "ayt_word": "membangunkan"}, {"pos": 6, "word_orig"