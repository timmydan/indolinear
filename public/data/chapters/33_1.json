": 4, "word_orig": "יֹצֵ֣א", "strong": "H3318", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "keluar"}, {"pos": 5, "word_orig": "מִ/מְּקוֹמ֑/וֹ", "strong": "H4725", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "tempat-Nya"}, {"pos": 6, "word_orig": "וְ/יָרַ֥ד", "strong": "H3381", "morph": "HC/Vqp3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "turun"}, {"pos": 7, "word_orig": "וְ/דָרַ֖ךְ", "strong": "H1869", "morph": "HC/Vqp3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjejak"}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 9, "word_orig": "במותי", "strong": "H1116", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "bukit-bukit"}, {"pos": 10, "word_orig": "בָּ֥מֳתֵי", "strong": "H1116", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "bumi"}, {"pos": 11, "word_orig": "אָֽרֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": ""}]}, {"book": 33, "chapter": 1, "verse": 4, "ayat_id": 22584, "title": "", "ayt_text": "Gunung-gunung akan luluh di bawah-Nya, lembah-lembah terbelah seperti lilin di depan api, seperti air tercurah dari lereng.", "words": [{"pos": 1, "word_orig": "וְ/נָמַ֤סּוּ", "strong": "H4549", "morph": "HC/VNq3cp", "morph_id": "Konjungsi (וְ) + Verba Nifal Orang ke-3 Jamak", "ayt_word": "luluh"}, {"pos": 2, "word_orig": "הֶֽ/הָרִים֙", "strong": "H2022", "morph": "HTd/Ncmpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Gunung-gunung"}, {"pos": 3, "word_orig": "תַּחְתָּ֔י/ו", "strong": "H8478", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms"