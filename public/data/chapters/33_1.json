 "H1323", "morph": "HR/Ncfpc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "burung"}, {"pos": 14, "word_orig": "יַעֲנָֽה", "strong": "H3284", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": ""}]}, {"book": 33, "chapter": 1, "verse": 9, "ayat_id": 22589, "title": "", "ayt_text": "Sebab, lukanya tidak dapat disembuhkan, sudah menjalar ke Yehuda, sampai ke pintu gerbang bangsaku, ke Yerusalem!", "words": [{"pos": 1, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "אֲנוּשָׁ֖ה", "strong": "H605", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "dapat"}, {"pos": 3, "word_orig": "מַכּוֹתֶ֑י/הָ", "strong": "H4347", "morph": "HNcfpc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3fs", "ayt_word": "lukanya"}, {"pos": 4, "word_orig": "כִּי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 5, "word_orig": "בָ֨אָה֙", "strong": "H935", "morph": "HVqp3fs", "morph_id": "Verba Qal Perfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjalar"}, {"pos": 6, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 7, "word_orig": "יְהוּדָ֔ה", "strong": "H3063", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Yehuda"}, {"pos": 8, "word_orig": "נָגַ֛ע", "strong": "H5060", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "sampai"}, {"pos": 9, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "ke"}, {"pos": 10, "word_orig": "שַׁ֥עַר", "strong": "H8179", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "pintu"}, {"pos": 11, "word_orig": "עַמִּ֖/י", "strong": "H5971", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Ter