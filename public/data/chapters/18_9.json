morph": "HR", "morph_id": "Preposisi", "ayt_word": "daripada"}, {"pos": 4, "word_orig": "רָ֑ץ", "strong": "H7323", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "pelari"}, {"pos": 5, "word_orig": "בָּֽ֝רְח֗וּ", "strong": "H1272", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "terbang"}, {"pos": 6, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "רָא֥וּ", "strong": "H7200", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "melihat"}, {"pos": 8, "word_orig": "טוֹבָֽה", "strong": "H2896", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "baik"}]}, {"book": 18, "chapter": 9, "verse": 26, "ayat_id": 13078, "title": "", "ayt_text": "Mereka melaju seperti perahu dari papirus, seperti burung rajawali yang menyambar mangsanya.", "words": [{"pos": 1, "word_orig": "חָ֭לְפוּ", "strong": "H2498", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "melaju"}, {"pos": 2, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dari"}, {"pos": 3, "word_orig": "אֳנִיּ֣וֹת", "strong": "H591", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "perahu"}, {"pos": 4, "word_orig": "אֵבֶ֑ה", "strong": "H16", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "papirus"}, {"pos": 5, "word_orig": "כְּ֝/נֶ֗שֶׁר", "strong": "H5404", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rajawali"}, {"pos": 6, "word_orig": "יָט֥וּשׂ", "strong": "H2907", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyambar"}, {"pos": 7, "word_orig": "עֲלֵי", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 8, "word_orig": "אֹֽכֶל", "strong": "H400", "morph": "HNcmsa"