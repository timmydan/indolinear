[{"book": 18, "chapter": 9, "verse": 1, "ayat_id": 13053, "title": "Tidak Seorang pun Dapat Bertahan di Hadapan Allah", "ayt_text": "Kemudian, Ayub menjawab, katanya,", "words": [{"pos": 1, "word_orig": "וַ/יַּ֥עַן", "strong": "H6030", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menjawab"}, {"pos": 2, "word_orig": "אִיּ֗וֹב", "strong": "H347", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Ayub"}, {"pos": 3, "word_orig": "וַ/יֹּאמַֽר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "katanya"}]}, {"book": 18, "chapter": 9, "verse": 2, "ayat_id": 13054, "title": "", "ayt_text": "“Betul, aku tahu bahwa itu memang benar. Namun, bagaimana manusia bisa benar di hadapan Allah?", "words": [{"pos": 1, "word_orig": "אָ֭מְנָם", "strong": "H551", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Betul"}, {"pos": 2, "word_orig": "יָדַ֣עְתִּי", "strong": "H3045", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "tahu"}, {"pos": 3, "word_orig": "כִי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "bahwa"}, {"pos": 4, "word_orig": "כֵ֑ן", "strong": "H3651", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "Namun"}, {"pos": 5, "word_orig": "וּ/מַה", "strong": "H4100", "morph": "HC/Ti", "morph_id": "Konjungsi (וְ) + Ti", "ayt_word": "bagaimana"}, {"pos": 6, "word_orig": "יִּצְדַּ֖ק", "strong": "H6663", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "benar"}, {"pos": 7, "word_orig": "אֱנ֣וֹשׁ", "strong": "H582", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "manusia"}, {"pos": 8, "word_orig": "עִם", "strong": "H5973", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "hadapan"}, {"pos": 9, "word_orig": "אֵֽל", "strong": "H410", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}]}, {"book": 18, "chapter": 9, "verse": 3, "ayat_id": 13055, "title": "", "ayt_text": "Jika orang ingin berbantah dengan Dia, dia tidak bisa menjawab-Nya satu pun dari seribu kali.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "יַ֭חְפֹּץ", "strong": "H2654", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ingin"}, {"pos": 3, "word_orig": "לָ/רִ֣יב", "strong": "H7378", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "berbantah"}, {"pos": 4, "word_orig": "עִמּ֑/וֹ", "strong": "H5973", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "dengan"}, {"pos": 5, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יַ֝עֲנֶ֗/נּוּ", "strong": "H6030", "morph": "HVqi3ms/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "menjawab-Nya"}, {"pos": 7, "word_orig": "אַחַ֥ת", "strong": "H259", "morph": "HAcfsa", "morph_id": "Acfsa", "ayt_word": "satu"}, {"pos": 8, "word_orig": "מִנִּי", "strong": "H4480", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dari"}, {"pos": 9, "word_orig": "אָֽלֶף", "strong": "H505", "morph": "HAcbsa", "morph_id": "Acbsa", "ayt_word": "seribu"}]}, {"book": 18, "chapter": 9, "verse": 4, "ayat_id": 13056, "title": "", "ayt_text": "Dia bijaksana dalam hati dan besar dalam kekuatan; siapa yang bersikeras melawan Dia, dan bisa berhasil?", "words": [{"pos": 1, "word_orig": "חֲכַ֣ם", "strong": "H2450", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "bijaksana"}, {"pos": 2, "word_orig": "לֵ֭בָב", "strong": "H3824", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hati"}, {"pos": 3, "word_orig": "וְ/אַמִּ֣יץ", "strong": "H533", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "besar"}, {"pos": 4, "word_orig": "כֹּ֑חַ", "strong": "H3581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatan"}, {"pos": 5, "word_orig": "מִֽי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "siapa"}, {"pos": 6, "word_orig": "הִקְשָׁ֥ה", "strong": "H7185", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersikeras"}, {"pos": 7, "word_orig": "אֵ֝לָ֗י/ו", "strong": "H413", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "melawan"}, {"pos": 8, "word_orig": "וַ/יִּשְׁלָֽם", "strong": "H7999", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berhasil"}]}, {"book": 18, "chapter": 9, "verse": 5, "ayat_id": 13057, "title": "", "ayt_text": "Dialah yang memindahkan gunung-gunung tanpa diketahui. Dalam kemurkaan-Nya, Dia menjungkirbalikkan mereka.", "words": [{"pos": 1, "word_orig": "הַ/מַּעְתִּ֣יק", "strong": "H6275", "morph": "HTd/Vhrmsa", "morph_id": "Artikel Definit (הַ) + Verba Hifil", "ayt_word": "memindahkan"}, {"pos": 2, "word_orig": "הָ֭רִים", "strong": "H2022", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "gunung-gunung"}, {"pos": 3, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tanpa"}, {"pos": 4, "word_orig": "יָדָ֑עוּ", "strong": "H3045", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "diketahui"}, {"pos": 5, "word_orig": "אֲשֶׁ֖ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": ""}, {"pos": 6, "word_orig": "הֲפָכָ֣/ם", "strong": "H2015", "morph": "HVqp3ms/Sp3mp", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal + Sp3mp", "ayt_word": "menjungkirbalikkan"}, {"pos": 7, "wo