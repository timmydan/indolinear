ִזְרָ֑ח", "strong": "H2224", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terbit"}, {"pos": 5, "word_orig": "וּ/בְעַ֖ד", "strong": "H1157", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": ""}, {"pos": 6, "word_orig": "כּוֹכָבִ֣ים", "strong": "H3556", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "sinar"}, {"pos": 7, "word_orig": "יַחְתֹּֽם", "strong": "H2856", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menyegel"}]}, {"book": 18, "chapter": 9, "verse": 8, "ayat_id": 13060, "title": "", "ayt_text": "Dia sendiri yang membentangkan langit, dan menginjak-injak gelombang laut.", "words": [{"pos": 1, "word_orig": "נֹטֶ֣ה", "strong": "H5186", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membentangkan"}, {"pos": 2, "word_orig": "שָׁמַ֣יִם", "strong": "H8064", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "langit"}, {"pos": 3, "word_orig": "לְ/בַדּ֑/וֹ", "strong": "H905", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "sendiri"}, {"pos": 4, "word_orig": "וְ֝/דוֹרֵ֗ךְ", "strong": "H1869", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menginjak-injak"}, {"pos": 5, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "menginjak-injak"}, {"pos": 6, "word_orig": "בָּ֥מֳתֵי", "strong": "H1116", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "gelombang"}, {"pos": 7, "word_orig": "יָֽם", "strong": "H3220", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "laut"}]}, {"book": 18, "chapter": 9, "verse": 9, "ayat_id": 13061, "title": "", "ayt_text": "Dia membuat bintang Biduk, bintang Belantik, bintang Kartika, dan kumpulan bintang-bintang selatan.", "words": [{"pos": 1, "word_orig": "עֹֽשֶׂה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "membuat"}, {"pos": 2, "word_orig": "עָ֭שׁ", "strong": "H5906", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Biduk"}, {"pos": 3, "word_orig": "כְּסִ֥יל", "strong": "H3685", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Belantik"}, {"pos": 4, "word_orig": "וְ/כִימָ֗ה", "strong": "H3598", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "bintang"}, {"pos": 5, "word_orig": "וְ/חַדְרֵ֥י", "strong": "H2315", "morph": "HC/Ncmpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "bintang-bintang"}, {"pos": 6, "word_orig": "תֵמָֽן", "strong": "H8486", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "selatan"}]}, {"book": 18, "chapter": 9, "verse": 10, "ayat_id": 13062, "title": "", "ayt_text": "Dialah yang melakukan perbuatan-perbuatan besar yang tidak terselami, serta keajaiban yang tidak terhitung jumlahnya.", "words": [{"pos": 1, "word_orig": "עֹשֶׂ֣ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "melakukan"}, {"pos": 2, "word_orig": "גְ֭דֹלוֹת", "strong": "H1419", "morph": "HAafpa", "morph_id": "Aafpa", "ayt_word": "besar"}, {"pos": 3, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 4, "word_orig": "אֵ֣ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "חֵ֑קֶר", "strong": "H2714", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "terselami"}, {"pos": 6, "word_orig": "וְ/נִפְלָא֗וֹת", "strong": "H6381", "morph": "HC/VNrfpa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "keajaiban"}, {"pos": 7, "word_orig": "עַד", "strong": "H5704", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 8, "word_orig": "אֵ֥ין", "strong": "H369", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 9, "word_orig": "מִסְפָּֽר", "strong": "H4557", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "jumlahnya"}]}, {"book": 18, "chapter": 9, "verse": 11, "ayat_id": 13063, "title": "", "ayt_text": "Lihatlah, Dia lewat di hadapanku, dan aku tidak dapat melihat-Nya. Dia mendahului aku, tetapi aku tidak mengetahui-Nya.", "words": [{"pos": 1, "word_orig": "הֵ֤ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "יַעֲבֹ֣ר", "strong": "H5674", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "lewat"}, {"pos": 3, "word_orig": "עָ֭לַ/י", "strong": "H5921", "morph": "HR/Sp1cs", "morph_id": "Preposisi + Sp1cs", "ayt_word": "di"}, {"pos": 4, "word_orig": "וְ/לֹ֣א", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "אֶרְאֶ֑ה", "strong": "H7200", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "melihat-Nya"}, {"pos": 6, "word_orig": "וְ֝/יַחֲלֹ֗ף", "strong": "H2498", "morph": "HC/Vqi3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendahului"}, {"pos": 7, "word_orig": "וְֽ/לֹא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 8, "word_orig": "אָבִ֥ין", "strong": "H995", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mengetahui-Nya"}, {"pos": 9, "word_orig": "לֽ/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}]}, {"book": 18, "chapter": 9, "verse": 12, "ayat_id": 13064, "title": "", "ayt_text": "Lihatlah, Dia mengambil; siapakah yang dapat menghalangi-Nya? Siapakah yang dapat berkata kepada-Nya, ‘Apa yang sedang Engkau lakukan?’", "words": [{"pos": 1, "word_orig": "הֵ֣ן", "strong": "H2005", "morph": "HTm", "morph_id": "Tm", "ayt_word": "Lihatlah"}, {"pos": 2, "word_orig": "יַ֭חְתֹּף", "strong": "H2862", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengambil"}, {"pos": 3, "word_orig": "מִ֣י", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "siapakah"}, {"pos": 4, "word_orig": "יְשִׁיבֶ֑/נּוּ", "strong": "H7725", "morph": "HVhi3ms/Sp3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp3ms", "ayt_word": "menghalangi-Nya"}, {"pos": 5, "word_orig": "מִֽי", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Siapakah"}, {"pos": 6, "word_orig": "יֹאמַ֥ר", "strong": "H559", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berkata"}, {"pos": 7, "word_orig": "אֵ֝לָ֗י/ו", "strong": "H413", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "kepada-Nya"}, {"pos": 8, "word_orig": "מַֽה", "strong": "H4100", "morph": "HTi", "morph_id": "Ti", "ayt_word": "Apa"}, {"pos": 9, "word_orig": "תַּעֲשֶֽׂה", "strong": "H6213", "morph": "HVqi2ms", "morph_id": "Verba Qal Imperfek Orang ke-2 Laki-laki Tunggal", "ayt_word": "lakukan"}]}, {"book": 18, "chapter": 9, "verse": 13, "ayat_id": 13065, "title": "", "ayt_text": "Allah tidak akan menarik kembali kemurkaan-Nya; para pembantu Rahab tunduk di bawah-Nya.", "words": [{"pos": 1, "word_orig": "אֱ֭לוֹהַּ", "strong": "H433", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Allah"}, {"pos": 2, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 3, "word_orig": "יָשִׁ֣יב", "strong": "H7725", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menarik"}, {"pos": 4, "word_orig": "אַפּ֑/וֹ", "strong": "H639", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kemurkaan-Nya"}, {"pos": 5, "word_orig": "תחת/ו", "strong": "H8478", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "bawah-Nya"}, {"pos": 6, "word_orig": "תַּחְתָּ֥י/ו", "strong": "H8478", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "tunduk"}, {"pos": 7, "word_orig": "שָׁ֝חֲח֗וּ", "strong": "H7817", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "pembantu"}, {"pos": 8, "word_orig": "עֹ֣זְרֵי", "strong": "H5826", "morph": "HVqrmpc", "morph_id": "Verba Qal", "ayt_word": "Rahab"}, {"pos": 9, "word_orig": "רָֽהַב", "strong": "H7293", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": ""}]}, {"book": 18, "chapter": 9, "verse": 14, "ayat_id": 13066, "title": "", "ayt_text": "Lalu, bagaimana aku dapat menjawab-Nya, dan memilih kata-kataku untuk berdebat dengan-Nya?", "words": [{"pos": 1, "word_orig": "אַ֭ף", "strong": "H637", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 2, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 3, "word_orig": "אָנֹכִ֣י", "strong": "H595", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 4, "word_orig": "אֶֽעֱנֶ֑/נּוּ", "strong": "H6030", "morph": "HVqi1cs/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal + Sp3ms", "ayt_word": "menjawab-Nya"}, {"pos": 5, "word_orig": "אֶבְחֲרָ֖ה", "strong": "H977", "morph": "HVqh1cs", "morph_id": "Verba Qal Orang ke-1 Tunggal", "ayt_word": "memilih"}, {"pos": 6, "word_orig": "דְבָרַ֣/י", "strong": "H1697", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": ""}, {"pos": 7, "word_orig": "עִמּֽ/וֹ", "strong": "H5973", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": "dengan-Nya"}]}, {"book": 18, "chapter": 9, "verse": 15, "ayat_id": 13067, "title": "", "ayt_text": "Meskipun aku di sisi yang benar, aku tidak bisa menjawab-Nya; aku hanya bisa memohon belas kasihan kepada Hakimku.", "words": [{"pos": 1, "word_orig": "אֲשֶׁ֣ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 2, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Meskipun"}, {"pos": 3, "word_orig": "צָ֭דַקְתִּי", "strong": "H6663", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "benar"}, {"pos": 4, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "אֶעֱנֶ֑ה", "strong": "H6030", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "menjawab-Nya"}, {"pos": 6, "word_orig": "לִ֝/מְשֹׁפְטִ֗/י", "strong": "H8199", "morph": "HR/Vmrmsc/Sp1cs", "morph_id": "Preposisi + Verba + Sp1cs", "ayt_word": "Hakimku"}, {"pos": 7, "word_orig": "אֶתְחַנָּֽן", "strong": "H2603", "morph": "HVti1cs", "morph_id": "Verba Hitpael Imperfek Orang ke-1 Tunggal", "ayt_word": "memohon"}]}, {"book": 18, "chapter": 9, "verse": 16, "ayat_id": 13068, "title": "", "ayt_text": "Jika aku berseru, dan Dia menjawab aku, aku tidak percaya bahwa Dia akan mendengarkan suaraku.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "קָרָ֥אתִי", "strong": "H7121", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berseru"}, {"pos": 3, "word_orig": "וַֽ/יַּעֲנֵ֑/נִי", "strong": "H6030", "morph": "HC/Vqw3ms/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menjawab"}, {"pos": 4, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "אַ֝אֲמִ֗ין", "strong": "H539", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "percaya"}, {"pos": 6, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "bahwa"}, {"pos": 7, "word_orig": "יַאֲזִ֥ין", "strong": "H238", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendengarkan"}, {"pos": 8, "word_orig": "קוֹלִֽ/י", "strong": "H6963", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "suaraku"}]}, {"book": 18, "chapter": 9, "verse": 17, "ayat_id": 13069, "title": "", "ayt_text": "Sebab, Dia meremukkanku dengan angin ribut, dan melipatgandakan lukaku tanpa alasan.", "words": [{"pos": 1, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "בִּ/שְׂעָרָ֥ה", "strong": "H8183", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "angin"}, {"pos": 3, "word_orig": "יְשׁוּפֵ֑/נִי", "strong": "H7779", "morph": "HVqi3ms/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "meremukkanku"}, {"pos": 4, "word_orig": "וְ/הִרְבָּ֖ה", "strong": "H7235", "morph": "HC/Vhq3ms", "morph_id": "Konjungsi (וְ) + Verba Hifil Orang ke-3 Laki-laki Tunggal", "ayt_word": "melipatgandakan"}, {"pos": 5, "word_orig": "פְצָעַ֣/י", "strong": "H6482", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "lukaku"}, {"pos": 6, "word_orig": "חִנָּֽם", "strong": "H2600", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "alasan"}]}, {"book": 18, "chapter": 9, "verse": 18, "ayat_id": 13070, "title": "", "ayt_text": "Dia tidak akan membiarkanku menghela napas, tetapi mengisiku dengan kepahitan.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יִ֭תְּנֵ/נִי", "strong": "H5414", "morph": "HVqi3ms/Sp1cs", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "membiarkanku"}, {"pos": 3, "word_orig": "הָשֵׁ֣ב", "strong": "H7725", "morph": "HVha", "morph_id": "Verba Hifil Infinitif Absolut", "ayt_word": "menghela"}, {"pos": 4, "word_orig": "רוּחִ֑/י", "strong": "H7307", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "napas"}, {"pos": 5, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "tetapi"}, {"pos": 6, "word_orig": "יַ֝שְׂבִּעַ֗/נִי", "strong": "H7646", "morph": "HVhi3ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "mengisiku"}, {"pos": 7, "word_orig": "מַמְּרֹרִֽים", "strong": "H4472", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kepahitan"}]}, {"book": 18, "chapter": 9, "verse": 19, "ayat_id": 13071, "title": "", "ayt_text": "Jika ini adalah kontes kekuatan, betul, Dia hebat! Jika ini soal keadilan, siapa yang dapat menggugat Dia?", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "לְ/כֹ֣חַ", "strong": "H3581", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekuatan"}, {"pos": 3, "word_orig": "אַמִּ֣יץ", "strong": "H533", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "hebat"}, {"pos": 4, "word_orig": "הִנֵּ֑ה", "strong": "H2009", "morph": "HTm", "morph_id": "Tm", "ayt_word": "betul"}, {"pos": 5, "word_orig": "וְ/אִם", "strong": "H518", "morph": "HC/C", "morph_id": "Konjungsi (וְ) + Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 6, "word_orig": "לְ֝/מִשְׁפָּ֗ט", "strong": "H4941", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 7, "word_orig": "מִ֣י", "strong": "H4310", "morph": "HTi", "morph_id": "Ti", "ayt_word": "siapa"}, {"pos": 8, "word_orig": "יוֹעִידֵֽ/נִי", "strong": "H3259", "morph": "HVhi3ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "menggugat"}]}, {"book": 18, "chapter": 9, "verse": 20, "ayat_id": 13072, "title": "", "ayt_text": "Meskipun aku di sisi yang benar, mulutku sendiri akan mengutukku. Meskipun aku tidak bersalah, Dia akan membuktikan bahwa aku bersalah.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Meskipun"}, {"pos": 2, "word_orig": "אֶ֭צְדָּק", "strong": "H6663", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "benar"}, {"pos": 3, "word_orig": "פִּ֣/י", "strong": "H6310", "morph": "HNcmsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "mulutku"}, {"pos": 4, "word_orig": "יַרְשִׁיעֵ֑/נִי", "strong": "H7561", "morph": "HVhi3ms/Sp1cs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "mengutukku"}, {"pos": 5, "word_orig": "תָּֽם", "strong": "H8535", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bersalah"}, {"pos": 6, "word_orig": "אָ֝֗נִי", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 7, "word_orig": "וַֽ/יַּעְקְשֵֽׁ/נִי", "strong": "H6140", "morph": "HC/Vhw3ms/Sp1cs", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal + Sp1cs", "ayt_word": "bersalah"}]}, {"book": 18, "chapter": 9, "verse": 21, "ayat_id": 13073, "title": "", "ayt_text": "Aku tidak bersalah; aku tidak mengenal diriku sendiri; aku membenci hidupku.", "words": [{"pos": 1, "word_orig": "תָּֽם", "strong": "H8535", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "אָ֭נִי", "strong": "H589", "morph": "HPp1cs", "morph_id": "Pp1cs", "ayt_word": "aku"}, {"pos": 3, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "אֵדַ֥ע", "strong": "H3045", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "mengenal"}, {"pos": 5, "word_orig": "נַפְשִׁ֗/י", "strong": "H5315", "morph": "HNcbsc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "sendiri"}, {"pos": 6, "word_orig": "אֶמְאַ֥ס", "strong": "H3988", "morph": "HVqi1cs", "morph_id": "Verba Qal Imperfek Orang ke-1 Tunggal", "ayt_word": "membenci"}, {"pos": 7, "word_orig": "חַיָּֽ/י", "strong": "H2416", "morph": "HNcmpc/Sp1cs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp1cs", "ayt_word": "hidupku"}]}, {"book": 18, "chapter": 9, "verse": 22, "ayat_id": 13074, "title": "", "ayt_text": "Semuanya sama saja; itulah sebabnya, aku berkata, ‘Dia menghancurkan baik orang yang tidak berdosa maupun orang jahat.’", "words": [{"pos": 1, "word_orig": "אַחַ֗ת", "strong": "H259", "morph": "HAcfsa", "morph_id": "Acfsa", "ayt_word": "saja"}, {"pos": 2, "word_orig": "הִ֥יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "itulah"}, {"pos": 3, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": ""}, {"pos": 4, "word_orig": "כֵּ֥ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "sebabnya"}, {"pos": 5, "word_orig": "אָמַ֑רְתִּי", "strong": "H559", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "berkata"}, {"pos": 6, "word_orig": "תָּ֥ם", "strong": "H8535", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "וְ֝/רָשָׁ֗ע", "strong": "H7563", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "jahat"}, {"pos": 8, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": ""}, {"pos": 9, "word_orig": "מְכַלֶּֽה", "strong": "H3615", "morph": "HVprmsa", "morph_id": "Verba Piel", "ayt_word": "menghancurkan"}]}, {"book": 18, "chapter": 9, "verse": 23, "ayat_id": 13075, "title": "", "ayt_text": "Jika bencana membawa kematian yang tiba-tiba, Dia menertawakan keputusasaan yang menimpa orang yang tidak bersalah.", "words": [{"pos": 1, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Jika"}, {"pos": 2, "word_orig": "שׁ֭וֹט", "strong": "H7752", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "bencana"}, {"pos": 3, "word_orig": "יָמִ֣ית", "strong": "H4191", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membawa"}, {"pos": 4, "word_orig": "פִּתְאֹ֑ם", "strong": "H6597", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "tiba-tiba"}, {"pos": 5, "word_orig": "לְ/מַסַּ֖ת", "strong": "H4531", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "keputusasaan"}, {"pos": 6, "word_orig": "נְקִיִּ֣ם", "strong": "H5355", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יִלְעָֽג", "strong": "H3932", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menertawakan"}]}, {"book": 18, "chapter": 9, "verse": 24, "ayat_id": 13076, "title": "", "ayt_text": "Bumi diserahkan ke dalam tangan orang fasik. Dia menutupi muka para hakimnya. Jika itu bukan Dia, lalu siapa lagi?", "words": [{"pos": 1, "word_orig": "אֶ֤רֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "Bumi"}, {"pos": 2, "word_orig": "נִתְּנָ֬ה", "strong": "H5414", "morph": "HVNp3fs", "morph_id": "Verba Nifal Perfek Orang ke-3 Pere