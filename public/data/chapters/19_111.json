[{"book": 19, "chapter": 111, "verse": 1, "ayat_id": 15795, "title": "Keagungan Karya TUHAN", "ayt_text": "Haleluya! Aku hendak bersyukur kepada TUHAN dengan segenap hatiku, dalam kumpulan orang yang lurus hati dan dalam jemaat.", "words": [{"pos": 1, "word_orig": "הַ֥לְלוּ", "strong": "H1984", "morph": "HVpv2mp", "morph_id": "Verba Piel Partisip Aktif Orang ke-2 Laki-laki Jamak", "ayt_word": "Haleluya"}, {"pos": 2, "word_orig": "יָ֨הּ", "strong": "H3050", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Haleluya"}, {"pos": 3, "word_orig": "אוֹדֶ֣ה", "strong": "H3034", "morph": "HVhi1cs", "morph_id": "Verba Hifil Imperfek Orang ke-1 Tunggal", "ayt_word": "bersyukur"}, {"pos": 4, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "בְּ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segenap"}, {"pos": 6, "word_orig": "לֵבָ֑ב", "strong": "H3824", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "hatiku"}, {"pos": 7, "word_orig": "בְּ/ס֖וֹד", "strong": "H5475", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kumpulan"}, {"pos": 8, "word_orig": "יְשָׁרִ֣ים", "strong": "H3477", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "yang"}, {"pos": 9, "word_orig": "וְ/עֵדָֽה", "strong": "H5712", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "jemaat"}]}, {"book": 19, "chapter": 111, "verse": 2, "ayat_id": 15796, "title": "", "ayt_text": "Perbuatan-perbuatan TUHAN besar, diselidiki oleh semua orang yang menyukainya.", "words": [{"pos": 1, "word_orig": "גְּ֭דֹלִים", "strong": "H1419", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "besar"}, {"pos": 2, "word_orig": "מַעֲשֵׂ֣י", "strong": "H4639", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Perbuatan-perbuatan"}, {"pos": 3, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "דְּ֝רוּשִׁ֗ים", "strong": "H1875", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "diselidiki"}, {"pos": 5, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 6, "word_orig": "חֶפְצֵי/הֶֽם", "strong": "H2656", "morph": "HAampc/Sp3mp", "morph_id": "Aampc + Sp3mp", "ayt_word": "menyukainya"}]}, {"book": 19, "chapter": 111, "verse": 3, "ayat_id": 15797, "title": "", "ayt_text": "Mulia dan agung pekerjaan-Nya, kebenaran-Nya bertahan selamanya.", "words": [{"pos": 1, "word_orig": "הוֹד", "strong": "H1935", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Mulia"}, {"pos": 2, "word_orig": "וְ/הָדָ֥ר", "strong": "H1926", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "agung"}, {"pos": 3, "word_orig": "פָּֽעֳל֑/וֹ", "strong": "H6467", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "pekerjaan-Nya"}, {"pos": 4, "word_orig": "וְ֝/צִדְקָת֗/וֹ", "strong": "H6666", "morph": "HC/Ncfsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kebenaran-Nya"}, {"pos": 5, "word_orig": "עֹמֶ֥דֶת", "strong": "H5975", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "bertahan"}, {"pos": 6, "word_orig": "לָ/עַֽד", "strong": "H5703", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya"}]}, {"book": 19, "chapter": 111, "verse": 4, "ayat_id": 15798, "title": "", "ayt_text": "Dia melakukan keajaiban-keajaiban-Nya sebagai peringatan; TUHAN itu murah hati dan belas kasih.", "words": [{"pos": 1, "word_orig": "זֵ֣כֶר", "strong": "H2143", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "peringatan"}, {"pos": 2, "word_orig": "עָ֭שָׂה", "strong": "H6213", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "melakukan"}, {"pos": 3, "word_orig": "לְ/נִפְלְאֹתָ֑י/ו", "strong": "H6381", "morph": "HR/VNrfpc/Sp3ms", "morph_id": "Preposisi + Verba Nifal + Sp3ms", "ayt_word": "keajaiban-keajaiban-Nya"}, {"pos": 4, "word_orig": "חַנּ֖וּן", "strong": "H2587", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "murah"}, {"pos": 5, "word_orig": "וְ/רַח֣וּם", "strong": "H7349", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "belas"}, {"pos": 6, "word_orig": "יְהוָֽה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}]}, {"book": 19, "chapter": 111, "verse": 5, "ayat_id": 15799, "title": "", "ayt_text": "Dia memberikan makanan kepada orang-orang yang takut akan Dia; Dia akan mengingat perjanjian-Nya selama-lamanya.", "words": [{"pos": 1, "word_orig": "טֶ֭רֶף", "strong": "H2964", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "makanan"}, {"pos": 2, "word_orig": "נָתַ֣ן", "strong": "H5414", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberikan"}, {"pos": 3, "word_orig": "לִֽ/ירֵאָ֑י/ו", "strong": "H3373", "morph": "HR/Aampc/Sp3ms", "morph_id": "Preposisi + Aampc + Sp3ms", "ayt_word": "takut"}, {"pos": 4, "word_orig": "יִזְכֹּ֖ר", "strong": "H2142", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengingat"}, {"pos": 5, "word_orig": "לְ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 6, "word_orig": "בְּרִיתֽ/וֹ", "strong": "H1285", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "perjanjian-Nya"}]}, {"book": 19, "chapter": 111, "verse": 6, "ayat_id": 15800, "title": "", "ayt_text": "Dia telah memberitahukan kepada umat-Nya kuasa pekerjaan-Nya, dengan memberikan kepada mereka warisan bangsa-bangsa.", "words": [{"pos": 1, "word_orig": "כֹּ֣חַ", "strong": "H3581", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "kuasa"}, {"pos": 2, "word_orig": "מַ֭עֲשָׂי/ו", "strong": "H4639", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "pekerjaan-Nya"}, {"pos": 3, "word_orig": "הִגִּ֣יד", "strong": "H5046", "morph": "HVhp3ms", "morph_id": "Verba Hifil Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memberitahukan"}, {"pos": 4, "word_orig": "לְ/עַמּ֑/וֹ", "strong": "H5971", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "umat-Nya"}, {"pos": 5, "word_orig": "לָ/תֵ֥ת", "strong": "H5414", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "memberikan"}, {"pos": 6, "word_orig": "לָ֝/הֶ֗ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": "mereka"}, {"pos": 7, "word_orig": "נַחֲלַ֥ת", "strong": "H5159", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "warisan"}, {"pos": 8, "word_orig": "גּוֹיִֽם", "strong": "H1471", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "bangsa-bangsa"}]}, {"book": 19, "chapter": 111, "verse": 7, "ayat_id": 15801, "title": "", "ayt_text": "Pekerjaan-pekerjaan tangan-Nya adalah kebenaran dan keadilan, semua peraturan-Nya tetap.", "words": [{"pos": 1, "word_orig": "מַעֲשֵׂ֣י", "strong": "H4639", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Pekerjaan-pekerjaan"}, {"pos": 2, "word_orig": "יָ֭דָי/ו", "strong": "H3027", "morph": "HNcbdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "tangan-Nya"}, {"pos": 3, "word_orig": "אֱמֶ֣ת", "strong": "H571", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 4, "word_orig": "וּ/מִשְׁפָּ֑ט", "strong": "H4941", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "keadilan"}, {"pos": 5, "word_orig": "נֶ֝אֱמָנִ֗ים", "strong": "H539", "morph": "HVNrmpa", "morph_id": "Verba Nifal", "ayt_word": "tetap"}, {"pos": 6, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 7, "word_orig": "פִּקּוּדָֽי/ו", "strong": "H6490", "morph": "HNcmpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "peraturan-Nya"}]}, {"book": 19, "chapter": 111, "verse": 8, "ayat_id": 15802, "title": "", "ayt_text": "Hal itu akan teguh seterusnya dan selama-lamanya, untuk dilakukan dalam kesetiaan dan kebenaran.", "words": [{"pos": 1, "word_orig": "סְמוּכִ֣ים", "strong": "H5564", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "teguh"}, {"pos": 2, "word_orig": "לָ/עַ֣ד", "strong": "H5703", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "seterusnya"}, {"pos": 3, "word_orig": "לְ/עוֹלָ֑ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 4, "word_orig": "עֲ֝שׂוּיִ֗ם", "strong": "H6213", "morph": "HVqsmpa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "dilakukan"}, {"pos": 5, "word_orig": "בֶּ/אֱמֶ֥ת", "strong": "H571", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesetiaan"}, {"pos": 6, "word_orig": "וְ/יָשָֽׁר", "strong": "H3477", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "kebenaran"}]}, {"book": 19, "chapter": 111, "verse": 9, "ayat_id": 15803, "title": "", "ayt_text": "Dia telah mengirimkan tebusan bagi umat-Nya, Dia telah memerintahkan perjanjian-Nya untuk selama-lamanya. Kudus dan terhormat nama-Nya.", "words": [{"pos": 1, "word_orig": "פְּד֤וּת", "strong": "H6304", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "tebusan"}, {"pos": 2, "word_orig": "שָׁ֘לַ֤ח", "strong": "H7971", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mengirimkan"}, {"pos": 3, "word_orig": "לְ/עַמּ֗/וֹ", "strong": "H5971", "morph": "HR/Ncmsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "umat-Nya"}, {"pos": 4, "word_orig": "צִוָּֽה", "strong": "H6680", "morph": "HVpp3ms", "morph_id": "Verba Piel Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "memerintahkan"}, {"pos": 5, "word_orig": "לְ/עוֹלָ֥ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 6, "word_orig": "בְּרִית֑/וֹ", "strong": "H1285", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "perjanjian-Nya"}, {"pos": 7, "word_orig": "קָד֖וֹשׁ", "strong": "H6918", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "Kudus"}, {"pos": 8, "word_orig": "וְ/נוֹרָ֣א", "strong": "H3372", "morph": "HC/VNrmsa", "morph_id": "Konjungsi (וְ) + Verba Nifal", "ayt_word": "terhormat"}, {"pos": 9, "word_orig": "שְׁמֽ/וֹ", "strong": "H8034", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "nama-Nya"}]}, {"book": 19, "chapter": 111, "verse": 10, "ayat_id": 15804, "title": "", "ayt_text": "Takut akan TUHAN ialah awal dari hikmat, semua orang yang melakukannya memiliki pengertian yang baik. Pujian kepada-Nya tetap untuk selamanya-lamanya.", "words": [{"pos": 1, "word_orig": "רֵ֘אשִׁ֤ית", "strong": "H7225", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "awal"}, {"pos": 2, "word_orig": "חָכְמָ֨ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 3, "word_orig": "יִרְאַ֬ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 4, "word_orig": "יְהוָ֗ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "שֵׂ֣כֶל", "strong": "H7922", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pengertian"}, {"pos": 6, "word_orig": "ט֭וֹב", "strong": "H2896", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "baik"}, {"pos": 7, "word_orig": "לְ/כָל", "strong": "H3605", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "semua"}, {"pos": 8, "word_orig": "עֹשֵׂי/הֶ֑ם", "strong": "H6213", "morph": "HVqrmpc/Sp3mp", "morph_id": "Verba Qal + Sp3mp", "ayt_word": "melakukan-Nya"}, {"pos": 9, "word_orig": "תְּ֝הִלָּת֗/וֹ", "strong": "H8416", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "Pujian"}, {"pos": 10, "word_orig": "עֹמֶ֥דֶת", "strong": "H5975", "morph": "HVqrfsa", "morph_id": "Verba Qal", "ayt_word": "tetap"}, {"pos": 11, "word_orig": "לָ/עַֽד", "strong": "H5703", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selamanya-lamanya"}]}]