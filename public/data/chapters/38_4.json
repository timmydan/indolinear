t_word": ""}]}, {"book": 38, "chapter": 4, "verse": 3, "ayat_id": 22926, "title": "", "ayt_text": "Ada dua pohon zaitun di dekatnya, satu di sebelah kanan tempat minyak itu dan satu lagi di sebelah kirinya.”", "words": [{"pos": 1, "word_orig": "וּ/שְׁנַ֥יִם", "strong": "H8147", "morph": "HC/Acmda", "morph_id": "Konjungsi (וְ) + Acmda", "ayt_word": "dua"}, {"pos": 2, "word_orig": "זֵיתִ֖ים", "strong": "H2132", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pohon"}, {"pos": 3, "word_orig": "עָלֶ֑י/הָ", "strong": "H5921", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": "di"}, {"pos": 4, "word_orig": "אֶחָד֙", "strong": "H259", "morph": "HAcmsa", "morph_id": "Acmsa", "ayt_word": "satu"}, {"pos": 5, "word_orig": "מִ/ימִ֣ין", "strong": "H3225", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "sebelah"}, {"pos": 6, "word_orig": "הַ/גֻּלָּ֔ה", "strong": "H1543", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "minyak"}, {"pos": 7, "word_orig": "וְ/אֶחָ֖ד", "strong": "H259", "morph": "HC/Acmsa", "morph_id": "Konjungsi (וְ) + Acmsa", "ayt_word": "satu"}, {"pos": 8, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "di"}, {"pos": 9, "word_orig": "שְׂמֹאלָֽ/הּ", "strong": "H8040", "morph": "HNcmsc/Sp3fs", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3fs", "ayt_word": "sebelah"}]}, {"book": 38, "chapter": 4, "verse": 4, "ayat_id": 22927, "title": "", "ayt_text": "Lalu, aku menjawab dan bertanya kepada malaikat yang berbicara denganku, kataku, “Apakah arti semua ini, Tuanku?”", "words": [{"pos": 1, "word_orig": "וָ/אַ֨עַן֙", "strong": "H6030", "morph": "HC/Vqw1cs", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal", "ayt_word": "menjawab"}, {"pos": 2, "word_