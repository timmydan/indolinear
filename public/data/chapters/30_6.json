": "וַ/תַּגִּישׁ֖וּ/ן", "strong": "H5066", "morph": "HC/Vhw2mp/Sn", "morph_id": "Konjungsi (וְ) + Verba Hifil Waw Konsekutif Imperfek Orang ke-2 Laki-laki Jamak + Sn", "ayt_word": "membawa"}, {"pos": 5, "word_orig": "שֶׁ֥בֶת", "strong": "H7675", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": ""}, {"pos": 6, "word_orig": "חָמָֽס", "strong": "H2555", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekerasan"}]}, {"book": 30, "chapter": 6, "verse": 4, "ayat_id": 22455, "title": "", "ayt_text": "yang berbaring di atas tempat tidur gading, dan yang bersantai di atas kursi sofa. Mereka makan daging anak-anak domba dari kawanannya, dan daging anak sapi dari tengah kandangnya;", "words": [{"pos": 1, "word_orig": "הַ/שֹּֽׁכְבִים֙", "strong": "H7901", "morph": "HTd/Vqrmpa", "morph_id": "Artikel Definit (הַ) + Verba Qal", "ayt_word": "berbaring"}, {"pos": 2, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 3, "word_orig": "מִטּ֣וֹת", "strong": "H4296", "morph": "HNcfpc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "tidur"}, {"pos": 4, "word_orig": "שֵׁ֔ן", "strong": "H8127", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "gading"}, {"pos": 5, "word_orig": "וּ/סְרֻחִ֖ים", "strong": "H5628", "morph": "HC/Vqsmpa", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Pasif", "ayt_word": "bersantai"}, {"pos": 6, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "atas"}, {"pos": 7, "word_orig": "עַרְשׂוֹתָ֑/ם", "strong": "H6210", "morph": "HNcfpc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat) + Sp3mp", "ayt_word": "sofa"}, {"pos": 8, "word_orig": "וְ/אֹכְלִ֤ים", "strong": "H398", "morph": "HC/Vqrmpa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_