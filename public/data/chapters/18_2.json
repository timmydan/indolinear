utukilah"}, {"pos": 8, "word_orig": "אֱלֹהִ֖ים", "strong": "H430", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Allah"}, {"pos": 9, "word_orig": "וָ/מֻֽת", "strong": "H4191", "morph": "HC/Vqv2ms", "morph_id": "Konjungsi (וְ) + Verba Qal Partisip Aktif Orang ke-2 Laki-laki Tunggal", "ayt_word": "matilah"}]}, {"book": 18, "chapter": 2, "verse": 10, "ayat_id": 12902, "title": "", "ayt_text": "Namun, jawab Ayub kepadanya, “Kamu berbicara seperti perempuan bodoh berbicara. Apakah kita akan menerima yang baik dari Allah, dan tidak akan menerima yang buruk?” Dalam semuanya itu, Ayub tidak berdosa dengan bibirnya.", "words": [{"pos": 1, "word_orig": "וַ/יֹּ֣אמֶר", "strong": "H559", "morph": "HC/Vqw3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "jawab"}, {"pos": 2, "word_orig": "אֵלֶ֗י/הָ", "strong": "H413", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": "kepadanya"}, {"pos": 3, "word_orig": "כְּ/דַבֵּ֞ר", "strong": "H1696", "morph": "HR/Vpc", "morph_id": "Preposisi + Verba Piel Imperatif", "ayt_word": "berbicara"}, {"pos": 4, "word_orig": "אַחַ֤ת", "strong": "H259", "morph": "HAcfsa", "morph_id": "Acfsa", "ayt_word": ""}, {"pos": 5, "word_orig": "הַ/נְּבָלוֹת֙", "strong": "H5036", "morph": "HTd/Aafpa", "morph_id": "Artikel Definit (הַ) + Aafpa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "תְּדַבֵּ֔רִי", "strong": "H1696", "morph": "HVpi2fs", "morph_id": "Verba Piel Imperfek Orang ke-2 Perempuan Tunggal", "ayt_word": "berbicara"}, {"pos": 7, "word_orig": "גַּ֣ם", "strong": "H1571", "morph": "HTa", "morph_id": "Ta", "ayt_word": ""}, {"pos": 8, "word_orig": "אֶת", "strong": "H853", "morph": "HTo", "morph_id": "Tanda Objek (אֵת)", "ayt_word": ""}, {"pos": 9, "word_orig": "הַ/טּ֗וֹב", "strong": "H2896", "morph": "HTd/Aamsa", "morph_id": "Artikel Definit (הַ) + Aamsa", "ayt_word": "baik"}, {"pos": 10, "word_orig": "נְקַבֵּל֙", "strong": "H690