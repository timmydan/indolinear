[{"book": 28, "chapter": 11, "verse": 1, "ayat_id": 22242, "title": "Kasih Allah bagi Israel", "ayt_text": "Ketika Israel masih muda, Aku mengasihinya. Dan dari Mesir, Aku memanggil anak-Ku.", "words": [{"pos": 1, "word_orig": "כִּ֛י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Ketika"}, {"pos": 2, "word_orig": "נַ֥עַר", "strong": "H5288", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "muda"}, {"pos": 3, "word_orig": "יִשְׂרָאֵ֖ל", "strong": "H3478", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Israel"}, {"pos": 4, "word_orig": "וָ/אֹהֲבֵ֑/הוּ", "strong": "H157", "morph": "HC/Vqw1cs/Sp3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Waw Konsekutif Imperfek Orang ke-1 Tunggal + Sp3ms", "ayt_word": "mengasihinya"}, {"pos": 5, "word_orig": "וּ/מִ/מִּצְרַ֖יִם", "strong": "H4714", "morph": "HC/R/Np", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Jamak", "ayt_word": "Mesir"}, {"pos": 6, "word_orig": "קָרָ֥אתִי", "strong": "H7121", "morph": "HVqp1cs", "morph_id": "Verba Qal Perfek Orang ke-1 Tunggal", "ayt_word": "memanggil"}, {"pos": 7, "word_orig": "לִ/בְנִֽ/י", "strong": "H1121", "morph": "HR/Ncmsc/Sp1cs", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp1cs", "ayt_word": "anak-Ku"}]}, {"book": 28, "chapter": 11, "verse": 2, "ayat_id": 22243, "title": "", "ayt_text": "Semakin mereka Kupanggil, semakin mereka pergi menjauh. Mereka terus-menerus memberi persembahan kepada para Baal, dan membakar ukupan bagi patung-patung berhala.", "words": [{"pos": 1, "word_orig": "קָרְא֖וּ", "strong": "H7121", "morph": "HVqp3cp", "morph_id": "Verba Qal Perfek Orang ke-3 Jamak", "ayt_word": "Kupanggil"}, {"pos": 2, "word_orig": "לָ/הֶ֑ם", "strong": "", "morph": "HR/Sp3mp", "morph_id": "Preposisi + Sp3mp", "ayt_word": ""}, {"pos": 3, "word_orig": "כֵּ֚ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "semakin"}, {"pos": 4, "word_or