 20, "chapter": 13, "verse": 13, "ayat_id": 16761, "title": "", "ayt_text": "Siapa menghina firman akan menanggung kehancuran, tetapi dia yang takut terhadap perintah akan menerima upahnya.", "words": [{"pos": 1, "word_orig": "בָּ֣ז", "strong": "H936", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menghina"}, {"pos": 2, "word_orig": "לְ֭/דָבָר", "strong": "H1697", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "firman"}, {"pos": 3, "word_orig": "יֵחָ֣בֶל", "strong": "H2254", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kehancuran"}, {"pos": 4, "word_orig": "ל֑/וֹ", "strong": "", "morph": "HR/Sp3ms", "morph_id": "Preposisi + Sp3ms", "ayt_word": ""}, {"pos": 5, "word_orig": "וִ/ירֵ֥א", "strong": "H3373", "morph": "HC/Aamsc", "morph_id": "Konjungsi (וְ) + Aamsc", "ayt_word": "takut"}, {"pos": 6, "word_orig": "מִ֝צְוָ֗ה", "strong": "H4687", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "perintah"}, {"pos": 7, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "akan"}, {"pos": 8, "word_orig": "יְשֻׁלָּֽם", "strong": "H7999", "morph": "HVPi3ms", "morph_id": "Verba Pual Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "upahnya"}]}, {"book": 20, "chapter": 13, "verse": 14, "ayat_id": 16762, "title": "", "ayt_text": "Pengajaran orang berhikmat adalah mata air kehidupan untuk menjauhkan orang dari perangkap maut.", "words": [{"pos": 1, "word_orig": "תּוֹרַ֣ת", "strong": "H8451", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Pengajaran"}, {"pos": 2, "word_orig": "חָ֭כָם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "מְק֣וֹר", "strong": "H4726", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Te