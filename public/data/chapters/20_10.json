ָ֗ה", "strong": "H1681", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "fitnah"}, {"pos": 7, "word_orig": "ה֣וּא", "strong": "H1931", "morph": "HPp3ms", "morph_id": "Pp3ms", "ayt_word": "adalah"}, {"pos": 8, "word_orig": "כְסִֽיל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}]}, {"book": 20, "chapter": 10, "verse": 19, "ayat_id": 16676, "title": "", "ayt_text": "Ketika perkataan banyak, pelanggaran tidak terhenti, tetapi dia yang menahan bibirnya adalah bijaksana.", "words": [{"pos": 1, "word_orig": "בְּ/רֹ֣ב", "strong": "H7230", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "banyak"}, {"pos": 2, "word_orig": "דְּ֭בָרִים", "strong": "H1697", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "perkataan"}, {"pos": 3, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יֶחְדַּל", "strong": "H2308", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "terhenti"}, {"pos": 5, "word_orig": "פָּ֑שַׁע", "strong": "H6588", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pelanggaran"}, {"pos": 6, "word_orig": "וְ/חֹשֵׂ֖ךְ", "strong": "H2820", "morph": "HC/Vqrmsa", "morph_id": "Konjungsi (וְ) + Verba Qal", "ayt_word": "menahan"}, {"pos": 7, "word_orig": "שְׂפָתָ֣י/ו", "strong": "H8193", "morph": "HNcfdc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat) + Sp3ms", "ayt_word": "bibirnya"}, {"pos": 8, "word_orig": "מַשְׂכִּֽיל", "strong": "H7919", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "bijaksana"}]}, {"book": 20, "chapter": 10, "verse": 20, "ayat_id": 16677, "title": "", "ayt_text": "Lidah orang benar adalah perak pilihan, tetapi hati orang fasik sedikit harganya.", "words": [{"pos": 1, "word_orig": "כֶּ֣סֶף", "strong": "H3701", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "perak"}, {"pos": 2, "word_orig": "נִ֭בְחָר", "strong": "H977", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "pilihan"}, {"pos": 3, "word_orig": "לְשׁ֣וֹן", "strong": "H3956", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Lidah"}, {"pos": 4, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "לֵ֖ב", "strong": "H3820", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "hati"}, {"pos": 6, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "כִּ/מְעָֽט", "strong": "H4592", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sedikit"}]}, {"book": 20, "chapter": 10, "verse": 21, "ayat_id": 16678, "title": "", "ayt_text": "Bibir orang benar memberi makan banyak orang, tetapi orang bodoh mati karena kekurangan akal budi.", "words": [{"pos": 1, "word_orig": "שִׂפְתֵ֣י", "strong": "H8193", "morph": "HNcfdc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Bibir"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "יִרְע֣וּ", "strong": "H7462", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "memberi"}, {"pos": 4, "word_orig": "רַבִּ֑ים", "strong": "H7227", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "banyak"}, {"pos": 5, "word_orig": "וֶֽ֝/אֱוִילִ֗ים", "strong": "H191", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "בַּ/חֲסַר", "strong": "H2638", "morph": "HR/Aamsc", "morph_id": "Preposisi + Aamsc", "ayt_word": "kekurangan"}, {"pos": 7, "word_orig": "לֵ֥ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "akal"}, {"pos": 8, "word_orig": "יָמֽוּתוּ", "strong": "H4191", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "mati"}]}, {"book": 20, "chapter": 10, "verse": 22, "ayat_id": 16679, "title": "", "ayt_text": "Berkat TUHAN menjadikan kaya, dan Dia tidak menambahkan kesusahan padanya.", "words": [{"pos": 1, "word_orig": "בִּרְכַּ֣ת", "strong": "H1293", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Berkat"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "הִ֣יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": ""}, {"pos": 4, "word_orig": "תַעֲשִׁ֑יר", "strong": "H6238", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjadikan"}, {"pos": 5, "word_orig": "וְ/לֹֽא", "strong": "H3808", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 6, "word_orig": "יוֹסִ֖ף", "strong": "H3254", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menambahkan"}, {"pos": 7, "word_orig": "עֶ֣צֶב", "strong": "H6089", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kesusahan"}, {"pos": 8, "word_orig": "עִמָּֽ/הּ", "strong": "H5973", "morph": "HR/Sp3fs", "morph_id": "Preposisi + Sp3fs", "ayt_word": ""}]}, {"book": 20, "chapter": 10, "verse": 23, "ayat_id": 16680, "title": "", "ayt_text": "Berbuat jahat itu seperti candaan bagi orang bodoh, tetapi perilaku hikmat adalah kesukaan bagi orang berpengertian.", "words": [{"pos": 1, "word_orig": "כִּ/שְׂח֣וֹק", "strong": "H7814", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "candaan"}, {"pos": 2, "word_orig": "לִ֭/כְסִיל", "strong": "H3684", "morph": "HR/Aamsa", "morph_id": "Preposisi + Aamsa", "ayt_word": "bodoh"}, {"pos": 3, "word_orig": "עֲשׂ֣וֹת", "strong": "H6213", "morph": "HVqc", "morph_id": "Verba Qal Imperatif", "ayt_word": "Berbuat"}, {"pos": 4, "word_orig": "זִמָּ֑ה", "strong": "H2154", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "jahat"}, {"pos": 5, "word_orig": "וְ֝/חָכְמָ֗ה", "strong": "H2451", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 6, "word_orig": "לְ/אִ֣ישׁ", "strong": "H376", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 7, "word_orig": "תְּבוּנָֽה", "strong": "H8394", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berpengertian"}]}, {"book": 20, "chapter": 10, "verse": 24, "ayat_id": 16681, "title": "", "ayt_text": "Yang ditakuti oleh orang fasik akan datang menimpa mereka, tetapi keinginan orang benar akan dikabulkan.", "words": [{"pos": 1, "word_orig": "מְגוֹרַ֣ת", "strong": "H4034", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "ditakuti"}, {"pos": 2, "word_orig": "רָ֭שָׁע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "fasik"}, {"pos": 3, "word_orig": "הִ֣יא", "strong": "H1931", "morph": "HPp3fs", "morph_id": "Pp3fs", "ayt_word": "akan"}, {"pos": 4, "word_orig": "תְבוֹאֶ֑/נּוּ", "strong": "H935", "morph": "HVqi3fs/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "datang"}, {"pos": 5, "word_orig": "וְ/תַאֲוַ֖ת", "strong": "H8378", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "keinginan"}, {"pos": 6, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 7, "word_orig": "יִתֵּֽן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dikabulkan"}]}, {"book": 20, "chapter": 10, "verse": 25, "ayat_id": 16682, "title": "", "ayt_text": "Bila topan melanda, orang fasik tidak akan ada lagi, tetapi orang benar adalah dasar yang kekal.", "words": [{"pos": 1, "word_orig": "כַּ/עֲב֣וֹר", "strong": "H5674", "morph": "HR/Vqc", "morph_id": "Preposisi + Verba Qal Imperatif", "ayt_word": "melanda"}, {"pos": 2, "word_orig": "ס֭וּפָה", "strong": "H5492", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "topan"}, {"pos": 3, "word_orig": "וְ/אֵ֣ין", "strong": "H369", "morph": "HC/Tn", "morph_id": "Konjungsi (וְ) + Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "רָשָׁ֑ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 5, "word_orig": "וְ֝/צַדִּ֗יק", "strong": "H6662", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "יְס֣וֹד", "strong": "H3247", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "dasar"}, {"pos": 7, "word_orig": "עוֹלָֽם", "strong": "H5769", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekal"}]}, {"book": 20, "chapter": 10, "verse": 26, "ayat_id": 16683, "title": "", "ayt_text": "Bagaikan cuka bagi gigi dan asap bagi mata, seperti itulah seorang pemalas bagi mereka yang menyuruhnya.", "words": [{"pos": 1, "word_orig": "כַּ/חֹ֤מֶץ", "strong": "H2558", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "cuka"}, {"pos": 2, "word_orig": "לַ/שִּׁנַּ֗יִם", "strong": "H8127", "morph": "HRd/Ncbda", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Absolut", "ayt_word": "gigi"}, {"pos": 3, "word_orig": "וְ/כֶ/עָשָׁ֥ן", "strong": "H6227", "morph": "HC/Rd/Ncmsa", "morph_id": "Konjungsi (וְ) + Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "asap"}, {"pos": 4, "word_orig": "לָ/עֵינָ֑יִם", "strong": "H5869", "morph": "HRd/Ncbda", "morph_id": "Rd + Nomina Konstruk (Terikat) Kedua Jenis Ganda (Dual) Absolut", "ayt_word": "mata"}, {"pos": 5, "word_orig": "כֵּ֥ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "itulah"}, {"pos": 6, "word_orig": "הֶ֝/עָצֵ֗ל", "strong": "H6102", "morph": "HTd/Aamsa", "morph_id": "Artikel Definit (הַ) + Aamsa", "ayt_word": "pemalas"}, {"pos": 7, "word_orig": "לְ/שֹׁלְחָֽי/ו", "strong": "H7971", "morph": "HR/Vqrmpc/Sp3ms", "morph_id": "Preposisi + Verba Qal + Sp3ms", "ayt_word": "menyuruhnya"}]}, {"book": 20, "chapter": 10, "verse": 27, "ayat_id": 16684, "title": "", "ayt_text": "Takut akan TUHAN memperpanjang umur, tetapi tahun-tahun orang fasik akan dipendekkan.", "words": [{"pos": 1, "word_orig": "יִרְאַ֣ת", "strong": "H3374", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Takut"}, {"pos": 2, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 3, "word_orig": "תּוֹסִ֣יף", "strong": "H3254", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "memperpanjang"}, {"pos": 4, "word_orig": "יָמִ֑ים", "strong": "H3117", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "umur"}, {"pos": 5, "word_orig": "וּ/שְׁנ֖וֹת", "strong": "H8141", "morph": "HC/Ncfpc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Jamak Konstruk (Terikat)", "ayt_word": "tahun-tahun"}, {"pos": 6, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 7, "word_orig": "תִּקְצֹֽרְנָה", "strong": "H7114", "morph": "HVqi3fp", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Jamak", "ayt_word": "dipendekkan"}]}, {"book": 20, "chapter": 10, "verse": 28, "ayat_id": 16685, "title": "", "ayt_text": "Pengharapan orang benar membawa sukacita, tetapi harapan orang fasik akan lenyap.", "words": [{"pos": 1, "word_orig": "תּוֹחֶ֣לֶת", "strong": "H8431", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Pengharapan"}, {"pos": 2, "word_orig": "צַדִּיקִ֣ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "שִׂמְחָ֑ה", "strong": "H8057", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "sukacita"}, {"pos": 4, "word_orig": "וְ/תִקְוַ֖ת", "strong": "H8615", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "harapan"}, {"pos": 5, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "תֹּאבֵֽד", "strong": "H6", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "lenyap"}]}, {"book": 20, "chapter": 10, "verse": 29, "ayat_id": 16686, "title": "", "ayt_text": "Jalan TUHAN adalah benteng bagi orang yang lurus, tetapi kehancuran bagi para pelaku kejahatan.", "words": [{"pos": 1, "word_orig": "מָע֣וֹז", "strong": "H4581", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "benteng"}, {"pos": 2, "word_orig": "לַ֭/תֹּם", "strong": "H8537", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "lurus"}, {"pos": 3, "word_orig": "דֶּ֣רֶךְ", "strong": "H1870", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "Jalan"}, {"pos": 4, "word_orig": "יְהוָ֑ה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 5, "word_orig": "וּ֝/מְחִתָּ֗ה", "strong": "H4288", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kehancuran"}, {"pos": 6, "word_orig": "לְ/פֹ֣עֲלֵי", "strong": "H6466", "morph": "HR/Vqrmpc", "morph_id": "Preposisi + Verba Qal", "ayt_word": "pelaku"}, {"pos": 7, "word_orig": "אָֽוֶן", "strong": "H205", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kejahatan"}]}, {"book": 20, "chapter": 10, "verse": 30, "ayat_id": 16687, "title": "", "ayt_text": "Orang benar tidak akan goyah untuk selama-lamanya, tetapi orang fasik tidak akan tinggal di negeri.", "words": [{"pos": 1, "word_orig": "צַדִּ֣יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 2, "word_orig": "לְ/עוֹלָ֣ם", "strong": "H5769", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "selama-lamanya"}, {"pos": 3, "word_orig": "בַּל", "strong": "H1077", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 4, "word_orig": "יִמּ֑וֹט", "strong": "H4131", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "goyah"}, {"pos": 5, "word_orig": "וּ֝/רְשָׁעִ֗ים", "strong": "H7563", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "לֹ֣א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 7, "word_orig": "יִשְׁכְּנוּ", "strong": "H7931", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "tinggal"}, {"pos": 8, "word_orig": "אָֽרֶץ", "strong": "H776", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "negeri"}]}, {"book": 20, "chapter": 10, "verse": 31, "ayat_id": 16688, "title": "", "ayt_text": "Mulut orang benar menghasilkan hikmat, tetapi lidah yang sesat akan dipotong.", "words": [{"pos": 1, "word_orig": "פִּֽי", "strong": "H6310", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Mulut"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "יָנ֣וּב", "strong": "H5107", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghasilkan"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 5, "word_orig": "וּ/לְשׁ֥וֹן", "strong": "H3956", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "lidah"}, {"pos": 6, "word_orig": "תַּ֝הְפֻּכ֗וֹת", "strong": "H8419", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "sesat"}, {"pos": 7, "word_orig": "תִּכָּרֵֽת", "strong": "H3772", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "dipotong"}]}, {"book": 20, "chapter": 10, "verse": 32, "ayat_id": 16689, "title": "", "ayt_text": "Bibir orang benar mengetahui hal yang diperkenan, tetapi mulut orang fasik adalah penentangan.", "words": [{"pos": 1, "word_orig": "שִׂפְתֵ֣י", "strong": "H8193", "morph": "HNcfdc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "Bibir"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "יֵדְע֣וּ/ן", "strong": "H3045", "morph": "HVqi3mp/Sn", "morph_id