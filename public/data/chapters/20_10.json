[{"book": 20, "chapter": 10, "verse": 1, "ayat_id": 16658, "title": "Amsal Salomo", "ayt_text": "Inilah amsal-amsal Salomo: Anak yang berhikmat menjadikan ayahnya bersukacita, tetapi anak yang bodoh adalah kedukaan ibunya.", "words": [{"pos": 1, "word_orig": "מִשְׁלֵ֗י", "strong": "H4912", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "amsal-amsal"}, {"pos": 2, "word_orig": "שְׁלֹ֫מֹ֥ה", "strong": "H8010", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "Salomo"}, {"pos": 3, "word_orig": "בֵּ֣ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Anak"}, {"pos": 4, "word_orig": "חָ֭כָם", "strong": "H2450", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "berhikmat"}, {"pos": 5, "word_orig": "יְשַׂמַּח", "strong": "H8055", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "bersukacita"}, {"pos": 6, "word_orig": "אָ֑ב", "strong": "H1", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "ayahnya"}, {"pos": 7, "word_orig": "וּ/בֵ֥ן", "strong": "H1121", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 8, "word_orig": "כְּ֝סִ֗יל", "strong": "H3684", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 9, "word_orig": "תּוּגַ֥ת", "strong": "H8424", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kedukaan"}, {"pos": 10, "word_orig": "אִמּֽ/וֹ", "strong": "H517", "morph": "HNcfsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "ibunya"}]}, {"book": 20, "chapter": 10, "verse": 2, "ayat_id": 16659, "title": "", "ayt_text": "Harta benda hasil kefasikan tidaklah menguntungkan, tetapi kebenaran melepaskan dari maut.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidaklah"}, {"pos": 2, "word_orig": "י֭וֹעִילוּ", "strong": "H3276", "morph": "HVhi3mp", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menguntungkan"}, {"pos": 3, "word_orig": "אוֹצְר֣וֹת", "strong": "H214", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "Harta"}, {"pos": 4, "word_orig": "רֶ֑שַׁע", "strong": "H7562", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kefasikan"}, {"pos": 5, "word_orig": "וּ֝/צְדָקָ֗ה", "strong": "H6666", "morph": "HC/Ncfsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kebenaran"}, {"pos": 6, "word_orig": "תַּצִּ֥יל", "strong": "H5337", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "melepaskan"}, {"pos": 7, "word_orig": "מִ/מָּֽוֶת", "strong": "H4194", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "maut"}]}, {"book": 20, "chapter": 10, "verse": 3, "ayat_id": 16660, "title": "", "ayt_text": "TUHAN tidak membiarkan orang benar kelaparan, tetapi Dia menghempaskan keinginan orang fasik.", "words": [{"pos": 1, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 2, "word_orig": "יַרְעִ֣יב", "strong": "H7456", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "kelaparan"}, {"pos": 3, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "נֶ֣פֶשׁ", "strong": "H5315", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "orang"}, {"pos": 5, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 6, "word_orig": "וְ/הַוַּ֖ת", "strong": "H1942", "morph": "HC/Ncfsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "keinginan"}, {"pos": 7, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 8, "word_orig": "יֶהְדֹּֽף", "strong": "H1920", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghempaskan"}]}, {"book": 20, "chapter": 10, "verse": 4, "ayat_id": 16661, "title": "", "ayt_text": "Tangan orang lamban menyebabkan kemiskinan, tetapi tangan orang rajin menjadikan kaya.", "words": [{"pos": 1, "word_orig": "רָ֗אשׁ", "strong": "H7326", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kemiskinan"}, {"pos": 2, "word_orig": "עֹשֶׂ֥ה", "strong": "H6213", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "menyebabkan"}, {"pos": 3, "word_orig": "כַף", "strong": "H3709", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Tangan"}, {"pos": 4, "word_orig": "רְמִיָּ֑ה", "strong": "H7423", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "lamban"}, {"pos": 5, "word_orig": "וְ/יַ֖ד", "strong": "H3027", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 6, "word_orig": "חָרוּצִ֣ים", "strong": "H2742", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "rajin"}, {"pos": 7, "word_orig": "תַּעֲשִֽׁיר", "strong": "H6238", "morph": "HVhi3fs", "morph_id": "Verba Hifil Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menjadikan"}]}, {"book": 20, "chapter": 10, "verse": 5, "ayat_id": 16662, "title": "", "ayt_text": "Dia yang mengumpulkan pada musim panas adalah anak yang bijak, tetapi dia yang tidur pada waktu panen adalah anak yang menyebabkan malu.", "words": [{"pos": 1, "word_orig": "אֹגֵ֣ר", "strong": "H103", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengumpulkan"}, {"pos": 2, "word_orig": "בַּ֭/קַּיִץ", "strong": "H7019", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "musim"}, {"pos": 3, "word_orig": "בֵּ֣ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 4, "word_orig": "מַשְׂכִּ֑יל", "strong": "H7919", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "bijak"}, {"pos": 5, "word_orig": "נִרְדָּ֥ם", "strong": "H7290", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "tidur"}, {"pos": 6, "word_orig": "בַּ֝/קָּצִ֗יר", "strong": "H7105", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "waktu"}, {"pos": 7, "word_orig": "בֵּ֣ן", "strong": "H1121", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "anak"}, {"pos": 8, "word_orig": "מֵבִֽישׁ", "strong": "H954", "morph": "HVhrmsa", "morph_id": "Verba Hifil", "ayt_word": "menyebabkan"}]}, {"book": 20, "chapter": 10, "verse": 6, "ayat_id": 16663, "title": "", "ayt_text": "Berkat ada di atas kepala orang benar, tetapi mulut orang fasik menutupi kekejaman.", "words": [{"pos": 1, "word_orig": "בְּ֭רָכוֹת", "strong": "H1293", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "Berkat"}, {"pos": 2, "word_orig": "לְ/רֹ֣אשׁ", "strong": "H7218", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kepala"}, {"pos": 3, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 4, "word_orig": "וּ/פִ֥י", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 5, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "יְכַסֶּ֥ה", "strong": "H3680", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menutupi"}, {"pos": 7, "word_orig": "חָמָֽס", "strong": "H2555", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekejaman"}]}, {"book": 20, "chapter": 10, "verse": 7, "ayat_id": 16664, "title": "", "ayt_text": "Kenangan akan orang benar adalah berkat, tetapi nama orang fasik akan membusuk.", "words": [{"pos": 1, "word_orig": "זֵ֣כֶר", "strong": "H2143", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "Kenangan"}, {"pos": 2, "word_orig": "צַ֭דִּיק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 3, "word_orig": "לִ/בְרָכָ֑ה", "strong": "H1293", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "berkat"}, {"pos": 4, "word_orig": "וְ/שֵׁ֖ם", "strong": "H8034", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "nama"}, {"pos": 5, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 6, "word_orig": "יִרְקָֽב", "strong": "H7537", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "membusuk"}]}, {"book": 20, "chapter": 10, "verse": 8, "ayat_id": 16665, "title": "", "ayt_text": "Hati yang berhikmat akan menerima perintah-perintah, tetapi bibir yang bodoh akan diruntuhkan.", "words": [{"pos": 1, "word_orig": "חֲכַם", "strong": "H2450", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "berhikmat"}, {"pos": 2, "word_orig": "לֵ֭ב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Hati"}, {"pos": 3, "word_orig": "יִקַּ֣ח", "strong": "H3947", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menerima"}, {"pos": 4, "word_orig": "מִצְוֺ֑ת", "strong": "H4687", "morph": "HNcfpa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Jamak Absolut", "ayt_word": "perintah-perintah"}, {"pos": 5, "word_orig": "וֶ/אֱוִ֥יל", "strong": "H191", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "שְׂ֝פָתַ֗יִם", "strong": "H8193", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "bibir"}, {"pos": 7, "word_orig": "יִלָּבֵֽט", "strong": "H3832", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diruntuhkan"}]}, {"book": 20, "chapter": 10, "verse": 9, "ayat_id": 16666, "title": "", "ayt_text": "Siapa berjalan dalam kejujuran berjalan dengan aman, tetapi dia yang membengkokkan jalannya akan ketahuan.", "words": [{"pos": 1, "word_orig": "הוֹלֵ֣ךְ", "strong": "H1980", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "berjalan"}, {"pos": 2, "word_orig": "בַּ֭/תֹּם", "strong": "H8537", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kejujuran"}, {"pos": 3, "word_orig": "יֵ֣לֶךְ", "strong": "H3212", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berjalan"}, {"pos": 4, "word_orig": "בֶּ֑טַח", "strong": "H983", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "aman"}, {"pos": 5, "word_orig": "וּ/מְעַקֵּ֥שׁ", "strong": "H6140", "morph": "HC/Vprmsa", "morph_id": "Konjungsi (וְ) + Verba Piel", "ayt_word": "membengkokkan"}, {"pos": 6, "word_orig": "דְּ֝רָכָ֗י/ו", "strong": "H1870", "morph": "HNcbpc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Jamak Konstruk (Terikat) + Sp3ms", "ayt_word": "jalannya"}, {"pos": 7, "word_orig": "יִוָּדֵֽעַ", "strong": "H3045", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "ketahuan"}]}, {"book": 20, "chapter": 10, "verse": 10, "ayat_id": 16667, "title": "", "ayt_text": "Siapa mengedipkan mata mendatangkan kesedihan, tetapi bibir yang bodoh akan diruntuhkan.", "words": [{"pos": 1, "word_orig": "קֹ֣רֵֽץ", "strong": "H7169", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengedipkan"}, {"pos": 2, "word_orig": "עַ֭יִן", "strong": "H5869", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "mata"}, {"pos": 3, "word_orig": "יִתֵּ֣ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "mendatangkan"}, {"pos": 4, "word_orig": "עַצָּ֑בֶת", "strong": "H6094", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kesedihan"}, {"pos": 5, "word_orig": "וֶ/אֱוִ֥יל", "strong": "H191", "morph": "HC/Aamsa", "morph_id": "Konjungsi (וְ) + Aamsa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "שְׂ֝פָתַ֗יִם", "strong": "H8193", "morph": "HNcfda", "morph_id": "Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Absolut", "ayt_word": "bibir"}, {"pos": 7, "word_orig": "יִלָּבֵֽט", "strong": "H3832", "morph": "HVNi3ms", "morph_id": "Verba Nifal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "diruntuhkan"}]}, {"book": 20, "chapter": 10, "verse": 11, "ayat_id": 16668, "title": "", "ayt_text": "Mulut orang benar adalah mata air kehidupan, tetapi mulut orang fasik menutupi kekejaman.", "words": [{"pos": 1, "word_orig": "מְק֣וֹר", "strong": "H4726", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "air"}, {"pos": 2, "word_orig": "חַ֭יִּים", "strong": "H2416", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 3, "word_orig": "פִּ֣י", "strong": "H6310", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 4, "word_orig": "צַדִּ֑יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 5, "word_orig": "וּ/פִ֥י", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 6, "word_orig": "רְ֝שָׁעִ֗ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 7, "word_orig": "יְכַסֶּ֥ה", "strong": "H3680", "morph": "HVpi3ms", "morph_id": "Verba Piel Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menutupi"}, {"pos": 8, "word_orig": "חָמָֽס", "strong": "H2555", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekejaman"}]}, {"book": 20, "chapter": 10, "verse": 12, "ayat_id": 16669, "title": "", "ayt_text": "Kebencian menimbulkan pertengkaran, tetapi kasih menutupi segala pelanggaran.", "words": [{"pos": 1, "word_orig": "שִׂ֭נְאָה", "strong": "H8135", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "Kebencian"}, {"pos": 2, "word_orig": "תְּעוֹרֵ֣ר", "strong": "H5782", "morph": "HVoi3fs", "morph_id": "Verba Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menimbulkan"}, {"pos": 3, "word_orig": "מְדָנִ֑ים", "strong": "H4090", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pertengkaran"}, {"pos": 4, "word_orig": "וְ/עַ֥ל", "strong": "H5921", "morph": "HC/R", "morph_id": "Konjungsi (וְ) + Preposisi", "ayt_word": ""}, {"pos": 5, "word_orig": "כָּל", "strong": "H3605", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "segala"}, {"pos": 6, "word_orig": "פְּ֝שָׁעִ֗ים", "strong": "H6588", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "pelanggaran"}, {"pos": 7, "word_orig": "תְּכַסֶּ֥ה", "strong": "H3680", "morph": "HVpi3fs", "morph_id": "Verba Piel Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "menutupi"}, {"pos": 8, "word_orig": "אַהֲבָֽה", "strong": "H160", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kasih"}]}, {"book": 20, "chapter": 10, "verse": 13, "ayat_id": 16670, "title": "", "ayt_text": "Pada bibir orang berpengertian terdapat hikmat, tetapi rotan ada untuk punggung orang yang kekurangan akal budi.", "words": [{"pos": 1, "word_orig": "בְּ/שִׂפְתֵ֣י", "strong": "H8193", "morph": "HR/Ncfdc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Ganda (Dual) Konstruk (Terikat)", "ayt_word": "bibir"}, {"pos": 2, "word_orig": "נָ֭בוֹן", "strong": "H995", "morph": "HVNrmsa", "morph_id": "Verba Nifal", "ayt_word": "berpengertian"}, {"pos": 3, "word_orig": "תִּמָּצֵ֣א", "strong": "H4672", "morph": "HVNi3fs", "morph_id": "Verba Nifal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "terdapat"}, {"pos": 4, "word_orig": "חָכְמָ֑ה", "strong": "H2451", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "hikmat"}, {"pos": 5, "word_orig": "וְ֝/שֵׁ֗בֶט", "strong": "H7626", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "rotan"}, {"pos": 6, "word_orig": "לְ/גֵ֣ו", "strong": "H1460", "morph": "HR/Ncmsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "punggung"}, {"pos": 7, "word_orig": "חֲסַר", "strong": "H2638", "morph": "HAamsc", "morph_id": "Aamsc", "ayt_word": "akal"}, {"pos": 8, "word_orig": "לֵֽב", "strong": "H3820", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "kekurangan"}]}, {"book": 20, "chapter": 10, "verse": 14, "ayat_id": 16671, "title": "", "ayt_text": "Orang berhikmat menyimpan pengetahuan, tetapi mulut orang bodoh membawa kehancuran mendekat.", "words": [{"pos": 1, "word_orig": "חֲכָמִ֥ים", "strong": "H2450", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "Orang"}, {"pos": 2, "word_orig": "יִצְפְּנוּ", "strong": "H6845", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "menyimpan"}, {"pos": 3, "word_orig": "דָ֑עַת", "strong": "H1847", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "pengetahuan"}, {"pos": 4, "word_orig": "וּ/פִֽי", "strong": "H6310", "morph": "HC/Ncmsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "mulut"}, {"pos": 5, "word_orig": "אֱ֝וִיל", "strong": "H191", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "bodoh"}, {"pos": 6, "word_orig": "מְחִתָּ֥ה", "strong": "H4288", "morph": "HNcfsa", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kehancuran"}, {"pos": 7, "word_orig": "קְרֹבָֽה", "strong": "H7138", "morph": "HAafsa", "morph_id": "Aafsa", "ayt_word": "mendekat"}]}, {"book": 20, "chapter": 10, "verse": 15, "ayat_id": 16672, "title": "", "ayt_text": "Harta orang kaya adalah kotanya yang kuat. Kehancuran orang melarat ialah kemiskinannya.", "words": [{"pos": 1, "word_orig": "ה֣וֹן", "strong": "H1952", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Harta"}, {"pos": 2, "word_orig": "עָ֭שִׁיר", "strong": "H6223", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "kaya"}, {"pos": 3, "word_orig": "קִרְיַ֣ת", "strong": "H7151", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kotanya"}, {"pos": 4, "word_orig": "עֻזּ֑/וֹ", "strong": "H5797", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "kuat"}, {"pos": 5, "word_orig": "מְחִתַּ֖ת", "strong": "H4288", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Kehancuran"}, {"pos": 6, "word_orig": "דַּלִּ֣ים", "strong": "H1800", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "melarat"}, {"pos": 7, "word_orig": "רֵישָֽׁ/ם", "strong": "H7389", "morph": "HNcmsc/Sp3mp", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3mp", "ayt_word": "kemiskinannya"}]}, {"book": 20, "chapter": 10, "verse": 16, "ayat_id": 16673, "title": "", "ayt_text": "Upah orang benar menuntun kepada kehidupan, penghasilan orang fasik kepada dosa.", "words": [{"pos": 1, "word_orig": "פְּעֻלַּ֣ת", "strong": "H6468", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "Upah"}, {"pos": 2, "word_orig": "צַדִּ֣יק", "strong": "H6662", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "benar"}, {"pos": 3, "word_orig": "לְ/חַיִּ֑ים", "strong": "H2416", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "kehidupan"}, {"pos": 4, "word_orig": "תְּבוּאַ֖ת", "strong": "H8393", "morph": "HNcfsc", "morph_id": "Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "penghasilan"}, {"pos": 5, "word_orig": "רָשָׁ֣ע", "strong": "H7563", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "לְ/חַטָּֽאת", "strong": "H2403", "morph": "HR/Ncfsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "dosa"}]}, {"book": 20, "chapter": 10, "verse": 17, "ayat_id": 16674, "title": "", "ayt_text": "Siapa memelihara didikan berada di jalan menuju kehidupan, tetapi dia yang menolak teguran menjadi tersesat.", "words": [{"pos": 1, "word_orig": "אֹ֣רַח", "strong": "H734", "morph": "HNcbsa", "morph_id": "Nomina Konstru