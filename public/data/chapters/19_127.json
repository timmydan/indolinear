 "בָּנִ֑ים", "strong": "H1121", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "anak"}, {"pos": 5, "word_orig": "שָׂ֝כָ֗ר", "strong": "H7939", "morph": "HNcmsa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "upah"}, {"pos": 6, "word_orig": "פְּרִ֣י", "strong": "H6529", "morph": "HNcmsc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat)", "ayt_word": "buah"}, {"pos": 7, "word_orig": "הַ/בָּֽטֶן", "strong": "H990", "morph": "HTd/Ncfsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Perempuan Tunggal Absolut", "ayt_word": "kandungan"}]}, {"book": 19, "chapter": 127, "verse": 4, "ayat_id": 16126, "title": "", "ayt_text": "Seperti anak-anak panah di tangan seorang pahlawan, begitu juga anak-anak pada masa mudanya.", "words": [{"pos": 1, "word_orig": "כְּ/חִצִּ֥ים", "strong": "H2671", "morph": "HR/Ncmpa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "panah"}, {"pos": 2, "word_orig": "בְּ/יַד", "strong": "H3027", "morph": "HR/Ncbsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "tangan"}, {"pos": 3, "word_orig": "גִּבּ֑וֹר", "strong": "H1368", "morph": "HAamsa", "morph_id": "Aamsa", "ayt_word": "pahlawan"}, {"pos": 4, "word_orig": "כֵּ֝֗ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "begitu"}, {"pos": 5, "word_orig": "בְּנֵ֣י", "strong": "H1121", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "anak-anak"}, {"pos": 6, "word_orig": "הַ/נְּעוּרִֽים", "strong": "H5271", "morph": "HTd/Ncbpa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Kedua Jenis Jamak Absolut", "ayt_word": "masa"}]}, {"book": 19, "chapter": 127, "verse": 5, "ayat_id": 16127, "title": "", "ayt_text": "Diberkatilah orang yang telah memenuhi tabung panahnya, dia takkan malu ketika berbicar