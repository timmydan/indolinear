[{"book": 19, "chapter": 1, "verse": 1, "ayat_id": 13941, "title": "Jilid 1<br/>(Mazmur 1-41)<br/>Kebahagiaan Sejati dalam Hukum Allah", "ayt_text": "Diberkatilah orang yang tidak berjalan menurut nasihat orang fasik, tidak berdiri di jalan orang-orang berdosa, dan tidak duduk di pertemuan para pencemooh.", "words": [{"pos": 1, "word_orig": "אַ֥שְֽׁרֵי", "strong": "H835", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "Diberkatilah"}, {"pos": 2, "word_orig": "הָ/אִ֗ישׁ", "strong": "H376", "morph": "HTd/Ncmsa", "morph_id": "Artikel Definit (הַ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "orang"}, {"pos": 3, "word_orig": "אֲשֶׁ֤ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 4, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 5, "word_orig": "הָלַךְ֮", "strong": "H1980", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berjalan"}, {"pos": 6, "word_orig": "בַּ/עֲצַ֪ת", "strong": "H6098", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "nasihat"}, {"pos": 7, "word_orig": "רְשָׁ֫עִ֥ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 8, "word_orig": "וּ/בְ/דֶ֣רֶךְ", "strong": "H1870", "morph": "HC/R/Ncbsc", "morph_id": "Konjungsi (וְ) + Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 9, "word_orig": "חַ֭טָּאִים", "strong": "H2400", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "berdosa"}, {"pos": 10, "word_orig": "לֹ֥א", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 11, "word_orig": "עָמָ֑ד", "strong": "H5975", "morph": "HVqp3ms", "morph_id": "Verba Qal Perfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berdiri"}, {"pos": 12, "word_orig": "וּ/בְ/מו