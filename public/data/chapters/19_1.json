bia", "ayt_word": "siang"}, {"pos": 9, "word_orig": "וָ/לָֽיְלָה", "strong": "H3915", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "malam"}]}, {"book": 19, "chapter": 1, "verse": 3, "ayat_id": 13943, "title": "", "ayt_text": "Dia seperti sebuah pohon yang ditanam di dekat aliran-aliran air, yang menghasilkan buahnya pada musimnya, dan daun-daunnya tidak layu. Segala sesuatu yang dilakukannya berhasil.", "words": [{"pos": 1, "word_orig": "וְֽ/הָיָ֗ה", "strong": "H1961", "morph": "HC/Vqq3ms", "morph_id": "Konjungsi (וְ) + Verba Qal Orang ke-3 Laki-laki Tunggal", "ayt_word": "seperti"}, {"pos": 2, "word_orig": "כְּ/עֵץ֮", "strong": "H6086", "morph": "HR/Ncmsa", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "pohon"}, {"pos": 3, "word_orig": "שָׁת֪וּל", "strong": "H8362", "morph": "HVqsmsa", "morph_id": "Verba Qal Partisip Pasif", "ayt_word": "ditanam"}, {"pos": 4, "word_orig": "עַֽל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "dekat"}, {"pos": 5, "word_orig": "פַּלְגֵ֫י", "strong": "H6388", "morph": "HNcmpc", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Konstruk (Terikat)", "ayt_word": "aliran-aliran"}, {"pos": 6, "word_orig": "מָ֥יִם", "strong": "H4325", "morph": "HNcmpa", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Jamak Absolut", "ayt_word": "air"}, {"pos": 7, "word_orig": "אֲשֶׁ֤ר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 8, "word_orig": "פִּרְי֨/וֹ", "strong": "H6529", "morph": "HNcmsc/Sp3ms", "morph_id": "Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "buahnya"}, {"pos": 9, "word_orig": "יִתֵּ֬ן", "strong": "H5414", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "menghasilkan"}, {"pos": 10, "word_orig": "בְּ/עִתּ֗/וֹ", "strong": "H6256", "morph": "HR/Ncbsc/Sp3ms", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "musimnya"}, {"pos": 11, "word_orig": "וְ/עָלֵ֥/הוּ", "strong": "H5929", "morph": "HC/Ncmsc/Sp3ms", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Konstruk (Terikat) + Sp3ms", "ayt_word": "daun-daunnya"}, {"pos": 12, "word_orig": "לֹֽא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "tidak"}, {"pos": 13, "word_orig": "יִבּ֑וֹל", "strong": "H5034", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "layu"}, {"pos": 14, "word_orig": "וְ/כֹ֖ל", "strong": "H3605", "morph": "HC/Ncmsa", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "Segala"}, {"pos": 15, "word_orig": "אֲשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 16, "word_orig": "יַעֲשֶׂ֣ה", "strong": "H6213", "morph": "HVqi3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "dilakukannya"}, {"pos": 17, "word_orig": "יַצְלִֽיחַ", "strong": "H6743", "morph": "HVhi3ms", "morph_id": "Verba Hifil Imperfek Orang ke-3 Laki-laki Tunggal", "ayt_word": "berhasil"}]}, {"book": 19, "chapter": 1, "verse": 4, "ayat_id": 13944, "title": "", "ayt_text": "Tidak demikian dengan orang fasik; mereka seperti sekam yang diterbangkan angin.", "words": [{"pos": 1, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "Tidak"}, {"pos": 2, "word_orig": "כֵ֥ן", "strong": "H3651", "morph": "HD", "morph_id": "Adverbia", "ayt_word": "demikian"}, {"pos": 3, "word_orig": "הָ/רְשָׁעִ֑ים", "strong": "H7563", "morph": "HTd/Aampa", "morph_id": "Artikel Definit (הַ) + Aampa", "ayt_word": "fasik"}, {"pos": 4, "word_orig": "כִּ֥י", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 5, "word_orig": "אִם", "strong": "H518", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": ""}, {"pos": 6, "word_orig": "כַּ֝/מֹּ֗ץ", "strong": "H4671", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "sekam"}, {"pos": 7, "word_orig": "אֲֽשֶׁר", "strong": "H834", "morph": "HTr", "morph_id": "Tr", "ayt_word": "yang"}, {"pos": 8, "word_orig": "תִּדְּפֶ֥/נּוּ", "strong": "H5086", "morph": "HVqi3fs/Sp3ms", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal + Sp3ms", "ayt_word": "diterbangkan"}, {"pos": 9, "word_orig": "רֽוּחַ", "strong": "H7307", "morph": "HNcbsa", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Absolut", "ayt_word": "angin"}]}, {"book": 19, "chapter": 1, "verse": 5, "ayat_id": 13945, "title": "", "ayt_text": "Oleh karena itu, orang fasik takkan bertahan dalam penghakiman, begitu juga orang-orang berdosa dalam kumpulan orang benar.", "words": [{"pos": 1, "word_orig": "עַל", "strong": "H5921", "morph": "HR", "morph_id": "Preposisi", "ayt_word": "Oleh"}, {"pos": 2, "word_orig": "כֵּ֤ן", "strong": "H3651", "morph": "HTm", "morph_id": "Tm", "ayt_word": "karena"}, {"pos": 3, "word_orig": "לֹא", "strong": "H3808", "morph": "HTn", "morph_id": "Tn", "ayt_word": "takkan"}, {"pos": 4, "word_orig": "יָקֻ֣מוּ", "strong": "H6965", "morph": "HVqi3mp", "morph_id": "Verba Qal Imperfek Orang ke-3 Laki-laki Jamak", "ayt_word": "bertahan"}, {"pos": 5, "word_orig": "רְ֭שָׁעִים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "orang"}, {"pos": 6, "word_orig": "בַּ/מִּשְׁפָּ֑ט", "strong": "H4941", "morph": "HRd/Ncmsa", "morph_id": "Rd + Nomina Konstruk (Terikat) Laki-laki Tunggal Absolut", "ayt_word": "penghakiman"}, {"pos": 7, "word_orig": "וְ֝/חַטָּאִ֗ים", "strong": "H2400", "morph": "HC/Aampa", "morph_id": "Konjungsi (וְ) + Aampa", "ayt_word": "berdosa"}, {"pos": 8, "word_orig": "בַּ/עֲדַ֥ת", "strong": "H5712", "morph": "HR/Ncfsc", "morph_id": "Preposisi + Nomina Konstruk (Terikat) Perempuan Tunggal Konstruk (Terikat)", "ayt_word": "kumpulan"}, {"pos": 9, "word_orig": "צַדִּיקִֽים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}]}, {"book": 19, "chapter": 1, "verse": 6, "ayat_id": 13946, "title": "", "ayt_text": "Sebab, TUHAN mengenal jalan orang benar, tetapi jalan orang fasik akan binasa.", "words": [{"pos": 1, "word_orig": "כִּֽי", "strong": "H3588", "morph": "HC", "morph_id": "Konjungsi (וְ)", "ayt_word": "Sebab"}, {"pos": 2, "word_orig": "יוֹדֵ֣עַ", "strong": "H3045", "morph": "HVqrmsa", "morph_id": "Verba Qal", "ayt_word": "mengenal"}, {"pos": 3, "word_orig": "יְ֭הוָה", "strong": "H3068", "morph": "HNp", "morph_id": "Nomina Jamak", "ayt_word": "TUHAN"}, {"pos": 4, "word_orig": "דֶּ֣רֶךְ", "strong": "H1870", "morph": "HNcbsc", "morph_id": "Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 5, "word_orig": "צַדִּיקִ֑ים", "strong": "H6662", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "benar"}, {"pos": 6, "word_orig": "וְ/דֶ֖רֶךְ", "strong": "H1870", "morph": "HC/Ncbsc", "morph_id": "Konjungsi (וְ) + Nomina Konstruk (Terikat) Kedua Jenis Tunggal Konstruk (Terikat)", "ayt_word": "jalan"}, {"pos": 7, "word_orig": "רְשָׁעִ֣ים", "strong": "H7563", "morph": "HAampa", "morph_id": "Aampa", "ayt_word": "fasik"}, {"pos": 8, "word_orig": "תֹּאבֵֽד", "strong": "H6", "morph": "HVqi3fs", "morph_id": "Verba Qal Imperfek Orang ke-3 Perempuan Tunggal", "ayt_word": "binasa"}]}]